@T 
@BEG_Attrib 
3 @RT(4)20.0 @RT(0) @RT(0) 
@END_Attrib 
1 0 @F @F @F @F 

@Var @RT(21)rStressFactorPressOut @RT(0) @T @F @DT @RT(4)REAL @RT(0) @T @T @BASIC 0 @F 
@F @F 
@T 
@BEG_Attrib 
3 @RT(0) @RT(0) @RT(0) 
@END_Attrib 
1 0 @F @F @F @F 

@Var @RT(25)iPressureSensorRegulation @RT(0) @T @F @DT @RT(3)INT @RT(0) @T @T @BASIC 0 @F 
@F @F 
@T 
@BEG_Attrib 
3 @RT(1)0 @RT(0) @RT(0) 
@END_Attrib 
1 0 @F @F @F @F 

@END_Dcl 

@END_Export 

@BEG_Body 
@TL(130)
IF SV_sGeneralSystemCfg.mSimulateProcess THEN
  
  //
  IF SV_ControlState.mBootupFinished AND NOT mInit THEN
    
    mInit := F_Version_String(i_zRoot    := cCatRootVersion,
                              i_zPath    := cCatPathVersion,
                              i_zName    := 'AB_GenerateActValues',
                              i_zVersion := Ag_zVersion);
    
    mTable       := TRUE;
    ag_mInitDone := TRUE;
    
  END_IF;
  
  IF (abChannels.fGetNrOfChannels() >= cIndex_MainChannel) AND mTestAdaption THEN
    // test adaption with changing gain factor
    IF ((abChannels.fGetChannelReservedBy(cIndex_MainChannel) = Triggers) AND (nChannelState <> Triggers))             OR
       ((abChannels.fGetChannelReservedBy(cIndex_MainChannel) = TP_Interpreter) AND (nChannelState <> TP_Interpreter)) THEN
      rBodyCounter := rBodyCounter + rGainBodyCounter;
      IF (rBodyCounter > rMaxBody) THEN
        rBodyCounter  := 0.0;
        rGainFlow     := 0.2;
        rGainPressApp := 30.0;
        rGainPressOut := 35.0;
      END_IF;
      
      rGainFlow     := rGainFlow + rGainFlow * rBodyCounter / 100.0; 
      rGainPressApp := rGainPressApp + rGainPressApp * rBodyCounter / 100.0; 
      rGainPressOut := rGainPressOut + rGainPressOut * rBodyCounter / 100.0;
        
    END_IF;
    nChannelState := abChannels.fGetChannelReservedBy(cIndex_MainChannel);
    
  ELSIF mStressTestMatManager THEN
    rGainFlow     := rGainFlow + rStressFactor;
    rGainPressApp := rGainPressApp + rStressFactor;
    rGainPressOut := rGainPressOut + rStressFactorPressOut;
    rSimTemp      := rSimTemp + rStressFactor;
    
    IF (rGainFlow >= 30.0) THEN
      rGainFlow     := 0.2;
      rGainPressApp := 30.0;
      rGainPressOut := 35.0;  
      rSimTemp      := 20.0;
    END_IF;
  END_IF;  
  
  mGunOn := FALSE;
  FOR i := 1 TO GV_sPCU.Devices.sNeedles.iNumber DO
    mGunOn := GV_sPCU.Devices.sNeedles.y[i].Common.Signals.ActValue;
    IF mGunOn THEN
      EXIT;
    END_IF;
  END_FOR;
  
  IF ag_mInitDone THEN      
    FOR i:=1 TO GV_sPCU.Devices.sAnalogSensors.iNumber DO
      IF (FIND(GV_sPCU.Devices.sAnalogSensors.y[i].zName, "MV2PE") > 0)THEN
        GV_sPCU.Devices.sAnalogSensors.y[i].pData.rSimValue := rDiffPressureInput + GV_sPCU.Devices.sAnalogSensors.y[cAnalogSensor_BMV2PA].pData.rSimValue;
      END_IF;
      IF (FIND(GV_sPCU.Devices.sAnalogSensors.y[i].zName, "AP1P") > 0)THEN
        iPressureSensorRegulation := i;
        IF (GV_sPCU.Devices.sAirFlows.y[cAirFlow_BMV2].Common.Signals.Set.rValue_Releases_Out > 0.0) THEN    
          GV_sPCU.Devices.sAnalogSensors.y[i].pData.rSimValue  := GV_sPCU.Devices.sAirFlows.y[cAirFlow_BMV2].Common.Signals.Set.rValue_Releases_Out * rGainPressApp;           
        ELSIF 
          (GV_sPCU.Devices.sValves.y[cValve_YAVR1].T001.Signals.ActValue     OR   // AVR1
           GV_sPCU.Devices.sNeedles.y[cNeedle_YHN1].Common.Signals.ActValue  OR   // HN1
           GV_sPCU.Devices.sNeedles.y[cNeedle_YHN2].Common.Signals.ActValue  OR   // HN2
           GV_sPCU.Devices.sNeedles.y[cNeedle_YHN3].Common.Signals.ActValue) THEN // HN3
      
           GV_sPCU.Devices.sAnalogSensors.y[i].pData.rSimValue  := 0.0; 
          
        END_IF;
        IF NOT mGunOn AND mGunOnOld THEN  
          GV_sPCU.Devices.sAnalogSensors.y[i].pData.rSimValue := GV_sPCU.Devices.sAirFlows.y[cAirFlow_BMV2].Common.Signals.Set.rValue_Releases_Out * rGainPressApp + (rOffsetSwitchOff / 100.0 * GV_sPCU.Devices.sAnalogSensors.y[i].pData.rSimValue); 
        END_IF;          
      END_IF;
      IF (FIND(GV_sPCU.Devices.sAnalogSensors.y[i].zName, "MV2PA") > 0)THEN
        IF (iPressureSensorRegulation = 0) THEN
          iPressureSensorRegulation := i;
        END_IF;
        IF (GV_sPCU.Devices.sAirFlows.y[cAirFlow_BMV2].Common.Signals.Set.rValue_Releases_Out > 0.0) THEN    
          GV_sPCU.Devices.sAnalogSensors.y[i].pData.rSimValue  := GV_sPCU.Devices.sAirFlows.y[cAirFlow_BMV2].Common.Signals.Set.rValue_Releases_Out * rGainPressOut;
        ELSIF 
          (GV_sPCU.Devices.sValves.y[cValve_YAVR1].T001.Signals.ActValue     OR   // AVR1
           GV_sPCU.Devices.sNeedles.y[cNeedle_YHN1].Common.Signals.ActValue  OR   // HN1
           GV_sPCU.Devices.sNeedles.y[cNeedle_YHN2].Common.Signals.ActValue  OR   // HN2
           GV_sPCU.Devices.sNeedles.y[cNeedle_YHN3].Common.Signals.ActValue) THEN // HN3
      
           GV_sPCU.Devices.sAnalogSensors.y[i].pData.rSimValue  := 0.0; 
          
        END_IF;
        IF NOT mGunOn AND mGunOnOld THEN  
          GV_sPCU.Devices.sAnalogSensors.y[i].pData.rSimValue := GV_sPCU.Devices.sAirFlows.y[cAirFlow_BMV2].Common.Signals.Set.rValue_Releases_Out * rGainPressOut + (rOffsetSwitchOff / 100.0 * GV_sPCU.Devices.sAnalogSensors.y[i].pData.rSimValue); 
        END_IF;                  
      END_IF;
    END_FOR;
                  
    IF ((GV_sPCU.Devices.sAirFlows.y[cAirFlow_BMV2].Common.Signals.Set.rValue_Releases_Out > 0.0) AND
        (iPressureSensorRegulation > 0)                                                           AND
         (GV_sPCU.Devices.sValves.y[cValve_YHG1].T001.Signals.ActValue                            AND  // HG1
          (GV_sPCU.Devices.sValves.y[cValve_YAVR1].T001.Signals.ActValue                          OR   // AVR1
           GV_sPCU.Devices.sNeedles.y[cNeedle_YHN1].Common.Signals.ActValue                       OR   // HN1
           GV_sPCU.Devices.sNeedles.y[cNeedle_YHN2].Common.Signals.ActValue                       OR   // HN2
           GV_sPCU.Devices.sNeedles.y[cNeedle_YHN3].Common.Signals.ActValue)))                    THEN // HN3
      
      IF NOT mTestIncreasing THEN
        abBMV2F.aSet_SimValue(GV_sPCU.Devices.sAnalogSensors.y[iPressureSensorRegulation].pData.rSimValue * rGainFlow + rOffsetFlow);
        rActFlow := abBMV2F.fGetDevAct_ActFlowFiltered();
      ELSE
        abBMV2F.aSet_SimValue(rActFlow);
      END_IF;
      
      
    ELSE
      
      abBMV2F.aSet_SimValue(0.0);
      
    END_IF;
    
    // sim temprature
    GV_sPCU.Devices.sAnalogSensors.y[cAnalogSensor_BAP1T].pData.rSimValue := rSimTemp;
    
  END_IF;
  
END_IF;

mGunOnOld := mGunOn;

@END_Body 

@@@BEG_Comment@@@ 
@TL(0)

@@@END_Comment@@@ 
@END_Body 

@END_Contents 
