//-------------------------------------------------------------------------------------------------

;


;#END_EDIT_BLOCK END_ALGORITHM

FUNCTION fInit : BOOL
 #DUMMY_EDIT_BLOCK
#BEGIN_EDIT_BLOCK
//-------------------------------------------------------------------------------------------------
// Initialization
//-------------------------------------------------------------------------------------------------

// Init of data block -----------------------------------------------------------------------------
IF NOT AG_mInitDataBlock THEN
 
  // Set version info to catalog
  AG_mInitDataBlock := F_Version_String(i_zRoot    := cCatRootVersion,
                                        i_zPath    := cCatPathVersion,
                                        i_zName    := AG_zMyName,
                                        i_zVersion := AG_zVersion);
  
END_IF;

// Do all initialization work here



// Set return value -------------------------------------------------------------------------------
fInit := (AG_mInitDataBlock AND
          fPriv_GetSoftwareReferences());


;#END_EDIT_BLOCK END_FUNCTION

ALGORITHM aCyclic


VAR_TEMP
 i : INT;
END_VAR

VAR
 nMainState : tnMainModeState;
 mTemp : BOOL;
END_VAR
#BEGIN_EDIT_BLOCK
//-------------------------------------------------------------------------------------------------
// Cyclic
//-------------------------------------------------------------------------------------------------

IF GV_mInitDone THEN
  
  //-------- Switch on tempering unit -------------------------------------------------------------
  //GV_sPCU.Devices.sTemperingUnits.y[cTemperingUnit_ATC1].T003.Signals.SetActive.mValue_Interlocks_In := TRUE;
  
  //-------- Set request to switch on AVV ---------------------------------------------------------
  // It's not allowed to switch on AVV in maintenance or T1 mode (personnel protection)
//  IF (((GV_sModesRef^.nRobotMainState = RobAuto)        OR
//       (GV_sModesRef^.nRobotMainState = RobT2))         AND
//      GV_sReleases.sReleases.Internal.AtomizerRelease) THEN
//    
//    CASE GV_sModesRef^.nMainState OF
//      
//      stHand:                    
//     
//        IF (abChannels.fGetChannelReservedBy(i_iChannelIdx := cIndex_MainChannel ) <> TP_Interpreter) THEN
//          abAYMV1.aSetDev_Set(i_mValue      := (GV_sReleases.sReleases.External.ReleaseHand AND
//                                                (abChannels.fGetChannelState(i_iChannelIdx :=cIndex_MainChannel) <> C_PressureReleased_done)),
//                              i_nSignalNode := nInterlocksIn);
//        END_IF;
//        
//      stAuto:
//        
//        IF (abChannels.fGetChannelReservedBy(i_iChannelIdx := cIndex_MainChannel ) <> TP_Interpreter) THEN
//          abAYMV1.aSetDev_Set(i_mValue      := TRUE,
//                              i_nSignalNode := nInterlocksIn);
//        END_IF;
//        
//    END_CASE;
//    
//  ELSE
//   
//    abAYMV1.aSetDev_Set(i_mValue      := FALSE,
//                        i_nSignalNode := nInterlocksIn);
//    
//  END_IF;
                                  
  // Reset channel state
//  IF abAYMV1.fGetDevAct_ActValue()                                                               AND 
//    (abChannels.fGetChannelState(i_iChannelIdx := cIndex_MainChannel) = C_PressureReleased_done) THEN
//   
//    mReturn := abChannels.fSetChannelState(i_iChannelIdx   := cIndex_MainChannel,
//                                           i_iChannelState := C_Undefined);
//  END_IF;
  IF (GV_sModesRef^.nMainState = stAuto) AND 
     (nMainState <> stAuto)              AND
     (abChannels.fGetChannelState(i_iChannelIdx := cIndex_MainChannel) = C_PressureReleased_done) THEN
    
    mTemp := abChannels.fSetChannelState(i_iChannelIdx   := cIndex_MainChannel,
                                         i_iChannelState := C_Undefined);
    
  END_IF;
  
  //-------- Copy Internal.ReleaseSetValues in pData of AnalogSensor  --------------
  //-------- devices to start/stop monitoring functions depending on  --------------
  //-------- the Internal.ReleaseSetValues flag                       --------------
  //-------- (monitoring of solvent supply pressure)                  --------------
  
  FOR i := 1 TO cNumberOfAnalogSensors DO
    
    GV_sPCU.Devices.sAnalogSensors.y[i].pData.mReleaseSetValues := GV_sReleases.sReleases.Internal.ReleaseSetValues;
    
  END_FOR;
 
  //edge detection
  nMainState := GV_sModesRef^.nMainState;
  
END_IF;


;#END_EDIT_BLOCK END_ALGORITHM



END_ALGORITHM_BLOCK



#END_OF_IEC_PART

