IMPORT_OVER_LISTFILE
 F_Version_String
, F_CheckStatusOfGET_REFTO
, cCatRootVersion
, cCatPathVersion
, cTimeout_GET_REFTO
, tsPCU
, tsFgParam
, tsReleases
, tsModes
, AB_Channels
//  AB_SwitchPLC_T001
, tsPCU2BCU
, KSYS_Status
, tnMainModeState

END_IMPORT

ALGORITHM_BLOCK AB_GeneralSetValues #DUMMY_EDIT_BLOCK

VAR_EXTERNAL
 GV_mInitDone : BOOL;
 GV_sPCU : tsPCU;
 GV_sFgParam : tsFgParam (* functiongroup-parameters of this FU *);
 GV_sReleases : tsReleases;
 GV_sModesRef : REFTO tsModes;
 abChannels : AB_Channels;
 // abAYMV1 : AB_SwitchPLC_T001;
END_VAR

VAR
 AG_mInitDataBlock : BOOL;
 ptSV_sPCU2BCU : REFTO tsPCU2BCU;
END_VAR

VAR CONSTANT
 AG_zMyName : STRING(19) := 'AB_GeneralSetValues';
 AG_zVersion : STRING(15) := 'V2_01.00.00';
END_VAR

FUNCTION fPriv_GetSoftwareReferences : BOOL
 #DUMMY_EDIT_BLOCK

VAR
 nStatusOfGetRefto : KSYS_Status (* Status of firmware function GET_REFTO *);
 mInitError : BOOL;
 zTemp : STRING(255);
END_VAR
#BEGIN_EDIT_BLOCK
//-------------------------------------------------------------------------------------------------
// Get software references
//-------------------------------------------------------------------------------------------------
mInitError := FALSE;

// Get reference to SV_sPCU2BCU -------------------------------------------------------------------
zTemp := CONCAT(GV_sFgParam.zBcuName, '.SV_sPCU2BCU');

ptSV_sPCU2BCU := GET_REFTO(SVName  := zTemp,
                           Timeout := cTimeout_GET_REFTO,
                           Status  := nStatusOfGetRefto);

mInitError := (mInitError OR F_CheckStatusOfGET_REFTO(nStatusOfGetRefto,
                                                      CONCAT(AG_zMyName, '.fPriv_GetSoftwareReferences'),
                                                      zTemp,
                                                      '',
                                                      ''));


//-------------------------------------------------------------------------------------------------
fPriv_GetSoftwareReferences := NOT mInitError;


;#END_EDIT_BLOCK END_FUNCTION

