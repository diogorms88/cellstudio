@BEG_Body 
@TL(18)
//Set Version Info to catalog
mInitError := NOT F_Version_String(i_zRoot    := cCatRootVersion,
                                   i_zPath    := cCatPathVersion,
                                   i_zName    := 'AB_InterlocksFixpositionsRob',
                                   i_zVersion := Ag_zVersion); 
IF NOT mInitError THEN
  mInitError := NOT p.fInit();
  IF NOT mInitError THEN
    Ag_iNrProgAfterDoorOpened := p.NrProgAfterDoorOpened();
  END_IF; 
END_IF;

//Set info to hmi that functionality 'extended user guide for start fixpositions in manually' is implemented
abFunctionLib.aSetMask_DWORD(io_dValue:=SV_System2HMI.tCommon.sOut.o_dCompatibilityInfo,
                             i_dMask  :=cCompFuncBit1);

fInit := NOT mInitError;

@END_Body 

@@@BEG_Comment@@@ 
@TL(0)

@@@END_Comment@@@ 

@BEG_Body 
@TL(117)
udiErrorIdent := 0;
SV_BCU2HMI.tFixpos.sOut.o_zInterlockMsg := '';

// Interlock 1 : movement is only allowed between PurgeHN1..3 and HOME
IF ( abInterfaceToMotion.fIsRobotInPosition(ci_PurgeHN1pos)   (*OR
     abInterfaceToMotion.fIsRobotInPosition(ci_PurgeHN2pos)   OR
     abInterfaceToMotion.fIsRobotInPosition(ci_PurgeHN3pos)*) )    AND
    (i_iReqProgNumber <> ci_PurgeHN1pos)                      AND
    //(i_iReqProgNumber <> ci_PurgeHN2pos)                      AND
    //(i_iReqProgNumber <> ci_PurgeHN3pos)                      AND
    (i_iReqProgNumber <> ci_Homepos)                               THEN  
     
  udiErrorIdent := cFB_InterlFixpos_NotInHomepos;
  iMsgCnt       := 1;
  
END_IF;
  

// Interlock 2 : movement is only allowed between PurgeHN1..3, HOME, PrePos and SavePos
//               when body in zone sealing has a high risk of collision with the body

IF ( (NOT abBodyManagement.fIsFifoEmpty(cFifoZone))               AND
     (NOT abInterfaceToMotion.fIsRobotInHome())                   AND
     (NOT abInterfaceToMotion.fIsRobotInPosition(ci_PurgeHN1pos)) AND
     //(NOT abInterfaceToMotion.fIsRobotInPosition(ci_PurgeHN2pos)) AND
     //(NOT abInterfaceToMotion.fIsRobotInPosition(ci_PurgeHN3pos)) AND
     (NOT abInterfaceToMotion.fIsRobotInPosition(ci_PrePospos))   AND
     (NOT abInterfaceToMotion.fIsRobotInPosition(ci_SavePospos)) )    THEN
  
  udiErrorIdent := cFB_InterlFixpos_NoFixpos;
  iMsgCnt       := 2;
    
END_IF;
  

// Interlock 3 : If robot in home position and body in zone then only purge position possible
IF (NOT abBodyManagement.fIsFifoEmpty(cFifoZone)     AND
    abInterfaceToMotion.fIsRobotInHome()             AND
    (i_iReqProgNumber <> ci_PurgeHN1pos)             (*AND
    (i_iReqProgNumber <> ci_PurgeHN2pos)             AND
    (i_iReqProgNumber <> ci_PurgeHN3pos)*))            AND
    (i_iReqProgNumber <> ci_PrePospos)               AND
    (i_iReqProgNumber <> ci_SavePospos)              AND
    (i_iReqProgNumber <> ci_SavePospos)              AND
    ((i_iReqProgNumber <> Ag_iNrProgAfterDoorOpened) OR
     (Ag_iNrProgAfterDoorOpened = -1))               THEN
     
  udiErrorIdent := cFB_InterlFixpos_OnlyPurgepos;
  iMsgCnt       := 3;
  
END_IF;
  

// Interlock 4 : Fix position only possible if robot in home position
IF  (((abInterfaceToMotion.fIsRobotInPosition(ci_Maintenancepos)                             OR
       abInterfaceToMotion.fIsRobotInPosition(ci_Cleanpos)                                   OR
       abInterfaceToMotion.fIsRobotInPosition(ci_ZeroPositionpos)                            OR
       abInterfaceToMotion.fIsRobotInPosition(ci_PrePospos)                                  OR
       abInterfaceToMotion.fIsRobotInPosition(ci_SavePospos) )                                AND
      (i_iReqProgNumber <> ci_Homepos))  OR
     ((NOT abInterfaceToMotion.fIsRobotInPosition(ci_PurgeHN1pos))                           AND
      //(NOT abInterfaceToMotion.fIsRobotInPosition(ci_PurgeHN2pos))                           AND
      //(NOT abInterfaceToMotion.fIsRobotInPosition(ci_PurgeHN3pos))                           AND
      (NOT abInterfaceToMotion.fIsRobotInPosition(ci_Maintenancepos))                        AND
      (NOT abInterfaceToMotion.fIsRobotInPosition(ci_ZeroPositionpos))                       AND
      (NOT abInterfaceToMotion.fIsRobotInPosition(ci_Cleanpos))                              AND
      (NOT abInterfaceToMotion.fIsRobotInHome()  )                               AND
      (i_iReqProgNumber <> ci_Homepos))) THEN
     
  udiErrorIdent := cFB_InterlFixpos_NotInHomepos;
  iMsgCnt        := 4;
  
END_IF;
  
// Check for error
IF (udiErrorIdent <> 0) THEN
   // if fixpos request from hmi and hmi supports functionality of extended user guide for fixpositions, use this interface.
  // if functionality is not supported, set error message
  IF i_mHMIFixposRequest AND 
     abFunctionLib.fCheckMask_DWORD(i_dValue:=SV_System2HMI.tCommon.sIn.i_dCompatibilityInfo,
                                    i_dMask := cCompFuncBit1) 
    THEN
  
    fbGetMessageStringForHMI(i_iIdent   := udiErrorIdent,
                             i_zParam1  := '',
                             i_zParam2  := '',
                             i_zParam3  := '',
                             o_zMsgText => SV_BCU2HMI.tFixpos.sOut.o_zInterlockMsg);
    
    fbSetProtocol(Ident    := cNothing,
                  BodyID   := 0,
                  Location := 'AB_InterlocksFixpositionsRob.fCalculate',
                  Message  := CONCAT('Fixpos interlock message to HMI : ',SV_BCU2HMI.tFixpos.sOut.o_zInterlockMsg)
                 );
  ELSE
    
    fbSetMessage(i_iIdent        := udiErrorIdent,
                 i_iMsgCount     := iMsgCnt,
                 i_iDeviceNr     := 0,
                 i_zLocation     := 'AB_InterlocksFixpositionsRob.fCalculate',
                 i_zTimeProgName := '',
                 i_iTimeProgStep := 0,
                 i_zParam1       := '',
                 i_zParam2       := '',
                 i_zParam3       := '');       
  
  END_IF;
  
END_IF;

// return true in case of an error
fCalculate := (udiErrorIdent <> 0);
  
  
  
  

@END_Body 

@@@BEG_Comment@@@ 
@TL(0)

@@@END_Comment@@@ 
@END_Body 

@END_Contents 
