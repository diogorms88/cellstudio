@BEG_Body 
@TL(89)
IF NOT mInitDone THEN
  // Set version info to catalog
  mInitDone := F_Version_String(i_zRoot    := cCatRootVersion,
                                i_zPath    := cCatPathVersion,
                                i_zName    := zMyName,
                                i_zVersion := zVersion);
END_IF;

//-------------------------------------------------------------------------------------------------
// Interlocks of initiators
//-------------------------------------------------------------------------------------------------

//-------------Interlocks of AirSupplyValve LV1 -----------------------------
//Set error when YLV1 is open and BLV1 is still FALSE after 5 seconds
//Start count time

fbWaitTime1(IN := (abYLV1.fGetDevSet_Set(i_nSignalNode := nReleasesOut) AND
                   NOT GV_sPCU.Devices.sInitiators.y[cInitiator_BLV1].mInterlock),
            PT := t#5000ms);

IF (fbWaitTime1.Q                               AND
    NOT abBLV1.fGetDevAct_ActValue_Debounced()) THEN
  
  fbSetMessagePCU(i_iIdent         := cFB_Interlocks_HV1,
                  i_iMsgCount      := 1,
                  i_iDeviceNr      := cMainValve_YLV1,
                  i_zLocation      := zMyName,
                  i_zParam1        := GV_sPCU.Devices.sMainValves.y[cMainValve_YLV1].zName,
                  i_zParam2        := GV_sPCU.Devices.sInitiators.y[cInitiator_BLV1].zName,
                  i_zParam3        := '',
                  i_iChannelNumber := GV_sPCU.Devices.sInitiators.y[cInitiator_BLV1].iChannelNr);
  
ELSE
  
  GV_sPCU.Devices.sMainValves.y[cMainValve_YLV1].mInterlock := FALSE;
  
END_IF;

GV_sReleases.sReleases.Internal.ReleaseAirSupply := (abYLV1.fGetDevSet_Set(i_nSignalNode := nReleasesOut) AND
                                                    (abBLV1.fGetDevAct_ActValue_Debounced() OR GV_sPCU.Devices.sInitiators.y[cInitiator_BLV1].mInterlock));

//If booster on robot is used: set error when BLV1 is TRUE and BHD1 is still FALSE after 2 seconds
//Start count time

//fbWaitTime2(IN := (abYLV1.fGetDevSet_Set(i_nSignalNode := nReleasesOut) AND
//                   abBLV1.fGetDevAct_ActValue_Debounced()               AND
//                   NOT GV_sPCU.Devices.sInitiators.y[cInitiator_BLV1].mInterlock),
//            PT := t#2000ms);
//
//If second separate air supply is used: set error when YLV2 is open and BHD1 is still FALSE after 5 seconds
//Start count time

fbWaitTime2(IN := (abYLV2.fGetDevSet_Set(i_nSignalNode := nReleasesOut) AND
                   NOT GV_sPCU.Devices.sInitiators.y[cInitiator_BHD1].mInterlock),
            PT := t#5000ms);

IF (fbWaitTime2.Q                              AND
    NOT SV_sGeneralSystemCfg.mSimulateProcess) THEN
  
  IF NOT abBHD1.fGetDevAct_NoFault_Debounced() THEN
    fbSetMessagePCU(i_iIdent         := cFB_Interlocks_BoosterOverPres,
                    i_iMsgCount      := 0,
                    i_iDeviceNr      := cInitiator_BHD1,
                    i_zLocation      := zMyName,
                    i_zParam1        := abBHD1.fGet_DeviceName(),
                    i_zParam2        := BOOL_TO_STRING(abBHD1.fGetDevAct_NoFault_Debounced()),
                    i_zParam3        := BOOL_TO_STRING(abBHD1.fGetDevAct_InRange_Debounced()),
                    i_iChannelNumber := cIndex_AirSupply);      
  ELSIF NOT abBHD1.fGetDevAct_InRange_Debounced() THEN
    fbSetMessagePCU(i_iIdent         := cFB_Interlocks_BoosterUnderPres,
                    i_iMsgCount      := 0,
                    i_iDeviceNr      := cInitiator_BHD1,
                    i_zLocation      := zMyName,
                    i_zParam1        := abBHD1.fGet_DeviceName(),
                    i_zParam2        := BOOL_TO_STRING(abBHD1.fGetDevAct_NoFault_Debounced()),
                    i_zParam3        := BOOL_TO_STRING(abBHD1.fGetDevAct_InRange_Debounced()),
                    i_iChannelNumber := cIndex_AirSupply);
  END_IF;
  
ELSE
  
  //If booster on robot is used
  GV_sPCU.Devices.sMainValves.y[cMainValve_YLV1].mInterlock := FALSE;
  
  //If second separate air supply is used
  GV_sPCU.Devices.sMainValves.y[cMainValve_YLV2].mInterlock := FALSE;
  
END_IF;

