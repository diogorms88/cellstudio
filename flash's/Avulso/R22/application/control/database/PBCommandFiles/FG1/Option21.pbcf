//  Version      | ReleaseDate | Respon | Changes
//  -------------------------------------------------------------------------------------
//  v2_01.00.00  | 30.09.2013  | STL    | First release
//  v2_01.01.00  | 28.01.2014  | SMOH   | Combine LASD Options 27 and 18 + Option14(BMV1T)--> Option27 + Busmaster--> Option14
//  v2_01.02.00  | 28.10.2016  | STL    | Check Option12 before deselect time program group AtomizerClean
//  v2_01.03.00  | 21.11.2016  | KLCH   | Change: redesign; check Option1 + further options instead of Option2
//  v2_01.04.00  | 10.10.2017  | KLCH   | AddOn: generate time programs

Imports Common

Parameter Option1 Option2 Option3 Option4 Option5 Option12 Option14 Option15 Option18 Option20 Option21 Option26 Option27 MaterialValve1 NumberOfMainNeedles NozzleExchanger Circulation OptionGun OptionShotMeter HelpGun1 ElectricalVersion

Call Main_Option21
Call Common_Sealing_GenerateTimeProg
// Select tab VariantConfiguration again
SelectNode RPC1.R11
SelectTab [VariantConfiguration]
END

SubRoutine Main_Option21
	SelectNode RPC1.R11
	SelectTab [Fixpositions]
	//******* Copy globalvars **
	FSCopy ..\SpecialOptions\_globalvars.tid ..\..\..\..\..\application\control\teachcontrol\Kin1\_global.tt
	//******* Add special fixpositions for MainNeedle 1 blow out**
	SelectCase Option21 //BlowOut
		Case 1
			FixposEnabled BlowOutHN1 1
			FixposUsedInTP BlowOutHN1 1
			
			FSCopy ..\SpecialOptions\Option21\Yes\AB_ControlAllSFC.pu ..\..\..\..\..\application\control\ieccontrol\PCU1\EngineeringFiles
			FSCopy ..\SpecialOptions\Option21\Yes\PCA.ini ..\..\..\..\..\application\control\PCU1\cfg
			FSCopy ..\SpecialOptions\Option21\Yes\PCA.DEF ..\..\..\..\..\application\control\PCU1\Definitions
			
			//******* Add special fixpositions for MainNeedle 2 or 3**
			SelectCase NumberOfMainNeedles
				Case 1
					FixposEnabled BlowOutHN2 0
					FixposUsedInTP BlowOutHN2 0
					FixposEnabled BlowOutHN3 0
					FixposUsedInTP BlowOutHN3 0
					
					FSCopy ..\SpecialOptions\Option21\Yes\1MainNeedle\BlowOutHN1.tid ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt
					FSCopy ..\SpecialOptions\Option21\Yes\1MainNeedle\BlowOutHN1.tip ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt
					FSCopy ..\SpecialOptions\Option21\Yes\2MainNeedles\BlowOutHN2.tid ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt
					FSCopy ..\SpecialOptions\Option21\Yes\2MainNeedles\BlowOutHN2.tip ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt
					FSCopy ..\SpecialOptions\Option21\Yes\3MainNeedles\BlowOutHN3.tid ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt
					FSCopy ..\SpecialOptions\Option21\Yes\3MainNeedles\BlowOutHN3.tip ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt
					
					FSDeleteFile ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt\BlowOutHN2.tid
					FSDeleteFile ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt\BlowOutHN2.tip
					FSDeleteFile ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt\BlowOutHN3.tid
					FSDeleteFile ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt\BlowOutHN3.tip
					
					FSCopy ..\SpecialOptions\Option21\Yes\1MainNeedle\AB_InterlocksFixpositionsRob.pu ..\..\..\..\..\application\control\ieccontrol\BCU1\EngineeringFiles
					
				Case 2
					FixposEnabled BlowOutHN2 1
					FixposUsedInTP BlowOutHN2 1
					FixposEnabled BlowOutHN3 0
					FixposUsedInTP BlowOutHN3 0
					
					FSCopy ..\SpecialOptions\Option21\Yes\1MainNeedle\BlowOutHN1.tid ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt
					FSCopy ..\SpecialOptions\Option21\Yes\1MainNeedle\BlowOutHN1.tip ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt
					FSCopy ..\SpecialOptions\Option21\Yes\2MainNeedles\BlowOutHN2.tid ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt
					FSCopy ..\SpecialOptions\Option21\Yes\2MainNeedles\BlowOutHN2.tip ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt
					FSCopy ..\SpecialOptions\Option21\Yes\3MainNeedles\BlowOutHN3.tid ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt
					FSCopy ..\SpecialOptions\Option21\Yes\3MainNeedles\BlowOutHN3.tip ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt
					
					FSDeleteFile ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt\BlowOutHN3.tid
					FSDeleteFile ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt\BlowOutHN3.tip
					
					FSCopy ..\SpecialOptions\Option21\Yes\2MainNeedles\AB_InterlocksFixpositionsRob.pu ..\..\..\..\..\application\control\ieccontrol\BCU1\EngineeringFiles
					
				Case 3
					FixposEnabled BlowOutHN2 1
					FixposUsedInTP BlowOutHN2 1
					FixposEnabled BlowOutHN3 1
					FixposUsedInTP BlowOutHN3 1
					
					FSCopy ..\SpecialOptions\Option21\Yes\1MainNeedle\BlowOutHN1.tid ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt
					FSCopy ..\SpecialOptions\Option21\Yes\1MainNeedle\BlowOutHN1.tip ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt
					FSCopy ..\SpecialOptions\Option21\Yes\2MainNeedles\BlowOutHN2.tid ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt
					FSCopy ..\SpecialOptions\Option21\Yes\2MainNeedles\BlowOutHN2.tip ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt
					FSCopy ..\SpecialOptions\Option21\Yes\3MainNeedles\BlowOutHN3.tid ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt
					FSCopy ..\SpecialOptions\Option21\Yes\3MainNeedles\BlowOutHN3.tip ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt
					
					FSCopy ..\SpecialOptions\Option21\Yes\3MainNeedles\AB_InterlocksFixpositionsRob.pu ..\..\..\..\..\application\control\ieccontrol\BCU1\EngineeringFiles
					
			EndSelect
		Case 0
			FixposEnabled BlowOutHN1 0
			FixposUsedInTP BlowOutHN1 0
			FixposEnabled BlowOutHN2 0
			FixposUsedInTP BlowOutHN2 0
			FixposEnabled BlowOutHN3 0
			FixposUsedInTP BlowOutHN3 0
			
			SelectCase Option1 // Process type
				Case EcoDose_PCL_PCL
				Case EcoDose_SM_PCL
				Case EcoDose_SM_SM
				CaseElse
					FSCopy ..\SpecialOptions\Option21\Yes\1MainNeedle\BlowOutHN1.tid ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt
					FSCopy ..\SpecialOptions\Option21\Yes\1MainNeedle\BlowOutHN1.tip ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt
			EndSelect
			
			FSCopy ..\SpecialOptions\Option21\Yes\2MainNeedles\BlowOutHN2.tid ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt
			FSCopy ..\SpecialOptions\Option21\Yes\2MainNeedles\BlowOutHN2.tip ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt
			FSCopy ..\SpecialOptions\Option21\Yes\3MainNeedles\BlowOutHN3.tid ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt
			FSCopy ..\SpecialOptions\Option21\Yes\3MainNeedles\BlowOutHN3.tip ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt
			
			SelectCase Option1 // Process type
				Case EcoDose_PCL_PCL
				Case EcoDose_SM_PCL
				Case EcoDose_SM_SM
				CaseElse
					FSDeleteFile ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt\BlowOutHN1.tid
					FSDeleteFile ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt\BlowOutHN1.tip
			EndSelect
			
			FSDeleteFile ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt\BlowOutHN2.tid
			FSDeleteFile ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt\BlowOutHN2.tip
			FSDeleteFile ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt\BlowOutHN3.tid
			FSDeleteFile ..\..\..\..\..\application\control\teachcontrol\Kin1\Fixpos.tt\BlowOutHN3.tip
			
			FSCopy ..\SpecialOptions\Option21\No\AB_ControlAllSFC.pu ..\..\..\..\..\application\control\ieccontrol\PCU1\EngineeringFiles
			FSCopy ..\SpecialOptions\Option21\No\PCA.ini ..\..\..\..\..\application\control\PCU1\cfg
			FSCopy ..\SpecialOptions\Option21\No\PCA.DEF ..\..\..\..\..\application\control\PCU1\Definitions
			
			SelectCase NumberOfMainNeedles
				Case 1
					FSCopy ..\SpecialOptions\Option21\No\1MainNeedle\AB_InterlocksFixpositionsRob.pu ..\..\..\..\..\application\control\ieccontrol\BCU1\EngineeringFiles
				Case 2
					FSCopy ..\SpecialOptions\Option21\No\2MainNeedles\AB_InterlocksFixpositionsRob.pu ..\..\..\..\..\application\control\ieccontrol\BCU1\EngineeringFiles
				Case 3
					FSCopy ..\SpecialOptions\Option21\No\3MainNeedles\AB_InterlocksFixpositionsRob.pu ..\..\..\..\..\application\control\ieccontrol\BCU1\EngineeringFiles
			EndSelect
		CaseElse
			Message Option21 wrong
	EndSelect
	
	SelectNode RPC1.R11.PCU1
	IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].BlowOut.YLV3
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].BlowOut.YLV3
		Delete
	Endif
	SelectCase Option21
		Case 1
			IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].BlowOut
			Else
				SelectNode RPC1.R11.PCU1
				//******** Add blow out 1 channel ************
				Call Common_AddChannel_BlowOut
			Endif
			
			SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].BlowOut
			Call Common_AddDevice_YLV3
			
			SelectNode RPC1.R11.PCU1
			SelectTab [TimeprogramGroups]
			//*** Activate time program groups and set "used"/"unused" in reset channel state for states "aborted" and "ready" ***
			// time program group 7 (Clean atomizer)
			ActivateTimeProgramGroup 7 1
			SetResetStateAborted 7 unused
			SetResetStateReady 7 unused
			
		Case 0
			IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].BlowOut
				SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].BlowOut
				Delete
			Endif
			
			SelectCase Option12 // MD Dump
				Case Dump
					SelectCase OptionGun
						Case Gun_MD_Air
						Case Gun_MD_El
						CaseElse
							Message Wrong type of gun or [Option12] (Option21)!!
					EndSelect
				CaseElse
					SelectNode RPC1.R11.PCU1
					SelectTab [TimeprogramGroups]
					//*** Activate time program groups and set "used"/"unused" in reset channel state for states "aborted" and "ready" ***
					// time program group 7 (Clean atomizer)
					ActivateTimeProgramGroup 7 0
					SetResetStateAborted 7 unused
					SetResetStateReady 7 unused
			EndSelect
	EndSelect
Return