//  Version      | ReleaseDate | Respon | Changes
//  -------------------------------------------------------------------------------------
//  v2_01.00.00  | 30.09.2013  | STL    | First release
//  v2_01.01.00  | 28.01.2014  | SMOH   | Combine LASD Options 27 and 18 + Option14(BMV1T)--> Option27 + Busmaster--> Option14
//  v2_01.02.00  | 14.04.2014  | KLCH   | Change: remove cfg parameter CheckDevice
//  v2_01.03.00  | 28.04.2014  | KLCH   | Bugfix: correction of Option14 (export for HMI not ok)
//  v2_01.04.00  | 12.09.2014  | KLCH   | Change: redesign; move SubRoutines to CommonTempControl
//  v2_01.05.00  | 13.04.2015  | STL    | Change: Trigger configuration heating sections because of new ProcessBuilder version
//  v2_01.06.00  | 21.11.2016  | KLCH   | Change: redesign; check Option1 + further options instead of Option2
//  v2_01.07.00  | 28.09.2017  | KLCH   | AddOn: all required parameters

Imports Common CommonTempControl

Parameter Option1 Option2 Option3 Option4 Option5 Option12 Option14 Option15 Option18 Option20 Option21 Option26 Option27 EcoTempAxis1 EcoTempAxis3 TempHeatZone1 TempHeatZone2 TempHeatZone3 TempHeatZone4 TempHeatZone5 TempHeatZone6 TempHeatZone7 TempHeatZone8 TempHeatZone9 NumberOfMainNeedles

Call CommonTempCtrl_MatHeater
Call Main_TempHeatZone4
// Select tab VariantConfiguration again
SelectNode RPC1.R11
SelectTab [VariantConfiguration]
END

SubRoutine Main_TempHeatZone4
	SelectNode RPC1.R11
	SelectCase Option1 // Process type
		Case EcoDose_SM
			Call AddDeviceToShotMeter1Sub_TempHeatZone4
		Case EcoDose_SM_PCL
			Call AddDeviceToShotMeter2Sub_2Single_TempHeatZone4
		Case EcoDose_SM_SM
			Call AddDeviceToShotMeter2Sub_2Single_TempHeatZone4
		CaseElse
			Message Wrong process type (TempHeatZone4)!!
	EndSelect
Return

SubRoutine AddDeviceToShotMeter1Sub_TempHeatZone4
	SelectCase TempHeatZone3
		Case 1
			SelectCase Option20 // Shot meter single
				Case 0
					IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].ShotMeter1Sub_.b.AMH1_2b
						SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].ShotMeter1Sub_.b.AMH1_2b
						VisuInterface 1 4
						// Cfg parameter
						// Select tab cfg parameter
						SelectTab [CfgParameter]
						SelectCase Option14 // Variant of bus system
							Case SercosIII
								SelectCfg AMH1_2.ControlMode
								Value 1
								SelectCfg AMH1_2.DeviceTemperature.ControlParam.P03_DevAlarm
								Value 50
								SelectCfg AMH1_2.DeviceTemperature.ControlParam.P06_Tv_Heating
								Value 20
								SelectCfg AMH1_2.DeviceTemperature.ControlParam.P22_Offset_Act
								Value 999
								SelectCfg AMH1_2.DeviceTemperature.ControlParam.TemperatureMax
								Value 42
								SelectCfg AMH1_2.DeviceTemperature.ControlParam.TemperatureMin
								Value 25
								SelectCfg AMH1_2.DeviceTemperature.ControlParam.Zone
								Value 4
								SelectCfg AMH1_2.SetTemperature
								Value 35
							Case Profibus
								SelectCfg AMH1_2.CtrlLevel
								Value 1
								SelectCfg AMH1_2.03_DevAlarm
								Value 50
								SelectCfg AMH1_2.06_Tv_Control
								Value 20
								SelectCfg AMH1_2.22_Offset_Act
								Value 99
								SelectCfg AMH1_2.CtrlTypeSetbackTemp
								OptionalUsed 1
								Value 1
								SelectCfg AMH1_2.MediumTempCtrl.ReactionLevelCtrl
								Value 1
								SelectCfg AMH1_2.NameSignalForFlow
								OptionalUsed 1
								Value "BShotMeter1.ActQuantity"
								SelectCfg AMH1_2.SetbackTemp
								OptionalUsed 1
								Value 25
								SelectCfg AMH1_2.SetTemp
								Value 25
								SelectCfg AMH1_2.SetTempMaterial
								OptionalUsed 0
								Value 25
								SelectCfg AMH1_2.SetTempMax
								Value 42
								SelectCfg AMH1_2.SetTempMaxAfterHys
								Value 42
								SelectCfg AMH1_2.SetTempMin
								Value 25
								SelectCfg AMH1_2.SetTempMinAfterHys
								Value 25
								SelectCfg AMH1_2.TemperatureSensorName
								Value "BAP1T"
								SelectCfg AMH1_2.TimeSetbackTemp
								OptionalUsed 1
								Value 0d0h30m0s0ms
								SelectCfg AMH1_2.Zone
								Value 4
							CaseElse
								Message Wrong bus master (AMH1_2b)!! Only Profibus and Sercos III supported
						EndSelect
					Else
						Message Script error in TempHeatZone3: AMH1_2 missing (TempHeatZone4)!!
					Endif
			EndSelect
	EndSelect
Return

SubRoutine AddDeviceToShotMeter2Sub_2Single_TempHeatZone4
	IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].ShotMeter2Sub_.a.AMH1_2_2a
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].ShotMeter2Sub_.a.AMH1_2_2a
		Delete
	Endif
	SelectCase TempHeatZone3
		Case 1
			SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].ShotMeter2Sub_
			Call Common_AddDevice_AMH1_2_2
			
			// Cfg parameter
			SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].ShotMeter2Sub_.a.AMH1_2_2a
			// Select tab cfg parameter
			SelectTab [CfgParameter]
			SelectCase Option14 // Variant of bus system
				Case SercosIII
					SelectCfg AMH1_2_2.ControlMode
					Value 1
					SelectCfg AMH1_2_2.DeviceTemperature.ControlParam.P03_DevAlarm
					Value 50
					SelectCfg AMH1_2_2.DeviceTemperature.ControlParam.P06_Tv_Heating
					Value 20
					SelectCfg AMH1_2_2.DeviceTemperature.ControlParam.P22_Offset_Act
					Value 999
					SelectCfg AMH1_2_2.DeviceTemperature.ControlParam.TemperatureMax
					Value 42
					SelectCfg AMH1_2_2.DeviceTemperature.ControlParam.TemperatureMin
					Value 30
					SelectCfg AMH1_2_2.DeviceTemperature.ControlParam.Zone
					Value 4
					SelectCfg AMH1_2_2.SetTemperature
					Value 25
				Case Profibus
					SelectCfg AMH1_2_2.CtrlLevel
					Value 1
					SelectCfg AMH1_2_2.03_DevAlarm
					Value 50
					SelectCfg AMH1_2_2.06_Tv_Control
					Value 20
					SelectCfg AMH1_2_2.22_Offset_Act
					Value 99
					SelectCfg AMH1_2_2.CtrlTypeSetbackTemp
					OptionalUsed 1
					Value 1
					SelectCfg AMH1_2_2.MediumTempCtrl.ReactionLevelCtrl
					Value 1
					SelectCfg AMH1_2_2.NameSignalForFlow
					OptionalUsed 1
					Value "BShotMeter2.ActQuantity"
					SelectCfg AMH1_2_2.SetbackTemp
					OptionalUsed 1
					Value 25
					SelectCfg AMH1_2_2.SetTemp
					Value 25
					SelectCfg AMH1_2_2.SetTempMaterial
					OptionalUsed 0
					Value 25
					SelectCfg AMH1_2_2.SetTempMax
					Value 42
					SelectCfg AMH1_2_2.SetTempMaxAfterHys
					Value 42
					SelectCfg AMH1_2_2.SetTempMin
					Value 25
					SelectCfg AMH1_2_2.SetTempMinAfterHys
					Value 25
					SelectCfg AMH1_2_2.TemperatureSensorName
					Value "BAP2T"
					SelectCfg AMH1_2_2.TimeSetbackTemp
					OptionalUsed 1
					Value 0d0h30m0s0ms
					SelectCfg AMH1_2_2.Zone
					Value 4
				CaseElse
					Message Wrong bus master (AMH1_2_2a)!! Only Profibus and Sercos III supported
			EndSelect
			Call CommonTempCtrl_SetConfigMaterial1_AMatManager1
	EndSelect
Return
