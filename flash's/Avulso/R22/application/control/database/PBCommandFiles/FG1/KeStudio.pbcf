//  v2_01.01.00  | 05.04.2018  | KTO    | AddOn: copy Python scripts

Parameter KeStudio

Call Main_KeStudio
Message KeStudio version changed! 
End

SubRoutine Main_KeStudio
	SelectCase KeStudio
		Case V3.20_RCMP
			FSCopy ..\..\..\..\ManagerProject\XML\Phyton_Scripts\Durr_Common.py		..\..\..\..\ManagerProject\
			FSCopy ..\..\..\..\ManagerProject\XML\Phyton_Scripts\Durr_Profinet.py		..\..\..\..\ManagerProject\
		Case V3.20_RCMP2
			FSCopy ..\..\..\..\ManagerProject\XML\Phyton_Scripts\Durr_Common.py		..\..\..\..\ManagerProject\
			FSCopy ..\..\..\..\ManagerProject\XML\Phyton_Scripts\Durr_Profinet.py		..\..\..\..\ManagerProject\
			FSCopy ..\..\..\..\ManagerProject\XML\Phyton_Scripts\Durr_SCP.py		..\..\..\..\ManagerProject\
	EndSelect
Return

