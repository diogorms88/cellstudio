// *********Start devices of family Initiator**********
SubRoutine Common_AddInitiator_LV1
	SelectCase Option14 // Variant of bus master
		Case SercosIII
			SelectCase ElectricalVersion
				Case El_V1
					AddDevice INI_Pres_10 LV1
					Description Initiator input pressure air supply 1
					VisuInterface 1 1
				Case El_V2
					AddDevice INI_Pres_10_CPX LV1
					Description Initiator input pressure air supply 1
					VisuInterface 1 1
				CaseElse
					Message ElectricalVersion not supported !! (Common_AddInitiator_LV1)
			EndSelect
		Case Profibus
			AddDevice INI_Pres_10 LV1
			Description Initiator input pressure air supply 1
			VisuInterface 1 1
		CaseElse
			Message Wrong bus master (Common_AddInitiator_LV1)!! Only Profibus and Sercos III supported
	EndSelect
Return

SubRoutine Common_AddDevice_BARZY1ER
	AddDevice INI_Pres_10 ARZY1ER
	Description Initiator locking cylinder rear
	VisuInterface 1 4
	SelectTab [CfgParameter]
	// Select required cfg parameter of device BARZY1ER
	SelectCfg BARZY1ER.DeBouncingTime
	// enable optional parameter
	OptionalUsed 1
	Value 0d0h0m0s500ms
Return

