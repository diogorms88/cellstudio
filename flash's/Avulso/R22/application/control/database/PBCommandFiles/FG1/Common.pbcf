SubRoutine Common_ActivateChannel_MaterialSupply1
	SelectNode RPC1.R11.PCU1
	//******** Add Material supply 1 channel ************
	Call Common_AddChannel_MaterialSupply1
	//Add physical channels to logical channel Material1
	SelectNode RPC1.R11.PCU1
	SelectTab [LogicChannelsSupplyGroups]
	SelectLogChannel PCU1
	SelectLogChannel PCU1.LogMaterial1
	//*********** Add physical MaterialSupply1*****************
	LogChannelAddPhysChannel MaterialSupply1
	//Parameter 1: Channelgroup or Channelgroup.Channel
	LogChannelPropertyLogMainChannel 0
	LogChannelPropertyOverallStateRelevant 1
Return

SubRoutine Common_ActivateChannel_MaterialSupply2
	SelectNode RPC1.R11.PCU1
	//******** Add Material supply 2 channel ************
	Call Common_AddChannel_MaterialSupply2
	//Add physical channels to logical channel Material2
	SelectNode RPC1.R11.PCU1
	SelectTab [LogicChannelsSupplyGroups]
	SelectLogChannel PCU1
	SelectLogChannel PCU1.LogMaterial2
	//*********** Add physical MaterialSupply2*****************
	LogChannelAddPhysChannel MaterialSupply2
	//Parameter 1: Channelgroup or Channelgroup.Channel
	LogChannelPropertyLogMainChannel 0
	LogChannelPropertyOverallStateRelevant 1
Return

SubRoutine Common_CheckChannel_MaterialSupply1
	IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].MaterialSupply1
		SelectCase Option27
			Case 1
			CaseElse
				SelectCase MaterialValve1
					Case 1
					CaseElse
						SelectCase Circulation
							Case Circ_OnRobot_NoRL
							CaseElse
								SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].MaterialSupply1
								Delete
						EndSelect
				EndSelect
		EndSelect
	Else
		SelectCase Option27
			Case 1
				Call Common_ActivateChannel_MaterialSupply1
			CaseElse
				SelectCase MaterialValve1
					Case 1
						Call Common_ActivateChannel_MaterialSupply1
					CaseElse
						SelectCase Circulation
							Case Circ_OnRobot_NoRL
								Call Common_ActivateChannel_MaterialSupply1
						EndSelect
				EndSelect
		EndSelect
	Endif
Return

SubRoutine Common_CheckChannel_MaterialSupply2
	IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].MaterialSupply2
		SelectCase Option27
			Case 1
			CaseElse
				SelectCase MaterialValve1
					Case 1
					CaseElse
						SelectCase Circulation
							Case Circ_OnRobot_NoRL
							CaseElse
								SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].MaterialSupply2
								Delete
						EndSelect
				EndSelect
		EndSelect
	Else
		SelectCase Option27
			Case 1
				Call Common_ActivateChannel_MaterialSupply2
			CaseElse
				SelectCase MaterialValve1
					Case 1
						Call Common_ActivateChannel_MaterialSupply2
					CaseElse
						SelectCase Circulation
							Case Circ_OnRobot_NoRL
								Call Common_ActivateChannel_MaterialSupply2
						EndSelect
				EndSelect
		EndSelect
	Endif
Return
//**************End routines to add channels *************

//**************Start routines to add devices *************

// *********Start devices of family Valve**********
// YLV1 for sealing processes
SubRoutine Common_AddDeviceSealing_YLV1
	SelectCase Option14 // Variant of bus master
		Case SercosIII
			AddDevice V_3-2_EL LV1
			Description Valve air supply 1
			VisuInterface 1 1 23
			WearCounter 1
		Case Profibus
			AddDevice V_3-2_LP04_DDL LV1
			Description Valve air supply 1
			VisuInterface 1 1 23
			WearCounter 1
		CaseElse
			Message Wrong bus master (Common_AddDeviceSealing_YLV1)!! Only Profibus and Sercos III supported
	EndSelect
Return

SubRoutine Common_AddDeviceSealing_YLV1_Main
	AddDevice V_3-2_EL_MAIN LV1
	Description Valve air supply 1
	VisuInterface 1 1 23
	WearCounter 1
Return

