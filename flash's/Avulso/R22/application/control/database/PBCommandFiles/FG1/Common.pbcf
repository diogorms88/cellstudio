//**************Start routines to set common properties*************
SubRoutine Common_Sealing_ConfigureFixpositions
	SelectNode RPC1.R11
	SelectTab [Fixpositions]
	//*********** set prefix *******************************
	FixposPrefix R
	//*********** Activate standard fixpositions ***********
	FixposEnabled Home 1
	FixposEnabled Maintenance 1
	FixposEnabled Clean 1
	FixposEnabled Bypass 1
	FixposEnabled Unselect 1
	FixposEnabled ZeroPosition 1
	FixposEnabled FlowCheck 1
	FixposEnabled BrakeCheck 1
	
	//*********** Set property "Used in TP" ****************
	FixposUsedInTP Home 1 // Home
	FixposUsedInTP FlowCheck 1 // FlowCheck	
	
	//*********** Additional fixpositions ******************
	FixposAdd PrePos
	FixposEnabled PrePos 1
	FixposUsedInTP PrePos 0
	FixposAdd SavePos
	FixposEnabled SavePos 1
	FixposUsedInTP SavePos 0
	FixposAdd Calib
	FixposEnabled Calib 1
	FixposUsedInTP Calib 0
	//*********** Enable is set in script Option21 *********
	FixposAdd BlowOutHN1
	FixposAdd BlowOutHN2
	FixposAdd BlowOutHN3
	
	// add fixpositions for SCP
	FixposAdd RefSCP
	FixposEnabled RefSCP 0
	FixposType RefSCP ReferenceSCP
	FixposAdd SyncSCP
	FixposEnabled SyncSCP 0
	FixposType SyncSCP SyncSCP

Return

SubRoutine Common_Sealing_ConfigureTriggerBrush
	SelectNode RPC1.R11.PCU1
	SelectTab [BrushTrigger]
	SelectTab [BrushTriggerConfiguration]
	MaxNoOfBrushes 255
	MaxNoOfColorGroups 1
	
	SelectCase Option1 // Process type
		Case EcoDose_PCL
			BrushSourceEnabled PaintPressure1 1
			BrushSourceEnabled PaintFlow1 1
			BrushSourceEnabled OffsetInitialPressure1 1
			BrushSourceEnabled ControlType1 1
		Case EcoDose_SM
			BrushSourceEnabled PaintFlow1 1
			BrushSourceEnabled OffsetInitialPressure1 1
			BrushSourceEnabled InitialPressure1 1
			BrushSourceEnabled DelayStop1 1
			BrushSourceEnabled DelayStart1 1
			BrushSourceEnabled PaintPressure1 1
			BrushSourceEnabled ControlType1 1
		Case EcoDose_ES
			BrushSourceEnabled PaintPressure1 1
			BrushSourceEnabled PaintFlow1 1
			BrushSourceEnabled Calibration1 1
			BrushSourceEnabled OffsetInitialPressure1 1
		Case EcoDose_PCL_PCL
			BrushSourceEnabled PaintPressure1 1
			BrushSourceEnabled PaintFlow1 1
			BrushSourceEnabled Calibration1 1
		Case EcoDose_SM_PCL
			BrushSourceEnabled PaintPressure1 1
			BrushSourceEnabled PaintFlow1 1
			BrushSourceEnabled Calibration1 1
			BrushSourceEnabled OffsetInitialPressure1 1
			BrushSourceEnabled InitialPressure1 1
			BrushSourceEnabled VelocityCompensation1 1
			BrushSourceEnabled DelayStop1 1
			BrushSourceEnabled DelayStart1 1
		Case EcoDose_SM_SM
			BrushSourceEnabled PaintFlow1 1
			BrushSourceEnabled OffsetInitialPressure1 1
			BrushSourceEnabled InitialPressure1 1
			BrushSourceEnabled DelayStop1 1
			BrushSourceEnabled DelayStart1 1
			BrushSourceEnabled PaintPressure1 1
			BrushSourceEnabled ControlType1 1
	EndSelect
	
	SelectCase OptionGun
		Case Gun_Swirl_Duerr
			BrushSourceEnabled VelocityCompensation1 1
		Case Gun_Swirl_Graco
			BrushSourceEnabled VelocityCompensation1 1
	EndSelect
	
Return

SubRoutine Common_Sealing_ConfigureBCUCfg
	SelectNode RPC1.R11.BCU1
	// Select tab cfg parameter
	SelectTab [CfgParameter]
	SelectCfg BCU1.T2Process
	OptionalUsed 1
	SelectCfg BCU1.T2Process.Enable
	OptionalUsed 1
	Value 1
	SelectCfg BCU1.T2Process.Type
	OptionalUsed 1
	Value 1
Return

SubRoutine Common_Sealing_ConfigureSCUCfg
	SelectNode RPC1.SCU
	// Select tab cfg parameter
	SelectTab [CfgParameter]
	SelectCfg SCU.StationConfig.FifoSizeZone
	Value 2
	SelectCfg SCU.StationConfig.HighTension
	Value 0
	SelectCfg SCU.StationConfig.Sealing
	Value 1
Return

SubRoutine Common_Sealing_GenerateTimeProg
	SelectCase Option1
		Case EcoDose_SM
			SaveAs ..\..\ecorpc_ecodose_sm.pb
		Case EcoDose_SM_SM
			SaveAs ..\..\ecorpc_ecodose_sm.pb
		Case EcoDose_PCL
			SaveAs ..\..\ecorpc_ecodose_pcl.pb
		Case EcoDose_PCL_PCL
			SaveAs ..\..\ecorpc_ecodose_pcl.pb
		CaseElse
			Message Process type not supported (Option1)! (Common_Sealing_GenerateTimeProg)
	EndSelect
	
	SelectNode RPC1.R11.PCU1
	
// Uncomment the following Call-actions when automatically generated 2-material-processes are available
//	Call Common_Sealing_DeleteTimeProg_SM1
//	Call Common_Sealing_DeleteTimeProg_SM2
//	Call Common_Sealing_DeleteTimeProg_PCL1
//	Call Common_Sealing_DeleteTimeProg_PCL2
	
	SelectCase Option1 // Process type
		Case EcoDose_SM
			Call Common_Sealing_DeleteTimeProg_SM1	// Remove this Call-action when automatically generated 2-material-processes are available
			Call Common_Sealing_GenerateTimeProg_SM1
		Case EcoDose_SM_SM
//			Call Common_Sealing_GenerateTimeProg_SM1
//			Call Common_Sealing_GenerateTimeProg_SM2
		Case EcoDose_SM_PCL
			Call Common_Sealing_DeleteTimeProg_SM1	// Remove this Call-action when automatically generated 2-material-processes are available
			Call Common_Sealing_GenerateTimeProg_SM1
			Call Common_Sealing_GenerateTimeProg_PCL1
		Case EcoDose_PCL
			Call Common_Sealing_GenerateTimeProg_PCL1
		Case EcoDose_PCL_PCL
			Call Common_Sealing_GenerateTimeProg_PCL1
//			Call Common_Sealing_GenerateTimeProg_PCL2
	EndSelect
	
	GenerateTimeprogram "tpcf\referencecurve_hn1.tpcf"
	
	SelectCase NumberOfMainNeedles
		Case 1
			FSDeleteFile ..\..\..\..\..\application\control\PCU1\timeprog\referencecurve_hn2.tp
		CaseElse
			GenerateTimeprogram "tpcf\referencecurve_hn2.tpcf"
	EndSelect
	SelectCase NumberOfMainNeedles
		Case 1
			FSDeleteFile ..\..\..\..\..\application\control\PCU1\timeprog\referencecurve_hn3.tp
		Case 2
			FSDeleteFile ..\..\..\..\..\application\control\PCU1\timeprog\referencecurve_hn3.tp
		CaseElse
			GenerateTimeprogram "tpcf\referencecurve_hn3.tpcf"
	EndSelect
	
	SelectCase Option18
		Case No_CleaningSystem
			SelectCase Option21
				Case 1
					GenerateTimeprogram "tpcf\atomizerclean.tpcf"
				CaseElse
					FSDeleteFile ..\..\..\..\..\application\control\PCU1\timeprog\atomizerclean.tp
			EndSelect
			FSDeleteFile ..\..\..\..\..\application\control\PCU1\timeprog\atomizercleanstandby.tp
			FSDeleteFile ..\..\..\..\..\application\control\PCU1\timeprog\hometoinbox.tp
			FSDeleteFile ..\..\..\..\..\application\control\PCU1\timeprog\inboxtohome.tp
		CaseElse
			GenerateTimeprogram "tpcf\atomizerclean.tpcf"
			GenerateTimeprogram "tpcf\atomizercleanstandby.tpcf"
			GenerateTimeprogram "tpcf\hometoinbox.tpcf"
			GenerateTimeprogram "tpcf\inboxtohome.tpcf"
	EndSelect
	SelectCase Option18
		Case CleaningSystem_PurgeWaterAuto
			GenerateTimeprogram "tpcf\fillwaterquench.tpcf"
			GenerateTimeprogram "tpcf\overflowwaterquench.tpcf"
			GenerateTimeprogram "tpcf\waterchange.tpcf"
		CaseElse
			FSDeleteFile ..\..\..\..\..\application\control\PCU1\timeprog\fillwaterquench.tp
			FSDeleteFile ..\..\..\..\..\application\control\PCU1\timeprog\overflowwaterquench.tp
			FSDeleteFile ..\..\..\..\..\application\control\PCU1\timeprog\waterchange.tp
	EndSelect
Return

SubRoutine Common_Sealing_GenerateTimeProg_SM1
	SelectNode RPC1.R11.PCU1
	GenerateTimeprogram "tpcf\pistoncheck.tpcf"
	GenerateTimeprogram "tpcf\pistonfill.tpcf"
	GenerateTimeprogram "tpcf\pistonmaster.tpcf"
	GenerateTimeprogram "tpcf\pistonpressurecontrol.tpcf"
	GenerateTimeprogram "tpcf\systempressurecontrol.tpcf"
	GenerateTimeprogram "tpcf\purgeatomizer_sm1.tpcf"
	GenerateTimeprogram "tpcf\releasepressure_sm1.tpcf"
	GenerateTimeprogram "tpcf\leakagecheck_sm1_sub1.tpcf"
	
	SelectCase Option20 // Shot meter single
		Case 0
			GenerateTimeprogram "tpcf\leakagecheck_sm1_sub2.tpcf"
		CaseElse
			FSDeleteFile ..\..\..\..\..\application\control\PCU1\timeprog\leakagecheck_sm1_sub2.tp
	EndSelect
	
	SelectCase Circulation
		Case No_Circulation
			GenerateTimeprogram "tpcf\systemdepressurise_sm1.tpcf"
			
			SelectCase Option20 // Shot meter single
				Case 0
					GenerateTimeprogram "tpcf\systemdepressurise_sm1_sub1.tpcf"
					GenerateTimeprogram "tpcf\systemdepressurise_sm1_sub2.tpcf"
				CaseElse
					FSDeleteFile ..\..\..\..\..\application\control\PCU1\timeprog\systemdepressurise_sm1_sub1.tp
					FSDeleteFile ..\..\..\..\..\application\control\PCU1\timeprog\systemdepressurise_sm1_sub2.tp
			EndSelect
			
			FSDeleteFile ..\..\..\..\..\application\control\PCU1\timeprog\circulation_sm1.tp
		CaseElse
			GenerateTimeprogram "tpcf\circulation_sm1.tpcf"
			
			FSDeleteFile ..\..\..\..\..\application\control\PCU1\timeprog\systemdepressurise_sm1.tp
			FSDeleteFile ..\..\..\..\..\application\control\PCU1\timeprog\systemdepressurise_sm1_sub1.tp
			FSDeleteFile ..\..\..\..\..\application\control\PCU1\timeprog\systemdepressurise_sm1_sub2.tp
	EndSelect
Return

SubRoutine Common_Sealing_DeleteTimeProg_SM1
	FSDeleteFile ..\..\..\..\..\application\control\PCU1\timeprog\pistoncheck.tp
	FSDeleteFile ..\..\..\..\..\application\control\PCU1\timeprog\pistonfill.tp
	FSDeleteFile ..\..\..\..\..\application\control\PCU1\timeprog\pistonmaster.tp
	FSDeleteFile ..\..\..\..\..\application\control\PCU1\timeprog\pistonpressurecontrol.tp
	FSDeleteFile ..\..\..\..\..\application\control\PCU1\timeprog\systempressurecontrol.tp
	FSDeleteFile ..\..\..\..\..\application\control\PCU1\timeprog\purgeatomizer_sm1.tp
	FSDeleteFile ..\..\..\..\..\application\control\PCU1\timeprog\releasepressure_sm1.tp
	FSDeleteFile ..\..\..\..\..\application\control\PCU1\timeprog\leakagecheck_sm1_sub1.tp
	FSDeleteFile ..\..\..\..\..\application\control\PCU1\timeprog\leakagecheck_sm1_sub2.tp
	FSDeleteFile ..\..\..\..\..\application\control\PCU1\timeprog\systemdepressurise_sm1.tp
	FSDeleteFile ..\..\..\..\..\application\control\PCU1\timeprog\systemdepressurise_sm1_sub1.tp
	FSDeleteFile ..\..\..\..\..\application\control\PCU1\timeprog\systemdepressurise_sm1_sub2.tp
	FSDeleteFile ..\..\..\..\..\application\control\PCU1\timeprog\circulation_sm1.tp
Return

SubRoutine Common_Sealing_GenerateTimeProg_PCL1
	SelectNode RPC1.R11.PCU1
	GenerateTimeprogram "tpcf\purgeatomizer.tpcf"
	GenerateTimeprogram "tpcf\circulation.tpcf"
	GenerateTimeprogram "tpcf\beakering.tpcf"
Return

SubRoutine Common_Sealing_DeleteTimeProg_PCL1
//	FSDeleteFile ..\..\..\..\..\application\control\PCU1\timeprog\purgeatomizer.tp
	FSDeleteFile ..\..\..\..\..\application\control\PCU1\timeprog\circulation.tp
	FSDeleteFile ..\..\..\..\..\application\control\PCU1\timeprog\beakering.tp
Return

SubRoutine Common_Description_PCU
	SelectNode RPC1.R11.PCU1
	SelectTab [Properties]
	SelectCase Option2
		Case xD
			SelectCase NozzleExchanger
				Case 0
					Call Common_Description_PCU_xD
				Case 3
					Call Common_Description_PCU_xD_NozzleExchanger
				Case 6
					Call Common_Description_PCU_xD_NozzleExchanger
				Case 10
					Call Common_Description_PCU_xD_NozzleExchanger
				CaseElse
					Message NozzleExchanger type not supported !! (Common_Description_PCU)
			EndSelect
		Case xD_LASD
			Call Common_Description_PCU_xD_LASD
		Case MD
			Call Common_Description_PCU_MD
		Case Swirl
			Call Common_Description_PCU_Swirl
		Case IDS
			Call Common_Description_PCU_IDS
		CaseElse
			Message Option 2 selection not supported !! (Common_Description_PCU)
	EndSelect
Return

