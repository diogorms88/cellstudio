SubRoutine Common_AddDevice_BFDS1
	AddDevice AF_Press_Analog20_10_BR FDS1
	Description Paint pressure control 1
	VisuInterface 1 3
	// Properties of hardware endpoints (Profibus / SercosIII) will be set by script for Option 14
Return

SubRoutine Common_AddDevice_BMV2
	AddDevice AF_Press_Analog20_10_BR MV2
	Description Air flow for pressure regulator material 1
	VisuInterface 1 1
	// set cfg parameters
	SelectTab [CfgParameter]
	SelectCfg BMV2.ActualPressure.MonitorStatic.LowerAlarmRange
	Value 50
	SelectCfg BMV2.ActualPressure.MonitorStatic.LowerWarningRange
	Value 15
	SelectCfg BMV2.ActualPressure.MonitorStatic.TimeIgnoreDifferenceDown
	Value 0d0h0m0s0ms
	SelectCfg BMV2.ActualPressure.MonitorStatic.TimeIgnoreDifferenceUp
	Value 0d0h0m0s0ms
	SelectCfg BMV2.ActualPressure.MonitorStatic.TimeOutLowerAlarm
	Value 0d0h0m0s0ms
	SelectCfg BMV2.ActualPressure.MonitorStatic.TimeOutLowerWarning
	Value 0d0h0m0s0ms
	SelectCfg BMV2.ActualPressure.MonitorStatic.TimeOutUpperAlarm
	Value 0d0h0m0s0ms
	SelectCfg BMV2.ActualPressure.MonitorStatic.TimeOutUpperWarning
	Value 0d0h0m0s0ms
	SelectCfg BMV2.ActualPressure.MonitorStatic.UpperAlarmRange
	Value 50
	SelectCfg BMV2.ActualPressure.MonitorStatic.UpperWarningRange
	Value 15
	SelectCfg BMV2.TimeDown
	Value 0d0h0m0s200ms
	SelectCfg BMV2.TimeUp
	Value 0d0h0m0s200ms
Return

