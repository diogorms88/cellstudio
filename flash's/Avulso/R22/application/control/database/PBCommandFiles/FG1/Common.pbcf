SubRoutine Common_AddDevice_YHG1
	SelectCase Option14 // Variant of bus master
		Case SercosIII
			AddDevice V_3-2_EL HG1
			Description Valve help gun 1
			VisuInterface 1 1 5
			WearCounter 1
			// set cfg parameters
			SelectTab [CfgParameter]
			SelectCfg YHG1.TimeOn
			OptionalUsed 1
			Value 00d00h00m00s070ms
			SelectCfg YHG1.TimeOff
			OptionalUsed 1
			Value 00d00h00m00s070ms
		Case Profibus
			AddDevice V_3-2_LP04_DDL HG1
			Description Valve help gun 1
			VisuInterface 1 1 5
			WearCounter 1
			// set cfg parameters
			SelectTab [CfgParameter]
			SelectCfg YHG1.TimeOn
			OptionalUsed 1
			Value 00d00h00m0s070ms
			SelectCfg YHG1.TimeOff
			OptionalUsed 1
			Value 00d00h00m00s070ms
		CaseElse
			Message Wrong bus master (Common_AddDevice_YHG1)!! Only Profibus and Sercos III supported
	EndSelect
Return

