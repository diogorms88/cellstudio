Return
//**************End routines to set common properties*************

SubRoutine Common_Enable_SCP_Fixpos
	SelectNode RPC1.R11
	SelectTab [Fixpositions]
	FixposEnabled RefSCP 1
	FixposEnabled SyncSCP 1
	SelectTab [VariantConfiguration]
Return

SubRoutine Common_Disable_SCP_Fixpos
	SelectNode RPC1.R11
	SelectTab [Fixpositions]
	FixposEnabled RefSCP 0
	FixposEnabled SyncSCP 0
	SelectTab [VariantConfiguration]
Return
