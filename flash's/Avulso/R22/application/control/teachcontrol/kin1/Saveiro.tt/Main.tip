RSELECT("R22")
  //
  SETOBJECT(BASE_SAVEIRO)
  RECEIVE(VISION, Data)
  //
  WAIT_PROCESS_READY()
  //
  CALL HOME()
  //
  CALL Umori1()
  //
  CALL UBF_2_gabriel()
  //
  //Colision bit R22 <--> R21
  SET(Collision3, High)
  RECEIVE(Collision3, High)
  //
  // Colision bit R11 <--> R21 <--> R12 <--> R22
  SET(Collision5, High)
  RECEIVE(Collision5, High)
  //
  CALL UBB_1()
  //
  SET(Collision3, Low)
  //
  SET(Collision5, Low)
  //
  CALL UBF_3_gabriel()
  //
  CALL UBF_1_gabriel()
  //
  CALL WLF_teste_gabriel()
  //
  CALL Umori2_gabriel()
  //
  CALL HOME()
  //
RDESELECT("R22")
