<VIEW>
   <MASKDEF key="TeachView.mask.vision_rel" textfile="userTx" permissiondef="userMenuPermission">           
        <GROUP key="vision_rel.label.group" columns="40" rows="40" col="1" row="1" halign="stretch" valign="stretch">   
      
           <LABEL key="vision_rel.label.vision" col="9"  row="2" cspan="9" halign="center"/> 
      	   <LABEL key="vision_rel.label.teach"  col="19" row="2" cspan="9" halign="center"/> 
      	   <LABEL key="vision_rel.label.object" col="29" row="2" cspan="9" halign="center"/> 
      	
      	   <!--  Coord X -->
      	   <LABEL key="vision_rel.label.CoordX" col="3" row="5" cspan="5" halign="left"/>
      	   <NUMFIELD var="_system.RcuUserPage.Vision.tVisionDataRel.X_mm" vartype="TT" key="vision_rel.numfield.coordX" col="9" row="5" cspan="9" halign="stretch"/>
           <NUMFIELD var="_system.RcuUserPage.Vision.tTeachInObject.X_mm" vartype="TT" enabled="false" col="19" row="5" cspan="9" halign="stretch"/>
      	   <NUMFIELD var="_system.RcuUserPage.Vision.tObjectDataRel.X_mm" vartype="TT" enabled="false" col="29" row="5" cspan="9" halign="stretch"/>
      	   
      	   <!--  Coord Y -->
      	   <LABEL key="vision_rel.label.CoordY" col="3" row="10" cspan="5" halign="left"/>
      	   <NUMFIELD var="_system.RcuUserPage.Vision.tVisionDataRel.Y_mm" vartype="TT" key="vision_rel.numfield.coordY" col="9" row="10" cspan="9" halign="stretch"/>
           <NUMFIELD var="_system.RcuUserPage.Vision.tTeachInObject.Y_mm" vartype="TT" enabled="false" col="19" row="10" cspan="9" halign="stretch"/>
      	   <NUMFIELD var="_system.RcuUserPage.Vision.tObjectDataRel.Y_mm" vartype="TT" enabled="false" col="29" row="10" cspan="9" halign="stretch"/>
      	   
      	   <!--  Coord Z -->
      	   <LABEL key="vision_rel.label.CoordZ" col="3" row="15" cspan="5" halign="left"/>
      	   <NUMFIELD var="_system.RcuUserPage.Vision.tVisionDataRel.Z_mm" vartype="TT" key="vision_rel.numfield.coordZ" col="9" row="15" cspan="9" halign="stretch"/>
           <NUMFIELD var="_system.RcuUserPage.Vision.tTeachInObject.Z_mm" vartype="TT" enabled="false" col="19" row="15" cspan="9" halign="stretch"/>
      	   <NUMFIELD var="_system.RcuUserPage.Vision.tObjectDataRel.Z_mm" vartype="TT" enabled="false" col="29" row="15" cspan="9" halign="stretch"/>
      	   
      	   <!--  Coord A -->
      	   <LABEL key="vision_rel.label.CoordA" col="3" row="20" cspan="5" halign="left"/>
           <NUMFIELD var="_system.RcuUserPage.Vision.tVisionDataRel.A_deg" vartype="TT" key="vision_rel.numfield.coordA" col="9" row="20" cspan="9" halign="stretch"/>
      	   <NUMFIELD var="_system.RcuUserPage.Vision.tTeachInObject.A_deg" vartype="TT" enabled="false" col="19" row="20" cspan="9" halign="stretch"/>
      	   <NUMFIELD var="_system.RcuUserPage.Vision.tObjectDataRel.A_deg" vartype="TT" enabled="false" col="29" row="20" cspan="9" halign="stretch"/>
      	   
      	   <!--  Coord B -->
      	   <LABEL key="vision_rel.label.CoordB" col="3" row="25" cspan="5" halign="left"/>
      	   <NUMFIELD var="_system.RcuUserPage.Vision.tVisionDataRel.B_deg" vartype="TT" key="vision_rel.numfield.coordB" col="9" row="25" cspan="9" halign="stretch"/>
      	   <NUMFIELD var="_system.RcuUserPage.Vision.tTeachInObject.B_deg" vartype="TT" enabled="false" col="19" row="25" cspan="9" halign="stretch"/>
      	   <NUMFIELD var="_system.RcuUserPage.Vision.tObjectDataRel.B_deg" vartype="TT" enabled="false" col="29" row="25" cspan="9" halign="stretch"/>
            
            <!--  Coord C -->
      	   <LABEL key="vision_rel.label.CoordC" col="3" row="30" vartype="TT" cspan="5" halign="left"/>
      	   <NUMFIELD var="_system.RcuUserPage.Vision.tVisionDataRel.C_deg" vartype="TT" key="vision_rel.numfield.coordC" col="9" row="30" cspan="9" halign="stretch"/>
      	   <NUMFIELD var="_system.RcuUserPage.Vision.tTeachInObject.C_deg" vartype="TT" enabled="false" col="19" row="30" cspan="9" halign="stretch"/>
      	   <NUMFIELD var="_system.RcuUserPage.Vision.tObjectDataRel.C_deg" vartype="TT" enabled="false" col="29" row="30" cspan="9" halign="stretch"/>
      	
      	   <!--  User-Info -->
      	   <LABEL key="vision_rel.label.source" var="_system.RcuUserPage.Vision.iInfoRel" vartype="TT"
      	          col="9" row="35" cspan="30" halign="left"/>
      	
      </GROUP>
   </MASKDEF>
   
   
   <MENUDEF key="TeachView.mask.vision_rel" textdef="userTx"  imagefile="KvtMenuIcon" permissiondef="userMenuPermission">
      <MENU>
           <MENUITEM type="empty"/>
	   <MENUITEM key="vision_rel.menu.set"   enabled="true" var="_system.RcuUserPage.Vision.bSetDataRel"    vartype="TT"/>
           <MENUITEM key="vision_rel.menu.read"  enabled="true" var="_system.RcuUserPage.Vision.bReadDataRel"   vartype="TT"/>
	   <MENUITEM key="vision_rel.menu.calc"  enabled="true" var="_system.RcuUserPage.Vision.bCalcObjectRel" vartype="TT"/>
	   <MENUITEM key="vision_rel.menu.reset" enabled="true" var="_system.RcuUserPage.Vision.bResetDataRel"  vartype="TT"/>
	   <MENUITEM type="empty"/>
      </MENU>
   </MENUDEF>
   
</VIEW>

