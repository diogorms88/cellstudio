			       key="motionmenu.button.group4"/>
			</GROUP>
			
			<!-- menu item 6 - handler torque check -->
			<GROUP key="motionmenu.label.group5" col="143" row="114" columns="142" rows="113" cspan="142" rspan="113" top="2" bottom="2" left="2" right="2"
			       visiblevar="_system.gRcuFocusedRobot.torqueCheck.showUserPage" visiblevartype="TT">
			       <BUTTON maskkey="TeachView.mask.TorqueCheck" file="TorqueCheck64x64.gif" col="26" row="4" cspan="79" rspan="79"
			       key="motionmenu.button.group5"/>
			</GROUP>
			
			<!-- menu item 7 - sfa -->
			<GROUP key="motionmenu.label.group6" col="286" row="114" columns="142" rows="113" cspan="142" rspan="113" top="2" bottom="2" left="2" right="2"
			       visiblevar="_system.gRcuFocusedRobot.sfaRobot" visiblevartype="TT">
			       <BUTTON maskkey="TeachView.mask.SFA" file="SFA64x64.gif" col="26" row="4" cspan="79" rspan="79"
			       key="motionmenu.button.group6"/>
			</GROUP> 
				
			<!-- menu item 8 - ToolCleaner -->
		        <GROUP key="motionmenu.label.group7" col="429" row="114" columns="142" rows="113" cspan="142" rspan="113" top="2" bottom="2" left="2" right="2"
		               visiblevar="_system.gRcuFocusedRobot.handler.toolCleaner.sCfgValues.bUseToolCleaner" visiblevartype="TT">
		               <BUTTON maskkey="TeachView.mask.toolCleaner" file="ToolCleaner64x64.gif" col="26" row="4" cspan="79" rspan="79"
		               key="motionmenu.button.group7"/>
			</GROUP> 
			
			<!-- menu item 9 - pneu unit -->
		        <GROUP key="motionmenu.label.group8" col="1" row="228" columns="142" rows="113" cspan="142" rspan="113" top="2" bottom="2" left="2" right="2"
		               visiblevar="_system.rcuuserpage.handlerTool.bShowPneuUnitPage" visiblevartype="TT">
			       <BUTTON maskkey="TeachView.mask.pneuUnit" file="PneuUnit64x64.gif" col="26" row="4" cspan="79" rspan="79"
			       key="motionmenu.button.group8"/>
			</GROUP>
			
			<!-- menu item 10 - safety control -->
			<GROUP key="motionmenu.label.group9" col="143" row="228" columns="142" rows="113" cspan="142" rspan="113" top="2" bottom="2" left="2" right="2"
			       visiblevar="_system.gRcuFocusedRobot.interfaceToSCP.bSafeRobotic" visiblevartype="TT">
			       <BUTTON maskkey="TeachView.mask.safetyControl" file="Safety64x64.gif" col="26" row="4" cspan="79" rspan="79"
			       key="motionmenu.button.group9"/>
			</GROUP>
			
			<!-- menu item 11 - safety control test -->
			<GROUP key="motionmenu.label.group10" col="286" row="228" columns="142" rows="113" cspan="142" rspan="113" top="2" bottom="2" left="2" right="2"
			       visiblevar="_system.gRcuFocusedRobot.interfaceToSCP.bVeloMonitoring" visiblevartype="TT">
			       <BUTTON maskkey="TeachView.mask.safetyControlTest" file="SafetyTest64x64.gif" col="26" row="4" cspan="79" rspan="79"
			       key="motionmenu.button.group10"/>
			</GROUP>
			
			<!--     menu item 12 - pneumatic handler tool -->
		        <GROUP key="motionmenu.label.group11" col="429" row="228" columns="142" rows="113" cspan="142" rspan="113" top="2" bottom="2" left="2" right="2"
		               visiblevar="_system.gRcuFocusedRobot.handler.tool.anyPneuToolUsed" visiblevartype="TT">
			       <BUTTON maskkey="TeachView.mask.pneuTool" file="pneutool64x64.gif" col="26" row="4" cspan="79" rspan="79"
			       key="motionmenu.button.group11"/>
			</GROUP>
			
		</MASKDEF>
	</MASKS>	
</VIEW>