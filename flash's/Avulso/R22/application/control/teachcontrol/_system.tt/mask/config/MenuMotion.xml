<VIEW>
	<MASKS>
		<MASKDEF maskkey="TeachView.mask.motionmenu" textdef="userTx" permissiondef="userMenuPermission"
		         width="571" columns="571" height="340" rows="340" top="1" bottom="1" left="1" right="1">
		
		        <!-- menu item 1 - logger --> 
		        <GROUP key="motionmenu.label.group0" col="1" row="1" columns="142" rows="113" cspan="142" rspan="113" top="2" bottom="2" left="2" right="2">
			       <BUTTON maskkey="TeachView.mask.logger" file="Logger64x64.gif" col="26" row="4" cspan="79" rspan="79"
			       key="motionmenu.button.group0"/>
			</GROUP> 
						
			<!-- menu item 2 - programm runtime --> 
			<GROUP key="motionmenu.label.group1" col="143" row="1" columns="142" rows="113" cspan="142" rspan="113" top="2" bottom="2" left="2" right="2">
			       <BUTTON maskkey="TeachView.mask.programTimeTable" file="ClockSchedule64x64.gif" col="26" row="4" cspan="79" rspan="79"
			       key="motionmenu.button.group1"/>
			</GROUP>
			
			<!-- menu item 3 - tracking --> 
			<GROUP key="motionmenu.label.group2" col="286" row="1" columns="142" rows="113" cspan="142" rspan="113" top="2" bottom="2" left="2" right="2"
			       visiblevar="_system.gbIsTrackingStation" visiblevartype="TT">
			       <BUTTON maskkey="TeachView.mask.tracking" file="Tracking64x64.gif" col="26" row="4" cspan="79" rspan="79"
			       key="motionmenu.button.group2"/>
			</GROUP>
			
			<!-- menu item 4 - Fifo --> 
		        <GROUP key="motionmenu.label.group3" col="429" row="1" columns="142" rows="113" cspan="142" rspan="113" top="2" bottom="2" left="2" right="2"
		               visiblevar="_system.gbIsTrackingStation" visiblevartype="TT">
			       <BUTTON maskkey="TeachView.mask.trackingBody" file="Fifo64x64.gif" col="26" row="4" cspan="79" rspan="79"
			       key="motionmenu.button.group3"/>
			</GROUP> 
			
			<!-- menu item 5 - handler tool --> 
		        <GROUP key="motionmenu.label.group4" col="1" row="114" columns="142" rows="113" cspan="142" rspan="113" top="2" bottom="2" left="2" right="2"
		               visiblevar="_system.gRcuFocusedRobot.handler.tool.bEnabled" visiblevartype="TT">
