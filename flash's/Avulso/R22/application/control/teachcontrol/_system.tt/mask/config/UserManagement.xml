<VIEW>
	<MASKS>
		<MASKDEF key="TeachView.mask.userManagement" textfile="userTx" permissiondef="userMenuPermission" width="550" columns="550" height="340" rows="340" top="1" bottom="1" left="1" right="1"
		         triggervar="_system.rcuuserpagevars.bShowMsgBoxLogIn" triggervartype="TT">
		
		        <LABEL key="userManagement.label.opclogout" col="100" row="35" cspan="300" halign="center" rspan="35" valign="stretch"/>
		        
		        <BUTTON key="userManagement.button.login"  var="_system.RcuUserPage.bKeepUserLoggedIn" vartype="TT" file="KeepLogin128x128.gif" col="100" row="95" cspan="140" rspan="100" halign="stretch"/>
		        <LABEL key="userManagement.label.keepuser" col="100" row="225" cspan="140" halign="center" rspan="35" valign="stretch"/>
		        
		        <BUTTON key="userManagement.button.logout" var="_system.RcuUserPage.bLogoutUser"       vartype="TT" file="Logout128x128.gif"    col="350" row="95" cspan="140" rspan="100" halign="stretch"/>
		        <LABEL key="userManagement.label.logout" col="350" row="225" cspan="140" halign="center" rspan="35" valign="stretch"/>
		
                        <LABEL key="userManagement.label.progress" col="100" row="300" cspan="400" halign="center" rspan="35" valign="stretch"/> 
                        <PROGRESSBAR var="_system.RcuUserPage.iTimerProgress" vartype="TT" col="100" cspan="400" row="330" rspan="10"/>
                        
                </MASKDEF>
	</MASKS>	
</VIEW>