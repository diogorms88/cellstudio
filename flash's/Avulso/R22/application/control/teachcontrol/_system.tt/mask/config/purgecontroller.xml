<VIEW>
  <MASKDEF key="TeachView.mask.purgecontroller" textfile="userTx" permissiondef="userMenuPermission">
    <GROUP key="purgeController.Label.purgeController" columns="40" rows="12" col="1" row="1" rspan="1" halign="stretch" valign="stretch">

	  <VARSYMBOL row="1" rspan="3" col="34" cspan="6" valign="stretch" halign="stretch" vartype="SV" var="system.SV_PurgeController[0].sOut.o_iExCertification">
		<SYMBOL file="purgecontroller_ATEX.gif" value="0"/>
		<SYMBOL file="purgecontroller_FM.gif" value="1"/>
	  </VARSYMBOL>
	  
	  <LABEL key="purgeController.Label.state" col="5" row="2" cspan="1" halign="left" />
      <LABEL key="purgeController.Value.state" var="system.SV_PurgeController[0].sOut.o_iPurgeState" vartype="SV" enabled="true" valign="stretch" halign="right" col="10" row="2" cspan="20" rSpan="2"/>

	  <CHECKBOX key="Manual Adressing" col="32" row="2" halign="left" enabled="true"
	            vartype="SV" var="system.SV_PurgeController[0].sIn.i_mStartAddressing" 
				visiblevartype="SV" visiblevar="system.SV_PurgeController[0].sOut.o_mShowAddressingButton"/>
	  
      <LABEL key="purgeController.Label.overPressure" col="5" row="4" cspan="1" halign="left" />
      <LABEL var="system.SV_PurgeController[0].sOut.o_iPressure" vartype="SV" enabled="true" halign="right" col="20" row="4" cspan="10" />
	  <LABEL key="mBar" col="31" row="4" cspan="1" halign="left" />
      
	  <LABEL key="purgeController.Label.startVolume" col="5" row="5" cspan="1" halign="left" />
      <LABEL var="system.SV_PurgeController[0].sOut.o_iStartPurgeVolume" vartype="SV" enabled="true" halign="right" col="20" row="5" cspan="10" />
	  <LABEL key="NL" col="31" row="5" cspan="1" halign="left" />
      
	  <LABEL key="purgeController.Label.restVolume" col="5" row="6" cspan="1" halign="left" />
      <LABEL var="system.SV_PurgeController[0].sOut.o_iRemainingPurgeVolume" vartype="SV" enabled="true" halign="right" col="20" row="6" cspan="10" />
	  <LABEL key="NL" col="31" row="6" cspan="1" halign="left" />

      <LABEL key="purgeController.Label.restTime" col="5" row="7" cspan="1" halign="left" />
      <LABEL var="system.SV_PurgeController[0].sOut.o_zRemainingPurgeTime" vartype="SV" enabled="true" halign="right" col="20" row="7" cspan="10" />
     
      <LABEL key="purgeController.Label.actFlow" col="5" row="8" cspan="1" halign="left" />
      <LABEL var="system.SV_PurgeController[0].sOut.o_iFlow" vartype="SV" enabled="true" halign="right" col="20" row="8" cspan="10" />
	  <LABEL key="NL/min" col="31" row="8" cspan="1" halign="left" />

      <LABEL key="purgeController.Label.actTemp" col="5" row="9" cspan="1" halign="left" />
      <LABEL var="system.SV_PurgeController[0].sOut.o_iTemperature" vartype="SV" enabled="true" halign="right" col="20" row="9" cspan="10" />
	  <LABEL key="°C" col="31" row="9" cspan="1" halign="left" />

      <LABEL key="purgeController.Label.lastTime" col="5" row="11" cspan="1" halign="left" />
      <LABEL var="system.SV_PurgeController[0].sOut.o_zLastPurgeTime" vartype="SV" enabled="true" halign="right" col="20" row="11" cspan="10" />

    </GROUP>
  </MASKDEF>
</VIEW>