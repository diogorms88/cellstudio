        gbBootupError := TRUE;
      END_IF;
           
      iMapSignals := iMapSignals + 1;              //Signal-Nr. 9
      svTCPVelocity := MAPX(cSV_rTcpVelocityPaint[locKinematic.kinListInx]); 
