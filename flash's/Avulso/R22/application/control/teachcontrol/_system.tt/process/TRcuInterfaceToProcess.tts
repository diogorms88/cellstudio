        gbBootupError := TRUE;
      END_IF;
             
      iMapSignals := iMapSignals + 1;              //Signal-Nr. 8
      svRobotMoving := MAPX(cSV_mRobotMovingPaint[locKinematic.kinListInx]);
      IF IS_MAPPED(svRobotMoving) THEN
