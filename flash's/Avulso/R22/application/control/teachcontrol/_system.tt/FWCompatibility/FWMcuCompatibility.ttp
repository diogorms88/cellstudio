CONSTANT GLOBAL
   cMcuDbObjVecLen: DINT := 16;
   cMcuMaxGuardPoints: DINT := 32;
   cMcuMaxGuardPositions: DINT := 64;   
END_CONSTANT

TYPE GLOBAL
   TMcuDbObjIDInfo: STRUCT
      mObjID: TMcuDbObjID;
      mContainingObjID: TMcuDbObjID;
   END_STRUCT;

   TMcuVecBool: STRUCT
      mValidLen: DINT;
      mValues: ARRAY [cMcuMaxJ] OF BOOL;
   END_STRUCT;

   TMcuDbObjIDVec: STRUCT
      mValidLen: DINT;
      mDbObjIDs: ARRAY [cMcuDbObjVecLen] OF TMcuDbObjID;
   END_STRUCT;

   TMcuGuardMode: (
      eMcuGuardInactive,
      eMcuGuardPosition,
      eMcuGuardVelocity,
      eMcuGuardPosAndVel,
      eMcuMaxGuardMode
   );

   TMcuGuardLocation: (
      eMcuGuardTCP,
      eMcuGuardElbow,
      eMcuGuardFlange,
      eMcuGuardJointFrame,
      eMcuGuardToolStart,
      eMcuGuardToolEnd,
      eMcuMaxGuardLocation
   );

   TMcuGuardOrigin: (
      eMcuGuardUser,
      eMcuGuardTool,
      eMcuGuardWorkpiece
   );

   TMcuCartDynamicType: (
      eMcuCartPosVel,
      eMcuCartOriVel,
      eMcuMaxCartDynamicType
   );

   TMcuGuardPoint: STRUCT
      mGuardMode: TMcuGuardMode;
      mGuardLocation: TMcuGuardLocation;
      mJointNr: DINT;
      mGuardPoint: TMcuFrame;
      mGuardName: TMcuStringShort;
   END_STRUCT;

   TMcuGuardPoints: STRUCT
      mName: TMcuString;
      mDBObjTyp: TMcuDBObjTyp;
      mUserData: TMcuUserData;
      mNrOfGuardPoints: DINT;
      mGuardPoints: ARRAY [cMcuMaxGuardPoints] OF TMcuGuardPoint;
   END_STRUCT;
   
   TMcuGuardCheckInfo: STRUCT
      mGuardMode: TMcuGuardMode;
      mGuardLocation: TMcuGuardLocation;
      mJointNr: DINT;
      mGuardOrigin: TMcuGuardOrigin;
   END_STRUCT;

   TMcuGuardObjectInfo: STRUCT
      mGuardIdx: DINT;
      mGuardObject: TMcuDbObjIDInfo;
   END_STRUCT;

   TMcuGuardPosition: STRUCT
      mCheckInfo: TMcuGuardCheckInfo;
      mObjectInfo: TMcuGuardObjectInfo;
      mPosition: TMcuFrame;
   END_STRUCT;

   TMcuGuardPositions: STRUCT
      mValidLen: DINT;
      mGuardPositions: ARRAY [cMcuMaxGuardPositions] OF TMcuGuardPosition;
   END_STRUCT;
   
   TMcuCartDynamicLimits: STRUCT
      mName: TMcuString;
      mDBObjTyp: TMcuDBObjTyp;
      mUserData: TMcuUserData;
      mKinematicID: TMcuDbObjID;
      mDynamicType: TMcuCartDynamicType;
      mLimit: REAL;
   END_STRUCT;
   
   TMcuGuardModeSelection: (
      eMcuAllGuards,
      eMcuOnlyPosGuards,
      eMcuOnlyPosAndVelGuards
   );

   TMcuKinematicRegionDef: (
      eMcuFullKinematic,
      eMcuSelectedKinRegions
   );

   TMcuNamedKinematicRegion: (
      eMcuKinRegionTCP,
      eMcuKinRegionFlange,
      eMcuKinRegionElbow,
      eMcuKinRegionTool,
      eMcuKinRegionWorkpiece,
      eMcuMaxNamedKinRegions
   );

   TMcuKinematicRegions: STRUCT
      mKinRegionDef: TMcuKinematicRegionDef;
      mNamedRegions: ARRAY [eMcuMaxNamedKinRegions] OF BOOL;
      mJointRegions: TMcuVecBool;
   END_STRUCT;

   TMcuAreaGuardSelection: STRUCT
      mGuardModes: TMcuGuardModeSelection;
      mGuardRegions: TMcuKinematicRegions;
   END_STRUCT;

   TMcuWSMCollectiveState: STRUCT
      mWorkSpaceState: TMcuWSMState;
      mBlockedSpaceState: TMcuWSMState;
      mWillLeaveWorkSpace: BOOL;
      mWillEnterBlockedSpace: BOOL;
      mReportedAreaID: TMcuDbObjID;
      mReportedKinematicPartIdx: DINT;
   END_STRUCT;

   TMcuCartesianWorkspaceMonitoring: STRUCT
      mState: TMcuWSMCollectiveState;
   END_STRUCT;

   TMcuJointsWorkspaceMonitoring: STRUCT
      mState: TMcuWSMCollectiveState;
   END_STRUCT;

   TMcuKinematicMonitoring: STRUCT
      mCartesianSpace: TMcuCartesianWorkspaceMonitoring;
      mJointsSpace: TMcuJointsWorkspaceMonitoring;
   END_STRUCT;

END_TYPE    

