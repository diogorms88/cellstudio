TYPE GLOBAL
   TRcuDriveValuesExt: STRUCT
      mValidLen: DINT;
      mPos: TMcuJointVector;
      mTorque: TMcuJointVector;
      mFinalTorque: TMcuJointVector;
      mActTorque: TMcuJointVector;
      mUpdateCounterDrives: DINT;
      mMicroIPState: TRcuMicroIPState;
      mMicroIPPathPos: TRcuPathPos;
   END_STRUCT;
   
   TRcuMicroIPState: (
      eRcuMicroIPStateNormal,
      eRcuMicroIPStateStopping,
      eRcuMicroIPStateFrozen
   );
   
   TRcuPathPos: STRUCT
      mPathID: TMcuDbObjID;
      mSegmentID: TMcuDbObjID;
      mSegParam: REAL;
   END_STRUCT;
END_TYPE


TYPE GLOBAL


   TMcuSmoothGeometry: STRUCT
      mSmoothFactor: REAL;
      mHasPathVelCompensation: BOOL;
   END_STRUCT;


   TMcuIPPosition: STRUCT
      mPosType: TMcuIPPosType;
      mJoints: TMcuVector;
      mFrame: TMcuFrame;
   END_STRUCT;


   TMcuIPPosType: (
      eMcuIPPosInvalid := 0,
      eMcuIPPosJoints,
      eMcuIPPosCart,
      eMcuIPPosMixed
   );

   TMcuIPPosErrorType: (
      eMcuIPPosOK,
      eMcuIPPosWrongParams,
      eMcuIPPosSegmentNotValid,
      eMcuIPPosSegmentNotCalculated,
      eMcuIPPosProfilesNotCalculated,
      eMcuIPPosTargetNotReachable
   );


   TMcuIPCalcType: (
      eMcuIPCalcNormal,
      eMcuIPCalcOriginal
   );


END_TYPE

VAR GLOBAL
   gbSmoothAvailable : BOOL := FALSE;
   gbActCartJointsAvailable : BOOL := TRUE;
   gbGuardsAvailable : BOOL := FALSE;
END_VAR

ROUTINE SetSmoothInSegHdl(lSegHdl : TMcuSegHdl; lSmooth : TMcuSmoothGeometry) GLOBAL
   //   lSegHdl.mSmoothGeometry := lSmooth;
   RETURN;
END_ROUTINE


ROUTINE GetActCartValJoints (CONST kin : TRcuKinematic; CONST iAxNr : INT) : REAL GLOBAL
   RETURN kin.actCartVals.mJoints.mPos[iAxNr];
END_ROUTINE


ROUTINE  McuGetInterpolationPosition(IPPosition: TMcuIPPosition; ErrorReason: TMcuIPPosErrorType; CONST PathPos: TMcuPathPos; CONST IPPosCalcType: TMcuIPCalcType): BOOL GLOBAL
   RETURN FALSE;
END_ROUTINE



CONSTANT GLOBAL
   cRcuMaxRobotAdditionalPositions : DINT := 1;
END_CONSTANT 

TYPE GLOBAL
   ADD_POSITIONS               : ARRAY[cRcuMaxRobotAdditionalPositions] OF REAL;
   ADD_POS_DYN                 : ARRAY[cRcuMaxRobotAdditionalPositions] OF TMcuSubDyn;
   MAPTO_ADD_POSITIONS         : ARRAY[cRcuMaxRobotAdditionalPositions] OF MAPTO REAL;
   
   ADD_POSITIONS_ROB_ARR       : ARRAY [cgiRcuMaxKinematics] OF ADD_POSITIONS;
   MAPTO_ADD_POSITIONS_ROB_ARR : ARRAY [cgiRcuMaxKinematics] OF MAPTO_ADD_POSITIONS;
END_TYPE


VAR GLOBAL
   actAdditionalPosRobArr   : MAPTO_ADD_POSITIONS_ROB_ARR;
   actIOAdditionalPosRobArr : MAPTO_ADD_POSITIONS_ROB_ARR;
END_VAR

(*
// In TMcuPosCart den Wert val für den zusaetzlicher Freiheitsgrad des 7-Achs-Roboter (PaintArm7VWrist)
// setzen
ROUTINE SetAdditionalPos(CONST val : ADD_POSITIONS; pos : TMcuPosCart; CONST kin : TRcuKinematic) GLOBAL
VAR
   i : DINT;
END_VAR

   pos.mAdditionalPos.mValidLen := kin.kinematic.mNrOfRobotAdditionalPositions;
   FOR i := 0 TO kin.kinematic.mNrOfRobotAdditionalPositions - 1 DO
      pos.mAdditionalPos.mValues[i] := val[i];
   END_FOR;
END_ROUTINE

// Gibt den Wert des zusaetzlichen Freiheitsgrads in pos für den 7-Achs-Roboter (PaintArm7VWrist)
// in der Variablen val zurück
ROUTINE GetAdditionalPos(val : ADD_POSITIONS; CONST pos : TMcuPosCart; CONST kin : TRcuKinematic) GLOBAL
VAR
   i : DINT;
END_VAR

   FOR i := 0 TO kin.kinematic.mNrOfRobotAdditionalPositions - 1 DO
      val[i] := pos.mAdditionalPos.mValues[i];
   END_FOR;
END_ROUTINE

// Gibt den aktuellen Wert des zusaetzlichen Freiheitsgrads für den 7-Achs-Roboter (PaintArm7VWrist)
// in der Variablen val zurück
ROUTINE GetActAdditionalPos(val : ADD_POSITIONS; CONST kin : TRcuKinematic) GLOBAL
VAR
   i : DINT;
END_VAR

   FOR i := 0 TO kin.kinematic.mNrOfRobotAdditionalPositions - 1 DO
      val[i] := kin.actCartVals.mAdditionalPos.mPos[i];
   END_FOR;
END_ROUTINE

// Mappt die Variable actAdditionalPosRobArr auf den aktuellen Wert des zusaetzlichen Freiheitsgrads für den 7-Achs-Roboter (PaintArm7VWrist)
// Für die angegebene Kinematik 
ROUTINE MapAdditionalPos(CONST kin : TRcuKinematic) GLOBAL
VAR
   i : DINT;
   j : DINT;
END_VAR

   j := kin.kinListInx;
   FOR i := 0 TO kin.kinematic.mNrOfRobotAdditionalPositions - 1 DO
      actAdditionalPosRobArr[j][i] := MAP(kin.actCartVals.mAdditionalPos.mPos[i]);
      actIOAdditionalPosRobArr[j][i] := MAP(kin.IOWorldPos.mAdditionalPos.mValues[i]);
   END_FOR;
END_ROUTINE

// Gibt die Dynamikwerte des zusaetzlichen Freiheitsgrads für den 7-Achs-Roboter (PaintArm7VWrist)
// zurück
ROUTINE GetAdditionalPosDyn(CONST kin : TRcuKinematic; dyn : ADD_POS_DYN; ReducedVel : ADD_POSITIONS) GLOBAL
VAR
   i : DINT;
END_VAR

   FOR i := 0 TO kin.kinematic.mNrOfRobotAdditionalPositions - 1 DO
      dyn[i] := kin.kinematic.mAdditionalPosData[i].mDynLimits;
      ReducedVel[i] := kin.kinematic.mAdditionalPosData[i].mReducedVelocity;
   END_FOR;
   
END_ROUTINE

ROUTINE IsPaintArm7VWrist(CONST kin : TRcuKinematic) : BOOL GLOBAL
   RETURN kin.kinematic.mRobotTyp = eMcuPaintArm7VWrist;
END_ROUTINE

ROUTINE NrOfRobotAdditionalPositions(CONST kin : TRcuKinematic) : DINT GLOBAL
   RETURN kin.kinematic.mNrOfRobotAdditionalPositions;
END_ROUTINE
*)

// bei FW ohne 7-Achs-Kinematik


// zusaetzlicher Freiheitsgrad für 7-Achs-Roboter (PaintArm7VWrist)
ROUTINE SetAdditionalPos(CONST val : ADD_POSITIONS; pos : TMcuPosCart; CONST kin : TRcuKinematic) GLOBAL
VAR
   i : DINT;
END_VAR

   RETURN;
   
END_ROUTINE

// Gibt den Wert des zusaetzlichen Freiheitsgrads in pos für den 7-Achs-Roboter (PaintArm7VWrist)
// in der Variablen val zurück
ROUTINE GetAdditionalPos(val : ADD_POSITIONS; CONST pos : TMcuPosCart; CONST kin : TRcuKinematic) GLOBAL
VAR
   i : DINT;
END_VAR

END_ROUTINE

// Gibt den aktuellen Wert des zusaetzlichen Freiheitsgrads für den 7-Achs-Roboter (PaintArm7VWrist)
// in der Variablen val zurück
ROUTINE GetActAdditionalPos(val : ADD_POSITIONS; CONST kin : TRcuKinematic) GLOBAL
VAR
   i : DINT;
END_VAR

END_ROUTINE

// Mappt die Variable actAdditionalPosRobArr auf den aktuellen Wert des zusaetzlichen Freiheitsgrads für den 7-Achs-Roboter (PaintArm7VWrist)
// Für die angegebene Kinematik 
ROUTINE MapAdditionalPos(CONST kin : TRcuKinematic) GLOBAL
VAR
   i : DINT;
   j : DINT;
END_VAR

END_ROUTINE

// Gibt die Dynamikwerte des zusaetzlichen Freiheitsgrads für den 7-Achs-Roboter (PaintArm7VWrist)
// zurück
ROUTINE GetAdditionalPosDyn(CONST kin : TRcuKinematic; dyn : ADD_POS_DYN; ReducedVel : ADD_POSITIONS) GLOBAL
VAR
   i : DINT;
END_VAR
   
END_ROUTINE

ROUTINE IsPaintArm7VWrist(CONST kin : TRcuKinematic) : BOOL GLOBAL
   RETURN FALSE;
END_ROUTINE

ROUTINE NrOfRobotAdditionalPositions(CONST kin : TRcuKinematic) : DINT GLOBAL
   RETURN 0;
END_ROUTINE

