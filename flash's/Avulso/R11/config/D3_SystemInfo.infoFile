[FileData]
;location of info file: ../appldisk/application/<FileName>
FileName=rpc_data/systeminfo.txt

[EcoRpc]
EcoRpc_deviceNumber=SYS.IO.ONBOARD.deviceInfo.deviceNumber
EcoRpc_eePromName=SYS.HW.TypeLabel.deviceName
EcoRpc_firmwareVersion=SYS.IO.ONBOARD.deviceInfo.firmwareVersion
EcoRpc_hwRevision=SYS.HW.TypeLabel.hwRevision
EcoRpc_orderNumber=SYS.HW.TypeLabel.orderNumber
EcoRpc_runTime=SYS.HW.TypeLabel.operatingHours
EcoRpc_serialNumber=SYS.HW.TypeLabel.serialNumber
EcoRpc_CPU_type=SYS.HW.CPU.type
EcoRpc_OS_driversVersion=SYS.HW.OS.driversVersion
EcoRpc_OS_kernelVersion=SYS.HW.OS.kernelVersion
EcoRpc_OS_version=SYS.HW.OS.osVersion
EcoRpc_disk_size=SYS.HW.Storage.LogicalDevices.sda1.size
EcoRpc_disk_free_space=SYS.HW.Storage.LogicalDevices.sda1.free
EcoRpc_disk_device_id=SYS.HW.Storage.PhysicalDevices.sda.caption
EcoRpc_disk_serial_number=SYS.HW.Storage.PhysicalDevices.sda.serial
EcoRpc_disk_life_time=SYS.HW.Storage.PhysicalDevices.sda.smartRemainingLifetime
EcoRpc_disk_state=SYS.HW.Storage.PhysicalDevices.sda.smartState
EcoRpc_time_zone=SYS.HW.Time.timeZone
EcoRpc_time_utc_offset=SYS.HW.Time.utcOffset
EcoRpc_version_Bios=SYS.HW.Versions.BIOS
EcoRpc_version_MMI=SYS.HW.Versions.MMI
EcoRpc_version_SYSFPGA=SYS.HW.Versions.SYSFPGA
EcoRpc_Security_WhiteList=SYS.HW.Network.Security.Integrity.stateStr

[SCP]
SCP_Firmware=SYS.IO.ONBOARD.SCPBUS:0.SCP:0.deviceInfo.firmwareVersion
SCP_hardware_revision=SYS.IO.ONBOARD.SCPBUS:0.SCP:0.deviceInfo.hwRevision
SCP_serial_number=SYS.IO.ONBOARD.SCPBUS:0.SCP:0.deviceInfo.serialNumber
SCP_FPGA_version=SYS.IO.ONBOARD.SCPBUS:0.SCP:0.scpInfo.FPGAVersion
SCP_validation_Code=SYS.IO.ONBOARD.SCPBUS:0.SCP:0.scpInfo.validationCode
SCP_KRS_version=SYS.IO.ONBOARD.SCPBUS:0.SCP:0.scpInfo.KRSVersion
SCP_configuration_CRC=SYS.IO.ONBOARD.SCPBUS:0.SCP:0.scpInfo.configurationCRC
SCP_program_CRC=SYS.IO.ONBOARD.SCPBUS:0.SCP:0.scpInfo.programCRC
SCP_upload_Counter=SYS.IO.ONBOARD.SCPBUS:0.SCP:0.scpInfo.uploadCounter

[SMM - only installed encoder boxes have values]
SMM_1002_serial_number=SYS.IO.ONBOARD.ECAT:0.ECATDEVICE:1002.deviceInfo.serialNumber
SMM_1002_Firmware=SYS.IO.ONBOARD.ECAT:0.ECATDEVICE:1002.deviceInfo.firmwareVersion
SMM_1002_validation_code=SYS.IO.ONBOARD.ECAT:0.ECATDEVICE:1002.smmInfo.validationCode
SMM_1003_serial_number=SYS.IO.ONBOARD.ECAT:0.ECATDEVICE:1003.deviceInfo.serialNumber
SMM_1003_Firmware=SYS.IO.ONBOARD.ECAT:0.ECATDEVICE:1003.deviceInfo.firmwareVersion
SMM_1003_validation_code=SYS.IO.ONBOARD.ECAT:0.ECATDEVICE:1003.smmInfo.validationCode      
SMM_1004_serial_number=SYS.IO.ONBOARD.ECAT:0.ECATDEVICE:1004.deviceInfo.serialNumber  
