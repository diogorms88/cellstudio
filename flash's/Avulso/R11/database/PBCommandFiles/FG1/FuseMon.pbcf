	OptionalUsed 0
	
	//Fuse10
	SelectCfg System.RCMP.FuseMonitoring.Fuse10_Name
	OptionalUsed 0
	SelectCfg System.RCMP.FuseMonitoring.Fuse10_HWEndpoint
