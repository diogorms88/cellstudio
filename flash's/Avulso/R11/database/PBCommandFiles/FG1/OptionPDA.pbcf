//  Version      | ReleaseDate | Respon | Changes
//  -------------------------------------------------------------------------------------
//  v2_01.00.00  | 20.12.2016  | KTO    | First release
//  v2_01.01.00  | 09.01.2019  | MWT    | Changed so there is no message if during build there was "noPDA" selected; if changed in PB later there is a message
//  v2_01.02.00  | 15.02.2019  | KLCH   | Change: copy PCU1 data dependent on process type

Parameter Option1 OptionPDA

	
	Call Main_OptionPDA

	SelectCase OptionPDA
		Case PDA_v0
			Message Please set [RC]activatePDA=0 in robotcontrol.cfg
	EndSelect		
END

SubRoutine Main_OptionPDA
	SelectCase OptionPDA
		//no pda
		Case PDA_v0
			Call Sub_OptionPDA_v0
		//paint robot
		Case PDA_v10	
			Call Sub_OptionPDA_v10
		//paint robot & opener	
		Case PDA_v11	
			Call Sub_OptionPDA_v11
		//paint robot & opener & opener
		Case PDA_v12	
			Call Sub_OptionPDA_v12
		//opener	
		Case PDA_v15	
			Call Sub_OptionPDA_v15
		//opener & opener
		Case PDA_v16
			Call Sub_OptionPDA_v16
		//opener & opener & opener
		Case PDA_v17
			Call Sub_OptionPDA_v17
	EndSelect
	SelectCase OptionPDA
		Case PDA_v0
			//
		CaseElse
			Message Please add [RC]activatePDA = 1 in robotcontrol.cfg and execute ..\ieccontrol\SetPDA_DeviceName.bat
	EndSelect		
	
Return

SubRoutine Sub_OptionPDA_v0
	//delete pda file
	FSDeleteFile ..\..\..\ieccontrol\PCU1\EngineeringFiles\AB_PDA_PCU.pu
	//copy dummy pda file if PCU1 exists
	SelectCase Option1
		Case Handler
		Case PaintChecker
		CaseElse
			FSCopy ..\..\..\..\..\PDA_Patterns\noPDA\AB_PDA_PCU.pu		..\..\..\ieccontrol\PCU1\EngineeringFiles
	EndSelect
	//delete pda file
	FSDeleteFile ..\..\..\ieccontrol\PCU1\EngineeringFiles\HW_PDA_PCU1.sv
	FSDeleteFile ..\..\..\ieccontrol\RCU1\EngineeringFiles\HW_PDA_RCU1.sv
	FSDeleteFile ..\..\..\ieccontrol\RCU2\EngineeringFiles\HW_PDA_RCU2_1.sv
	FSDeleteFile ..\..\..\ieccontrol\RCU2\EngineeringFiles\HW_PDA_RCU2_2.sv
	FSDeleteFile ..\..\..\ieccontrol\RCU3\EngineeringFiles\HW_PDA_RCU3_1.sv
	FSDeleteFile ..\..\..\ieccontrol\RCU3\EngineeringFiles\HW_PDA_RCU3_2.sv
Return

SubRoutine Sub_OptionPDA_v10
	//delete dummy file
	FSDeleteFile ..\..\..\ieccontrol\PCU1\EngineeringFiles\AB_PDA_PCU.pu
	//copy process specific pda file
	FSCopy ..\..\..\..\..\PDA_Patterns\PDA\AB_PDA_PCU.pu		..\..\..\ieccontrol\PCU1\EngineeringFiles
	FSCopy ..\..\..\..\..\PDA_Patterns\PDA\HW_PDA_PCU1.sv		..\..\..\ieccontrol\PCU1\EngineeringFiles
    //copy first kinematic files
	FSCopy ..\..\..\..\..\PDA_Patterns\PDA\HW_PDA_RCU1.sv		..\..\..\ieccontrol\RCU1\EngineeringFiles
Return

SubRoutine Sub_OptionPDA_v11
	//delete dummy file
	FSDeleteFile ..\..\..\ieccontrol\PCU1\EngineeringFiles\AB_PDA_PCU.pu
	//copy process specific pda file
	FSCopy ..\..\..\..\..\PDA_Patterns\PDA\AB_PDA_PCU.pu		..\..\..\ieccontrol\PCU1\EngineeringFiles
	FSCopy ..\..\..\..\..\PDA_Patterns\PDA\HW_PDA_PCU1.sv		..\..\..\ieccontrol\PCU1\EngineeringFiles
    //copy first kinematic files
	FSCopy ..\..\..\..\..\PDA_Patterns\PDA\HW_PDA_RCU1.sv		..\..\..\ieccontrol\RCU1\EngineeringFiles
	//copy second kinematic files
	FSCopy ..\..\..\..\..\PDA_Patterns\PDA\HW_PDA_RCU2_1.sv		..\..\..\ieccontrol\RCU2\EngineeringFiles
Return

SubRoutine Sub_OptionPDA_v12
	//delete dummy file
	FSDeleteFile ..\..\..\ieccontrol\PCU1\EngineeringFiles\AB_PDA_PCU.pu
	//copy process specific pda file
	FSCopy ..\..\..\..\..\PDA_Patterns\PDA\AB_PDA_PCU.pu		..\..\..\ieccontrol\PCU1\EngineeringFiles
	FSCopy ..\..\..\..\..\PDA_Patterns\PDA\HW_PDA_PCU1.sv		..\..\..\ieccontrol\PCU1\EngineeringFiles
    //copy first kinematic files
	FSCopy ..\..\..\..\..\PDA_Patterns\PDA\HW_PDA_RCU1.sv		..\..\..\ieccontrol\RCU1\EngineeringFiles
	//copy second kinematic files
	FSCopy ..\..\..\..\..\PDA_Patterns\PDA\HW_PDA_RCU2_1.sv		..\..\..\ieccontrol\RCU2\EngineeringFiles
	//copy third kinematic files
	FSCopy ..\..\..\..\..\PDA_Patterns\PDA\HW_PDA_RCU3_1.sv		..\..\..\ieccontrol\RCU3\EngineeringFiles
Return

SubRoutine Sub_OptionPDA_v15
    //copy first kinematic files
	FSCopy ..\..\..\..\..\PDA_Patterns\PDA\HW_PDA_RCU1.sv		..\..\..\ieccontrol\RCU1\EngineeringFiles
Return

SubRoutine Sub_OptionPDA_v16
    //copy first kinematic files
	FSCopy ..\..\..\..\..\PDA_Patterns\PDA\HW_PDA_RCU1.sv		..\..\..\ieccontrol\RCU1\EngineeringFiles
	//copy second kinematic files
	FSCopy ..\..\..\..\..\PDA_Patterns\PDA\HW_PDA_RCU2_2.sv		..\..\..\ieccontrol\RCU2\EngineeringFiles
Return

SubRoutine Sub_OptionPDA_v17
    //copy first kinematic files
	FSCopy ..\..\..\..\..\PDA_Patterns\PDA\HW_PDA_RCU1.sv		..\..\..\ieccontrol\RCU1\EngineeringFiles
	//copy second kinematic files
	FSCopy ..\..\..\..\..\PDA_Patterns\PDA\HW_PDA_RCU2_2.sv		..\..\..\ieccontrol\RCU2\EngineeringFiles
	//copy third kinematic files
	FSCopy ..\..\..\..\..\PDA_Patterns\PDA\HW_PDA_RCU3_2.sv		..\..\..\ieccontrol\RCU3\EngineeringFiles
Return
