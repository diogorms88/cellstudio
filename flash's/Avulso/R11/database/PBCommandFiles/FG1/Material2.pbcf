//  Version     | ReleaseDate | Respon  | Changes
//  -----------------------------------------------------------------------------------------------
//  v2_01.00.00 | 2022-04-12  | KLCH    | First release [ECORPC-1148]

Imports Common

Parameter Option1

Call Main_Material2
// Select tab VariantConfiguration again
SelectNode RPC1.R11
SelectTab [VariantConfiguration]
END

SubRoutine Main_Material2
	SelectCase Option1
		Case EcoDose_SM
		Case EcoDose_SM_SM
			Call Material2_ChannelsAndDevices_SM
			Call Material2_ConfigureLogChannels
			Call Material2_ConfigureResetChannelStates
			Call Material2_ConfigureTriggerBrush_SM
		Case EcoDose_SM_PCL
			Call Material2_ChannelsAndDevices_PCL
			Call Material2_ConfigureLogChannels
			Call Material2_ConfigureResetChannelStates
			Call Material2_ConfigureTriggerBrush_PCL
		Case EcoDose_PCL
		Case EcoDose_PCL_PCL
			Call Material2_ChannelsAndDevices_PCL
			Call Material2_ConfigureLogChannels
			Call Material2_ConfigureResetChannelStates
			Call Material2_ConfigureTriggerBrush_PCL
		CaseElse
			Message Process type not supported (Option1)! (Main_Material2)
	EndSelect
Return

SubRoutine Material2_ConfigureLogChannels
	//Add physical channels to logical main channel
	//*********** Add physical Material2*****************
	SelectNode RPC1.R11.PCU1
	SelectTab [LogicChannelsSupplyGroups]
	SelectLogChannel PCU1.LogMainChannel
	LogChannelAddPhysChannel Material2
	//Parameter 1: Channelgroup or Channelgroup.Channel
	LogChannelPropertyLogMainChannel 0
	LogChannelPropertyOverallStateRelevant 1
	//Add logical channels
	//*********** Logic Material2***************
	SelectNode RPC1.R11.PCU1
	SelectTab [LogicChannelsSupplyGroups]
	SelectLogChannel PCU1
	AddLogChannel LogMaterial2
	LogChannelDescription Logical channel for material 2
	LogChannelPropertyPaintRelevant 0
	LogChannelPropertyMixedMaterial 0
	//*********** Add physical Material2************************
	SelectLogChannel PCU1.LogMaterial2
	LogChannelAddPhysChannel Material2
	//Parameter 1: Channelgroup or Channelgroup.Channel
	LogChannelPropertyLogMainChannel 0
	LogChannelPropertyOverallStateRelevant 1
Return

SubRoutine Material2_ConfigureResetChannelStates
	SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].Material2
	SelectTab [ResetChannelStates]
	ResetChannelState 2r 73a 1
	ResetChannelState 2r 73r 1
Return

SubRoutine Material2_ChannelsAndDevices_SM
	//******** Add Material2************
	Call Common_AddChannel_Material2
	SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].Material2
	Call Common_AddDevice_BShotMeter2
	SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].Material2.BShotMeter2
	SelectTab [CfgParameter]
	SelectCfg BShotMeter2.HoseCompensation
	OptionalUsed 1
	SelectCfg BShotMeter2.HoseCompensation.EnableHoseComp
	Value 0
	SelectCfg BShotMeter2.TimeOff
	Value 0d0h0m0s70ms
	SelectCfg BShotMeter2.TimeOn
	Value 0d0h0m0s160ms
	SelectCfg BShotMeter2.PressureSensorName
	Value "AP2P"
	SelectCfg BShotMeter2.FillingVolumeTol
	OptionalUsed 1
	SelectCfg BShotMeter2.FillingVolumeInPerc
	OptionalUsed 1
	SelectCfg BShotMeter2.ActualPressure
	OptionalUsed 1
	SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].Material2
	Call Common_AddDevice_AMatManager2
	SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].Material2.AMatManager2
	SelectTab [CfgParameter]
	SelectCfg AMatManager2.Characteristics
	OptionalUsed 1
	SelectCfg AMatManager2.Characteristics.CheckIncreasing
	OptionalUsed 1
	SelectCfg AMatManager2.Characteristics.ExponentialCalib
	OptionalUsed 1
	SelectCfg AMatManager2.DeviceNames.PressureSensor
	OptionalUsed 1
	Value "AP2P"
	SelectCfg AMatManager2.DeviceNames.TemperatureSensor
	OptionalUsed 1
	Value "AP2T"
	SelectCfg AMatManager2.DeviceNames.SetPressureCtrlDevice
	OptionalUsed 1
	Value "ShotMeter2.SetPressure"
	SelectCfg AMatManager2.DeviceNames.SetFlowCtrlDevice
	OptionalUsed 1
	Value "ShotMeter2.SetQuantity"
	SelectCfg AMatManager2.Adaption
	OptionalUsed 1
Return

SubRoutine Material2_ChannelsAndDevices_PCL
	//******** Add Material2************
	Call Common_AddChannel_Material2
	SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].Material2
Return

SubRoutine Material2_ConfigureTriggerBrush_SM
	SelectNode RPC1.R11.PCU1
	SelectTab [BrushTrigger]
	// ************Set paint relevant devices for SM*************
//	SelectTab [BrushTriggerSetValuesPaintRelDevices]
	// ************Set trigger devices for SM*************
	SelectTab [BrushTriggerSetValuesBrushGunTrigger]
	// Set analog signals for paint relevant devices
	NotResetBrushAtEnd BShotMeter2.InitialPressure 0
	BrushSource BShotMeter2.InitialPressure InitialPressure1
	IdleBrush1Enable BShotMeter2.InitialPressure 1
	IdleBrush1Value BShotMeter2.InitialPressure 20
	IdleBrush2Enable BShotMeter2.InitialPressure 1
	IdleBrush2Value BShotMeter2.InitialPressure 20
	OverrideEnable BShotMeter2.InitialPressure 0
	NotResetBrushAtEnd BShotMeter2.OffsetInitialPressure 0
	BrushSource BShotMeter2.OffsetInitialPressure OffsetInitialPressure1
	IdleBrush1Enable BShotMeter2.OffsetInitialPressure 0
	IdleBrush1Value BShotMeter2.OffsetInitialPressure 0
	IdleBrush2Enable BShotMeter2.OffsetInitialPressure 0
	IdleBrush2Value BShotMeter2.OffsetInitialPressure 0
	OverrideEnable BShotMeter2.OffsetInitialPressure 0
	NotResetBrushAtEnd BShotMeter2.SetQuantity 0
	BrushSource BShotMeter2.SetQuantity PaintFlow1
	IdleBrush1Enable BShotMeter2.SetQuantity 0
	IdleBrush1Value BShotMeter2.SetQuantity 0
	IdleBrush2Enable BShotMeter2.SetQuantity 0
	IdleBrush2Value BShotMeter2.SetQuantity 0
	OverrideEnable BShotMeter2.SetQuantity 1
	NotResetBrushAtEnd BShotMeter2.SetPressure 0
	BrushSource BShotMeter2.SetPressure PaintPressure1
	IdleBrush1Enable BShotMeter2.SetPressure 0
	IdleBrush1Value BShotMeter2.SetPressure 0
	IdleBrush2Enable BShotMeter2.SetPressure 0
	IdleBrush2Value BShotMeter2.SetPressure 0
	OverrideEnable BShotMeter2.SetPressure 1
	NotResetBrushAtEnd BShotMeter2.ShotmeterControltype 0
	BrushSource BShotMeter2.ShotmeterControltype ControlType1
	IdleBrush1Enable BShotMeter2.ShotmeterControltype 0
	IdleBrush1Value BShotMeter2.ShotmeterControltype 0
	IdleBrush2Enable BShotMeter2.ShotmeterControltype 0
	IdleBrush2Value BShotMeter2.ShotmeterControltype 0
	OverrideEnable BShotMeter2.ShotmeterControltype 0
	NotResetBrushAtEnd BShotMeter2.TimeOff 0
	BrushSource BShotMeter2.TimeOff DelayStop1
	IdleBrush1Enable BShotMeter2.TimeOff 0
	IdleBrush1Value BShotMeter2.TimeOff 0
	IdleBrush2Enable BShotMeter2.TimeOff 0
	IdleBrush2Value BShotMeter2.TimeOff 0
	OverrideEnable BShotMeter2.TimeOff 0
	NotResetBrushAtEnd BShotMeter2.TimeOn 0
	BrushSource BShotMeter2.TimeOn DelayStart1
	IdleBrush1Enable BShotMeter2.TimeOn 0
	IdleBrush1Value BShotMeter2.TimeOn 0
	IdleBrush2Enable BShotMeter2.TimeOn 0
	IdleBrush2Value BShotMeter2.TimeOn 0
	OverrideEnable BShotMeter2.TimeOn 0
Return

SubRoutine Material2_ConfigureTriggerBrush_PCL
	SelectNode RPC1.R11.PCU1
	SelectTab [BrushTrigger]
	// ************Set paint relevant devices for PCL*************
//	SelectTab [BrushTriggerSetValuesPaintRelDevices]
	// Set boolean signals for paint relevant devices
	// ************Set trigger devices for PCL*************
	SelectTab [BrushTriggerSetValuesBrushGunTrigger]
Return
