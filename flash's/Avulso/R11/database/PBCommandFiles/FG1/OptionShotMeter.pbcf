SubRoutine OptionShotMeter_ConfigureDevices
	SelectCase Option1 // Process type
		Case EcoDose_SM
			Call OptionShotMeter_ConfigureDevice_BDP92PA
		Case EcoDose_SM_PCL
			Call OptionShotMeter_ConfigureDevice_BDP92PA
		Case EcoDose_SM_SM
			Call OptionShotMeter_ConfigureDevice_BDP92PA_1
			Call OptionShotMeter_ConfigureDevice_BDP92PA_2
		CaseElse
			Message Process type [Option1] not supported !! (OptionShotMeter_ConfigureDevices)
	EndSelect
Return

SubRoutine OptionShotMeter_ConfigureDevice_BDP92PA
	IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].ShotMeter1Sub_.a.BDP92PAa
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].ShotMeter1Sub_.a.BDP92PAa
		SelectCase OptionShotMeter
			Case SM_113ccm
				SelectTab [CfgParameter]
				SelectCfg BDP92PA.ActualPressure.MonitorStatic.UpperAlarmRange
				Value 260
				SelectCfg BDP92PA.ActualPressure.MonitorStatic.UpperWarningRange
				Value 240
			Case SM_590ccm
				SelectTab [CfgParameter]
				SelectCfg BDP92PA.ActualPressure.MonitorStatic.UpperAlarmRange
				Value 260
				SelectCfg BDP92PA.ActualPressure.MonitorStatic.UpperWarningRange
				Value 240
			Case SM_300ccm
				SelectTab [CfgParameter]
				SelectCfg BDP92PA.ActualPressure.MonitorStatic.UpperAlarmRange
				Value 250
				SelectCfg BDP92PA.ActualPressure.MonitorStatic.UpperWarningRange
				Value 220
			Case SM_600ccm
				SelectTab [CfgParameter]
				SelectCfg BDP92PA.ActualPressure.MonitorStatic.UpperAlarmRange
				Value 250
				SelectCfg BDP92PA.ActualPressure.MonitorStatic.UpperWarningRange
				Value 220
			CaseElse
				Message ShotMeter type not supported !! (OptionShotMeter_ConfigureDevice_BDP92PA; a)
		EndSelect
	Endif
	
	IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].ShotMeter1Sub_.b.BDP92PAb
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].ShotMeter1Sub_.b.BDP92PAb
		SelectCase OptionShotMeter
			Case SM_113ccm
				SelectTab [CfgParameter]
				SelectCfg BDP92PA.ActualPressure.MonitorStatic.UpperAlarmRange
				Value 260
				SelectCfg BDP92PA.ActualPressure.MonitorStatic.UpperWarningRange
				Value 240
			Case SM_590ccm
				SelectTab [CfgParameter]
				SelectCfg BDP92PA.ActualPressure.MonitorStatic.UpperAlarmRange
				Value 260
				SelectCfg BDP92PA.ActualPressure.MonitorStatic.UpperWarningRange
				Value 240
			Case SM_300ccm
				SelectTab [CfgParameter]
				SelectCfg BDP92PA.ActualPressure.MonitorStatic.UpperAlarmRange
				Value 250
				SelectCfg BDP92PA.ActualPressure.MonitorStatic.UpperWarningRange
				Value 220
			Case SM_600ccm
				SelectTab [CfgParameter]
				SelectCfg BDP92PA.ActualPressure.MonitorStatic.UpperAlarmRange
				Value 250
				SelectCfg BDP92PA.ActualPressure.MonitorStatic.UpperWarningRange
				Value 220
			CaseElse
				Message ShotMeter type not supported !! (OptionShotMeter_ConfigureDevice_BDP92PA; b)
		EndSelect
	Endif
Return

