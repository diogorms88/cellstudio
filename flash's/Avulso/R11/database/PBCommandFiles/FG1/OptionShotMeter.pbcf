SubRoutine OptionShotMeter_ConfigurePressureRegulation
	SelectCase Option20 // Shot meter single
		Case 0
			SelectCase OptionShotMeter
				Case SM_113ccm
					// Enable Inside Pressure Regulation
					SelectNode RPC1.R11.PCU1.[DeviceFamilies].Piston.Piston Sealing 100 ccm / PISTON_SEAL_100ccm
					SelectCfg Piston Sealing 100 ccm / PISTON_SEAL_100ccm.SetPressureControl.GainPressureRegInside
					OptionalUsed 1
				Case SM_590ccm
					// Enable Inside Pressure Regulation
					SelectNode RPC1.R11.PCU1.[DeviceFamilies].Piston.Piston Sealing 585 ccm / PISTON_SEAL_585ccm
					SelectCfg Piston Sealing 585 ccm / PISTON_SEAL_585ccm.SetPressureControl.GainPressureRegInside
					OptionalUsed 1
				Case SM_300ccm
					// Enable Inside Pressure Regulation
					SelectNode RPC1.R11.PCU1.[DeviceFamilies].Piston.Piston Sealing 300 ccm / PISTON_SEAL_300ccm
					SelectCfg Piston Sealing 300 ccm / PISTON_SEAL_300ccm.SetPressureControl.GainPressureRegInside
					OptionalUsed 1
				Case SM_600ccm
					// Enable Inside Pressure Regulation
					SelectNode RPC1.R11.PCU1.[DeviceFamilies].Piston.Piston Sealing 600 ccm / PISTON_SEAL_600ccm
					SelectCfg Piston Sealing 600 ccm / PISTON_SEAL_600ccm.SetPressureControl.GainPressureRegInside
					OptionalUsed 1
				CaseElse
					Message ShotMeter type not supported !! (ShotMeter_ConfigurePressureRegulation)
			EndSelect
		Case 1
			SelectCase OptionShotMeter
				Case SM_113ccm
					// Disable Inside Pressure Regulation
					SelectNode RPC1.R11.PCU1.[DeviceFamilies].Piston.Piston Sealing 100 ccm / PISTON_SEAL_100ccm
					SelectCfg Piston Sealing 100 ccm / PISTON_SEAL_100ccm.SetPressureControl.GainPressureRegInside
					OptionalUsed 0
				Case SM_590ccm
					// Disable Inside Pressure Regulation
					SelectNode RPC1.R11.PCU1.[DeviceFamilies].Piston.Piston Sealing 585 ccm / PISTON_SEAL_585ccm
					SelectCfg Piston Sealing 585 ccm / PISTON_SEAL_585ccm.SetPressureControl.GainPressureRegInside
					OptionalUsed 0
				Case SM_300ccm
					// Disable Inside Pressure Regulation
					SelectNode RPC1.R11.PCU1.[DeviceFamilies].Piston.Piston Sealing 300 ccm / PISTON_SEAL_300ccm
					SelectCfg Piston Sealing 300 ccm / PISTON_SEAL_300ccm.SetPressureControl.GainPressureRegInside
					OptionalUsed 0
				Case SM_600ccm
					// Disable Inside Pressure Regulation
					SelectNode RPC1.R11.PCU1.[DeviceFamilies].Piston.Piston Sealing 600 ccm / PISTON_SEAL_600ccm
					SelectCfg Piston Sealing 600 ccm / PISTON_SEAL_600ccm.SetPressureControl.GainPressureRegInside
					OptionalUsed 0
				CaseElse
					Message ShotMeter type not supported !! (OptionShotMeter_ConfigurePressureRegulation)
			EndSelect
	EndSelect
Return
