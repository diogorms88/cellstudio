//  Version     | ReleaseDate | Respon  | Changes
//  -----------------------------------------------------------------------------------------------
//  V2_01.00.00 | 2016-11-21  | KLCH    | First release
//  V2_01.01.00 | 2017-08-25  | KLCH    | Change: adaptions for mfb.cfg
//  V2_01.02.00 | 2017-11-17  | KLCH    | Change: generate time programs (copy operation not needed)
//  V2_01.03.00 | 2019-01-31  | KLCH    | Change: adjustments due to structural changes (EA2.0)
//  V2_01.04.00 | 2021-09-10  | KLCH    | Change: remove device tags (BMK) in configuration values
//  V2_01.05.00 | 2024-07-11  | KLCH    | Change: [ECORPC-1837] new option 31 to enable initiator of EcoShot Meter (end position)

Imports Common Option20

Parameter Option1 Option20 OptionShotMeter

// Check [Option20] because of direct dependency
Call Main_Option20
Call OptionShotMeter_ConfigureDevices
// Select tab VariantConfiguration again
SelectNode RPC1.R11
SelectTab [VariantConfiguration]
END

SubRoutine Main_OptionShotMeter
	SelectCase Option1 // Process type
		Case EcoDose_SM EcoDose_SM_PCL
			Call OptionShotMeter_ShotMeter1
		Case EcoDose_SM_SM
			Call OptionShotMeter_ShotMeter1_Multi
			Call OptionShotMeter_ShotMeter2_Multi
		CaseElse
			Message Process type [Option1] not supported !! (Main_OptionShotMeter)
	EndSelect
	
	Call OptionShotMeter_ConfigurePressureRegulation
Return

SubRoutine OptionShotMeter_ShotMeter1
	IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].ShotMeter1Sub_.a
		IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].ShotMeter1Sub_.a.MDP92a
			SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].ShotMeter1Sub_.a.MDP92a
			Delete
		Endif
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].ShotMeter1Sub_
		SelectCase OptionShotMeter
			Case SM_113ccm
				Call Common_AddDevice_MDP92_100ccm
				SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].ShotMeter1Sub_.a.MDP92a
				SelectTab [CfgParameter]
				SelectCfg MDP92.EStop
				OptionalUsed 1
				Value ESTOP92a"
				SelectCfg MDP92.PressureSensorName
				Value DP92PAa"
				
				FSCopy ..\SpecialOptions\Material\1\SM\113ccm\mfb.cfg ..\..\..\..\..\application\control\config
			Case SM_590ccm
				Call Common_AddDevice_MDP92_585ccm
				SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].ShotMeter1Sub_.a.MDP92a
				SelectTab [CfgParameter]
				SelectCfg MDP92.EStop
				OptionalUsed 1
				Value ESTOP92a
				SelectCfg MDP92.PressureSensorName
				Value DP92PAa
				
				FSCopy ..\SpecialOptions\Material\1\SM\590ccm\mfb.cfg ..\..\..\..\..\application\control\config
			Case SM_300ccm
				Call Common_AddDevice_MDP92_300ccm
				SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].ShotMeter1Sub_.a.MDP92a
				SelectTab [CfgParameter]
				SelectCfg MDP92.EStop
				OptionalUsed 1
				Value -
				OptionalUsed 0
				SelectCfg MDP92.PressureSensorName
				Value DP92PAa
				
				FSCopy ..\SpecialOptions\Material\1\SM\300ccm\mfb.cfg ..\..\..\..\..\application\control\config
			Case SM_600ccm
				Call Common_AddDevice_MDP92_600ccm
				SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].ShotMeter1Sub_.a.MDP92a
				SelectTab [CfgParameter]
				SelectCfg MDP92.EStop
				OptionalUsed 1
				Value -
				OptionalUsed 0
				SelectCfg MDP92.PressureSensorName
				Value DP92PAa
				
				FSCopy ..\SpecialOptions\Material\1\SM\600ccm\mfb.cfg ..\..\..\..\..\application\control\config
			CaseElse
				Message ShotMeter type not supported !! (OptionShotMeter_ShotMeter1; SM1a)
		EndSelect
		
		SelectCase Option20 // Shot meter single
			Case 0
				IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].ShotMeter1Sub_.b
					SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].ShotMeter1Sub_.b.MDP92b
					VisuInterface 1 2
					SelectCase OptionShotMeter
						Case SM_113ccm
							SelectTab [CfgParameter]
							SelectCfg MDP92.EStop
							OptionalUsed 1
							Value ESTOP92b
							SelectCfg MDP92.PressureSensorName
							Value DP92PAb
						Case SM_590ccm
							SelectTab [CfgParameter]
							SelectCfg MDP92.EStop
							OptionalUsed 1
							Value ESTOP92b
							SelectCfg MDP92.PressureSensorName
							Value DP92PAb
						Case SM_300ccm
							SelectTab [CfgParameter]
							SelectCfg MDP92.EStop
							OptionalUsed 1
							Value -
							OptionalUsed 0
							SelectCfg MDP92.PressureSensorName
							Value DP92PAb
						Case SM_600ccm
							SelectTab [CfgParameter]
							SelectCfg MDP92.EStop
							OptionalUsed 1
							Value -
							OptionalUsed 0
							SelectCfg MDP92.PressureSensorName
							Value DP92PAb
						CaseElse
							Message ShotMeter type not supported !! (OptionShotMeter_ShotMeter1; SM1b)
					EndSelect
				Else
					Message Script error - check script for [Option20] !! (OptionShotMeter_ShotMeter1; SM1b)
				Endif
		EndSelect
	Else
		Message Script error - check script for [Option20] !! (OptionShotMeter_ShotMeter1; SM1a)
	Endif
Return

SubRoutine OptionShotMeter_ShotMeter1_Multi
	IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].ShotMeter1Sub_.a
		IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].ShotMeter1Sub_.a.MDP92_1a
			SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].ShotMeter1Sub_.a.MDP92_1a
