		EndSelect
		
		SelectCase Option20 // Shot meter single
			Case 0
				IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].ShotMeter1Sub_.b
					SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].ShotMeter1Sub_.b.MDP92_1b
					VisuInterface 1 2
					SelectCase OptionShotMeter
						Case SM_113ccm
							SelectTab [CfgParameter]
							SelectCfg MDP92_1.EStop
							OptionalUsed 1
							Value ESTOP92_1b
							SelectCfg MDP92_1.PressureSensorName
							Value DP92PA_1b
						Case SM_590ccm
							SelectTab [CfgParameter]
							SelectCfg MDP92_1.EStop
							OptionalUsed 1
							Value ESTOP92_1b
							SelectCfg MDP92_1.PressureSensorName
							Value DP92PA_1b
						Case SM_300ccm
							SelectTab [CfgParameter]
							SelectCfg MDP92_1.EStop
							OptionalUsed 1
							Value -
							OptionalUsed 0
							SelectCfg MDP92_1.PressureSensorName
							Value DP92PA_1b
						Case SM_600ccm
							SelectTab [CfgParameter]
							SelectCfg MDP92_1.EStop
							OptionalUsed 1
							Value -
							OptionalUsed 0
							SelectCfg MDP92_1.PressureSensorName
							Value DP92PA_1b
						CaseElse
							Message ShotMeter type not supported !! (OptionShotMeter_ShotMeter1_Multi; SM1b)
					EndSelect
				Else
					Message Script error - check script for [Option20] !! (OptionShotMeter_ShotMeter1_Multi; SM1b)
				Endif
		EndSelect
	Else
