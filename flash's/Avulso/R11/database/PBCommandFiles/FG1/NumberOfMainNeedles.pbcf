						SelectTab [BrushTrigger]
						SelectTab [BrushTriggerSetValuesBrushGunTrigger]
						SetTriggerGun2 AMH1_51_2.SetNewTemp 1
					Endif
					IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].MainChannel.AMH1_7
						SelectNode RPC1.R11.PCU1
						SelectTab [BrushTrigger]
						SelectTab [BrushTriggerSetValuesBrushGunTrigger]
						SetTriggerGun1 AMH1_7.SetNewTemp 1
						SetTriggerGun2 AMH1_7.SetNewTemp 0
					Endif
			EndSelect
		Case 3
			SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].Material1.BShotMeter1
			// Select tab cfg parameter
			SelectTab [CfgParameter]
			SelectCfg BShotMeter1.ActiveWithGuns
			Value 3
			SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].Material2.BShotMeter2
			// Select tab cfg parameter
			SelectTab [CfgParameter]
			SelectCfg BShotMeter2.ActiveWithGuns
			Value 4
			SelectNode RPC1.R11.PCU1
			SelectTab [BrushTriggerConfiguration]
			NoOfGuns 3
			SelectTab [BrushTriggerSetValuesBrushGunTrigger]
			NotResetTriggerAtEnd YHN1.Set 0
			SetInverseTrigger YHN1.Set 0
			SetTriggerGun1 YHN1.Set 1
			NotResetTriggerAtEnd YHN2.Set 0
			SetInverseTrigger YHN2.Set 0
			SetTriggerGun2 YHN2.Set 1
			NotResetTriggerAtEnd YHN3.Set 0
			SetInverseTrigger YHN3.Set 0
			SetTriggerGun3 YHN3.Set 1
			SetTriggerGun1 BShotMeter1.OrderMove 1
			SetTriggerGun2 BShotMeter1.OrderMove 1
			SetTriggerGun2 BShotMeter2.OrderMove 0
			SetTriggerGun3 BShotMeter2.OrderMove 1
			IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].Material1.AMatManager1
				SelectNode RPC1.R11.PCU1
				SelectTab [BrushTrigger]
				SelectTab [BrushTriggerSetValuesBrushGunTrigger]
				SetTriggerGun1 AMatManager1.OrderSet 1
				SetTriggerGun2 AMatManager1.OrderSet 1
			Endif
			IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].Material2.AMatManager2
				SelectNode RPC1.R11.PCU1
				SelectTab [BrushTrigger]
				SelectTab [BrushTriggerSetValuesBrushGunTrigger]
				SetTriggerGun2 AMatManager2.OrderSet 0
				SetTriggerGun3 AMatManager2.OrderSet 1
			Endif
			SelectCase Option14 // Variant of bus system
				Case Profibus
					IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].Material1.AMH1_12_1
						SelectNode RPC1.R11.PCU1
						SelectTab [BrushTrigger]
						SelectTab [BrushTriggerSetValuesBrushGunTrigger]
						SetTriggerGun1 AMH1_12_1.SetNewTemp 1
						SetTriggerGun2 AMH1_12_1.SetNewTemp 1
					Endif
					IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].Material2.AMH1_12_2
						SelectNode RPC1.R11.PCU1
						SelectTab [BrushTrigger]
						SelectTab [BrushTriggerSetValuesBrushGunTrigger]
						SetTriggerGun3 AMH1_12_2.SetNewTemp 1
						SetTriggerGun2 AMH1_12_2.SetNewTemp 0
					Endif
					IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].Material1.AMH1_51_1
						SelectNode RPC1.R11.PCU1
						SelectTab [BrushTrigger]
						SelectTab [BrushTriggerSetValuesBrushGunTrigger]
						SetTriggerGun1 AMH1_51_1.SetNewTemp 1
						SetTriggerGun2 AMH1_51_1.SetNewTemp 1
					Endif
					IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].Material2.AMH1_51_2
						SelectNode RPC1.R11.PCU1
						SelectTab [BrushTrigger]
						SelectTab [BrushTriggerSetValuesBrushGunTrigger]
						SetTriggerGun3 AMH1_51_2.SetNewTemp 1
						SetTriggerGun2 AMH1_51_2.SetNewTemp 0
					Endif
					IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].MainChannel.AMH1_7
						SelectNode RPC1.R11.PCU1
						SelectTab [BrushTrigger]
						SelectTab [BrushTriggerSetValuesBrushGunTrigger]
						SetTriggerGun1 AMH1_7.SetNewTemp 1
						SetTriggerGun2 AMH1_7.SetNewTemp 1
					Endif
			EndSelect
		CaseElse
			Message Wrong number of MainNeedles !! (ConfigureTriggers2Materials_SM)
	EndSelect
Return