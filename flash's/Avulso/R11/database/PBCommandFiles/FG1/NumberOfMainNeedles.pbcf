				SetTriggerGun2 AMatManager1.OrderSet 0
			Endif
			IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].Material2.AMatManager2
				SelectNode RPC1.R11.PCU1
				SelectTab [BrushTrigger]
				SelectTab [BrushTriggerSetValuesBrushGunTrigger]
				SetTriggerGun1 AMatManager2.OrderSet 0
				SetTriggerGun2 AMatManager2.OrderSet 1
			Endif
			SelectCase Option14 // Variant of bus system
				Case Profibus
					IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].Material1.AMH1_12_1
						SelectNode RPC1.R11.PCU1
						SelectTab [BrushTrigger]
						SelectTab [BrushTriggerSetValuesBrushGunTrigger]
