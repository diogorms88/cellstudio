//  Version      | ReleaseDate | Respon | Changes
//  -------------------------------------------------------------------------------------
//  v2_01.00.00  | 2013-09-30  | STL    | First release
//  v2_01.01.00  | 2014-01-28  | SMOH   | Combine LASD Options 27 and 18 + Option14(BMV1T)--> Option27 + Busmaster--> Option14
//  v2_01.02.00  | 2014-04-14  | KLCH   | Change: remove cfg parameter CheckDevice
//  v2_01.03.00  | 2014-04-28  | KLCH   | Bugfix: correction of Option14 (export for HMI not ok)
//  v2_01.04.00  | 2014-09-12  | KLCH   | Change: redesign; move SubRoutines to CommonTempControl
//  v2_01.05.00  | 2016-11-21  | KLCH   | Change: redesign; check Option1 + further options instead of Option2
//  v2_01.06.00  | 2017-09-28  | KLCH   | AddOn:  all required parameters
//  v2_01.07.00  | 2021-09-10  | KLCH   | Change: remove device tags (BMK) in configuration values

Imports Common CommonTempControl

Parameter Option1 Option2 Option3 Option4 Option5 Option12 Option14 Option15 Option18 Option20 Option21 Option26 Option27 EcoTempAxis1 EcoTempAxis3 TempHeatZone1 TempHeatZone2 TempHeatZone3 TempHeatZone4 TempHeatZone5 TempHeatZone6 TempHeatZone7 TempHeatZone8 TempHeatZone9 NumberOfMainNeedles

Call CommonTempCtrl_MatHeater
Call Main_TempHeatZone7
// Select tab VariantConfiguration again
SelectNode RPC1.R11
SelectTab [VariantConfiguration]
END

SubRoutine Main_TempHeatZone7
	SelectNode RPC1.R11
	SelectCase Option1 // Process type
		Case EcoDose_PCL
			Call AddDeviceToMaterial1_TempHeatZone7
		Case EcoDose_SM
			Call AddDeviceToMaterial1_TempHeatZone7
		Case EcoDose_PM
			Call AddDeviceToMaterial1_TempHeatZone7
		Case EcoDose_ES
			Call AddDeviceToMaterial1_TempHeatZone7
		Case EcoDose_PCL_PCL
			Call AddDeviceToMaterial1_2Single_TempHeatZone7
		Case EcoDose_SM_PCL
			Call AddDeviceToMaterial1_2Single_TempHeatZone7
		Case EcoDose_SM_SM
			Call AddDeviceToMaterial1_2Single_TempHeatZone7
		CaseElse
			Message Wrong process type (TempHeatZone7)!!
	EndSelect
Return

SubRoutine AddDeviceToMaterial1_TempHeatZone7
	IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].MainChannel.AMH1_7
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].MainChannel.AMH1_7
		Delete
	Endif
	SelectCase TempHeatZone7
		Case 1
			SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].MainChannel
			Call Common_AddDevice_AMH1_7
			
			// Cfg parameter
			SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].MainChannel.AMH1_7
			// Select tab cfg parameter
			SelectTab [CfgParameter]
			SelectCase Option14 // Variant of bus system
				Case SercosIII
					SelectCfg AMH1_7.ControlMode
					Value 1
					SelectCfg AMH1_7.DeviceTemperature.ControlParam.P03_DevAlarm
					Value 100
					SelectCfg AMH1_7.DeviceTemperature.ControlParam.P06_Tv_Heating
					Value 5
					SelectCfg AMH1_7.DeviceTemperature.ControlParam.P22_Offset_Act
					Value 999
					SelectCfg AMH1_7.DeviceTemperature.ControlParam.TemperatureMax
					Value 43
					SelectCfg AMH1_7.DeviceTemperature.ControlParam.TemperatureMin
					Value 30
					SelectCfg AMH1_7.DeviceTemperature.ControlParam.Zone
					Value 7
					SelectCfg AMH1_7.SetTemperature
					Value 32
				Case Profibus
					SelectCfg AMH1_7.CtrlLevel
					Value 1
					SelectCfg AMH1_7.03_DevAlarm
					Value 100
					SelectCfg AMH1_7.06_Tv_Control
					Value 5
					SelectCfg AMH1_7.22_Offset_Act
					Value 99
					SelectCfg AMH1_7.CtrlTypeSetbackTemp
					OptionalUsed 1
					Value 1
					SelectCfg AMH1_7.MediumTempCtrl.ReactionLevelCtrl
					Value 1
					IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].Material1.BMV2F
						SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].MainChannel.AMH1_7
						SelectTab [CfgParameter]
						SelectCfg AMH1_7.NameSignalForFlow
						OptionalUsed 1
						Value "MV2F.ActFlowFiltered"
					Else
						SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].MainChannel.AMH1_7
						SelectTab [CfgParameter]
						SelectCfg AMH1_7.NameSignalForFlow
						OptionalUsed 1
						Value "ShotMeter1.ActQuantity"
					Endif
					SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].MainChannel.AMH1_7
					SelectCfg AMH1_7.SetbackTemp
					OptionalUsed 1
					Value 30
					SelectCfg AMH1_7.SetTemp
					Value 32
					SelectCfg AMH1_7.SetTempMaterial
					OptionalUsed 1
					Value 30
					SelectCfg AMH1_7.SetTempMax
					Value 43
					SelectCfg AMH1_7.SetTempMaxAfterHys
					Value 42
					SelectCfg AMH1_7.SetTempMin
					Value 30
					SelectCfg AMH1_7.SetTempMinAfterHys
					Value 31
					SelectCfg AMH1_7.TemperatureSensorName
					Value "AP1T"
					SelectCfg AMH1_7.TimeSetbackTemp
					OptionalUsed 1
					Value 0d0h30m0s0ms
					SelectCfg AMH1_7.Zone
					Value 7
					// Trigger configuration
					SelectNode RPC1.R11.PCU1
					SelectTab [BrushTrigger]
					SelectTab [BrushTriggerSetValuesBrushGunTrigger]
					SelectCase NumberOfMainNeedles
						Case 1
							SetTriggerGun1 AMH1_7.SetNewTemp 1
						Case 2
							SetTriggerGun1 AMH1_7.SetNewTemp 1
							SetTriggerGun2 AMH1_7.SetNewTemp 1
						Case 3
							SetTriggerGun1 AMH1_7.SetNewTemp 1
							SetTriggerGun2 AMH1_7.SetNewTemp 1
							SetTriggerGun3 AMH1_7.SetNewTemp 1
						CaseElse
							Message Wrong number of MainNeedles (TempHeatZone7)!!
					EndSelect
				CaseElse
					Message Wrong bus master (AMH1_7)!! Only Profibus and Sercos III supported
			EndSelect
			Call CommonTempCtrl_SetConfigMaterial1_AMatManager1
	EndSelect
Return

SubRoutine AddDeviceToMaterial1_2Single_TempHeatZone7
	IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].MainChannel.AMH1_7
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].MainChannel.AMH1_7
		Delete
	Endif
	SelectCase TempHeatZone7
		Case 1
			SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].MainChannel
			Call Common_AddDevice_AMH1_7
			
			// Cfg parameter
			SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].MainChannel.AMH1_7
			// Select tab cfg parameter
			SelectTab [CfgParameter]
			SelectCase Option14 // Variant of bus system
				Case SercosIII
					SelectCfg AMH1_7.ControlMode
					Value 1
					SelectCfg AMH1_7.DeviceTemperature.ControlParam.P03_DevAlarm
					Value 100
					SelectCfg AMH1_7.DeviceTemperature.ControlParam.P06_Tv_Heating
					Value 5	
					SelectCfg AMH1_7.DeviceTemperature.ControlParam.P22_Offset_Act
					Value 999
					SelectCfg AMH1_7.DeviceTemperature.ControlParam.TemperatureMax
					Value 43
					SelectCfg AMH1_7.DeviceTemperature.ControlParam.TemperatureMin
					Value 30
					SelectCfg AMH1_7.DeviceTemperature.ControlParam.Zone
					Value 7
					SelectCfg AMH1_7.SetTemperature
					Value 32
				Case Profibus
					SelectCfg AMH1_7.CtrlLevel
					Value 1
					SelectCfg AMH1_7.03_DevAlarm
					Value 100
					SelectCfg AMH1_7.06_Tv_Control
					Value 5
					SelectCfg AMH1_7.22_Offset_Act
					Value 99
					SelectCfg AMH1_7.CtrlTypeSetbackTemp
					OptionalUsed 1
					Value 1
					SelectCfg AMH1_7.MediumTempCtrl.ReactionLevelCtrl
					Value 1
					IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].Material1.BMV2F_1
						SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].MainChannel.AMH1_7
						SelectTab [CfgParameter]
						SelectCfg AMH1_7.NameSignalForFlow
						OptionalUsed 1
						Value "MV2F_1.ActFlowFiltered"
					Else
						SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].MainChannel.AMH1_7
						SelectTab [CfgParameter]
						SelectCfg AMH1_7.NameSignalForFlow
						OptionalUsed 1
						Value "ShotMeter1.ActQuantity"
					Endif
					SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].MainChannel.AMH1_7
					SelectCfg AMH1_7.SetbackTemp
					OptionalUsed 1
					Value 30
					SelectCfg AMH1_7.SetTemp
					Value 32
					SelectCfg AMH1_7.SetTempMaterial
					OptionalUsed 1
					Value 30
					SelectCfg AMH1_7.SetTempMax
					Value 43
					SelectCfg AMH1_7.SetTempMaxAfterHys
					Value 42
					SelectCfg AMH1_7.SetTempMin
					Value 30
					SelectCfg AMH1_7.SetTempMinAfterHys
					Value 31
					SelectCfg AMH1_7.TemperatureSensorName
					Value "AP1T"
					SelectCfg AMH1_7.TimeSetbackTemp
					OptionalUsed 1
					Value 0d0h30m0s0ms
					SelectCfg AMH1_7.Zone
					Value 7
					// Trigger configuration
					SelectNode RPC1.R11.PCU1
					SelectTab [BrushTrigger]
					SelectTab [BrushTriggerSetValuesBrushGunTrigger]
					SelectCase NumberOfMainNeedles
						Case 2
							SetTriggerGun1 AMH1_7.SetNewTemp 1
							SetTriggerGun2 AMH1_7.SetNewTemp 0
						Case 3
							SetTriggerGun1 AMH1_7.SetNewTemp 1
							SetTriggerGun2 AMH1_7.SetNewTemp 1
							SetTriggerGun3 AMH1_7.SetNewTemp 0
						CaseElse
							Message Wrong number of MainNeedles (TempHeatZone7)!!
					EndSelect
				CaseElse
					Message Wrong bus master (AMH1_7)!! Only Profibus and Sercos III supported
			EndSelect
			Call CommonTempCtrl_SetConfigMaterial1_AMatManager1
	EndSelect
Return
