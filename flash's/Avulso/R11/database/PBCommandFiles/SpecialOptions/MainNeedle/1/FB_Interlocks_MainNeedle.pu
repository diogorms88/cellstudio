(*
Version     | ReleaseDate | Respon | Changes
---------------------------------------------------------------------------------------------------
V2_01.00.00 | 2016-10-18  | STL    | First release
v2_02.00.00 | 08.07.2021  | PE3    | Change: Automatic code change (rename device instances)
*)

IMPORT_OVER_LISTFILE
 F_Version_String
, cCatRootVersion
, cCatPathVersion
, cDevicesForTrigger
, cMaxGunsForTrigger
, cNumberOfNeedles
, nInterlocksOut
, cFB_Interlocks_Misc
, cFB_Interlocks_MainNeedleNoRel
, tyGunTriggers
, tyDevicesForTrigger
, tsStationPLCDataPCU
, AB_Needle_T001
, tsPCU
, FB_SetMessagePCU
, FB_ReSetMessage
, tsReleases

END_IMPORT

FUNCTION_BLOCK FB_Interlocks_MainNeedle #DUMMY_EDIT_BLOCK

VAR_IN_OUT
 io_yGunTriggers : tyGunTriggers;
 io_yDevicesForTrigger : tyDevicesForTrigger;
 io_mReleaseNeedles : BOOL;
 io_mReleaseFlowControl : BOOL;
END_VAR

SYSTEM_VAR
 SV_PLC2PCU : tsStationPLCDataPCU;
END_VAR

VAR_EXTERNAL
 abNeedle_HN1 : AB_Needle_T001 (* Needle  *);
 GV_sPCU : tsPCU;
 fbSetMessagePCU : FB_SetMessagePCU;
 fbReSetMessage : FB_ReSetMessage;
 GV_sReleases : tsReleases;
END_VAR

VAR_TEMP
 i : INT;
 j : INT;
 k : INT;
END_VAR

VAR
 mGetGunTriggers : BOOL;
 mHN_Set_InterlocksIn : BOOL;
 iInterlockNeedle : INT;
 iInterlockNeedleOld : INT;
 iInterlockGunNr : INT;
 zTempText : STRING(255);
 zTempTextOld : STRING(255);
 mInitDone : BOOL;
END_VAR

VAR CONSTANT
 zMyName : STRING(24) := 'FB_Interlocks_MainNeedle' (* Block name *);
 zVersion : STRING(15) := 'v2_02.00.00' (* Block version *);
END_VAR
#BEGIN_EDIT_BLOCK
IF NOT mInitDone THEN
  // Set version info to catalog
  mInitDone := F_Version_String(i_zRoot    := cCatRootVersion,
                                i_zPath    := cCatPathVersion,
                                i_zName    := zMyName,
                                i_zVersion := zVersion);
END_IF;

//-------------------------------------------------------------------------------------------------
// Interlocks of needles
//-------------------------------------------------------------------------------------------------

IF NOT mGetGunTriggers THEN
  
  // search for trigger from motion
  FOR i := 1 TO GV_sPCU.Devices.sNeedles.iNumber DO
    FOR j := 1 TO cDevicesForTrigger DO
      IF (io_yDevicesForTrigger[j].mEntriesValid                                        AND
          (GV_sPCU.Devices.sNeedles.y[i].zName = io_yDevicesForTrigger[j].zDeviceName)) THEN
        FOR k := 1 TO cMaxGunsForTrigger DO
          IF io_yDevicesForTrigger[j].ySwitchedByTrigger[k] THEN
            io_yGunTriggers[i] := k;
            EXIT;
          END_IF;
        END_FOR;
        IF (io_yGunTriggers[i] <> 0) THEN
          EXIT;
        END_IF;  
      END_IF;  
    END_FOR;
  END_FOR;
  
  mGetGunTriggers := TRUE;
  
END_IF;

// Check releases and trigger signals only when process is released
IF GV_sReleases.sReleases.External.AtomizerRelease THEN
  
  zTempText              := '';
  iInterlockNeedle       := 0;
  io_mReleaseFlowControl := FALSE;
  mHN_Set_InterlocksIn   := FALSE;
    
  FOR i := 1 TO GV_sPCU.Devices.sNeedles.iNumber DO
    
    iInterlockGunNr := 0;
      
    FOR j := 1 TO cNumberOfNeedles DO
      IF (io_yGunTriggers[j] = i) THEN
        iInterlockGunNr := j;
        EXIT;
      END_IF;
    END_FOR;

    CASE STRING_TO_INT(DELETE(GV_sPCU.Devices.sNeedles.y[i].zName, 
                              LEN(GV_sPCU.Devices.sNeedles.y[i].zName) - 1, 1)) OF
      1: 
          IF abNeedle_HN1.fGetDevSet_Set(nInterlocksOut) THEN
            mHN_Set_InterlocksIn := TRUE;
            iInterlockNeedle := GV_sPCU.Devices.sNeedles.y[i].iDeviceNr;
           // abNeedle_HN2.aSet_HMIRelease(i_mValue := FALSE);
            //abNeedle_HN3.aSet_HMIRelease(i_mValue := FALSE);
          END_IF;
//      2: 
//          IF abNeedle_HN2.fGetDevSet_Set(nInterlocksOut) THEN
//            mHN_Set_InterlocksIn := TRUE;
//            iInterlockNeedle := GV_sPCU.Devices.sNeedles.y[i].iDeviceNr;
//            abNeedle_HN1.aSet_HMIRelease(i_mValue := FALSE);
//            abNeedle_HN3.aSet_HMIRelease(i_mValue := FALSE);
//          END_IF;                             
//      3: 
//          IF abNeedle_HN3.fGetDevSet_Set(nInterlocksOut) THEN
//            mHN_Set_InterlocksIn := TRUE;
//            iInterlockNeedle := GV_sPCU.Devices.sNeedles.y[i].iDeviceNr;
//            abNeedle_HN1.aSet_HMIRelease(i_mValue := FALSE);
//            abNeedle_HN2.aSet_HMIRelease(i_mValue := FALSE); 
//          END_IF;
  
    END_CASE;
          
    IF (NOT SV_PLC2PCU.tReleases.mReleaseGun[i] OR
        NOT io_mReleaseNeedles)                 THEN
      
      IF (iInterlockGunNr <> 0) THEN
        IF (zTempText = '') THEN
          zTempText := GV_sPCU.Devices.sNeedles.y[iInterlockGunNr].zName;
        ELSE
          zTempText := CONCAT(zTempText, ' - ', GV_sPCU.Devices.sNeedles.y[iInterlockGunNr].zName);
        END_IF;
        GV_sPCU.Devices.sNeedles.y[iInterlockGunNr].mInterlock := TRUE;
        mHN_Set_InterlocksIn := FALSE;
      END_IF;
      
    ELSIF mHN_Set_InterlocksIn THEN //GV_sPCU.Devices.sNeedles.y[i].Common.Signals.Set.mValue_Interlocks_In

      // Check if more than one needle are triggered
      IF  (iInterlockNeedle <> iInterlockNeedleOld) AND (iInterlockNeedle <> 0) AND (iInterlockNeedleOld <> 0)THEN
        
        GV_sPCU.Devices.sNeedles.y[iInterlockNeedle].mInterlock    := TRUE;
        GV_sPCU.Devices.sNeedles.y[iInterlockNeedleOld].mInterlock := TRUE;
        
        fbSetMessagePCU(i_iIdent         := cFB_Interlocks_Misc,
                        i_iMsgCount      := 1,
                        i_iDeviceNr      := i,
                        i_zLocation      := zMyName,
                        i_zParam1        := GV_sPCU.Devices.sNeedles.y[iInterlockNeedle].zName,
                        i_zParam2        := GV_sPCU.Devices.sNeedles.y[iInterlockNeedleOld].zName,
                        i_zParam3        := '',
                        i_iChannelNumber := GV_sPCU.Devices.sNeedles.y[i].iChannelNr); 
        RETURN;
                  
      ELSE
        
        GV_sPCU.Devices.sNeedles.y[iInterlockNeedle].mInterlock := FALSE;
        iInterlockNeedleOld := iInterlockNeedle; 

      END_IF;

      io_mReleaseFlowControl := TRUE;
      
    ELSE
      
      GV_sPCU.Devices.sNeedles.y[iInterlockGunNr].mInterlock := FALSE;
      
      iInterlockNeedleOld    := 0;
      io_mReleaseFlowControl := TRUE;
      
    END_IF;
    
  END_FOR;
  
  // Set info when one or more mainneedle(s) not released
  IF ((zTempText <> '')            AND
      (zTempTextOld <> zTempText)) THEN
    fbReSetMessage(i_iIdent        := cFB_Interlocks_MainNeedleNoRel,
                   i_iMsgCount     := 1,
                   i_iDeviceNr     := i,
                   i_zLocation     := zMyName,
                   i_zTimeProgName := '',
                   i_iTimeProgStep := 0,
                   i_zParam1       := zTempText,
                   i_zParam2       := '',
                   i_zParam3       := '');
  END_IF;
  
  zTempTextOld := zTempText;
  
END_IF;


;#END_EDIT_BLOCK END_FUNCTION_BLOCK



#END_OF_IEC_PART

