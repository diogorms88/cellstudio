(*
Version     | ReleaseDate | Respon  | Changes
---------------------------------------------------------------------------------------------------
V2_01.00.00 | 2016-10-18  | STL     | First release
V2_02.00.00 | 2021-07-08  | PE3     | Change: Automatic code change (rename device instances)
V2_02.01.00 | 2022-05-02  | KLCH    | Change: rename air supply

*)

IMPORT_OVER_LISTFILE
 F_Version_String
, cCatRootVersion
, cCatPathVersion
, nReleasesOut
, cInitiator_LV2
, AB_SwitchPLC_T001
, tsPCU
, FB_TON

END_IMPORT

FUNCTION_BLOCK FB_Interlocks_MaterialValve1 #DUMMY_EDIT_BLOCK

VAR_EXTERNAL
 abSwitchPLC_YMV1 : AB_SwitchPLC_T001 (* Switch plc *);
 GV_sPCU : tsPCU;
END_VAR

VAR
 fbWaitTime1 : FB_TON;
 mInitDone : BOOL;
END_VAR

VAR CONSTANT
 zMyName : STRING(28) := 'FB_Interlocks_MaterialValve1' (* Block name *);
 zVersion : STRING(15) := 'V2_02.01.00' (* Block version *);
END_VAR
#BEGIN_EDIT_BLOCK
IF NOT mInitDone THEN
  // Set version info to catalog
  mInitDone := F_Version_String(i_zRoot    := cCatRootVersion,
                                i_zPath    := cCatPathVersion,
                                i_zName    := zMyName,
                                i_zVersion := zVersion);
END_IF;

//-------------------------------------------------------------------------------------------------
// Interlocks of initiators
//-------------------------------------------------------------------------------------------------
fbWaitTime1(IN := abSwitchPLC_YMV1.fGetDevSet_Set(i_nSignalNode := nReleasesOut),
            PT := t#10s);

// Material valve needs a lot of air while switching on
IF (abSwitchPLC_YMV1.fGetDevSet_Set(i_nSignalNode := nReleasesOut) AND
    NOT fbWaitTime1.Q)                                    THEN
  
  GV_sPCU.Devices.sInitiators.y[cInitiator_LV2].mInterlock := TRUE;
  
ELSE
  
  GV_sPCU.Devices.sInitiators.y[cInitiator_LV2].mInterlock := FALSE;
  
END_IF;


;#END_EDIT_BLOCK END_FUNCTION_BLOCK



#END_OF_IEC_PART

