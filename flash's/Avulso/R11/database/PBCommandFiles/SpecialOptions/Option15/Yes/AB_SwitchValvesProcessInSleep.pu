@BEG_Body 
@TL(34)
// Set version info to catalog
mInitError := NOT F_Version_String(i_zRoot    := cCatRootVersion,
                                   i_zPath    := cCatPathVersion,
                                   i_zName    := "AB_SwitchProcessValvesInSleep",
                                   i_zVersion := AG_zVersion);

zRef := CONCAT(GV_sFgParam.zBcuName, '.SV_sPCU2BCU');

Ag_ptSV_sPCU2BCU := GET_REFTO(SVName  := zRef,
                              Timeout := cTimeout_GET_REFTO,
                              Status  := StatusOfGET_REFTO);

mInitError := mInitError OR F_CheckStatusOfGET_REFTO(Status       := StatusOfGET_REFTO,
                                                     i_zIdent     := 'AB_Releases.fInit',
                                                     i_zErrParam1 := zRef,
                                                     i_zErrParam2 := '',
                                                     i_zErrParam3 := '');

IF NOT mInitError THEN
  zRef := CONCAT(GV_sFgParam.zPcuName, '.SLI_mReady4Uncoupling');
  
  Ag_ptSLI_mReady4Uncoupling := GET_REFTO(SVName  := zRef,
                                          Timeout := cTimeout_GET_REFTO,
                                          Status  := StatusOfGET_REFTO);
  
  mInitError := mInitError OR F_CheckStatusOfGET_REFTO(Status       := StatusOfGET_REFTO,
                                                       i_zIdent     := 'AB_Releases.fInit',
                                                       i_zErrParam1 := zRef,
                                                       i_zErrParam2 := '',
                                                       i_zErrParam3 := '');
END_IF;  

fInit := NOT mInitError;

@END_Body 

@@@BEG_Comment@@@ 
@TL(0)

@@@END_Comment@@@ 

@BEG_Body 
@TL(43)
IF SV_sFgAssignment.yFG[GV_sFgParam.iFgNumber].sProcess.mInitDone THEN

  IF Ag_ptSV_sPCU2BCU^.mEmergencyStop   AND                                                             
     SV_PLC2System.tCommon.i_mFireAlarm AND
     (
      (
       (GV_sModesRef^.nRobotMainState = RobT2) AND
       (GV_sModesRef^.nMainState = stSleep)    AND
       GV_sReleases.sReleases.External.AtomizerRelease
      )  OR
      (
       NOT GV_sReleases.sReleases.External.AtomizerRelease AND
       (
        (GV_sModesRef^.nMainState = stAuto)
       )
      )
     ) THEN
    
    // signals for masking device changing system
    GV_sPCU.Devices.sValves.y[cValve_KPL1].T001.Signals.Set.mValue_Releases_Out   := GV_sPCU.Devices.sValves.y[cValve_KPL1].T001.Signals.Set.mValue_Interlocks_Out;
    GV_sPCU.Devices.sValves.y[cValve_ZY1AB1].T001.Signals.Set.mValue_Releases_Out := GV_sPCU.Devices.sValves.y[cValve_ZY1AB1].T001.Signals.Set.mValue_Interlocks_Out;
    GV_sPCU.Devices.sMainValves.y[cMainValve_LV2].T001.Signals.Set.mValue_Releases_Out    := TRUE;
    
  END_IF;
  // check if coupling for masking device changing system can be opened
  IF NOT Ag_ptSLI_mReady4Uncoupling^ THEN
    IF GV_sPCU.Devices.sValves.y[cValve_KPL1].T001.Signals.Set.mValue_Interlocks_In THEN
      
      fbSetMessagePCU(i_iIdent         := cFB_Interlocks_InitiatorNotSet,
                      i_iMsgCount      := 1,
                      i_iDeviceNr      := cValve_KPL1,
                      i_zLocation      := 'AB_SwitchValvesProcessInSleep',
                      i_zParam1        := 'YKPL1',
                      i_zParam2        := 'BSP2',
                      i_zParam3        := '',
                      i_iChannelNumber := GV_sPCU.Devices.sValves.y[cValve_KPL1].iChannelNr);
      
    END_IF;
    GV_sPCU.Devices.sValves.y[cValve_KPL1].T001.Signals.Set.mValue_Releases_Out := FALSE;
  END_IF;
  
END_IF;

@END_Body 

