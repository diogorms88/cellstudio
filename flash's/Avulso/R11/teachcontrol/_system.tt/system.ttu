   ROUTINE CPV_GET_STATE (state : TRcuCpvStates) : BOOL { macro="CPV"|enable="_system.gRcuFocusedRobot.vision.VisionDasNano.bEnabled" };
   ROUTINE CPV_SET_INFO (infoMsg : TRcuCpvInfoMsg) { macro="CPV"|enable="_system.gRcuFocusedRobot.vision.VisionDasNano.bEnabled" };
   ROUTINE SETPROCESSCOMMAND (Command : COMMAND; point : POINT; Trigger : TRIGGERFRAME; OPTIONAL Number : DINT) { macro="PROCESS" };
   ROUTINE SETPROCESSCOMMAND_DIRECT (Command : COMMAND; OPTIONAL Number : DINT) { macro="PROCESS" };
   ROUTINE WAIT_PROCESS_READY () { macro="PROCESS" };
   ROUTINE SET_SEAMTOLERANCE (value : TUserReal) { macro="PROCESS" };
   ROUTINE COLORGROUP_ACTIVE (colorGroup : INT) : BOOL { macro="PROCESS"|enable="_system.gRcuFocusedRobot.bHasProcess" };
   ROUTINE TRACKING (Cmd : TRcuTrackingCmd) { macro="Tracking"|enable="_system.gbIsTrackingStation" };
   ROUTINE SETTRACKINGMODE (mode : TRcuTrackingMode) { macro="Tracking"|enable="_system.gbIsTrackingStation" };
   ROUTINE WAIT_CONVEYOR (Conveyor : TUserReal) { macro="Tracking"|enable="_system.gbIsTrackingStation" };
   ROUTINE CHECK_CONVEYOR (Conveyor : TUserReal) : BOOL { macro="Tracking"|enable="_system.gbIsTrackingStation" };
   ROUTINE CONVEYOR_INCLINE_AT (Conveyor : TUserReal) { macro="Tracking"|enable="_system.gRcuFocusedRobot.tracking.bEnableConveyorTable" };
   ROUTINE TRACKING_USE_Z_OFFSET (Active : BOOL) { macro="Tracking"|enable="_system.gRcuFocusedRobot.RcuInterfaceToBCU.bUseOffsetZ" };
