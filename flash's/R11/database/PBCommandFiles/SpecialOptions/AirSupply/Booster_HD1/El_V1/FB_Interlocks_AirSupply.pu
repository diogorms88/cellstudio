@BEG_Body 
@TL(93)
IF NOT mInitDone THEN
  // Set version info to catalog
  mInitDone := F_Version_String(i_zRoot    := cCatRootVersion,
                                i_zPath    := cCatPathVersion,
                                i_zName    := zMyName,
                                i_zVersion := zVersion);
END_IF;

//-------------------------------------------------------------------------------------------------
// Interlocks of initiators
//-------------------------------------------------------------------------------------------------

//------------- Interlocks of AirSupplyValve -----------------------------
//Set error when valve is open and initiator is still FALSE after 5 seconds
//Start count time

fbWaitTime1(IN := (abMainValve_LV2.fGetDevSet_Set(i_nSignalNode := nReleasesOut) AND
                   NOT GV_sPCU.Devices.sInitiators.y[cInitiator_LV2].mInterlock),
            PT := t#5000ms);

IF (fbWaitTime1.Q                                        AND
    NOT abInitiator_LV2.fGetDevAct_ActValue_Debounced()) THEN
  
  mTmp := abMsgPCU.fSet(i_iIdent         := cFB_Interlocks_HV1,
                        i_iMsgCount      := 1,
                        i_iDeviceNr      := cMainValve_LV2,
                        i_zLocation      := zMyName,
                        i_zParam1        := GV_sPCU.Devices.sMainValves.y[cMainValve_LV2].zName,
                        i_zParam2        := GV_sPCU.Devices.sInitiators.y[cInitiator_LV2].zName,
                        i_zParam3        := '',
                        i_iChannelNumber := GV_sPCU.Devices.sInitiators.y[cInitiator_LV2].iChannelNr,
                        i_refRef1        := EMPTY,
                        i_iDevDrvIdx     := 0);
  
ELSE
  
  GV_sPCU.Devices.sMainValves.y[cMainValve_LV2].mInterlock := FALSE;
  
END_IF;

GV_sReleases.sReleases.Internal.ReleaseAirSupply := (abMainValve_LV2.fGetDevSet_Set(i_nSignalNode := nReleasesOut) AND
                                                     (abInitiator_LV2.fGetDevAct_ActValue_Debounced() OR GV_sPCU.Devices.sInitiators.y[cInitiator_LV2].mInterlock));

//If booster on robot is used: set error when initiator for air supply is TRUE and initiator for high pressure is still FALSE after 2 seconds
//Start count time

fbWaitTime2(IN := (abMainValve_LV2.fGetDevSet_Set(i_nSignalNode := nReleasesOut) AND
                   abInitiator_LV2.fGetDevAct_ActValue_Debounced()               AND
                   NOT GV_sPCU.Devices.sInitiators.y[cInitiator_LV2].mInterlock),
            PT := t#2000ms);

IF (fbWaitTime2.Q                              AND
    NOT SV_sGeneralSystemCfg.mSimulateProcess) THEN
  
  IF NOT abInitiator_HD1.fGetDevAct_NoFault_Debounced() THEN
    mTmp := abMsgPCU.fSet(i_iIdent         := cFB_Interlocks_BoosterOverPres,
                          i_iMsgCount      := 0,
                          i_iDeviceNr      := cInitiator_HD1,
                          i_zLocation      := zMyName,
                          i_zParam1        := abInitiator_HD1.fGet_DeviceName(),
                          i_zParam2        := BOOL_TO_STRING(abInitiator_HD1.fGetDevAct_NoFault_Debounced()),
                          i_zParam3        := BOOL_TO_STRING(abInitiator_HD1.fGetDevAct_InRange_Debounced()),
                          i_iChannelNumber := cIndex_AirSupply,
                          i_refRef1        := EMPTY,
                          i_iDevDrvIdx     := 0);
    
    //set mainchannel to error to stop robot
    mTmp := abChannels.fSetChannelChannelErrorBit(cIndex_MainChannel, TRUE);
    
  ELSIF NOT abInitiator_HD1.fGetDevAct_InRange_Debounced() THEN
    mTmp := abMsgPCU.fSet(i_iIdent         := cFB_Interlocks_BoosterUnderPres,
                          i_iMsgCount      := 0,
                          i_iDeviceNr      := cInitiator_HD1,
                          i_zLocation      := zMyName,
                          i_zParam1        := abInitiator_HD1.fGet_DeviceName(),
                          i_zParam2        := BOOL_TO_STRING(abInitiator_HD1.fGetDevAct_NoFault_Debounced()),
                          i_zParam3        := BOOL_TO_STRING(abInitiator_HD1.fGetDevAct_InRange_Debounced()),
                          i_iChannelNumber := cIndex_AirSupply,
                          i_refRef1        := EMPTY,
                          i_iDevDrvIdx     := 0);
    
    //set mainchannel to error to stop robot
    mTmp := abChannels.fSetChannelChannelErrorBit(cIndex_MainChannel, TRUE);
    
  END_IF;
  
ELSE
  
  //If booster on robot is used
  GV_sPCU.Devices.sMainValves.y[cMainValve_LV2].mInterlock := FALSE;
  
END_IF;

@END_Body 

