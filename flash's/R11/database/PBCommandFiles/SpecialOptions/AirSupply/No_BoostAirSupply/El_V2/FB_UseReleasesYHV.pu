@BEG_Body 
@TL(41)
IF GV_mInitDone THEN
  
  IF (NOT mFirst) THEN
    mFirst := TRUE;
    // Get iChannel only once
    iChannel := abMainValve_LV2.fGet_ChannelNr();
  END_IF;
  
  IF GV_sReleases.sReleases.Internal.PreReleaseSetValueAirSupply
     AND
     (NOT abChannels.fGetChannelAnyError(i_iChannelIdx := iChannel))
     AND
     abChannels.fGetChannelEnabled(i_iChannelIdx := iChannel)
     AND
     (abChannels.fGetChannelReservedBy(iChannel) = Nobody)
     AND NOT abMainValve_LV2.fGet_Interlock()
  THEN
    // If no release and no error flag is on the channel write InterlocksOut to ReleasesOut
    abMainValve_LV2.aSetDev_Set(i_mValue      := TRUE,
                       i_nSignalNode := nReleasesOut);
  END_IF;
  
  mValve_Set := abMainValve_LV2.fGetDevSet_Set(i_nSignalNode:= nReleasesOut);
  
  IF (mValve_Set XOR mValve_Set_old) THEN
    
    IF SV_sGeneralSystemCfg.mSimulateProcess THEN
      abInitiator_LV2.aSet_SimValue(i_mValue := mValve_Set);
    END_IF;
    
    fbSetProtocol(Ident    := 1,
                  BodyID   := 0,
                  Location := 'FB_UseReleasesYHV',
                  Message  := CONCAT('Air supply switched: ', BOOL_TO_STRING(mValve_Set_old), ' -> ', BOOL_TO_STRING(mValve_Set)));
    
    mValve_Set_old := mValve_Set;
    
  END_IF;
  
END_IF;

@END_Body 

