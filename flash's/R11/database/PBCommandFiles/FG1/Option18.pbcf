//  Version      | ReleaseDate | Respon | Changes
//  -------------------------------------------------------------------------------------
//  v2_01.00.00  | 2016-11-21  | KLCH   | First release
//  v2_01.01.00  | 2019-02-15  | KLCH   | Change: adjustments due to structural changes (EA2.0)
//  v2_01.02.00  | 2020-01-08  | KLCH   | Bugfix: wrong "AdditionalStartFixPos" (74 -> 265)
//  v2_01.03.00  | 2021-09-10  | KLCH   | Change: remove device tags (BMK) in configuration values
//  v2_01.04.00  | 2022-01-10  | KLCH   | Change: water quench blocks are always available (no copy or delete actions)
//  v2_01.05.00  | 2022-01-25  | KLCH   | Change: [ECORPC-1137] adaptions to reduce variant/ option dependent software blocks

Imports Common OptionGun

Parameter Option1 Option2 Option3 Option4 Option5 Option12 Option14 Option15 Option18 Option20 Option21 Option26 Option27 MaterialValve1 NumberOfMainNeedles NozzleExchanger Circulation OptionGun OptionShotMeter HelpGun1 OptionElectricalVersion

Call Main_Option18
Call Common_Sealing_OptionalTPGroups
Call Common_Sealing_OptionalFixpos
Call Common_Sealing_Configuration
Call OptionGun_GlobalVars
// Select tab VariantConfiguration again
SelectNode RPC1.R11
SelectTab [VariantConfiguration]
END

SubRoutine Main_Option18
	Call Option18_ResetAll

	SelectCase Option18
		Case No_CleaningSystem
		Case CleaningSystem_PurgeWaterManual
			Call Option18_PurgeWaterManual
		Case CleaningSystem_PurgeWaterAuto
			Call Option18_PurgeWaterManual
			Call Option18_PurgeWaterAuto
		CaseElse
			Message Cleaning system [Option18] not supported !! (Main_Option18)
	EndSelect
Return

SubRoutine Option18_ResetAll
	IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].WaterQuench
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].WaterQuench
		Delete
		Message Check configuration of fixpos and time program groups!! (Option18_ResetAll)
	Endif
Return

SubRoutine Option18_PurgeWaterManual
	SelectNode RPC1.R11.PCU1
	Call Common_AddChannel_WaterQuench
	SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].WaterQuench
	Call Common_AddDevice_YBL1_Sealing
	SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].WaterQuench
	Call Common_AddDevice_BSW1
	SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].WaterQuench
	Call Common_AddDevice_AManagerSW1
	//*********** Set cfg parameter ****************
	SelectNode RPC1.R11.BCU1
	// Select tab cfg parameter
	SelectTab [CfgParameter]
	SelectCfg BCU1.StationData.AdditionalStartFixPos
	OptionalUsed 1
	Value 265
Return

SubRoutine Option18_PurgeWaterAuto
	// Additional settings to Option18_PurgeWaterManual
	SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].WaterQuench
	Call Common_AddDevice_YSWVR1
	SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].WaterQuench
	Call Common_AddDevice_YSWVV1
	SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].WaterQuench
	Call Common_AddDevice_BSW2
	SelectNode RPC1.R11.PCU1
	SelectTab [CfgParameter]
	//************* Enable cfg group ********************
	// Enable optional cfg group
	SelectCfg PCU1.WaterQuench
	OptionalUsed 1
	SelectCfg PCU1.WaterQuench.FillingLevelIni
	OptionalUsed 1
	Value "SW1"
	SelectCfg PCU1.WaterQuench.OverFlowIni
	OptionalUsed 1
	Value "SW2"
Return
