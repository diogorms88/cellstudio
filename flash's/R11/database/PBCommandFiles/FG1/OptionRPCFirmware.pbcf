SubRoutine Sub_RPC_V140
	//create d3 identifier
	FSCopy ..\..\..\..\..\CompatibilityFunctions\V1.40Common\ccontrol\*.*			..\..\..\ccontrol
	
	//copy compatibility files and firmware specific settings
	FSCopy ..\..\..\..\..\CompatibilityFunctions\V1.40Common\IECsystem\*.*			..\..\..\ieccontrol\system\CompatibilityFunctions\
	FSCopy ..\..\..\..\..\CompatibilityFunctions\V1.40Common\TC\*.*					..\..\..\teachcontrol\_system.tt\FWCompatibility\
	FSCopy ..\..\..\..\..\CompatibilityFunctions\V1.40Common\TCglobal\*.*			..\..\..\teachcontrol\kin1\_global.tt\
	FSCopy ..\..\..\..\..\CompatibilityFunctions\V1.40Common\systemsettings\*.*		..\..\..\..\..\systemsettings
	FSCopy ..\..\..\..\..\CompatibilityFunctions\V1.40Common\mmi\*.*				..\..\..\..\mmi\
	FSCopy ..\..\..\..\..\CompatibilityFunctions\V1.40Common\config\*.*				..\..\..\config\
	FSCopy ..\..\..\..\..\CompatibilityFunctions\V1.40Common\IEC\version.txt		..\..\..\ieccontrol\BCU1\
	FSCopy ..\..\..\..\..\CompatibilityFunctions\V1.40Common\IEC\version.txt		..\..\..\ieccontrol\PCU1\
	FSCopy ..\..\..\..\..\CompatibilityFunctions\V1.40Common\IEC\version.txt		..\..\..\ieccontrol\RCU1\
	FSCopy ..\..\..\..\..\CompatibilityFunctions\V1.40Common\IEC\version.txt		..\..\..\ieccontrol\SCU\
	FSCopy ..\..\..\..\..\CompatibilityFunctions\V1.40Common\IEC\version.txt		..\..\..\ieccontrol\system\
	FSCopy ..\..\..\..\..\CompatibilityFunctions\V1.40Common\IEC\version.txt		..\..\..\ieccontrol\
	FSCopy ..\..\..\..\..\CompatibilityFunctions\V1.40Common\encoder_data\*.*		..\..\..\..\encoder_data\config\
	FSDeleteFile ..\..\..\config\profinetslave.*				            //delete profinetinterface
	FSDeleteFile ..\..\..\config\profibusslave.*				            //delete profibusinterface
	
	SelectCase OptionSafetyType
		Case Safety		//same as SafeRobotics
			// get correct slave interface for controller
			FSCopy ..\..\..\..\ManagerProject\SlaveInterface\RPC2\ProfiNet_Slave_Bus.cfgr		..\..\..\..\ManagerProject\RPC2\config\KeStudio_generated\PNIOS\
			FSCopy ..\..\..\..\ManagerProject\SlaveInterface\RPC2\profinetslaveaddress.cfgr		..\..\..\config\
			FSDeleteFolder ..\..\..\..\ManagerProject\SlaveInterface
			//copy Safety specific compatibility files
			FSCopy ..\..\..\..\..\CompatibilityFunctions\V1.40Safety\IECRCU1\*.*			..\..\..\ieccontrol\RCU1\CompatibilityFunctions\
			FSCopy ..\..\..\..\..\CompatibilityFunctions\V1.40Safety\IECsystem\*.*			..\..\..\ieccontrol\system\CompatibilityFunctions\
			
			//get correct bus configuration and delete unused bus configurations and mappings
			FSCopy ..\..\..\..\ManagerProject\RPC2\config\*.*								..\..\..\config\
			FSDeleteFolder ..\..\..\..\ManagerProject\RPC_V2.x
			FSDeleteFolder ..\..\..\..\ManagerProject\RPC_V3.1
			FSDeleteFolder ..\..\..\..\ManagerProject\RPC_V3.3
			FSDeleteFolder ..\..\..\..\ManagerProject\PB
			
			//get common files for XML generation and delete other XML templates
			FSCopy ..\..\..\..\ManagerProject\XML\D3_Common\*.* ..\..\..\..\ManagerProject\XML\V1.40_RCMP2\
			FSDeleteFolder ..\..\..\..\ManagerProject\XML\D3_Common
			FSDeleteFolder ..\..\..\..\ManagerProject\XML\V1.40_RCMP
			FSDeleteFolder ..\..\..\..\ManagerProject\XML\V3.4.4.8_CP36x
			
		Case SafeRobotics		//same as Safety
			// get correct slave interface for controller
			FSCopy ..\..\..\..\ManagerProject\SlaveInterface\RPC2\ProfiNet_Slave_Bus.cfgr		..\..\..\..\ManagerProject\RPC2\config\KeStudio_generated\PNIOS\
			FSCopy ..\..\..\..\ManagerProject\SlaveInterface\RPC2\profinetslaveaddress.cfgr		..\..\..\config\
			FSDeleteFolder ..\..\..\..\ManagerProject\SlaveInterface
			//copy Safety specific compatibility files
			FSCopy ..\..\..\..\..\CompatibilityFunctions\V1.40Safety\IECRCU1\*.*			..\..\..\ieccontrol\RCU1\CompatibilityFunctions\
			FSCopy ..\..\..\..\..\CompatibilityFunctions\V1.40Safety\IECsystem\*.*			..\..\..\ieccontrol\system\CompatibilityFunctions\
			
			//get correct bus configuration and delete unused bus configurations and mappings
			FSCopy ..\..\..\..\ManagerProject\RPC2\config\*.*								..\..\..\config\
			FSDeleteFolder ..\..\..\..\ManagerProject\RPC_V2.x
			FSDeleteFolder ..\..\..\..\ManagerProject\RPC_V3.1
			FSDeleteFolder ..\..\..\..\ManagerProject\RPC_V3.3
			FSDeleteFolder ..\..\..\..\ManagerProject\PB
			
			//get common files for XML generation and delete other XML templates
			FSCopy ..\..\..\..\ManagerProject\XML\D3_Common\*.* ..\..\..\..\ManagerProject\XML\V1.40_RCMP2\
			FSDeleteFolder ..\..\..\..\ManagerProject\XML\D3_Common
			FSDeleteFolder ..\..\..\..\ManagerProject\XML\V1.40_RCMP
			FSDeleteFolder ..\..\..\..\ManagerProject\XML\V3.4.4.8_CP36x
			
		CaseElse
			// get correct slave interface for controller
			FSCopy ..\..\..\..\ManagerProject\SlaveInterface\RPC_V3.3\ProfiNet_Slave_Bus.cfgr		..\..\..\..\ManagerProject\RPC_V3.3\config\KeStudio_generated\PNIOS\
