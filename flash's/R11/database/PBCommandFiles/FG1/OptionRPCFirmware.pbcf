//  Version      | ReleaseDate | Respon | Changes
//  -------------------------------------------------------------------------------------
//  v2_01.00.00  | 23.04.2018  | PZB    | First release
//  v2_01.01.00  | 02.10.2018  | KTO    | Change: structural modification
//  v2_01.02.00  | 17.12.2018  | MWT    | Change: also delete profibusmaster and create compatibility folder
//  v2_01.03.00  | 03.01.2019  | MWT    | Change: copy common files of D3 xml files to specific folder
//  v2_01.04.00  | 10.01.2019  | MWT    | Change: for less redundancy in compatibility files there is now V1.40Common which will be copied for all V1.40 variants and additional files for safety
//  v2_01.05.00  | 15.01.2019  | KTO    | Change: folder names for D3 files changed based on FW-version instead of tool version
//  v2_01.06.00  | 16.01.2019  | MWT    | Bugfix: also copy IPC bus config to application
//  v2_01.07.00  | 12.02.2019  | KLCH   | Change: create folder for RCU1 compatibility functions (avoid errors in ieccontrol)
//  v2_01.08.00  | 18.02.2019  | MWT    | Bugfix: Slave bus interface has been moved to common location for all HW platforms
//  v2_01.09.00  | 13.03.2019  | MWT    | Change: delete scp directory for all controllers, that don't need it
//  v2_01.10.00  | 02.12.2019  | MWT    | AddOn:  Add item for firmware V1.55 and the compatibility files
//  v2_01.11.00  | 11.12.2019  | KTO    | Bugfix: call subroutine for firmware V1.55
//  v2_01.12.00  | 14.02.2020  | BIT    | AddOn:  Copy folder encoder_data with standard_motors.cfg for D3 platform
//  v2_01.13.00  | 04.02.2021  | BIT    | AddOn:  Copy file connect_variables.tip to folder kin1\_global.tt\
//  v2_01.14.00  | 19.09.2023  | BIT    | AddOn:  [ECORPC-1545] Copy file T_RCU2HMI.tu_iec to folder RCU1\CompatibilityFunctions
//  v2_01.15.00  | 24.04.2024  | MUCH   | AddOn:  [ECORPC-1790] Copy T70 application according to selected firmware version

Imports Common

Parameter OptionRPCFirmware OptionSafetyType

Call Main_RPCFirmware
END

SubRoutine Main_RPCFirmware
	//delete old compatibility files in iec
	FSDeleteFolder  ..\..\..\ieccontrol\system\CompatibilityFunctions
	FSDeleteFolder  ..\..\..\ieccontrol\RCU1\CompatibilityFunctions
	//delete old compatibility files in teachcontrol
	FSDeleteFolder  ..\..\..\teachcontrol\_system.tt\FWCompatibility
	FSDeleteFile ..\..\..\teachcontrol\kin1\_global.tt\connect_variables.tip
	
	//delete d3 identifier
	FSDeleteFolder  ..\..\..\ccontrol
    
	//delete old hardware config
	FSDeleteFile ..\..\..\config\*.bak						//backup files
	FSDeleteFile ..\..\..\config\*.sci						//sercos3 master config
	FSDeleteFile ..\..\..\config\sercos*.cfgr				//sercos2/3 master config
	FSDeleteFile ..\..\..\config\profibusmaster.cfgr		//profibus master config
	FSDeleteFile ..\..\..\config\*.pbm						//profibus master config
	FSDeleteFile ..\..\..\config\ecat_readparams.cfg		//Ecat specific parameter file
	FSDeleteFile ..\..\..\config\D3_SystemInfo.cfg			//D3 specific parameter file
	FSDeleteFile ..\..\..\config\KeStudio.*					//D3 hardware config
	FSDeleteFolder  ..\..\..\config\KeStudio_generated		//D3 hardware config
	FSDeleteFolder  ..\..\..\config\setup					//D3 hardware config
	FSDeleteFolder  ..\..\encoder_data						//EtherCat drive config
	
	SelectCase OptionRPCFirmware // rpc firmware version
		Case RPC_V544d
			Call Sub_RPC_V544d
		Case RPC_V544e
			Call Sub_RPC_V544
		Case RPC_V544j
			Call Sub_RPC_V544j
		Case RPC_V612
			Call Sub_RPC_V612
		Case RPC_V624
			Call Sub_RPC_V624
		Case RPC_V624a
			Call Sub_RPC_V624a
		Case RPC_V630
			Call Sub_RPC_V630
		Case RPC_V140
			Call Sub_RPC_V140
		Case RPC_V155
			Call Sub_RPC_V155
		Case RPC_V186
			Call Sub_RPC_V186
		CaseElse
			Message Firmware not supported.
	EndSelect
Return

SubRoutine Sub_RPC_V544d
	FSDeleteFile ..\..\..\config\s3_readparams.cfg			//Sercos specific parameter file
	FSCopy ..\..\..\..\..\CompatibilityFunctions\V5.44d\IECsystem\*.*		..\..\..\ieccontrol\system\CompatibilityFunctions\
	FSCopy ..\..\..\..\..\CompatibilityFunctions\V5.44d\TC\*.*				..\..\..\teachcontrol\_system.tt\FWCompatibility\
	FSCopy ..\..\..\..\..\CompatibilityFunctions\V5.44d\TCglobal\*.*		..\..\..\teachcontrol\kin1\_global.tt\
	FSCopy ..\..\..\..\..\CompatibilityFunctions\V5.44d\systemsettings\*.*	..\..\..\..\..\systemsettings
	FSCopy ..\..\..\..\..\CompatibilityFunctions\V5.44d\TeachView\*.*		..\..\..\teachcontrol\_system.tt\mask\
	FSCopy ..\..\..\..\ManagerProject\RPC_V2.x\config\*.*					..\..\..\config\
	FSDeleteFolder ..\..\..\..\ManagerProject\RPC_V3.1
	FSDeleteFolder ..\..\..\..\ManagerProject\RPC_V3.3
	FSDeleteFolder ..\..\..\..\ManagerProject\RPC2
	FSDeleteFolder ..\..\..\..\ManagerProject\PB
	FSDeleteFolder ..\..\..\..\ManagerProject\XML\D3_Common
	FSDeleteFolder ..\..\..\..\ManagerProject\XML\V1.40_RCMP
	FSDeleteFolder ..\..\..\..\ManagerProject\XML\V1.40_RCMP2
	FSDeleteFolder ..\..\..\..\ManagerProject\XML\Python_Scripts
	FSDeleteFolder ..\..\..\..\scp
	FSCopy ..\..\..\..\..\CompatibilityFunctions\V5.44d\IEC\version.txt		..\..\..\ieccontrol\BCU1\
	FSCopy ..\..\..\..\..\CompatibilityFunctions\V5.44d\IEC\version.txt		..\..\..\ieccontrol\PCU1\
	FSCopy ..\..\..\..\..\CompatibilityFunctions\V5.44d\IEC\version.txt		..\..\..\ieccontrol\RCU1\
	FSCopy ..\..\..\..\..\CompatibilityFunctions\V5.44d\IEC\version.txt		..\..\..\ieccontrol\SCU\
	FSCopy ..\..\..\..\..\CompatibilityFunctions\V5.44d\IEC\version.txt		..\..\..\ieccontrol\system\
	FSCopy ..\..\..\..\..\CompatibilityFunctions\V5.44d\IEC\version.txt		..\..\..\ieccontrol\
	
	Call Sub_MakeDir_IECRCU1
	//copy RCU specific compatibility files
	FSCopy ..\..\..\..\..\CompatibilityFunctions\V5.44d\IECRCU1\*.*			..\..\..\ieccontrol\RCU1\CompatibilityFunctions\
	// get correct slave interface for controller
	FSCopy ..\..\..\..\ManagerProject\SlaveInterface\RPC_V2.x_V3.1\*.* 		..\..\..\config\
	FSDeleteFolder ..\..\..\..\ManagerProject\SlaveInterface
	SelectNode RPC1
	ExportSlave Profibus
Return

