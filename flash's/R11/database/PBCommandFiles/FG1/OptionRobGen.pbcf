	IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].ColorLine2.BL2ZYEV
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].ColorLine2.BL2ZYEV
		Delete
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].ColorLine2
		Call Common_AddDevice_BL2ZYEV
