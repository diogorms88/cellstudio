SubRoutine Sub_RobGen3_ChangeDevice_BFDS1
	IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].StockPaint.BFDS1
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].StockPaint.BFDS1
		Delete
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].StockPaint
		Call Common_AddDevice_BFDS1
		Call Common_Configure_HWSignals_BFDS1
		Call Common_Configure_TrBr_BFDS1
	EndIf
	IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].MainChannel.BFDS1
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].MainChannel.BFDS1
		Delete
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].MainChannel
		Call Common_AddDevice_BFDS1
		Call Common_Configure_HWSignals_BFDS1
		Call Common_Configure_TrBr_BFDS1
	EndIf
Return

SubRoutine Sub_RobGen3_ChangeDevice_BFDS2
	SelectCase Option1 // Process type
		Case EcoPurgeLCC2_2K
			IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].Hardener.BFDS2
				SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].Hardener.BFDS2
				Delete
				SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].Hardener
				Call Common_AddDevice_BFDS2
				Call Common_Configure_HWSignals_BFDS2
				Call Common_Configure_TrBr_BFDS2
			EndIf
		CaseElse
			IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].PumpHardener.BFDS2
				SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].PumpHardener.BFDS2
				Delete
				SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].PumpHardener
				Call Common_AddDevice_BFDS2
				Call Common_Configure_HWSignals_BFDS2
				Call Common_Configure_TrBr_BFDS2
			EndIf
	EndSelect
Return

SubRoutine Sub_RobGen3_ChangeDevice_BFDS1_AB
	IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].StockPaint_.a.BFDS1a
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].StockPaint_.a.BFDS1a
		Delete
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].StockPaint_
		Call Common_AddDevice_BFDS1_AB
		
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].StockPaint_.a.BFDS1a
		Call Common_ConfigDevice_BFDS1a
		Call Common_Configure_HWSignals_BFDS1a
		
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].StockPaint_.b.BFDS1b
		Call Common_ConfigDevice_BFDS1b
		Call Common_Configure_HWSignals_BFDS1b
		
		Call Common_Configure_TrBr_BFDS1_AB
	EndIf
	
	IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].ColorChanger_.a.BFDS1a
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].ColorChanger_.a.BFDS1a
		Delete
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].ColorChanger_
		Call Common_AddDevice_BFDS1_AB
		
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].ColorChanger_.a.BFDS1a
		Call Common_ConfigDevice_BFDS1a
		Call Common_Configure_HWSignals_BFDS1a
		
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].ColorChanger_.b.BFDS1b
		Call Common_ConfigDevice_BFDS1b
		Call Common_Configure_HWSignals_BFDS1b
		
		Call Common_Configure_TrBr_BFDS1_AB
	EndIf
Return

SubRoutine Sub_RobGen3_ChangeDevice_BFDS3_AB
	IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].Hardener_.a.BFDS3a
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].Hardener_.a.BFDS3a
		Delete
			
	   //add device
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].Hardener_
		Call Common_AddDevice_BFDS3_AB
		//configure BFDS3a
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].Hardener_.a.BFDS3a
		Call Common_ConfigDevice_BFDS3a
		//configure BFDS3b
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].Hardener_.b.BFDS3b
		Call Common_ConfigDevice_BFDS3b
		
		//Configure BFDS3b as virtual device (optional)
		SelectTab [VirtualDevices]
		//Set link to real device
		VirtualDeviceSetReference PCU.Hardener_.BFDS3a
		
		//Trigger Brush configuration
		Call Common_Configure_TrBr_BFDS3_AB
	EndIf
Return

SubRoutine Sub_RobGen3_ChangeDevice_BFDCAN1
	IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].ColorLine1.BFDCAN1
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].ColorLine1.BFDCAN1
		Delete
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].ColorLine1
		Call Common_AddDevice_BFDCAN1
		Call Common_Configure_HWSignals_BFDCAN1
	EndIf
Return

SubRoutine Sub_RobGen3_ChangeDevice_BFDCAN2
	IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].ColorLine2.BFDCAN2
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].ColorLine2.BFDCAN2
		Delete
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].ColorLine2
		Call Common_AddDevice_BFDCAN2
		Call Common_Configure_HWSignals_BFDCAN2
	EndIf
Return
