//  Version     | ReleaseDate | Respon  | Changes
//  -----------------------------------------------------------------------------------------------
//  V2_01.00.00 | 2013-09-30  | STL     | First release
//  V2_01.01.00 | 2014-01-28  | SMOH    | Change: Combine LASD Options 27 and 18 + Option14(BMV1T)--> Option27 + Busmaster--> Option14
//  V2_01.02.00 | 2014-02-14  | SMOH    | Change: Encompass ExhaustUnit Option into Option12 + Delete Option6, Option17 and Option 9+ Include Temp HE_2 for PCL
//  V2_01.03.00 | 2014-04-15  | SMOH    | Change: Option22 converted to BoostAirSupply
//  V2_01.04.00 | 2014-04-28  | KLCH    | Bugfix: correction of Option14 (export for HMI not ok)
//  V2_01.05.00 | 2014-12-15  | STL     | AddOn:  Nozzle exchanger
//  V2_01.06.00 | 2015-11-18  | STL     | Change: Option26 (BAP1P) (0 -> 1)
//  V2_01.07.00 | 2016-10-10  | RHI     | AddOn:  KeStudio XML Version
//  V2_01.08.00 | 2016-10-17  | STL     | AddOn:  HelpGun as option
//  V2_01.09.00 | 2016-11-21  | KLCH    | Change: new option OptionGun; modification of items
//  V2_01.10.00 | 2016-12-21  | RHI     | AddOn:  Option Cooling Device
//  V2_01.11.00 | 2017-01-12  | KLCH    | Change: Option5 (BMV2PE) (0 -> 1)
//  V2_01.12.00 | 2017-08-23  | KLCH    | Change: Option14 (Profibus -> Sercos III); TempHE (1 -> 0); EcoTempAxis1 (Not existing -> Air cooled large); EcoTempAxis3 (Not existing -> Air cooled small); ElectricalVersion(Version 1 -> Version 2)
//  V2_01.13.00 | 2017-12-12  | KLCH    | Change: modified selection for circulation
//  V2_01.14.00 | 2018-03-20  | KTO     | AddOn:  KeStudio Version 3.20+ and RCMP / RCMP2, set "KeStudio 3.20+ and RCMP (Sercos3 drives)" as default
//  V2_01.15.00 | 2018-04-24  | KLCH    | AddOn:  OptionRobType, OptionSafetyType
//  V2_01.16.00 | 2018-10-02  | KLCH    | Change: modified selection for renamed RobType (OptionRobType), SafetyType (OptionSafetyType)
//  V2_01.17.00 | 2019-03-05  | STL     | AddOn:  ECORPC-198: Nozzle head exchanger
//  V2_01.18.00 | 2020-03-03  | KLCH    | Change: ECORPC-484: BoostAirSupply (remove additional air supply; rename air supply)
//  V2_01.19.00 | 2024-07-11  | KLCH    | Change: ECORPC-1837: new option 31 to enable initiator of EcoShot Meter (end position)

[Option1]
Name=Option 1
Description=Process
