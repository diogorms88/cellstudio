SubRoutine AddDeviceToMaterial1_BMV2
	IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].Material1.BMV2
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].Material1.BMV2
		Delete
	Endif
	SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].Material1
	Call Common_AddDevice_BMV2
	IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].Material1.BMV2
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].Material1.BMV2
		SelectCase Option14 // Variant of bus master
			Case Profibus
				SelectTab [HWSignals]
				SelectHWSignal HWI_wBMV2
	  			BusType 1 //Profibus-DP
	  			Vendor  1 //Siemens
	  			Card    2 //Analog input current - 6ES7 134-4GB61-0AB0
				SelectHWSignal HWO_wBMV2
	  			BusType 1 //Profibus-DP
	  			Vendor  1 //Siemens
	  			Card    2 //Analog output current - 6ES7135-4GB01-0AB0
	  			SelectHWSignal HWI_bBMV2_HSK
	  			Export 0
	  			SelectHWSignal HWO_bBMV2_HSK
	  			Export 0
	  			SelectHWSignal HWO_wBMV2_PD
	  			Export 0
			Case SercosIII
				SelectCase OptionElectricalVersion
					Case El_V1
						SelectTab [HWSignals]
						SelectHWSignal HWI_wBMV2
						BusType 6 //Sercos III
						Vendor  2 //Phoenix Contact
						Card    1 //Analog input current/voltage - IB IL AI 2/SF-PAC
						SelectHWSignal HWO_wBMV2
						BusType 6 //Sercos III
						Vendor  2 //Phoenix Contact
						Card    1 //Analog output current - 28 61 31 5
						SelectHWSignal HWI_bBMV2_HSK
						Export 0
						SelectHWSignal HWO_bBMV2_HSK
						Export 0
						SelectHWSignal HWO_wBMV2_PD
						Export 0
					Case El_V2
						SelectTab [HWSignals]
						SelectHWSignal HWI_wBMV2
						BusType 6 //Sercos III
						Vendor  19 //FESTO
						Card    6 //CPX Analog input U/I VZ+15bit - CPX-4AE-U-I
						SelectHWSignal HWO_wBMV2
						BusType 6 //Sercos III
						Vendor  19 //FESTO
						Card    4 //CPX Analog Output U/I VZ+12bit - CPX-2AA-U-I
						SelectHWSignal HWI_bBMV2_HSK
						Export 0
						SelectHWSignal HWO_bBMV2_HSK
						Export 0
						SelectHWSignal HWO_wBMV2_PD
						Export 0
					CaseElse
						Message OptionElectricalVersion not supported !! (AddDeviceToMaterial1_BMV2)
				EndSelect
			CaseElse
				Message Wrong bus master (AddDeviceToMaterial1_BMV2)!! Only Profibus and Sercos III supported
		EndSelect
	Endif
Return

