SubRoutine Option14_ManagerProject
	//copy config-files to config folder
	SelectCase Option14
		Case Profibus
			SelectCase OptionRPCFirmware // rpc firmware version
				Case RPC_V140
					SelectNode RPC1
					//don't load ASC, if RPC v3.3, because Directory "RPC_V2.x" was deleted before
				Case RPC_V155
					SelectNode RPC1
					//don't load ASC, if RPC v3.3, because Directory "RPC_V2.x" was deleted before
				CaseElse
					SelectNode RPC1
					LoadEplanData ..\..\..\..\Managerproject\RPC_V2.x\ASC
			EndSelect
		Case SercosIII
			SelectNode RPC1
			SelectCase OptionRCMPGen
				Case RCMP2_Rev2
					LoadEplanData ..\..\..\..\Managerproject\RPC2\ASC
				Case RCMP2.1
					LoadEplanData ..\..\..\..\Managerproject\RPC2\ASC
				Case RCMP1_D3
					LoadEplanData ..\..\..\..\Managerproject\RPC_V3.3\ASC
				Case RCMP1_Cube
					LoadEplanData ..\..\..\..\Managerproject\RPC_V3.1\ASC
			EndSelect
		CaseElse
			Message Error while configuring drive system: Actual drive system not supported !!
	EndSelect
Return