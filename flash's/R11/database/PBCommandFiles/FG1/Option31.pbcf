						SelectCase Option20 // Shot meter single
							Case 0
								IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].ShotMeter1Sub_.b
									SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].ShotMeter1Sub_.b.BDP92GR_1b
									VisuInterface 1 4
									SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].ShotMeter1Sub_.b.MDP92_1b
									SelectTab [CfgParameter]
									SelectCfg MDP92_1.PistonEndPosSensorName
									OptionalUsed 1
									Value DP92GR_1b
								Else
									Message Script error - check script for [Option31] !! (Option31_ShotMeter1Sub_Multi; Enable)
								Endif
						EndSelect
					Case 0
						SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].ShotMeter1Sub_.a.MDP92_1a
						SelectTab [CfgParameter]
						SelectCfg MDP92_1.PistonEndPosSensorName
						OptionalUsed 1
						Value -
						OptionalUsed 0
						SelectCase Option20 // Shot meter single
							Case 0
								IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].ShotMeter1Sub_.b
									SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].ShotMeter1Sub_.b.MDP92_1b
									SelectTab [CfgParameter]
									SelectCfg MDP92_1.PistonEndPosSensorName
									OptionalUsed 1
									Value -
									OptionalUsed 0
								Else
									Message Script error - check script for [Option31] !! (Option31_ShotMeter1Sub_Multi; Disable)
								Endif
						EndSelect
				EndSelect
			CaseElse
				Message ShotMeter type not supported !! (Option31_ShotMeter1Sub_Multi)
		EndSelect
	Else
		Message Script error - check script for [Option31] !! (Option31_ShotMeter1Sub_Multi; SM1a)
	Endif
Return

