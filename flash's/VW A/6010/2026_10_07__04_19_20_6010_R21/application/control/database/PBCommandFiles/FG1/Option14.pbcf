SubRoutine Option14_ManagerProject
	//copy config-files to config folder
	SelectCase Option14 // Variant of bus master
		Case SercosIII
			
			FSDeleteFile ..\..\..\..\..\application\control\config\profibusmaster.cfgr
			FSDeleteFile ..\..\..\..\..\application\control\config\EcoRpc_0.dbm
			FSDeleteFile ..\..\..\..\..\application\control\config\sercos2.cfgr
			
			FSCopy ..\..\..\..\ManagerProject\Sercos3\config\Sercos3_Simulation.SCI ..\..\..\..\..\application\control\config
			FSCopy ..\..\..\..\ManagerProject\Sercos3\config\Sercos3.cfgr ..\..\..\..\..\application\control\config
			
		Case Profibus
			
			FSDeleteFile ..\..\..\..\..\application\control\config\Sercos3_Simulation.SCI
			FSDeleteFile ..\..\..\..\..\application\control\config\Sercos3.cfgr
			
			FSCopy ..\..\..\..\ManagerProject\PB\config\profibusmaster.cfgr ..\..\..\..\..\application\control\config
			FSCopy ..\..\..\..\ManagerProject\PB\config\EcoRpc_0.dbm ..\..\..\..\..\application\control\config
			FSCopy ..\..\..\..\ManagerProject\PB\config\sercos2.cfgr ..\..\..\..\..\application\control\config
			
		CaseElse
			Message Wrong bus master (Option14_ManagerProject)!! Only Profibus and Sercos III supported
	EndSelect
Return

SubRoutine ExportSlaveInterface
	//copy config-files to config folder
	SelectCase Option14 // Variant of bus master
		Case SercosIII
			SelectNode RPC1
			ExportSlave Profinet
	EndSelect
Return