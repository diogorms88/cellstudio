//  Version      | ReleaseDate | Respon | Changes
//  -------------------------------------------------------------------------------------
//  v2_01.00.00  | 30.09.2013  | STL    | First release
//  v2_01.01.00  | 28.01.2014  | SMOH   | Combine LASD Options 27 and 18 + Option14(BMV1T)--> Option27 + Busmaster--> Option14
//  v2_01.02.00  | 14.04.2014  | KLCH   | Change: remove cfg parameter CheckDevice
//  v2_01.03.00  | 28.04.2014  | KLCH   | Bugfix: correction of Option14 (export for HMI not ok)
//  v2_01.04.00  | 12.09.2014  | KLCH   | Change: redesign; move SubRoutines to CommonTempControl
//  v2_01.05.00  | 21.11.2016  | KLCH   | Change: redesign; check Option1 + further options instead of Option2
//  v2_01.06.00  | 28.09.2017  | KLCH   | AddOn: all required parameters

Imports Common CommonTempControl

Parameter Option1 Option2 Option3 Option4 Option5 Option12 Option14 Option15 Option18 Option20 Option21 Option26 Option27 EcoTempAxis1 EcoTempAxis3 TempHeatZone1 TempHeatZone2 TempHeatZone3 TempHeatZone4 TempHeatZone5 TempHeatZone6 TempHeatZone7 TempHeatZone8 TempHeatZone9 NumberOfMainNeedles

Call CommonTempCtrl_MatHeater
Call Main_TempHeatZone8
// Select tab VariantConfiguration again
SelectNode RPC1.R11
SelectTab [VariantConfiguration]
END

SubRoutine Main_TempHeatZone8
	SelectNode RPC1.R11
	Call AddDeviceToWaterQuench_TempHeatZone8
Return

SubRoutine AddDeviceToWaterQuench_TempHeatZone8
	IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].WaterQuench.AMH1_SW1
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].WaterQuench.AMH1_SW1
		Delete
	Endif
	SelectCase TempHeatZone8
		Case 1
			SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].WaterQuench
			Call Common_AddDevice_AMH1_SW1
			
			// Cfg parameter
			SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].WaterQuench.AMH1_SW1
			// Select tab cfg parameter
			SelectTab [CfgParameter]
			SelectCase Option14 // Variant of bus system
				Case SercosIII
					SelectCfg AMH1_SW1.ControlMode
					Value 1
					SelectCfg AMH1_SW1.DeviceTemperature.ControlParam.P03_DevAlarm
					Value 100
					SelectCfg AMH1_SW1.DeviceTemperature.ControlParam.P06_Tv_Heating
					Value 5
					SelectCfg AMH1_SW1.DeviceTemperature.ControlParam.P22_Offset_Act
					Value 999
					SelectCfg AMH1_SW1.DeviceTemperature.ControlParam.TemperatureMax
					Value 49
					SelectCfg AMH1_SW1.DeviceTemperature.ControlParam.TemperatureMin
					Value 30
					SelectCfg AMH1_SW1.DeviceTemperature.ControlParam.Zone
					Value 8
					SelectCfg AMH1_SW1.SetTemperature
					Value 38
				Case Profibus
					SelectCfg AMH1_SW1.CtrlLevel
					Value 1
					SelectCfg AMH1_SW1.03_DevAlarm
					Value 100
					SelectCfg AMH1_SW1.06_Tv_Control
					Value 5
					SelectCfg AMH1_SW1.22_Offset_Act
					Value 99
					SelectCfg AMH1_SW1.CtrlTypeSetbackTemp
					OptionalUsed 1
					Value 2
					SelectCfg AMH1_SW1.MediumTempCtrl.ReactionLevelCtrl
					Value 1
					SelectCfg AMH1_SW1.NameSignalForFlow
					OptionalUsed 0
					SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].WaterQuench.AMH1_SW1
					SelectCfg AMH1_SW1.SetbackTemp
					OptionalUsed 1
					Value 30
					SelectCfg AMH1_SW1.SetTemp
					Value 38
					SelectCfg AMH1_SW1.SetTempMaterial
					OptionalUsed 1
					Value 30
					SelectCfg AMH1_SW1.SetTempMax
					Value 49
					SelectCfg AMH1_SW1.SetTempMaxAfterHys
					Value 42
					SelectCfg AMH1_SW1.SetTempMin
					Value 30
					SelectCfg AMH1_SW1.SetTempMinAfterHys
					Value 31
					SelectCfg AMH1_SW1.TemperatureSensorName
					Value "-"
					SelectCfg AMH1_SW1.TimeSetbackTemp
					OptionalUsed 1
					Value 0d0h30m0s0ms
					SelectCfg AMH1_SW1.Zone
					Value 8
				CaseElse
					Message Wrong bus master (AMH1_SW1)!! Only Profibus and Sercos III supported
			EndSelect
			Call CommonTempCtrl_SetConfigWaterQuench_AManagerSW1
	EndSelect
Return
