(* Konfiguration in RobotControl.cfg:

// ------------------------------------------------------------------------------------------------
//E  configuration ISRA_BK system 

[RC.KINEMATIC:0.ISRA_BK_ROVIS]
Enable          = 1             //  0=no BK, 1=activate it
LinearLimit     = 50.0          //  Limit in mm for accepted correction values from ISRA_BK system --> at overstepping an error will be set
RotationLimit   =  5.0          //  Limit in deg for accepted correction values from ISRA_BK system --> at overstepping an error will be set
IPAddress       = "192.168.1.198"   // IP-Address of ISRA-PC (if ISRA is server)
Portnumber      = 6008          //  Port of ISRA-BK (if ISRA is server) 
SimulateBK      = 0             //  1 to simulate the ISRA_BK-Macros
 *)

(*
   direkte Schnittstelle zu ISRA (ohne SPS) mit TCP/IP

XML-Eingangstelegramm des Roboters

<DataSet>
   <TelVer>2</TelVer>                              //Telegramm Version 2 - Rovis Vorbereitung findet über die Roboterschnittstelle statt
   <TelType>1</TelType>                            //Aktuelle Kommandoart 1 - SysCmd   2 - Hemflange
   <SendID>1</SendID>					               //laufende Nummer
	<Index>1</Index>    				                  //laufende Nummer (aus KRC2 - Zeiten hier nochmals...)
	<NumIndices>3</NumIndices>			               //Anzahl der Korrekturen
	<Label>Punkt1</Label>				               //Name der Korrektur
	<SegLabel>Segment1</SegLabel>			            //Name des Segments innerhalb der die Korrektur gruppiert ist
	<Corr X=0.0 Y=0.0 Z=0.0 A=0.0 B=0.0 C=0.0>	   //Korrekturwert (A = Rotation Z, B = Rotation Y, C = Rotation X)
	<Expected X=0.0 Y=0.0 Z=0.0 A=0.0 B=0.0 C=0.0>	//Erwartete Applikationspunktpose, die der Roboter prüfen kann. Derzeit nicht verwendet
	<Teach>0</Teach>				                     //Wenn Teach=1, soll der Roboter die Applikationsbahn ohne Korrektur fahren
	<Error>0</Error>				                     //Bitfeld für Fehler s.u.
	<MeasurementID>1</MeasurementID>		            //Beauftragte Messung zum Crosscheck auf dem Roboter
	<SysCmd>
	   <Ready>0</Ready>                             //Bereit für Typ 1 - ROVIS ist bereit für eine neue Typanmeldung   0 - ROVIS noch aktiv
	   <Runmode>2</Runmode>                         //Betriebsart
	   <Prepared>0</Prepared>                       //Vorbereitung aktiv 1 - Typ gültig  2 - Typ nicht definiert
	   <Aquisition>1</Aquisition>                   //Start OK, Bildaufnahme läuft  1 - Bildaufnahme läuft   0 - Bildaufnahme beendet
	   <Measurement>1</Measurement>                 //Messung läuft  1 - Messzyklus aktiv    0 - Messzyklus beendet
	   <Error>0</Error>                             //Fehlerzustand  1 - Fehlerzustand   0 - Kein Fehlerzustand
	</SysCmd>
</DataSet>

Error:

=0 ; Fehlerart "Keine"                                                        
=1 ; Fehlerart "Messfehler bei Messung"                                   
=2 ; Fehlerart "Toleranzueberschreitung bei Messung"                       
=4 ; Fehlerart "Messfehler bei Spalt-Buendigkeitsmessung"               
=8 ; Fehlerart "Toleranzueberschreitung bei Spalt-Buendigkeitsmessung"   
=16 ; Fehlerart "Toleranzueberschreitung Roboter"                           


XML-Ausgangstelegramm des Roboters

<Robot>
  <TelVer>2</TelVer>                              //Telegramm Version 2 - Rovis Vorbereitung findet über die Roboterschnittstelle statt
  <TelType>1</TelType>                            //Aktuelle Kommandoart 1 - SysCmd   2 - Hemflange
  <Index>1</Index>
  <MeasurementPath>1</MeasurementPath>	//Messpunkt ?
  <ApplicationPath>0</ApplicationPath>	//Applikationspunkt ?
  <NumIndices>0</NumIndices>		      //Normalerweise nicht in Verwendung
  <Label>Messpunkt 1</Label>		      //Name des Messpunkts
  <SegLabel>Segment 1</SegLabel>	      //Segmente werden bei Messpunkten nicht verwendet, bei Applikationspunkten hingegen schon.
  <X>1.0</X>			               	//Punktkoordinate
  <Y>2.0</Y>
  <Z>3.0</Z>
  <A>4.0</A>
  <B>5.0</B>
  <C>6.0</C>
  <MeasurementID>1</MeasurementID>	  //Beauftragte Mess-ID
  <Valid>1</Valid>			           //Dieser Punkt ist "gültig"
  <PointInfo>1</PointInfo>		        //Bitfeld für Zusatzinfos: s.u.
  <SysCmd>
	   <Runmode>2</Runmode>                         //Betriebsart  1 - Teilautomatik   2 - Automatikbetrieb
	   <Type>1</Type>                               //Typnummer
	   <Prepare>0</Prepare>                         //Typ vorbereiten
	   <Start>1</Start>                             //Messung starten
	   <Quit>0</Quit>                               //Fehler zurücksetzen
  </SysCmd>
</Robot>


*)


CONSTANT
   MaxPunkteProMessung   : INT := 255;
   
   // Berechnete Korrekturen
   BK_MaxKorrekturenProBahn : INT := 255;
   // BK_TriggerTime : FLOAT := 0.032;
   BK_TriggerTime : REAL := 0.048;
END_CONSTANT

TYPE
   TELEGRAM_TYPE : (eInvalidType, eCorrValue, eRovis, eMaxType);
   ROVISTELEGRAM : STRUCT
      Ready         : BOOL;
      Runmode       : INT;
      Prepared      : BOOL;
      Acquisition   : BOOL;
      Measurement   : BOOL;
      Data          : BOOL;
      Error         : INT;
      Result        : FRAME;
   END_STRUCT;
   TELEGRAM : STRUCT
      Type          : TELEGRAM_TYPE;
      TelVer        : INT;
      TelType       : INT;
      SendID        : INT;
      Index         : INT;
      NumIndices    : INT;
      Label         : STRING;
      SegLabel      : STRING;
      Teach         : INT;
      Error         : INT;
      MeasurementID : INT;
      Corr          : FRAME;
      Expected      : FRAME;
      SysCmd        : ROVISTELEGRAM;
   END_STRUCT;
END_TYPE


(******************************************************************************
***  Variables ****************************************************************
******************************************************************************)

VAR
   bCfgDataRead             : BOOL;
   BK_TYPE                  : INT := 0;
   BK_PATH                  : INT := 0;

   BK_ScanRobPos            : INT := 0; // Zähler für Triggerpunkte bei Messfahrt bzw.
                                        // Bahnpunkte bei PP_REF oder Applikation
   BK_RequestCount          : INT := 0; // Zähler für Punkte, die an Vision gesendet wurden
   BK_TriggerCount          : INT := 0; // Zähler für Trigger im Vorlauf
   bPointCountValid         : BOOL;     // BK_TriggerCount bzw. BK_NumberOfPoints sind gültig
   BK_NumberOfPoints        : INT := 0; // Zähler für Anzahl Bahnpunkte im PATH
   
   NULLFRAME                : FRAME := (0,0,0,0,0,0);
   //Anzahl der Korrekturen fuer die einzelnen Bahnen
   BK_KORREKTUREN_GUELTIG   : ARRAY[1..5] OF INT := (0,0,0,0,0);

   //ID der einzelnen Bahnen
   BK_KORR_BAHN_ID          : ARRAY[1..5] OF INT := (0,0,0,0,0);

   //Korrekturwerte fuer alle Bahnpunkte nach Bahnen getrennt
   BK_KORREKTUR             : ARRAY[1..5,1..255] OF FRAME;
   
   //IDs der einzelnen Punktkorrekturen nach Bahnen getrennt
   BK_KORR_PUNKT_ID         : ARRAY [1..5,1..255] OF INT;
   BK_KORR_BAHNEN           : INT := 2;

   BK_MODUS                 : BK_MODE_TYPE := Mode_Off;
   BK_POINT_ID              : INT := 0;

   (* Fehler von ISRA: Umsetzung auf BK_ERROR und auf Fehlertexte überarbeiten !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
=0 ; Fehlerart "Keine"                                                        
=1 ; Fehlerart "Messfehler bei Messung"                                   
=2 ; Fehlerart "Toleranzueberschreitung bei Messung"                       
=4 ; Fehlerart "Messfehler bei Spalt-Buendigkeitsmessung"               
=8 ; Fehlerart "Toleranzueberschreitung bei Spalt-Buendigkeitsmessung"   
=16 ; Fehlerart "Toleranzueberschreitung Roboter"                           
   *)

   BK_STATE_OK              : INT := 0;
   BK_STATE_FAIL            : INT := 16;
   BK_STATE_MORE            : INT := 8;
   BK_ERROR_LIMIT           : INT := 2;
   BK_ERROR_COLLISION       : INT := 4;
   BK_ERROR_DETECTION       : INT := 1;
     
   BKMessPos                : ARRAY [1..255] OF FRAME;
   BKMessPunkt              : ARRAY [1..255] OF INT;

   BK_STATUS                : INT := 0;
   BK_PATH_INDEX            : INT := 2;

   BK_Korr_X                : REAL := 0.0;
   BK_Korr_Y                : REAL := 0.0;
   BK_Korr_Z                : REAL := 0.0;
   BK_Korr_RX               : REAL := 0.0;
   BK_Korr_RY               : REAL := 0.0;
   BK_Korr_RZ               : REAL := 0.0;
   
   BK_Wait                  : DINT := 40;

   BK_Measure_Ok            : BOOL;

   rLinLimit               : REAL;
   rRotLimit               : REAL;

   bSimulateBK             : BOOL;
   iBkKorrPunktNr          : INT;
   bBkKorrFlag             : BOOL;
   iBkAutoPunktNr          : DINT;
   
   sIPAddress              : STRING;
   dPortNumber             : DINT;

   iBkPPNrPreRun           : INT;

   bInSensorCheckHMI       : MAPTO BOOL;
   bOutSensorCheckHMI      : MAPTO BOOL;
   bSensorCheck            : MAPTO BOOL;  // Check of camerasystem
   corrFrameMR             : TMcuFrame;   // corrFrame in Mainrun
   
   // ROVIS
   
   bRovisTelegram          : BOOL; // Telegramm an ROVIS senden
   
   bFinishMeasureAEC       : BOOL;
   bFinishApplicationAEC   : BOOL;
   bReceiveToolAEC         : BOOL; // Ergebnis TCP empfangen
   bReceiveObjectAEC       : BOOL; // Ergebnis Box-Position empfangen
   // ROVIS Schnittstellensignale
   
   // von ROVIS an Robooter
   bRovisReady             : BOOL;
   bRovisPrepared          : BOOL;
   bRovisAcquisition       : BOOL;
   bRovisMeasurement       : BOOL;
   bRovisData              : BOOL;
   iRovisRunMode           : INT;
   iRovisError             : INT;
   RovisResult             : FRAME;
   
   // von Roboter an ROVIS
   iRunMode                : INT;
   iType                   : INT;
   bPrepare                : BOOL;
   bStart                  : BOOL;
   bQuit                   : BOOL;   
   
   TelCounter              : INT;
   
END_VAR   


ROUTINE ReadConfig(locRobot : TRcuRobot) : BOOL
VAR
   bError : BOOL;
   iTemp       : DINT;
   iCatalogHdl : DINT;
END_VAR

   bError := FALSE;
   bCfgDataRead := FALSE;
   instId := RcuGetInstanceId(); //instance identification number (for alarms)
   myRobot := MAP(locRobot);
   IF NOT IS_MAPPED(myRobot) THEN
      RcuSetMessageOnce(TRcVisionBk_ErrMappKin, myRobot.kinListInx, 2, instId, "TRcuVisionIsraBK2.ReadConfig");
      RETURN FALSE;
   END_IF; 
             
   IF CatalogGetHandleRelative(myRobot.rcCatHdl, "ISRA_BK_ROVIS", iCatalogHdl) THEN
      IF CatalogReadIntRange(iCatalogHdl, "Enable", iTemp, 0, 1, FALSE) THEN
         IF (iTemp <> 1) THEN
            myRobot.DebugPrint(eTraceVision, "---------------------------------------");
            myRobot.DebugPrint(eTraceVision, "-------- ISRA BK ROVIS deactivated ----");  
            myRobot.DebugPrint(eTraceVision, "---------------------------------------");
            bCfgDataRead := TRUE;
            RETURN FALSE;
         ELSE
            IF NOT CatalogReadRealRange(iCatalogHdl, "LinearLimit", rLinLimit , 0.0, 50.0, FALSE) THEN
               rLinLimit := 5.0;
            END_IF;
            IF NOT CatalogReadRealRange(iCatalogHdl, "RotationLimit", rRotLimit , 0.0, 5.0, FALSE) THEN
               rRotLimit := 0.5;
            END_IF;
            IF NOT CatalogReadString(iCatalogHdl,"IPAddress", sIPAddress, FALSE) THEN
               bError := TRUE;
            END_IF;
            IF NOT CatalogReadInt(iCatalogHdl, "Portnumber", dPortNumber, FALSE) THEN
               bError := TRUE;
            END_IF;

            IF CatalogReadIntRange(iCatalogHdl, "SimulateBK", iTemp, 0, 1, TRUE) THEN
               bSimulateBK := iTemp = 1;
            ELSE
               bSimulateBK := FALSE;
            END_IF;
         END_IF;
      ELSE  
         bError := TRUE;
         myRobot.DebugPrint(eTraceVision, "ISRA BK ROVIS not enabled");
         RETURN FALSE;
      END_IF;
   ELSE
      bError := TRUE;
      myRobot.DebugPrint(eTraceVision, "No configuration for ISRA BK ROVIS found");
      RETURN FALSE;
   END_IF;

   IF NOT bError THEN
      MapBkSignals();
   END_IF;
   
   IF bMappingOk AND NOT bError THEN
      bCfgDataRead := TRUE;
      RETURN TRUE;
   ELSE
      RcuSetMessageOnce(TRcVisionBk_ErrBkInit, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBK2.ReadConfig");
      myRobot.DebugPrint(eTraceVision, "---------------------------------------");
      myRobot.DebugPrint(eTraceVision, "----- Boot-Up ISRA BK ROVIS failed ----");  
      myRobot.DebugPrint(eTraceVision, "---------------------------------------");
      bCfgDataRead := FALSE;
      RETURN FALSE;
   END_IF;
END_ROUTINE

//------------------------------------------------------------------------
// Initialization and starting coroutines
//------------------------------------------------------------------------
ROUTINE Init()
VAR
   s : STRING;
END_VAR

   IF NOT bCfgDataRead THEN
      RcuSetMessageOnce(TRcVisionBk_ErrBkInit, myRobot.kinListInx, 5, instId, "TRcuVisionIsraBK2.Init");
      RETURN;
   END_IF;
   
   WAIT myRobot.initKinComplete;
   WAIT myRobot.fixPosReady;
   s := "Kin"+STR(myRobot.kinListInx+1)+".SENSOR_CHECK";
   bSensorCheck := MAPX(s);
   IF IS_MAPPED(bSensorCheck) THEN
      START MapSensorCheck();
   ELSE
      WHILE TRUE DO
      myRobot.DebugPrint(eTraceVision,"SENSOR_CHECK = " + s + " not mapped");
         RcuSetMessageOnce(TRcVisionBk_ErrSensorCheckNMap, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBk2.Init", s);
	 WAIT NOT myRobot.svMotionAllowed;
	 myRobot.WaitMcMicroCycles(3);
	 WAIT myRobot.svMotionAllowed;
      END_WHILE;
   END_IF;

   bInSensorCheckHMI  := MAPX(cSV_InSensorCheck[myRobot.kinListInx]); 
   bOutSensorCheckHMI := MAPX(cSV_OutSensorCheck[myRobot.kinListInx]);
   IF NOT IS_MAPPED(bInSensorCheckHMI) THEN
      myRobot.DebugPrint(eTraceVision,"SENSOR_CHECK HMI interface = " + cSV_InSensorCheck[myRobot.kinListInx] + " not mapped");
   ELSIF NOT IS_MAPPED(bOutSensorCheckHMI) THEN
      myRobot.DebugPrint(eTraceVision,"SENSOR_CHECK HMI interface = " + cSV_OutSensorCheck[myRobot.kinListInx] + " not mapped");
   ELSE
      START SensorCheckHMI();
   END_IF;

   //Wird bei ISRA nicht benötigt, da Simulationsbetrieb unterstützt wird. BIT 07.08.2014
   //myRobot.vision.bBKGhostMode   := UPDATE(myRobot.fieldbusIn.GhostMode.svBool);

   START ObserveBkActive();
   START ObserveErrorQuit();
   START ObserveBkModus();
   START BkSignalsToEPS() PRIO 3;
   
   myRobot.DebugPrint(eTraceVision, "---------------------------------------");
   myRobot.DebugPrint(eTraceVision, "---  Boot-up ISRA_BK_ROVIS finished ---");
   myRobot.DebugPrint(eTraceVision, "---------------------------------------");
   myRobot.vision.bBKBootUpOk := TRUE;
   
   // Kemroskop test
   SwoAddBoolVariable(bBK_SIG_TRIGGER,                       "BK.SIG_TRIGGER");
   
   corrFrameMR.mFrameTyp := eMcuFrameKardan;
   
   IF myRobot.vision.iLoggerNumber <> 0 THEN
      iLoggerNumber := myRobot.vision.iLoggerNumber;
   ELSE
      iLoggerNumber  := myRobot.logger.ActivateLogger("TRcuVisionBK", myRobot);
   END_IF;

   myRobot.logger.SetLoggerStep(iLoggerNumber, "ISRA BK ROVIS initialized");

   (*
   SwoAddBoolVariable(bRovisReady,"BK.bRovisReady");
   SwoAddBoolVariable(bRovisPrepared,"BK.bRovisPrepared");
   SwoAddBoolVariable(bRovisAcquisition,"BK.bRovisAcquisition");
   SwoAddBoolVariable(bRovisMeasurement,"BK.bRovisMeasurement");
   SwoAddBoolVariable(bRovisData,"BK.bRovisData");
   SwoAddBoolVariable(bSensorCheck,"BK.bSensorCheck");
   SwoAddBoolVariable(bRovisTelegram,"BK.bRovisTelegram");
   SwoAddBoolVariable(bPrepare,"BK.bPrepare");
   SwoAddBoolVariable(bStart,"BK.bStart");
   SwoAddBoolVariable(bQuit,"BK.bQuit");
   SwoAddIntVariable(iRovisRunMode,"BK.iRovisRunMode");
   SwoAddIntVariable(iType,"BK.iType");
   SwoAddIntVariable(iRunMode,"BK.iRunMode");
   SwoAddIntVariable(iRovisError,"BK.iRovisError");
   SwoAddIntVariable(BK_PATH,"BK.BK_PATH");
   *)
   RETURN;
END_ROUTINE


//****************************************
// Paket:    VMT BK 
// Funktion: BK initialisieren
// Version:  
// Name:     F.Höfts
// Datum:    16.09.2008
// Aenderungen: 
//****************************************
ROUTINE BK_Init()
VAR
   timeOut : BOOL;
END_VAR   

   IF NOT myRobot.vision.bBKBootUpOk THEN
      
   END_IF;
   IF bDisabledHMI THEN
       myRobot.DebugPrint(eTraceVision, "BK_INIT is disabled by HMI");
   ELSE
       myRobot.DebugPrint(eTraceVision, "BK_Init");
   END_IF;
   
   BK_TYPE                                 := 0;
   BK_PATH                                 := 0;
   BK_MODUS                                := Mode_Off;
   BK_RequestCount                         := 0;
   BK_ScanRobPos                           := 0;
   BK_TriggerCount                         := 0;
   BK_NumberOfPoints                       := 0;
   bPointCountValid                        := FALSE;
   bCommError                              := FALSE;
   
   IF bDisabledHMI THEN
      RETURN ;
   END_IF;
    
   SysTimerSet(10000, timeOut);
   bBkConnect                              := TRUE;
   WAIT bBkActive OR timeOut OR bSimulateBK OR bDisabledHMI;
   IF bDisabledHMI THEN
       myRobot.DebugPrint(eTraceVision, "BK_INIT is disabled by HMI");
   ELSIF timeOut THEN
      myRobot.DebugPrint(eTraceVision, "TimeOut in BK_Init by waiting for bBkActive");
      RcuSetMessageOnce(TRcVisionBk_ErrTimeOut, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.BK_Init", "BK_INIT", "bBkActive");
      bCommError := TRUE;
      bBkConnect := FALSE;
      myRobot.ErrorReaction(TRUE);
      RETURN;
   END_IF;
   
END_ROUTINE


//****************************************
// Paket:    VMT BK 
// Funktion: BK Start + Auswahl Modus Messung, MP/BP Referenz, Applikation
// Version:  
// Name:     F.Höfts
// Datum:    27.05.2009
// Aenderungen: 
//****************************************
ROUTINE BK_Start(Typ : INT; Bahn : INT; Modus : BK_MODE_TYPE)
VAR
   i       : INT;
   j       : INT;
   bEXIT   : BOOL;
   sText   : STRING;
   timeOut : BOOL;
END_VAR


   BK_MODUS := Modus;
   BK_TYPE  := Typ;
   BK_PATH  := Bahn;
   bOverflowError := FALSE;
   bSyncRobots    := FALSE;
   IF bDisabledHMI THEN
      myRobot.DebugPrint(eTraceVision, "BK_START is disabled by HMI");
      RETURN;
   END_IF;
   IF client.tcpConnectionState <> stateSckConnected THEN
      myRobot.DebugPrint(eTraceVision, "BK_Start: Communication to Vision PC: ConnectionState <> stateSckConnected");
      IF (BK_MODUS = ModeMeasure) OR (BK_MODUS = Mode_AEC_Measure)THEN
         RcuSetMessageOnce(TRcVisionBk_ErrTcpIpConnect, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.BK_Start");
         bCommError := TRUE;         
         myRobot.ErrorReaction(TRUE);
         RETURN;
      END_IF;
   END_IF;
   
   //;HALT 
   sText := "BK_Start: Type = "+STR(Typ)+" Path = "+STR(Bahn)+" Mode = "+STR(Modus);
   myRobot.DebugPrint(eTraceVision, sText);
   myRobot.logger.SetLoggerStep(iLoggerNumber, sText);
   
   IF (BK_MODUS = Mode_AEC_Application) OR (BK_MODUS = ModeApplication) THEN // Keine ROVIS-Beauftragung
      IF (BK_MODUS = ModeApplication) THEN
         myRobot.DebugPrint(eTraceVision, " A p p l i c a t i o n");
         myRobot.logger.SetLoggerStep(iLoggerNumber, " A p p l i c a t i o n");
      ELSE
         myRobot.DebugPrint(eTraceVision, " A E C");
         myRobot.logger.SetLoggerStep(iLoggerNumber, " A E C");
      END_IF;
   ELSE
   
      IF (BK_MODUS = Mode_AEC_Measure) THEN
         myRobot.DebugPrint(eTraceVision, " A E C");
         myRobot.logger.SetLoggerStep(iLoggerNumber, " A E C");
      END_IF;
      SysTimerSet(10000, timeOut);
      WAIT (TelCounter <> 0) OR timeOut; // auf erstes Telegramm von ROVIS warten
      IF timeOut THEN
         myRobot.DebugPrint(eTraceVision, "TimeOut in BK_START by waiting for TelCounter <> 0");
         bCommError := TRUE;
         RcuSetMessageOnce(TRcVisionBk_ErrTimeOut, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.BK_Start", "BK_START", "TelCounter <> 0");
         myRobot.ErrorReaction(TRUE);
      END_IF;
      
      SysTimerSet(10000, timeOut);
      WAIT bRovisReady OR timeOut OR (iRovisError <> 0) OR bSimulateBK;
      IF timeOut THEN
         myRobot.DebugPrint(eTraceVision, "TimeOut in BK_START by waiting for bRovisReady");
         bCommError := TRUE;
         RcuSetMessageOnce(TRcVisionBk_ErrTimeOut, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.BK_Start", "BK_START", "ROVIS Ready");
         myRobot.ErrorReaction(TRUE);
      ELSIF (iRovisError <> 0) THEN
         iRunMode := 0;              // Fehler quittieren
         iType    := 0;
         bPrepare := FALSE;
         bStart   := FALSE;
         bQuit    := TRUE;
         bRovisTelegram := TRUE;
         WAIT NOT bRovisTelegram;  // Telegramm gesendet
         
         // WAIT bRovisReady OR timeOut;
         WAIT (bRovisReady AND (iRovisError = 0)) OR timeOut OR bSimulateBK;; // 06.06.2016 Mai/ISRA
         IF timeOut THEN
            myRobot.DebugPrint(eTraceVision, "TimeOut in BK_START by waiting for (bRovisReady AND (iRovisError = 0))");
            bCommError := TRUE;
            RcuSetMessageOnce(TRcVisionBk_ErrTimeOut, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.BK_Start", "BK_START", "(bRovisReady AND (iRovisError = 0))");
            myRobot.ErrorReaction(TRUE);
         END_IF;
      END_IF;
   
      IF (BK_MODUS = Mode_AEC_Measure) THEN
         // Runmode = 8 senden, wenn ROVIS nicht in Nullmessung
         IF iRovisRunMode <> 8 THEN
            iRunMode := 8;  // Betriebsart = Nullmessung
            iType    := 0;
            bPrepare := FALSE;
            bStart   := FALSE;
            bQuit    := FALSE;
            bRovisTelegram := TRUE;
            WAIT NOT bRovisTelegram;  // Telegramm gesendet
            // Warten bis Runmode = 2 empfangen
            SysTimerSet(10000, timeOut);
            WAIT (iRovisRunMode = 2) OR timeOut OR bSimulateBK;
            IF timeOut THEN
               bCommError := TRUE;
               RcuSetMessageOnce(TRcVisionBk_ErrTimeOut, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.BK_Start", "BK_START", "ROVIS Automatic");
               myRobot.ErrorReaction(TRUE);
            END_IF;
         END_IF;
      ELSE
         // Runmode = 2 senden, wenn ROVIS nicht in Automatik
         IF iRovisRunMode <> 2 THEN
            iRunMode := 2;  // Betriebsart = Automatik
            iType    := 0;
            bPrepare := FALSE;
            bStart   := FALSE;
            bQuit    := FALSE;
            bRovisTelegram := TRUE;
            WAIT NOT bRovisTelegram;  // Telegramm gesendet
            // Warten bis Runmode = 2 empfangen
            SysTimerSet(10000, timeOut);
            WAIT (iRovisRunMode = 2) OR timeOut OR bSimulateBK;
            IF timeOut THEN
               bCommError := TRUE;
               RcuSetMessageOnce(TRcVisionBk_ErrTimeOut, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.BK_Start", "BK_START", "ROVIS Automatic");
               myRobot.ErrorReaction(TRUE);
            END_IF;
         END_IF;
      END_IF;
      
      iRunMode := 0;              // alles zurücksetzen
      iType    := 0;
      bPrepare := FALSE;
      bStart   := FALSE;
      bQuit    := FALSE;
      bRovisTelegram := TRUE;
      WAIT NOT bRovisTelegram;  // Telegramm gesendet

      iRunMode := 0;
      iType    := Typ;
      bPrepare := TRUE;
      bStart   := FALSE;
      bQuit    := FALSE;
      bRovisTelegram := TRUE;
      WAIT NOT bRovisTelegram;  // Telegramm gesendet

      SysTimerSet(10000, timeOut);
      WAIT bRovisPrepared OR (iRovisError<>0) OR timeOut OR bSimulateBK; // Status Prepared = 1 erwarten
      IF (iRovisError <> 0) THEN
         myRobot.DebugPrint(eTraceVision, "BK_Start Type " + STR(Typ) + " Wrong Type");
         myRobot.logger.SetLoggerStep(iLoggerNumber, "ISRA BK_Start Type " + STR(Typ) + " Wrong Type");
         RcuSetMessageOnce(TRcVisionBk_ErrWrongType, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.BK_Start", STR(Typ), "BK_START");
         myRobot.ErrorReaction(TRUE);
      ELSIF timeOut THEN
         bCommError := TRUE;
         RcuSetMessageOnce(TRcVisionBk_ErrTimeOut, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.BK_Start", "BK_START", "ROVIS Prepared");
         myRobot.ErrorReaction(TRUE);
      END_IF;

      iType    := 0;
      bPrepare := FALSE;
      bStart   := TRUE;
      bRovisTelegram := TRUE;
      WAIT NOT bRovisTelegram;  // Telegramm gesendet

      SysTimerSet(10000, timeOut);
      WAIT (bRovisAcquisition AND bRovisMeasurement) OR timeOut OR bSimulateBK;
      IF timeOut THEN
         bCommError := TRUE;
         RcuSetMessageOnce(TRcVisionBk_ErrTimeOut, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.BK_Start", "BK_START", "ROVIS Acquisition & Measurement");
         myRobot.ErrorReaction(TRUE);
      END_IF;

      bStart   := FALSE;
      (* 02.02.2015 wg. Pilatus ISRA
      bRovisTelegram := TRUE;
      WAIT NOT bRovisTelegram;  // Telegramm gesendet
      *)
   END_IF;



   CASE BK_MODUS OF
     Mode_Off :
       ;

     ModeMeasure: //Messung
     
     Mode_AEC_Measure: // Sensortoolberechnung

     ModeApplication:
     
     Mode_AEC_Application:

      ELSE
         RcuSetMessageOnce(TRcVisionBk_ErrInvMode, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBK2.BK_Start", STR(BK_MODUS));
         BK_MODUS := Mode_Off;

   END_CASE;


   BK_RequestCount := 1;
   BK_ScanRobPos := 1;
   BK_TriggerCount := 0;
   BK_NumberOfPoints := 0;
   bBK_SIG_TRIGGER := FALSE;
   IF (BK_MODUS = ModeMeasure) OR (BK_MODUS = Mode_AEC_Measure) THEN

     // Aktuelle Messpositionen loeschen
     FOR i := 1 TO MaxPunkteProMessung DO
       BKMessPos[i] := NULLFRAME;
       BKMessPunkt[i] := 0;
     END_FOR;

      BK_Measure_Ok := TRUE;

     // Evtl. vorhandene Korrekturen loeschen
     FOR i := 1 TO 5 DO
       IF (BK_KORR_BAHN_ID[i] = BK_PATH) OR (BK_KORR_BAHN_ID[i] = -BK_PATH) THEN
         BK_KORR_BAHN_ID[i] := 0;
         BK_KORREKTUREN_GUELTIG[i] := 0;
         FOR j := 1 TO MaxPunkteProMessung DO
           BK_KORREKTUR[i][j] := NULLFRAME;
         END_FOR;
         IF (BK_KORR_BAHNEN > 0) THEN
           BK_KORR_BAHNEN := BK_KORR_BAHNEN - 1;
         END_IF;
       END_IF;
     END_FOR;

         //BahnIndex bestimmen
         BK_PATH_INDEX := 0;
         FOR i := 1 TO 5 DO
            IF (BK_KORR_BAHN_ID[i] = BK_PATH) THEN
               BK_PATH_INDEX := i;
            END_IF;
         END_FOR;
         //Keine aktuellen Ergebnisse fuer diese Bahn gefunden
         IF (BK_PATH_INDEX = 0) THEN
            // Erste freie Stelle suchen
            i := 1;
            bEXIT := FALSE;
            WHILE (i <= 5) AND NOT bEXIT DO
               IF (BK_KORR_BAHN_ID[i] = 0) THEN
                  BK_PATH_INDEX := i;
                  BK_KORR_BAHN_ID[i] := BK_PATH;
                  BK_KORR_BAHNEN := BK_KORR_BAHNEN + 1;
                  BK_KORREKTUREN_GUELTIG[i] := 0;
                  FOR j := 1 TO MaxPunkteProMessung DO
                     BK_KORREKTUR[i][j] := NULLFRAME;
                     BK_KORR_PUNKT_ID[i][j] := 0;
                  END_FOR;
                  bEXIT := TRUE;
               END_IF; 
               i := i+1;
            END_WHILE;
         END_IF;

         // Kein freier Platz mehr - einen loeschen (den ersten bereits abgeholten)
         IF (BK_PATH_INDEX = 0) THEN
            // Erste freie Stelle suchen
            i := 1;
            bEXIT := FALSE;
            WHILE (i <= 5) AND NOT bEXIT DO
               IF (BK_KORR_BAHN_ID[i] < 0) THEN
                  BK_PATH_INDEX := i;
                  BK_KORR_BAHN_ID[i] := BK_PATH;
                  BK_KORR_BAHNEN := BK_KORR_BAHNEN + 1;
                  BK_KORREKTUREN_GUELTIG[i] := 0;
                  FOR j := 1 TO MaxPunkteProMessung DO
                     BK_KORREKTUR[i][j] := NULLFRAME;
                     BK_KORR_PUNKT_ID[i][j] := 0;
                  END_FOR;
                  bEXIT := TRUE;
               END_IF; 
               i := i+1;
            END_WHILE;
         END_IF;

   END_IF;

   IF (BK_MODUS = ModeApplication) OR (BK_MODUS = Mode_AEC_Application) THEN
   
      // Aktuelle Messpositionen loeschen da im Teachbetrieb Applikationsfahrt mehrfach wiederholt wird
      // delete current measurement positions because in T1/T2 the application is repeated several times
      FOR i := 1 TO MaxPunkteProMessung DO
          BKMessPos[i] := NULLFRAME;
          BKMessPunkt[i] := 0;
      END_FOR; 
      //BahnIndex bestimmen
      iBkAutoPunktNr := 0;
      BK_PATH_INDEX := 0;
      FOR i := 1 TO 5 DO
         // BK_KORR_BAHN_ID[i] = -BK_PATH) ... Bahn wurde schon einmal abgefahren!!!!!
         IF ((BK_KORR_BAHN_ID[i] = BK_PATH) OR (BK_KORR_BAHN_ID[i] = -BK_PATH)) THEN
            BK_PATH_INDEX := i;
         END_IF;
      END_FOR;
      IF (BK_PATH_INDEX = 0) THEN
         myRobot.DebugPrint(eTraceVision, "BK_Start: BK_PATH_INDEX = 0");
         RcuSetMessageOnce(TRcVisionBk_ErrInvPath, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBK2.BK_Start", STR(BK_TYPE), STR(BK_PATH));
      END_IF;
   END_IF;

END_ROUTINE


//==========================================================
ROUTINE Prerun_BK_Ende(AnzahlPunkte : INT)
   
   // Die Anzahl der Trigger und die Anzahl der BK_CORR auf der Bahn sind jetzt bekannt
   myRobot.DebugPrint(eTraceVision, "Prerun_BK_Ende AnzahlPunkte = "+STR(AnzahlPunkte)+" BK_TriggerCount = "+STR(BK_TriggerCount));
   myRobot.DebugPrint(eTraceVision, "Prerun_BK_Ende AnzahlPunkte = "+STR(AnzahlPunkte)+" BK_NumberOfPoints = "+STR(BK_NumberOfPoints));
   bPointCountValid := TRUE;
 END_ROUTINE

//==========================================================
ROUTINE BK_Ende(AnzahlPunkte : INT; OPTIONAL iRetVal : VISION_STATE) : BOOL   

VAR
   i            : INT;
   j            : INT;
   timeOut      : BOOL;
   bEXIT        : BOOL;
   corrFrame    : TMcuFrame;
   bk_ok        : BOOL := TRUE;
   outString1   : STRING;
   outString2   : STRING;
   strLen1      : INT;
   error        : BOOL;
   bPlcFeedback : BOOL;
END_VAR

   myRobot.DebugPrint(eTraceVision, "BK_Ende: Number of points = "+STR(AnzahlPunkte));

   CASE BK_MODUS OF
      ModeMeasure:

         IF bDisabledHMI THEN
            bk_ok  := FALSE;
            myRobot.DebugPrint(eTraceVision, "BK_Ende is disabled by HMI");
         ELSIF client.tcpConnectionState <> stateSckConnected THEN
            RcuSetMessageOnce(TRcVisionBk_ErrTcpIpConnect, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.BK_Ende");
            bCommError := TRUE;         
         ELSE
            //Warten bis alle Messpunkte an Vision uebertragen worden sind ( in BK_SendData )
            timeOut := FALSE;
            SysTimerSet(10000, timeOut);
            WAIT (BK_RequestCount >= BK_ScanRobPos) OR timeOut;
            IF timeOut THEN
               myRobot.DebugPrint(eTraceVision, "TimeOut in BK_Ende by waiting for BK_RequestCount >= BK_ScanRobPos");
               RcuSetMessageOnce(TRcVisionBk_ErrTimeOutSend, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBK2.BK_Ende", "BK_FINISH");
            END_IF;
            
            // Warten bis alle Korrekturen von ISRA empfangen worden sind 
            bk_ok   := TRUE;
            timeOut := FALSE;
            SysTimerSet(10000, timeOut);
            WAIT (BK_KORREKTUREN_GUELTIG[BK_PATH_INDEX] > AnzahlPunkte) OR timeOut OR bSimulateBK;
            IF timeOut THEN
               myRobot.DebugPrint(eTraceVision, "TimeOut in BK_Ende by waiting for BK_KORREKTUREN_GUELTIG[BK_PATH_INDEX] >= AnzahlPunkte");
               IF IS_USED(iRetVal) THEN
                  RcuSetMessageOnce(TRcVisionBk_ErrTimeOutBkEnd, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBK2.BK_Ende");
                  error := TRUE;
               ELSE
                  BK_MODUS := Mode_Off;
                  RcuSetMessageOnce(TRcVisionBk_ErrTimeOutBkEnd, myRobot.kinListInx, 2, instId, "TRcuVisionIsraBK2.BK_Ende");
                  RETURN FALSE;
               END_IF;
            END_IF;
            
            BK_MODUS := Mode_Off; 
            
            IF (BK_KORREKTUREN_GUELTIG[BK_PATH_INDEX]-1 <> AnzahlPunkte) AND NOT error AND NOT bSimulateBK THEN
               RcuSetMessageOnce(TRcVisionBk_ErrPointNo, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBK2.BK_Ende", STR(AnzahlPunkte), STR(BK_ScanRobPos-1));
               bk_ok := FALSE;
            END_IF;
         END_IF;
                        
         bk_ok := bk_ok AND BK_Measure_Ok AND NOT (error OR bCommError);
         
      Mode_AEC_Measure:
         myRobot.DebugPrint(eTraceVision, "BK_Ende: BK_MODUS = BK_MODUS_AEC_MEASURE");
         bFinishMeasureAEC := TRUE;
         WAIT NOT bFinishMeasureAEC;
         myRobot.DebugPrint(eTraceVision, "BK_Ende: FinishApplicationAEC");
         bFinishApplicationAEC :=  TRUE;
         WAIT NOT bFinishApplicationAEC;
   
      
      Mode_AEC_Application,
      ModeApplication:
         IF (BK_MODUS = Mode_AEC_Application) THEN
            myRobot.DebugPrint(eTraceVision, "BK_Ende: BK_MODUS = BK_MODUS_AEC_APPLICATION");
            bFinishApplicationAEC :=  TRUE;
            WAIT NOT bFinishApplicationAEC;
         ELSE
            myRobot.DebugPrint(eTraceVision, "BK_Ende: BK_MODUS = BK_MODUS_APPLICATION");
         END_IF;
         
         //Base Verschiebung
         corrFrame.mFrameTyp := eMcuFrameKardan;
         corrFrame.mPos.mValues[0] := 0.0;
         corrFrame.mPos.mValues[1] := 0.0;
         corrFrame.mPos.mValues[2] := 0.0;
         corrFrame.mOri.mValues[0] := 0.0;
         corrFrame.mOri.mValues[1] := 0.0;
         corrFrame.mOri.mValues[2] := 0.0;
         RcuRefSysSetKardan(myRobot.RcuRefSystemObject, corrFrame, myRobot.RcuRefSystemVisionRel, FALSE, "Object");
         myRobot.homing.StoreRefSystemVision(FALSE, corrFrame);
         CalcActualObject(corrFrame, FALSE);  // FALSE because of STOPPOINT in Macro BK_FINISH
         BK_MODUS := Mode_Off;
         //die letzten Korrekturen schon mal freigeben
         IF (BK_PATH_INDEX = 0) THEN
            //$MSG_T.RELEASE = TRUE
            myRobot.DebugPrint(eTraceVision, "BK_Ende: BK_PATH_INDEX = 0");
            RcuSetMessageOnce(TRcVisionBk_ErrInvPath, myRobot.kinListInx, 2, instId, "TRcuVisionIsraBK2.BK_Ende", STR(BK_TYPE), STR(BK_PATH));
        ELSE
            BK_KORR_BAHN_ID[BK_PATH_INDEX] := -BK_KORR_BAHN_ID[BK_PATH_INDEX];
        END_IF;
   END_CASE;

   BK_TYPE                                 := 0;
   BK_PATH                                 := 0;
   BK_MODUS                                := Mode_Off;
   BK_RequestCount                         := 0;
   BK_ScanRobPos                           := 0;
   BK_TriggerCount                         := 0;
   BK_NumberOfPoints                       := 0;
   IF bOverflowError THEN
      RcuSetMessageOnce(TRcVisionBk_ErrValOutOfRange, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBK2.BK_Ende");
      bOverflowError := FALSE;
      bk_ok          := FALSE;
   END_IF;
   timeOut := FALSE;
   SysTimerSet(10000, timeOut);
   bBkConnect := FALSE;
   WAIT NOT bBkActive OR timeOut OR bDisabledHMI;
   IF timeOut THEN
      myRobot.DebugPrint(eTraceVision, "TimeOut in BK_Ende by waiting for bBkConnect = FALSE");
      RcuSetMessageOnce(TRcVisionBk_ErrTimeOutBkEnd, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBK2.BK_Ende");
   END_IF;
   
   IF IS_USED(iRetVal) THEN   
      IF bk_ok AND NOT bSyncRobots THEN
         myRobot.fieldbusOut.VisionError.svBool   := FALSE;
         myRobot.fieldbusOut.ReqSyncVision.svBool := FALSE;
         iRetVal := DataOk;
         RETURN TRUE;
      ELSIF bk_ok AND bSyncRobots THEN
         myRobot.fieldbusOut.VisionError.svBool   := FALSE;
         myRobot.fieldbusOut.ReqSyncVision.svBool := TRUE;
         bPlcFeedback := UPDATE(myRobot.fieldbusIn.AckSyncVision.svBool OR myRobot.fieldbusIn.GoDirectHome.svBool OR myRobot.fieldbusIn.DoRemeasure.svBool OR myRobot.fieldbusIn.Continue.svBool);
         myRobot.logger.SetLoggerStep(iLoggerNumber, "BK_FINISH - Sync - waiting AckSyncVision or GoDirectHome or DoRemeasure or Continue");
      ELSE 
         IF NOT BK_Measure_Ok  THEN
            RcuSetMessageOnce(TRcVisionBk_ErrStateNotOk, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBK2.BK_Ende");
         END_IF;
         myRobot.fieldbusOut.VisionError.svBool   := TRUE;
         myRobot.fieldbusOut.ReqSyncVision.svBool := bSyncRobots;
         IF bSyncRobots THEN
            myRobot.logger.SetLoggerStep(iLoggerNumber, "BK_FINISH - Sync Error detected - waiting GoDirectHome or DoRemeasure or Continue");
         ELSE
            myRobot.logger.SetLoggerStep(iLoggerNumber, "BK_FINISH - Error detected - waiting GoDirectHome or DoRemeasure or Continue");
         END_IF;
         bPlcFeedback := UPDATE(myRobot.fieldbusIn.GoDirectHome.svBool OR myRobot.fieldbusIn.DoRemeasure.svBool OR myRobot.fieldbusIn.Continue.svBool);
      END_IF;
      
      WAIT bPlcFeedback;
      myRobot.fieldbusOut.VisionError.svBool   := FALSE;
      myRobot.fieldbusOut.ReqSyncVision.svBool := FALSE;
      IF myRobot.fieldbusIn.DoRemeasure.svBool THEN
         myRobot.logger.SetLoggerStep(iLoggerNumber, "BK_FINISH- DoRemeasure received from PLC");
         WAIT NOT myRobot.fieldbusIn.DoRemeasure.svBool;
         iRetVal := Remeasure;
      ELSIF myRobot.fieldbusIn.GoDirectHome.svBool THEN
         myRobot.logger.SetLoggerStep(iLoggerNumber, "BK_FINISH - GoDirectHome received from PLC");   
         WAIT NOT myRobot.fieldbusIn.GoDirectHome.svBool;
         iRetVal := GoHome;
      ELSIF myRobot.fieldbusIn.Continue.svBool THEN
         myRobot.logger.SetLoggerStep(iLoggerNumber, "BK_FINISH - Continue received from PLC");
         WAIT NOT myRobot.fieldbusIn.Continue.svBool;
         iRetVal := Continue;    
      ELSIF myRobot.fieldbusIn.AckSyncVision.svBool THEN  
         myRobot.logger.SetLoggerStep(iLoggerNumber, "BK_FINISH - Ack Sync received from PLC");
         WAIT NOT myRobot.fieldbusIn.AckSyncVision.svBool;
         iRetVal := DataOk;
      END_IF;
   END_IF;
   
   RETURN bk_ok;
   
END_ROUTINE  


//==========================================================
ROUTINE BK_Ende2(AnzahlPunkte : INT; AnzahlKorrekturen : INT; OPTIONAL iRetVal : VISION_STATE) : BOOL   

VAR
   i            : INT;
   j            : INT;
   timeOut      : BOOL;
   bEXIT        : BOOL;
   corrFrame    : TMcuFrame;
   bk_ok        : BOOL := TRUE;
   outString1   : STRING;
   outString2   : STRING;
   strLen1      : INT;
   error        : BOOL;
   bPlcFeedback : BOOL;
END_VAR

   myRobot.DebugPrint(eTraceVision, "BK_Ende: Number of triggerpoints = "+STR(AnzahlPunkte)+" Number of corrections = "+STR(AnzahlKorrekturen));

   CASE BK_MODUS OF
      ModeMeasure:

         IF bDisabledHMI THEN
            bk_ok  := FALSE;
            BK_Measure_Ok := FALSE;
            myRobot.DebugPrint(eTraceVision, "BK_Ende2 is disabled by HMI");
         ELSIF client.tcpConnectionState <> stateSckConnected THEN
            RcuSetMessageOnce(TRcVisionBk_ErrTcpIpConnect, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.BK_Ende2");
            bCommError := TRUE;         
            bk_ok  := FALSE;
         ELSE
            //Warten bis alle Messpunkte an Vision uebertragen worden sind ( in BK_SendData )
            timeOut := FALSE;
            SysTimerSet(10000, timeOut);
            WAIT (BK_RequestCount >= BK_ScanRobPos) OR timeOut;
            IF timeOut THEN
               myRobot.DebugPrint(eTraceVision, "TimeOut in BK_Ende by waiting for BK_RequestCount >= BK_ScanRobPos");
               RcuSetMessageOnce(TRcVisionBk_ErrTimeOutSend, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBK2.BK_Ende2", "BK_FINISH");
            END_IF;
            
            // Warten bis alle Korrekturen von ISRA empfangen worden sind 
            bk_ok   := TRUE;
            timeOut := FALSE;
            IF NOT bSimulateBK THEN
               SysTimerSet(10000, timeOut);
               WAIT (BK_KORREKTUREN_GUELTIG[BK_PATH_INDEX] > AnzahlKorrekturen) OR timeOut;
               IF timeOut THEN
                  myRobot.DebugPrint(eTraceVision, "TimeOut in BK_Ende by waiting for BK_KORREKTUREN_GUELTIG[BK_PATH_INDEX] >= AnzahlKorrekturen");
                  IF IS_USED(iRetVal) THEN
                     RcuSetMessageOnce(TRcVisionBk_ErrTimeOutBkEnd, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBK2.BK_Ende2");
                     error := TRUE;
                  ELSE
                     BK_MODUS := Mode_Off;
                     RcuSetMessageOnce(TRcVisionBk_ErrTimeOutBkEnd, myRobot.kinListInx, 2, instId, "TRcuVisionIsraBK2.BK_Ende2");
                     RETURN FALSE;
                  END_IF;
               END_IF;

               BK_MODUS := Mode_Off; 

               IF (BK_KORREKTUREN_GUELTIG[BK_PATH_INDEX]-1 <> AnzahlKorrekturen) AND NOT error THEN
                  RcuSetMessageOnce(TRcVisionBk_ErrPointNo, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBK2.BK_Ende", STR(AnzahlKorrekturen), STR(BK_KORREKTUREN_GUELTIG[BK_PATH_INDEX]-1));
                  bk_ok := FALSE;
               END_IF;
            END_IF;
         END_IF;
                        
         bk_ok := bk_ok AND BK_Measure_Ok AND NOT (error OR bCommError);
         
      Mode_AEC_Measure:
         myRobot.DebugPrint(eTraceVision, "BK_Ende: BK_MODUS = BK_MODUS_AEC_MEASURE");
         bFinishMeasureAEC := TRUE;
         WAIT NOT bFinishMeasureAEC;
         myRobot.DebugPrint(eTraceVision, "BK_Ende: FinishApplicationAEC");
         bFinishApplicationAEC :=  TRUE;
         WAIT NOT bFinishApplicationAEC;
      
      Mode_AEC_Application,
      ModeApplication:
         IF (BK_MODUS = Mode_AEC_Application) THEN
            myRobot.DebugPrint(eTraceVision, "BK_Ende: BK_MODUS = BK_MODUS_AEC_APPLICATION");
            bFinishApplicationAEC :=  TRUE;
            WAIT NOT bFinishApplicationAEC;
         ELSE
            myRobot.DebugPrint(eTraceVision, "BK_Ende: BK_MODUS = BK_MODUS_APPLICATION");
         END_IF;
         
         //Base Verschiebung
         corrFrame.mFrameTyp := eMcuFrameKardan;
         corrFrame.mPos.mValues[0] := 0.0;
         corrFrame.mPos.mValues[1] := 0.0;
         corrFrame.mPos.mValues[2] := 0.0;
         corrFrame.mOri.mValues[0] := 0.0;
         corrFrame.mOri.mValues[1] := 0.0;
         corrFrame.mOri.mValues[2] := 0.0;
         RcuRefSysSetKardan(myRobot.RcuRefSystemObject, corrFrame, myRobot.RcuRefSystemVisionRel, FALSE, "Object");
         myRobot.homing.StoreRefSystemVision(FALSE, corrFrame);
         CalcActualObject(corrFrame, FALSE);  // FALSE because of STOPPOINT in Macro BK_FINISH
         BK_MODUS := Mode_Off;
         //die letzten Korrekturen schon mal freigeben
         IF (BK_PATH_INDEX = 0) THEN
            //$MSG_T.RELEASE = TRUE
            myRobot.DebugPrint(eTraceVision, "BK_Ende: BK_PATH_INDEX = 0");
            RcuSetMessageOnce(TRcVisionBk_ErrInvPath, myRobot.kinListInx, 2, instId, "TRcuVisionIsraBK2.BK_Ende", STR(BK_TYPE), STR(BK_PATH));
        ELSE
            BK_KORR_BAHN_ID[BK_PATH_INDEX] := -BK_KORR_BAHN_ID[BK_PATH_INDEX];
        END_IF;
   END_CASE;

   IF NOT BK_Measure_Ok  THEN
      RcuSetMessageOnce(TRcVisionBk_ErrStateNotOk, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBK2.BK_Ende2");
   END_IF;
         
   BK_TYPE                                 := 0;
   BK_PATH                                 := 0;
   BK_MODUS                                := Mode_Off;
   BK_RequestCount                         := 0;
   BK_ScanRobPos                           := 0;
   BK_TriggerCount                         := 0;
   BK_NumberOfPoints                       := 0;
   IF bOverflowError THEN
      RcuSetMessageOnce(TRcVisionBk_ErrValOutOfRange, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBK2.BK_Ende2");
      bOverflowError := FALSE;
      bk_ok          := FALSE;
   END_IF;
   
   timeOut := FALSE;
   SysTimerSet(10000, timeOut);
   bBkConnect := FALSE;
   WAIT NOT bBkActive OR timeOut OR bDisabledHMI;
   IF timeOut THEN
      myRobot.DebugPrint(eTraceVision, "TimeOut in BK_Ende by waiting for bBkConnect = FALSE");
      RcuSetMessageOnce(TRcVisionBk_ErrTimeOutBkEnd, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBK2.BK_Ende2");
   END_IF;
   
   IF IS_USED(iRetVal) THEN   
      IF bk_ok AND NOT bSyncRobots THEN
         myRobot.fieldbusOut.VisionError.svBool   := FALSE;
         myRobot.fieldbusOut.ReqSyncVision.svBool := FALSE;
         iRetVal := DataOk;
         RETURN TRUE;
      ELSIF bk_ok AND bSyncRobots THEN
         myRobot.fieldbusOut.VisionError.svBool   := FALSE;
         myRobot.fieldbusOut.ReqSyncVision.svBool := TRUE;
         bPlcFeedback := UPDATE(myRobot.fieldbusIn.AckSyncVision.svBool OR myRobot.fieldbusIn.GoDirectHome.svBool OR myRobot.fieldbusIn.DoRemeasure.svBool OR myRobot.fieldbusIn.Continue.svBool);
         myRobot.logger.SetLoggerStep(iLoggerNumber, "BK_FINISH - Sync - waiting AckSyncVision or GoDirectHome or DoRemeasure or Continue");
      ELSE 
         myRobot.fieldbusOut.VisionError.svBool   := TRUE;
         myRobot.fieldbusOut.ReqSyncVision.svBool := bSyncRobots;
         IF bSyncRobots THEN
            myRobot.logger.SetLoggerStep(iLoggerNumber, "BK_FINISH - Sync Error detected - waiting GoDirectHome or DoRemeasure or Continue");
         ELSE
            myRobot.logger.SetLoggerStep(iLoggerNumber, "BK_FINISH - Error detected - waiting GoDirectHome or DoRemeasure or Continue");
         END_IF;
         bPlcFeedback := UPDATE(myRobot.fieldbusIn.GoDirectHome.svBool OR myRobot.fieldbusIn.DoRemeasure.svBool OR myRobot.fieldbusIn.Continue.svBool);
      END_IF;
      
      WAIT bPlcFeedback;
      myRobot.fieldbusOut.VisionError.svBool   := FALSE;
      myRobot.fieldbusOut.ReqSyncVision.svBool := FALSE;
      IF myRobot.fieldbusIn.DoRemeasure.svBool THEN
         myRobot.logger.SetLoggerStep(iLoggerNumber, "BK_FINISH- DoRemeasure received from PLC");
         WAIT NOT myRobot.fieldbusIn.DoRemeasure.svBool;
         iRetVal := Remeasure;
      ELSIF myRobot.fieldbusIn.GoDirectHome.svBool THEN
         myRobot.logger.SetLoggerStep(iLoggerNumber, "BK_FINISH - GoDirectHome received from PLC");   
         WAIT NOT myRobot.fieldbusIn.GoDirectHome.svBool;
         iRetVal := GoHome;
      ELSIF myRobot.fieldbusIn.Continue.svBool THEN
         myRobot.logger.SetLoggerStep(iLoggerNumber, "BK_FINISH - Continue received from PLC");
         WAIT NOT myRobot.fieldbusIn.Continue.svBool;
         iRetVal := Continue;    
      ELSIF myRobot.fieldbusIn.AckSyncVision.svBool THEN  
         myRobot.logger.SetLoggerStep(iLoggerNumber, "BK_FINISH - Ack Sync received from PLC");
         WAIT NOT myRobot.fieldbusIn.AckSyncVision.svBool;
         iRetVal := DataOk;
      END_IF;
   END_IF;
   
   RETURN bk_ok;
   
END_ROUTINE  


//==========================================================
// BK_Korr wird von EcoTalk im Vorlauf aufgerufen. Der nächste Punkt im Teachprogramm
// ist ein Bahnpunkt, für den es einen Korrekturwert geben soll.
//==========================================================
ROUTINE BK_Korr(PunktNr : DINT)   

VAR
   i          : INT;
   j          : INT;
   timeOut    : BOOL;
   bError     : BOOL;
   PunktIndex : INT;
   corrFrame  : TMcuFrame;
END_VAR


   myRobot.DebugPrint(eTraceVision, "BK_Korr: Pointnumber = "+STR(PunktNr));
   BK_NumberOfPoints := BK_NumberOfPoints + 1;
   iBkPPNrPreRun := PunktNr;
   CASE BK_MODUS OF
      Mode_AEC_Measure,
      Mode_AEC_Application,
      ModeMeasure:
         
      ModeApplication:
         // für ISRA auch bei Applikationsfahrt die Bahnpunkte an das Visionsystem übertragen
         // Achtung!!! Die Korrekturwerte sind dabei schon eingerechnet.
         // Prüfung ob PunktNr. schon verwendet
         bError := FALSE;
         FOR i := 1 TO BK_ScanRobPos DO
            IF BKMessPunkt[i] = PunktNr THEN
               RcuSetMessageOnce(TRcVisionBk_ErrInvPointNumber, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBK2.BK_Korr");
               myRobot.DebugPrint(eTraceVision, "BK_Korr: pointnumer already used!");
               bError := TRUE;
            END_IF;
         END_FOR;
         IF NOT bError THEN
            iBkKorrPunktNr := PunktNr;
            bBkKorrFlag := TRUE; // Signalisierung (wird in BK_PP_Ref ausgewertet)
         END_IF;

         // Korrekturwerte aktivieren
         IF (BK_PATH_INDEX = 0) THEN
            //$MSG_T.RELEASE = TRUE
            myRobot.DebugPrint(eTraceVision, "BK_Korr: BK_PATH_INDEX = 0");
            RcuSetMessageOnce(TRcVisionBk_ErrInvPath, myRobot.kinListInx, 3, instId, "TRcuVisionIsraBK2.BK_Korr", STR(BK_TYPE), STR(BK_PATH));
            RETURN;
         END_IF;
         myRobot.DebugPrint(eTraceVision, "BK_Korr: BK_MODUS_APPLICATION Pointnumber = " + STR(PunktNr));
         PunktIndex := BK_GetIndex(BK_PATH_INDEX, PunktNr);
         IF (PunktIndex >= 0) THEN
            myRobot.DebugPrint(eTraceVision, "BK_Korr: pointindex = " + STR(PunktIndex));
            //Base Verschiebung
            corrFrame.mFrameTyp := eMcuFrameKardan;
            corrFrame.mPos.mValues[0] := BK_KORREKTUR[BK_PATH_INDEX][PunktIndex].X;
            corrFrame.mPos.mValues[1] := BK_KORREKTUR[BK_PATH_INDEX][PunktIndex].Y;
            corrFrame.mPos.mValues[2] := BK_KORREKTUR[BK_PATH_INDEX][PunktIndex].Z;
            corrFrame.mOri.mValues[0] := BK_KORREKTUR[BK_PATH_INDEX][PunktIndex].A;
            corrFrame.mOri.mValues[1] := BK_KORREKTUR[BK_PATH_INDEX][PunktIndex].B;
            corrFrame.mOri.mValues[2] := BK_KORREKTUR[BK_PATH_INDEX][PunktIndex].C;
            RcuRefSysSetKardan(myRobot.RcuRefSystemObject, corrFrame, myRobot.RcuRefSystemVisionRel, FALSE, "Object");
            myRobot.homing.StoreRefSystemVision(FALSE, corrFrame);
            START CalcActualObject(corrFrame, TRUE);
         ELSE
            IF NOT bSimulateBK THEN
               RcuSetMessageOnce(TRcVisionBk_ErrCorr, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBK2.BK_Korr", STR(PunktNr));
               myRobot.ErrorReaction(TRUE);
               RETURN;
            END_IF;
         END_IF;
       
   END_CASE;

END_ROUTINE 


//****************************************
// zählt die Trigger im Vorlauf
//****************************************
ROUTINE BK_Action()
   
   
   IF client.tcpConnectionState <> stateSckConnected THEN
      myRobot.DebugPrint(eTraceVision, "BK_ACTION: Communication to Vision PC: ConnectionState <> stateSckConnected");
      bCommError := TRUE;         
      RETURN;
   END_IF;
   BK_TriggerCount := BK_TriggerCount + 1;
   
END_ROUTINE

//-------------------------------------------------------------------------------------------
// Check PLC feedback even measuring was successful to syncronize several robots
//-------------------------------------------------------------------------------------------
ROUTINE SyncRobots(state : BOOL)
  bSyncRobots := state;
END_ROUTINE


ROUTINE TriggerDirectVmtBk(pointNumber : INT)

  STOPPOINT();
  IF client.tcpConnectionState <> stateSckConnected THEN
     myRobot.DebugPrint(eTraceVision, "BK_ACTION_DIRECT: Communication to Vision PC: ConnectionState <> stateSckConnected");
     bCommError := TRUE;         
     RETURN;
  END_IF;
   
  IF BK_ScanRobPos > 0 THEN
    CASE BK_MODUS OF

    Mode_AEC_Measure,
    ModeMeasure:

      myRobot.DebugPrint(eTraceVision, "TriggerDirectVmtBk: BK_MODUS_MEASUREMENT point = " + STR(pointNumber));
      // ?????????????? BKMessPos[BK_ScanRobPos] := $pos_int // Position beim Interrupt
      BKMessPos[BK_ScanRobPos].X := myRobot.readBackObjectPos.mPos.mValues[0];
      BKMessPos[BK_ScanRobPos].Y := myRobot.readBackObjectPos.mPos.mValues[1];
      BKMessPos[BK_ScanRobPos].Z := myRobot.readBackObjectPos.mPos.mValues[2];
      BKMessPos[BK_ScanRobPos].A := myRobot.readBackObjectPos.mOri.mValues[0];
      BKMessPos[BK_ScanRobPos].B := myRobot.readBackObjectPos.mOri.mValues[1];
      BKMessPos[BK_ScanRobPos].C := myRobot.readBackObjectPos.mOri.mValues[2];
      BKMessPunkt[BK_ScanRobPos] := pointNumber;

      // CONTINUE
      IF bBK_SIG_TRIGGER THEN
         WAIT NOT bBK_SIG_TRIGGER;
         RcuSetMessageOnce(TRcVisionBk_ErrTrigTooFast, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBK2.TriggerDirectVmtBk", STR(pointNumber));
         myRobot.ErrorReaction(TRUE);
         RETURN;
      ELSE
         PULSE(bBK_SIG_TRIGGER, TRUE, BK_TriggerTime);
      END_IF;

    ModeApplication,
    Mode_AEC_Application:
      RETURN;

    Mode_ApplTest:
      RETURN;

    END_CASE;

  END_IF;
  BK_ScanRobPos := BK_ScanRobPos + 1; 
END_ROUTINE


(******************************************************************************
***  Tool Correction **********************************************************
******************************************************************************)

VAR
   bEnabled                 : BOOL;
   bCfgDataToolRead         : BOOL;
   bSimulate                : BOOL;

   rLinLimitTool            : REAL;
   rRotLimitTool            : REAL;
   
   bDisabledHMI             : BOOL;
   tEPS_ToolCorrIn          : MAPTO tsToolCorrIn;
   tEPS_ToolCorrOut         : MAPTO tsToolCorrOut;
END_VAR   


ROUTINE ReadConfigTool(locRobot : TRcuRobot) : BOOL
VAR
   bError : BOOL;
   iTemp       : DINT;
   iCatalogHdl : DINT;
END_VAR

   bError := FALSE;
   bCfgDataToolRead := FALSE;
   instId := RcuGetInstanceId(); //instance identification number (for alarms)
   myRobot := MAP(locRobot);
   IF NOT IS_MAPPED(myRobot) THEN
      RcuSetMessageOnce(TRcVisionTool_ErrMappKin, myRobot.kinListInx, 2, instId, "TRcuVisionIsraBK2.ReadConfigTool");
      RETURN FALSE;
   END_IF; 
   IF CatalogGetHandleRelative(myRobot.rcCatHdl, "ISRA_TC", iCatalogHdl) THEN
      IF CatalogReadIntRange(iCatalogHdl, "Enable", iTemp, 0, 1, FALSE) THEN
         IF (iTemp <> 1) THEN
            myRobot.DebugPrint(eTraceVision, "---------------------------------------");
            myRobot.DebugPrint(eTraceVision, "---------- TC deactivated -------------");  
            myRobot.DebugPrint(eTraceVision, "---------------------------------------");
            bCfgDataToolRead := TRUE;
            RETURN FALSE;
         ELSE
            IF NOT CatalogReadRealRange(iCatalogHdl, "LinearLimit", rLinLimitTool , 0.0, 50.0, FALSE) THEN
               rLinLimitTool := 5.0;
            END_IF;
            IF NOT CatalogReadRealRange(iCatalogHdl, "RotationLimit", rRotLimitTool , 0.0, 5.0, FALSE) THEN
               rRotLimitTool := 0.5;
            END_IF;

            IF CatalogReadIntRange(iCatalogHdl, "SimulateTC", iTemp, 0, 1, TRUE) THEN
               bSimulate := iTemp = 1;
            ELSE
               bSimulate := FALSE;
            END_IF;
         END_IF;
      ELSE  
         bError := TRUE;
         myRobot.DebugPrint(eTraceVision, "ISRA TC not enabled");
         RETURN FALSE;
      END_IF;
   ELSE
      bError := TRUE;
      myRobot.DebugPrint(eTraceVision, "No configuration for ISRA TC found");
      RETURN FALSE;
   END_IF;

   IF NOT bError THEN
      bCfgDataToolRead := TRUE;
      RETURN TRUE;
   ELSE
      RcuSetMessageOnce(TRcVisionTool_ErrInit, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBK2.ReadConfigTool");
      myRobot.DebugPrint(eTraceVision, "---------------------------------------");
      myRobot.DebugPrint(eTraceVision, "-------- Boot-Up ISRA TC failed -------");  
      myRobot.DebugPrint(eTraceVision, "---------------------------------------");
      bCfgDataToolRead := FALSE;
      RETURN FALSE;
   END_IF;
   RETURN TRUE;
END_ROUTINE

//------------------------------------------------------------------------
// Initialization and starting coroutines
//------------------------------------------------------------------------
ROUTINE InitTool()
VAR
   s : STRING;
END_VAR

   IF NOT bCfgDataToolRead THEN
      RcuSetMessageOnce(TRcVisionTool_ErrInit, myRobot.kinListInx, 2, instId, "TRcuVisionIsraBK2.InitTool");
      RETURN;
   END_IF;
   
   WAIT myRobot.initKinComplete;
   WAIT myRobot.fixPosReady;
   IF myRobot.vision.iLoggerNumber <> 0 THEN
      iLoggerNumber := myRobot.vision.iLoggerNumber;
      myRobot.logger.SetLoggerStep(iLoggerNumber, "ISRA TC initialized");
   END_IF;

   START TcSignalsToEPS() PRIO 3;
   myRobot.DebugPrint(eTraceVision, "--------------------------------");
   myRobot.DebugPrint(eTraceVision, "---  Boot-up ISRA_TC finished --");
   myRobot.DebugPrint(eTraceVision, "--------------------------------");
   myRobot.vision.bTCBootUpOk := TRUE;
   myRobot.vision.VisionTool.bUserPageVisible := TRUE;
   // bUserPageVisible := TRUE;
   RETURN;
END_ROUTINE


ROUTINE TC_Start(ToolNr : DINT) : BOOL
VAR
   timeOut : BOOL;
   sText   : STRING;
END_VAR

   
   IF bDisabledHMI THEN
      myRobot.DebugPrint(eTraceVision, "TC_Start is disabled by HMI");
      RETURN FALSE;
   END_IF;
   IF (ToolNr < 0) OR (ToolNr > 255) THEN
      RcuSetMessageOnce(TRcVisionTool_ErrInvalidTool, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBK2.TC_Start", myRobot.progPath.GetSource());
      myRobot.ErrorReaction(TRUE);
   END_IF;
   
   myRobot.vision.VisionTool.TVToolNr       := ToolNr;  //Userpage

   bCommError                              := FALSE;
   SysTimerSet(10000, timeOut);
   bBkConnect                              := TRUE;
   WAIT bBkActive OR timeOut OR bSimulate OR bDisabledHMI;
   IF bDisabledHMI THEN
      myRobot.DebugPrint(eTraceVision, "TC_Start is disabled by HMI");
      RETURN FALSE;
   ELSIF timeOut THEN
      RcuSetMessageOnce(TRcVisionBk_ErrTimeOut, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.TC_Start", "TC_START", "bBkActive");
      bCommError := TRUE;
      bBkConnect := FALSE;
      myRobot.ErrorReaction(TRUE);
      RETURN FALSE;
   END_IF;
   
   sText := "TC_Start: Type = "+STR(ToolNr);
   myRobot.DebugPrint(eTraceVision, sText);
   myRobot.logger.SetLoggerStep(iLoggerNumber, sText);

   SysTimerSet(10000, timeOut);
   WAIT (TelCounter <> 0) OR timeOut; // auf erstes Telegramm von ROVIS warten
   IF timeOut THEN
      myRobot.DebugPrint(eTraceVision, "TimeOut in TC_START by waiting for TelCounter <> 0");
      bCommError := TRUE;
      RcuSetMessageOnce(TRcVisionBk_ErrTimeOut, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.TC_Start", "TC_START", "TelCounter <> 0");
      myRobot.ErrorReaction(TRUE);
   END_IF;

   // Status Ready=1 Error=0 erwarten
   SysTimerSet(10000, timeOut);
   WAIT bRovisReady OR timeOut OR (iRovisError <> 0) OR bSimulate;
   IF timeOut THEN
      myRobot.DebugPrint(eTraceVision, "TimeOut in TC_START by waiting for bRovisReady");
      bCommError := TRUE;
      RcuSetMessageOnce(TRcVisionBk_ErrTimeOut, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.TC_Start", "TC_START", "ROVIS Ready");
      myRobot.ErrorReaction(TRUE);
   ELSIF (iRovisError <> 0) THEN
      iRunMode := 0;              // Fehler quittieren
      iType    := 0;
      bPrepare := FALSE;
      bStart   := FALSE;
      bQuit    := TRUE;
      bRovisTelegram := TRUE;
      WAIT NOT bRovisTelegram;  // Telegramm gesendet

      // WAIT bRovisReady OR timeOut;
      WAIT (bRovisReady AND (iRovisError = 0)) OR timeOut OR bSimulate; // 06.06.2016 Mai/ISRA
      IF timeOut THEN
         myRobot.DebugPrint(eTraceVision, "TimeOut in TC_START by waiting for >bRovisReady AND (iRovisError = 0)<");
         bCommError := TRUE;
         RcuSetMessageOnce(TRcVisionBk_ErrTimeOut, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.TC_Start", "TC_START", "bRovisReady AND (iRovisError = 0)");
         myRobot.ErrorReaction(TRUE);
      END_IF;
   END_IF;
   



   // Runmode = 2 senden, wenn ROVIS nicht in Automatik
   IF iRovisRunMode <> 2 THEN
      iRunMode := 2;  // Betriebsart = Automatik
      iType    := 0;
      bPrepare := FALSE;
      bStart   := FALSE;
      bQuit    := FALSE;
      bRovisTelegram := TRUE;
      WAIT NOT bRovisTelegram;  // Telegramm gesendet
      // Warten bis Runmode = 2 empfangen
      SysTimerSet(10000, timeOut);
      WAIT (iRovisRunMode = 2) OR timeOut OR bSimulate;
      IF timeOut THEN
         bCommError := TRUE;
         RcuSetMessageOnce(TRcVisionBk_ErrTimeOut, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.TC_Start", "TC_START", "ROVIS Automatic");
         myRobot.ErrorReaction(TRUE);
      END_IF;
   END_IF;

   iRunMode := 0;              // alles zurücksetzen
   iType    := 0;
   bPrepare := FALSE;
   bStart   := FALSE;
   bQuit    := FALSE;
   bRovisTelegram := TRUE;
   WAIT NOT bRovisTelegram;  // Telegramm gesendet

   iRunMode := 0;
   iType    := ToolNr;
   bPrepare := TRUE;
   bStart   := FALSE;
   bQuit    := FALSE;
   bRovisTelegram := TRUE;
   WAIT NOT bRovisTelegram;  // Telegramm gesendet

   SysTimerSet(10000, timeOut);
   WAIT bRovisPrepared OR (iRovisError<>0) OR timeOut OR bSimulate; // Status Prepared = 1 erwarten
   IF (iRovisError <> 0) THEN
      myRobot.DebugPrint(eTraceVision, "TC_Start Type " + STR(ToolNr) + " Wrong Type");
      myRobot.logger.SetLoggerStep(iLoggerNumber, "ISRA TC_Start Type " + STR(ToolNr) + " Wrong Type");
      RcuSetMessageOnce(TRcVisionBk_ErrWrongType, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.TC_Start", STR(ToolNr), "TC_START");
      myRobot.ErrorReaction(TRUE);
   ELSIF timeOut THEN
      bCommError := TRUE;
      RcuSetMessageOnce(TRcVisionBk_ErrTimeOut, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.TC_Start", "TC_START", "ROVIS Prepared");
      myRobot.ErrorReaction(TRUE);
   END_IF;
    
   myRobot.DebugPrint(eTraceVision, "TC_Start Type " + STR(ToolNr) + " send to ISRA");
   myRobot.logger.SetLoggerStep(iLoggerNumber, "ISRA TC_Start Type " + STR(ToolNr) + " send to ISRA");
   RETURN TRUE;
END_ROUTINE


ROUTINE TC_SetPos(PosNr : DINT)
VAR
   timeOut : BOOL;
END_VAR
   
   IF bDisabledHMI THEN
      myRobot.DebugPrint(eTraceVision, "TC_SetPos is disabled by HMI");
      RETURN;
   END_IF;
   IF (PosNr < 1) OR (PosNr > 2) THEN
      RcuSetMessageOnce(TRcVisionTool_ErrInvalidPos, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBK2.TC_SetPos", myRobot.progPath.GetSource());
      myRobot.ErrorReaction(TRUE);
   END_IF;
   IF (PosNr = 1) THEN
      myRobot.DebugPrint(eTraceVision, "ISRA TC_SetPos position 1");
      myRobot.logger.SetLoggerStep(iLoggerNumber, "ISRA TC_SetPos position 1");

      
      
      iType    := 0;
      bPrepare := FALSE;
      bStart   := TRUE;         // Strobe Start = 1 senden
      bRovisTelegram := TRUE;
      WAIT NOT bRovisTelegram;  // Telegramm gesendet

      SysTimerSet(10000, timeOut);
      WAIT (NOT bRovisAcquisition AND bRovisMeasurement AND bRovisData) OR timeOut OR bSimulate; 
                                                                       // bei Mehrfachbildaufnahme:
                                                                       // Status Acquisition = 0 &
                                                                       // Measurement = 1 &
                                                                       // Data = 1 erwarten
      IF timeOut THEN
         bCommError := TRUE;
         RcuSetMessageOnce(TRcVisionBk_ErrTimeOut, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.TC_SetPos", 
                           "TC_SETPOS", "ROVIS NOT Acquisition & Measurement & Data");
         myRobot.ErrorReaction(TRUE);
      END_IF;
      
      bPrepare := FALSE;
      bStart   := FALSE;        // Strobe Start = 0 senden
      bRovisTelegram := TRUE;
      WAIT NOT bRovisTelegram;  // Telegramm gesendet

      IF timeOut THEN
         RcuSetMessageOnce(TRcVisionTool_ErrTimeOutSignal, myRobot.kinListInx, 9, instId, "TRcuVisionIsraBK2.TC_SetPos", "Vmt_PictureFinished");
         myRobot.ErrorReaction(TRUE);
      END_IF;
      
      myRobot.DebugPrint(eTraceVision, "TC_SetPos picture finished for position 1");
      myRobot.logger.SetLoggerStep(iLoggerNumber, "ISRA TC_SetPos picture finished for position 1");
      RETURN;
   ELSE
      myRobot.DebugPrint(eTraceVision, "ISRA TC_SetPos position 2");
      myRobot.logger.SetLoggerStep(iLoggerNumber, "ISRA TC_SetPos position 2");
   
      bPrepare := FALSE;
      bStart   := TRUE;         // Strobe Start = 1 senden
      bRovisTelegram := TRUE;
      WAIT NOT bRovisTelegram;  // Telegramm gesendet

      SysTimerSet(10000, timeOut);
      WAIT (bRovisAcquisition AND bRovisMeasurement AND bRovisData) OR timeOut OR bSimulate;     
                                                                       // Status Acquisition = 1 &
                                                                       // Measurement = 1 &
                                                                       // Data = 1 erwarten
   
      IF timeOut THEN
         bCommError := TRUE;
         RcuSetMessageOnce(TRcVisionBk_ErrTimeOut, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.TC_SetPos", 
                           "TC_SETPOS", "ROVIS Acquisition & Measurement & Data");
         myRobot.ErrorReaction(TRUE);
      END_IF;

      bPrepare := FALSE;
      bStart   := FALSE;        // Strobe Start = 0 senden 
      bRovisTelegram := TRUE;
      WAIT NOT bRovisTelegram;  // Telegramm gesendet

      myRobot.DebugPrint(eTraceVision, "ISRA TC_SetPos picture finished for position 2");
      myRobot.logger.SetLoggerStep(iLoggerNumber, "ISRA TC_SetPos picture finished for position 2");
   END_IF;
   
END_ROUTINE


ROUTINE TC_ReceiveTool(refTool : TOOL; corrTool : TOOL; iRetVal : VISION_STATE) : BOOL
VAR
   CorrFrame          : TMcuFrame;
   bRangeOK           : BOOL;
   bPlcFeedback       : BOOL;
   timeOut            : BOOL;
END_VAR   


   //init data for EcoScreen
   tEPS_ToolCorrOut.tDataVision.name   := "";
   tEPS_ToolCorrOut.tDataVision.x      := 0.0;
   tEPS_ToolCorrOut.tDataVision.y      := 0.0;
   tEPS_ToolCorrOut.tDataVision.z      := 0.0;
   tEPS_ToolCorrOut.tDataVision.A      := 0.0;
   tEPS_ToolCorrOut.tDataVision.B      := 0.0;
   tEPS_ToolCorrOut.tDataVision.C      := 0.0;
   tEPS_ToolCorrOut.tDataRefTool.name  := "";
   tEPS_ToolCorrOut.tDataRefTool.x     := 0.0;
   tEPS_ToolCorrOut.tDataRefTool.y     := 0.0;
   tEPS_ToolCorrOut.tDataRefTool.z     := 0.0;
   tEPS_ToolCorrOut.tDataRefTool.A     := 0.0;
   tEPS_ToolCorrOut.tDataRefTool.B     := 0.0;
   tEPS_ToolCorrOut.tDataRefTool.C     := 0.0;
   tEPS_ToolCorrOut.tDataCorrTool.name := "";
   tEPS_ToolCorrOut.tDataCorrTool.x    := 0.0;
   tEPS_ToolCorrOut.tDataCorrTool.y    := 0.0;
   tEPS_ToolCorrOut.tDataCorrTool.z    := 0.0;
   tEPS_ToolCorrOut.tDataCorrTool.A    := 0.0;
   tEPS_ToolCorrOut.tDataCorrTool.B    := 0.0;
   tEPS_ToolCorrOut.tDataCorrTool.C    := 0.0;

   IF bDisabledHMI THEN
      corrTool := refTool;
      iRetVal  := Failure;
      bRangeOK  := FALSE;
      myRobot.DebugPrint(eTraceVision, "TC_RECEIVE_TOOL is disabled by HMI");
   ELSE   
      SysTimerSet(10000, timeOut);
      WAIT (NOT bRovisAcquisition AND NOT bRovisMeasurement AND NOT bRovisData) OR timeOut OR bSimulate; 
                                                                               // Status Acquisition = 0 &
                                                                               // Measurement = 0 &
                                                                               // Data = 0 erwarten
      IF timeOut THEN
         bCommError := TRUE;
         bRangeOK := FALSE;
         RcuSetMessageOnce(TRcVisionBk_ErrTimeOut, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.TC_ReceiveTool", 
                           "TC_RECEIVE_TOOL", "ROVIS NOT Acquisition & NOT Measurement & NOT Data");
      END_IF;

      // Daten von ISRA -> CorrFrame
      IF iRovisError = 0 THEN
         IF (rAbs(RovisResult.X) > rLinLimitTool) OR
            (rAbs(RovisResult.Y) > rLinLimitTool) OR
            (rAbs(RovisResult.Z) > rLinLimitTool) OR
            (rAbs(RovisResult.A) > rRotLimitTool) OR
            (rAbs(RovisResult.B) > rRotLimitTool) OR
            (rAbs(RovisResult.C) > rRotLimitTool) THEN
            myRobot.logger.SetLoggerStep(iLoggerNumber, "correction values out off limits");
            CorrFrame.mFrameTyp := eMcuFrameKardan;
            CorrFrame.mPos.mValues[0]  := 0.0;
            CorrFrame.mPos.mValues[1]  := 0.0;
            CorrFrame.mPos.mValues[2]  := 0.0;
            CorrFrame.mOri.mValues[0] := 0.0;
            CorrFrame.mOri.mValues[1] := 0.0;
            CorrFrame.mOri.mValues[2] := 0.0;
            bRangeOK := FALSE;
            iRetVal := Failure;
         ELSE
            bRangeOK := TRUE;
            iRetVal := DataOk;
            CorrFrame.mFrameTyp := eMcuFrameKardan;
            CorrFrame.mPos.mValues[0] := RovisResult.X;
            CorrFrame.mPos.mValues[1] := RovisResult.Y;
            CorrFrame.mPos.mValues[2] := RovisResult.Z;
            CorrFrame.mOri.mValues[0] := RovisResult.A;
            CorrFrame.mOri.mValues[1] := RovisResult.B;
            CorrFrame.mOri.mValues[2] := RovisResult.C;

            myRobot.logger.SetLoggerStep(iLoggerNumber, "ISRA TC_ReceiveTool");    
            RcuCalcTool(myRobot, refTool, CorrFrame, corrTool);      
         END_IF;
         //data for EcoScreen
         tEPS_ToolCorrOut.tDataVision.name   := "";
         tEPS_ToolCorrOut.tDataVision.x      := CorrFrame.mPos.mValues[0];
         tEPS_ToolCorrOut.tDataVision.y      := CorrFrame.mPos.mValues[1];
         tEPS_ToolCorrOut.tDataVision.z      := CorrFrame.mPos.mValues[2];
         tEPS_ToolCorrOut.tDataVision.A      := CorrFrame.mOri.mValues[0];
         tEPS_ToolCorrOut.tDataVision.B      := CorrFrame.mOri.mValues[1];
         tEPS_ToolCorrOut.tDataVision.C      := CorrFrame.mOri.mValues[2];
         tEPS_ToolCorrOut.tDataRefTool.name  := refTool.GetName();
         tEPS_ToolCorrOut.tDataRefTool.x     := refTool.X_mm;
         tEPS_ToolCorrOut.tDataRefTool.y     := refTool.Y_mm;
         tEPS_ToolCorrOut.tDataRefTool.z     := refTool.Z_mm;
         tEPS_ToolCorrOut.tDataRefTool.A     := refTool.A_deg;
         tEPS_ToolCorrOut.tDataRefTool.B     := refTool.B_deg;
         tEPS_ToolCorrOut.tDataRefTool.C     := refTool.C_deg;
         tEPS_ToolCorrOut.tDataCorrTool.name := corrTool.GetName();
         tEPS_ToolCorrOut.tDataCorrTool.x    := corrTool.X_mm; 
         tEPS_ToolCorrOut.tDataCorrTool.y    := corrTool.Y_mm; 
         tEPS_ToolCorrOut.tDataCorrTool.z    := corrTool.Z_mm; 
         tEPS_ToolCorrOut.tDataCorrTool.A    := corrTool.A_deg;
         tEPS_ToolCorrOut.tDataCorrTool.B    := corrTool.B_deg;
         tEPS_ToolCorrOut.tDataCorrTool.C    := corrTool.C_deg;
      ELSE
         RcuSetMessageOnce(TRcVisionBk_ErrStateNotOk, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBK2.TC_ReceiveTool");
         bRangeOK := FALSE;
      END_IF;
   END_IF;

   // Userpage
   myRobot.vision.VisionTool.CorrFrame      := CorrFrame;
   myRobot.vision.VisionTool.TVCorrTool     := corrTool;
   myRobot.vision.VisionTool.TVRefTool      := refTool;
   myRobot.vision.VisionTool.TVRefToolName  := refTool.GetName();
   myRobot.vision.VisionTool.TVCorrToolName := corrTool.GetName();
   
   
   IF NOT bRangeOK THEN
      IF IS_USED(iRetVal) THEN   
         IF bRangeOK AND NOT bSyncRobots THEN
            myRobot.fieldbusOut.VisionError.svBool   := FALSE;
            myRobot.fieldbusOut.ReqSyncVision.svBool := FALSE;
            iRetVal := DataOk;
            RETURN TRUE;
         ELSIF bRangeOK AND bSyncRobots THEN
            myRobot.fieldbusOut.VisionError.svBool   := FALSE;
            myRobot.fieldbusOut.ReqSyncVision.svBool := TRUE;
            bPlcFeedback := UPDATE(myRobot.fieldbusIn.AckSyncVision.svBool OR myRobot.fieldbusIn.GoDirectHome.svBool OR myRobot.fieldbusIn.DoRemeasure.svBool OR myRobot.fieldbusIn.Continue.svBool);
            myRobot.logger.SetLoggerStep(iLoggerNumber, "TC_ReceiveTool - Sync - waiting AckSyncVision or GoDirectHome or DoRemeasure or Continue");
         ELSE   
            myRobot.fieldbusOut.VisionError.svBool   := TRUE;
            myRobot.fieldbusOut.ReqSyncVision.svBool := bSyncRobots;
            IF bSyncRobots THEN
               myRobot.logger.SetLoggerStep(iLoggerNumber, "TC_RECEIVE_TOOL - Sync Error detected - waiting GoDirectHome or DoRemeasure or Continue");
            ELSE
               myRobot.logger.SetLoggerStep(iLoggerNumber, "TC_RECEIVE_TOOL - Error detected - waiting GoDirectHome or DoRemeasure or Continue");
            END_IF;
            bPlcFeedback := UPDATE(myRobot.fieldbusIn.GoDirectHome.svBool OR myRobot.fieldbusIn.DoRemeasure.svBool OR myRobot.fieldbusIn.Continue.svBool);
         END_IF;

         WAIT bPlcFeedback;
         myRobot.fieldbusOut.VisionError.svBool   := FALSE;
         myRobot.fieldbusOut.ReqSyncVision.svBool := FALSE;
         IF myRobot.fieldbusIn.DoRemeasure.svBool THEN
            myRobot.logger.SetLoggerStep(iLoggerNumber, "TC_RECEIVE_TOOL- DoRemeasure received from PLC");
            WAIT NOT myRobot.fieldbusIn.DoRemeasure.svBool;
            iRetVal := Remeasure;
         ELSIF myRobot.fieldbusIn.GoDirectHome.svBool THEN
            myRobot.logger.SetLoggerStep(iLoggerNumber, "TC_RECEIVE_TOOL - GoDirectHome received from PLC");   
            WAIT NOT myRobot.fieldbusIn.GoDirectHome.svBool;
            iRetVal := GoHome;
         ELSIF myRobot.fieldbusIn.Continue.svBool THEN
            myRobot.logger.SetLoggerStep(iLoggerNumber, "TC_RECEIVE_TOOL - Continue received from PLC");
            WAIT NOT myRobot.fieldbusIn.Continue.svBool;
            iRetVal := Continue;    
         ELSIF myRobot.fieldbusIn.AckSyncVision.svBool THEN  
            myRobot.logger.SetLoggerStep(iLoggerNumber, "TC_RECEIVE_TOOL - Ack Sync received from PLC");
            WAIT NOT myRobot.fieldbusIn.AckSyncVision.svBool;
            iRetVal := DataOk;
         END_IF;
      END_IF;

   END_IF;

   RETURN bRangeOK;
END_ROUTINE



// *****************************************************************************
//
// Erweiterungen für ISRA Toolbox
//
// *****************************************************************************
TYPE PRIVATE
  tLimitsUserPage : STRUCT
     iLabel    : INT;
     rXmin     : REAL;
     rXmax     : REAL;
     rYmin     : REAL;
     rYmax     : REAL;
     rZmin     : REAL;
     rZmax     : REAL;
     rRotLimit : REAL;
  END_STRUCT;
  
  tLimits : STRUCT
     bConfigured   : BOOL;
     bSetByEcoTalk : BOOL;
     rXmin_Cfg     : REAL;
     rXmax_Cfg     : REAL;
     rYmin_Cfg     : REAL;
     rYmax_Cfg     : REAL;
     rZmin_Cfg     : REAL;
     rZmax_Cfg     : REAL;
     rXmin_TP      : REAL;
     rXmax_TP      : REAL;
     rYmin_TP      : REAL;
     rYmax_TP      : REAL;
     rZmin_TP      : REAL;
     rZmax_TP      : REAL;
     rRotLimit     : REAL;
  END_STRUCT;
  
END_TYPE

CONSTANT PRIVATE
   cToleranceLimit  : REAL := 50.0; //50mm
END_CONSTANT

VAR
   bTBoxEnabled             : BOOL;
   bTBoxCfgDataRead         : BOOL;
   bTBoxSimulate            : BOOL;
   //correction values are bigger than warning limnit --> warning message (Lock outlet) 
   bShowWarnLockOutlet      : BOOL;
   //Maximum allowed correction values for TV
   sAlarmLimitsUserPage     : tLimitsUserPage;
   sWarnLimitsUserPage      : tLimitsUserPage;
   bCorrectionOkUserPage    : BOOL;
   //Maximum allowed correction values
   sAlarmLimits             : tLimits;
   sWarnLimits              : tLimits;
   yTBoxCntRetry            : ARRAY [1..255] OF INT;
   iTBoxMaxRetry            : INT;
   bUseWarningLimit         : BOOL;
   bWarningToPLC            : BOOL;
   
   // Kommandos fuer VMT ToolBox
   TBOX_CMD_CHECK           : INT := 16#81;
   TBOX_CMD_CORRECT         : INT := 16#82;
   TBOX_CMD_TCP_1SHOT       : INT := 16#83;
   TBOX_CMD_TCP_NSHOTS      : INT := 16#84;
   
   TBOX_TOOL_NUM            : INT; // set for TCP measurement run with multiple points
   TBOX_PATH_ID             : INT;

   TBOX_PATH_INDEX          : INT := 2;

   TBOX_Korr_X              : REAL := 0.0;
   TBOX_Korr_Y              : REAL := 0.0;
   TBOX_Korr_Z              : REAL := 0.0;
   TBOX_Korr_RX             : REAL := 0.0;
   TBOX_Korr_RY             : REAL := 0.0;
   TBOX_Korr_RZ             : REAL := 0.0;

   TBOX_Base_X              : REAL := 0.0;
   TBOX_Base_Y              : REAL := 0.0;
   TBOX_Base_Z              : REAL := 0.0;
   TBOX_Base_RX             : REAL := 0.0;
   TBOX_Base_RY             : REAL := 0.0;
   TBOX_Base_RZ             : REAL := 0.0;
   
   TBOX_Tool_X              : REAL := 0.0;
   TBOX_Tool_Y              : REAL := 0.0;
   TBOX_Tool_Z              : REAL := 0.0;
   TBOX_Tool_RX             : REAL := 0.0;
   TBOX_Tool_RY             : REAL := 0.0;
   TBOX_Tool_RZ             : REAL := 0.0;
   
   TBOX_SCALE_FAC_T         : INT := 10000;
   TBOX_SCALE_FAC_R         : INT := 10000;
//   tEPS_ToolCorrIn          : MAPTO tsToolCorrIn;   
//   tEPS_ToolCorrOut         : MAPTO tsToolCorrOut;
END_VAR


ROUTINE ReadConfigTBox(locRobot : TRcuRobot) : BOOL
VAR
   bError      : BOOL;
   iTemp       : DINT;
   iCatalogHdl : DINT;
   iCatToolHdl : DINT;
   r           : REAL;
END_VAR

   bError := FALSE;
   bTBoxCfgDataRead := FALSE;
   instId := RcuGetInstanceId(); //instance identification number (for alarms)
   myRobot := MAP(locRobot);
   IF NOT IS_MAPPED(myRobot) THEN
      RcuSetMessageOnce(TRcVisionBk_ErrMappKin, myRobot.kinListInx, 2, instId, "TRcuVisionIsraBK2.ReadConfigTBox");
      RETURN FALSE;
   END_IF; 
             
   IF CatalogGetHandleRelative(myRobot.rcCatHdl, "ISRA_TBOX", iCatalogHdl) THEN
      IF CatalogReadIntRange(iCatalogHdl, "Enable", iTemp, 0, 1, FALSE) THEN
         IF (iTemp <> 1) THEN
            myRobot.DebugPrint(eTraceVision, "---------------------------------------");
            myRobot.DebugPrint(eTraceVision, "---------- TBOX deactivated -----------");  
            myRobot.DebugPrint(eTraceVision, "---------------------------------------");
            bTBoxCfgDataRead := TRUE;
            RETURN FALSE;
         ELSE
            //----------------------------------------------------------------------------------------------------------------------------------------------
            IF CatalogReadIntRange(iCatalogHdl, "SimulateTBOX", iTemp, 0, 1, TRUE) THEN
               bTBoxSimulate := iTemp = 1;
            ELSE
               bTBoxSimulate := FALSE;
            END_IF;
            //----------------------------------------------------------------------------------------------------------------------------------------------
            IF CatalogReadIntRange(iCatalogHdl, "MaxRetryCount", iTemp, 0, 5, TRUE) THEN
               iTBoxMaxRetry := iTemp;
            ELSE
               iTBoxMaxRetry := 0;
            END_IF;
            //----------------------------------------------------------------------------------------------------------------------------------------------
            IF CatalogReadIntRange(iCatalogHdl, "ShowWarnLockOutlet", iTemp, 0, 1, TRUE) THEN
               bShowWarnLockOutlet := iTemp = 1;
            ELSE
               bShowWarnLockOutlet := FALSE;
            END_IF;
            //----------------------------------------------------------------------------------------------------------------------------------------------
            IF CatalogReadRealRange(iCatalogHdl, "RotationLimit", r , 0.0, 5.0, FALSE) THEN
               sAlarmLimits.rRotLimit := r;
            ELSE
               sAlarmLimits.rRotLimit := 0.5;
            END_IF;  
            //----------------------------------------------------------------------------------------------------------------------------------------------
            //alarm limits from global node [RC.KINEMATIC:0.VMT_TBOX]
            IF CatalogReadRealRange(iCatalogHdl, "MaxToolAdjustment_X", r, 0.0, 50.0, FALSE) THEN
               sAlarmLimits.bConfigured     := TRUE;
               sAlarmLimits.rXmin_Cfg       := -r;
               sAlarmLimits.rXmax_Cfg       := r;
            ELSE
               sAlarmLimits.rXmin_Cfg       := -30.0;
               sAlarmLimits.rXmax_Cfg       :=  30.0;
            END_IF;
            IF CatalogReadRealRange(iCatalogHdl, "MaxToolAdjustment_Y", r, 0.0, 50.0, FALSE) THEN
               sAlarmLimits.bConfigured     := TRUE;
               sAlarmLimits.rYmin_Cfg       := -r;
               sAlarmLimits.rYmax_Cfg       := r;
            ELSE
               sAlarmLimits.rYmin_Cfg       := -30.0;
               sAlarmLimits.rYmax_Cfg       :=  30.0;  
            END_IF;
            IF CatalogReadRealRange(iCatalogHdl, "MaxToolAdjustment_Z", r, 0.0, 50.0, FALSE) THEN
               sAlarmLimits.bConfigured     := TRUE;
               sAlarmLimits.rZmin_Cfg       := -r;
               sAlarmLimits.rZmax_Cfg       := r;
            ELSE
               sAlarmLimits.rZmin_Cfg       := -30.0;
               sAlarmLimits.rZmax_Cfg       :=  30.0;
            END_IF; 
            //----------------------------------------------------------------------------------------------------------------------------------------------
            IF bShowWarnLockOutlet THEN
               //warning limits from global node [RC.KINEMATIC:0.VMT_TBOX]
               IF CatalogReadRealRange(iCatalogHdl, "WarnToolAdjustment_X", r, 0.0, 50.0, TRUE) THEN
                  sWarnLimits.bConfigured     := TRUE;
                  sWarnLimits.rXmin_Cfg       := -r;
                  sWarnLimits.rXmax_Cfg       := r;
               END_IF;
               IF CatalogReadRealRange(iCatalogHdl, "WarnToolAdjustment_Y", r, 0.0, 50.0, TRUE) THEN
                  sWarnLimits.bConfigured     := TRUE;
                  sWarnLimits.rYmin_Cfg       := -r;
                  sWarnLimits.rYmax_Cfg       := r;
               END_IF;
               IF CatalogReadRealRange(iCatalogHdl, "WarnToolAdjustment_Z", r, 0.0, 50.0, TRUE) THEN
                  sWarnLimits.bConfigured     := TRUE;
                  sWarnLimits.rZmin_Cfg       := -r;
                  sWarnLimits.rZmax_Cfg       := r;
               END_IF;
            END_IF;        
         END_IF;
      ELSE  
         bError := TRUE;
         myRobot.DebugPrint(eTraceVision, "TBOX not enabled");
         RETURN FALSE;
      END_IF;
   ELSE
      bError := TRUE;
      myRobot.DebugPrint(eTraceVision, "No configuration for TBOX found");
      RETURN FALSE;
   END_IF;

   IF NOT bError AND NOT bMappingOk THEN
      MapBkSignals();
   END_IF;
   
   IF bMappingOk AND NOT bError THEN
      bTBoxCfgDataRead := TRUE;
      RETURN TRUE;
   ELSE
      RcuSetMessageOnce(TRcVisionBk_ErrBkInit, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBK2.ReadConfigTBox");
//      RcuSetMessageOnce(TRcVisionBk_ErrTBoxInit, myRobot.kinListInx, 1, instId, "TRcuVisionBk.ReadConfig");
      myRobot.DebugPrint(eTraceVision, "---------------------------------------");
      myRobot.DebugPrint(eTraceVision, "-------- Boot-Up TBOX failed ----------");  
      myRobot.DebugPrint(eTraceVision, "---------------------------------------");
      bTBoxCfgDataRead := FALSE;
      RETURN FALSE;
   END_IF;
END_ROUTINE


//------------------------------------------------------------------------
// Initialization and starting coroutines if neccessary
//------------------------------------------------------------------------
ROUTINE InitTBox()
VAR
   s : STRING;
END_VAR

   IF NOT bTBoxCfgDataRead THEN
      RcuSetMessageOnce(TRcVisionBk_ErrBkInit, myRobot.kinListInx, 5, instId, "TRcuVisionIsraBK2.Init");
//      RcuSetMessageOnce(TRcVisionBk_ErrTBoxInit, myRobot.kinListInx, 5, instId, "TRcuVisionBK.InitTBox");
      gbBootupError := TRUE;
      RETURN;
   END_IF;
   
   WAIT myRobot.initKinComplete;
   WAIT myRobot.fixPosReady;

   START TBoxSignalsToEPS() PRIO 3;
   myRobot.vision.TBOX_GhostNoVision := UPDATE(myRobot.fieldbusIn.GhostMode.svBool AND myRobot.fieldbusIn.GhostNoVision.svBool);
   IF bShowWarnLockOutlet THEN   
      START WarningToPLC();
   END_IF;
   myRobot.DebugPrint(eTraceVision, "--------------------------------");
   myRobot.DebugPrint(eTraceVision, "--  Boot-up ISRA_TBOX finished --");
   myRobot.DebugPrint(eTraceVision, "--------------------------------");
   myRobot.vision.bTBoxBootUpOk := TRUE;
   myRobot.vision.VisionTool.bUserPageVisible := TRUE;
   

   corrFrameMR.mFrameTyp := eMcuFrameKardan;      
   IF myRobot.vision.iLoggerNumber <> 0 THEN
      iLoggerNumber := myRobot.vision.iLoggerNumber;
      myRobot.logger.SetLoggerStep(iLoggerNumber, "ISRA TBOX initialized");
   END_IF;
   RETURN;
END_ROUTINE


ROUTINE TBoxTcpStart(ToolNr : DINT) : BOOL
VAR
   bResult    : BOOL;
   bTimeOut   : BOOL;
   pos_act    : FRAME;
   nullTool   : TOOL;
   timeOut    : BOOL;
   sText      : STRING;
   bRangeOK   : BOOL;
   i          : INT;
   j          : INT;
   bEXIT      : BOOL;
END_VAR

   TBOX_TOOL_NUM := ToolNr;

   IF bDisabledHMI THEN
      myRobot.DebugPrint(eTraceVision, "ToolBox is disabled");
      bResult  := FALSE;
   ELSE   
      IF (ToolNr < 0) OR (ToolNr > 255) THEN
         RcuSetMessageOnce(TRcVisionTool_ErrInvalidTool, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBK2.TBoxTcpStart", myRobot.progPath.GetSource());
         myRobot.ErrorReaction(TRUE);
      END_IF;

      ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
      // Ablauf gemaess Kapitel 5.3 Beauftragung TCP-Kalibrierung mit Rovis-Typanwahl //
      ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
      // Nummer der Messaufgabe an ISRA      
      TBOX_TOOL_NUM := ToolNr;
      bCommError                              := FALSE;
      SysTimerSet(10000, timeOut);
      bBkConnect                              := TRUE;
      WAIT bBkActive OR timeOut OR bTBoxSimulate OR bDisabledHMI;
      IF bDisabledHMI THEN
         myRobot.DebugPrint(eTraceVision, "TBOX_CORR is disabled by HMI");
         RETURN FALSE;
      ELSIF timeOut THEN
         RcuSetMessageOnce(TRcVisionBk_ErrTimeOut, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.TBoxTcpStart", "TBOX_CORR", "bBkActive");
         bCommError := TRUE;
         bBkConnect := FALSE;
         myRobot.ErrorReaction(TRUE);
         RETURN FALSE;
      END_IF;

      sText := "TBoxTcpStart: Type = "+STR(ToolNr);
      myRobot.DebugPrint(eTraceVision, sText);
      myRobot.logger.SetLoggerStep(iLoggerNumber, sText);

      SysTimerSet(10000, timeOut);
      WAIT (TelCounter <> 0) OR timeOut; // auf erstes Telegramm von ROVIS warten
      IF timeOut THEN
         myRobot.DebugPrint(eTraceVision, "TimeOut in TBoxTcpStart by waiting for TelCounter <> 0");
         bCommError := TRUE;
         RcuSetMessageOnce(TRcVisionBk_ErrTimeOut, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.TBoxTcpStart", "TBOX_CORR", "TelCounter <> 0");
         myRobot.ErrorReaction(TRUE);
      END_IF;

      // Status Ready=1 Error=0 erwarten
      SysTimerSet(10000, timeOut);
      WAIT bRovisReady OR timeOut OR (iRovisError <> 0) OR bTBoxSimulate;
      IF timeOut THEN
         myRobot.DebugPrint(eTraceVision, "TimeOut in TBoxTcpStart by waiting for bRovisReady");
         bCommError := TRUE;
         RcuSetMessageOnce(TRcVisionBk_ErrTimeOut, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.TBoxTcpStart", "TBOX_CORR", "ROVIS Ready");
         myRobot.ErrorReaction(TRUE);
      ELSIF (iRovisError <> 0) THEN
         iRunMode := 0;              // Fehler quittieren
         iType    := 0;
         bPrepare := FALSE;
         bStart   := FALSE;
         bQuit    := TRUE;
         bRovisTelegram := TRUE;
         WAIT NOT bRovisTelegram;  // Telegramm gesendet

         // WAIT bRovisReady OR timeOut;
         WAIT (bRovisReady AND (iRovisError = 0)) OR timeOut OR bTBoxSimulate; // 06.06.2016 Mai/ISRA
         IF timeOut THEN
            myRobot.DebugPrint(eTraceVision, "TimeOut in TBoxTcpStart by waiting for >bRovisReady AND (iRovisError = 0)<");
            bCommError := TRUE;
            RcuSetMessageOnce(TRcVisionBk_ErrTimeOut, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.TBoxTcpStart", "TBOX_CORR", "bRovisReady AND (iRovisError = 0)");
            myRobot.ErrorReaction(TRUE);
         END_IF;
      END_IF;

      // Runmode = 8 senden, wenn ROVIS nicht in Betriebsart "Nullmessung"
      IF iRovisRunMode <> 8 THEN
         iRunMode := 8;  // Betriebsart = Nullmessung
         iType    := 0;
         bPrepare := FALSE;
         bStart   := FALSE;
         bQuit    := FALSE;
         bRovisTelegram := TRUE;
         WAIT NOT bRovisTelegram;  // Telegramm gesendet
         // Warten bis Runmode = 8 empfangen
         SysTimerSet(10000, timeOut);
         WAIT (iRovisRunMode = 8) OR timeOut OR bTBoxSimulate;
         IF timeOut THEN
            bCommError := TRUE;
            RcuSetMessageOnce(TRcVisionBk_ErrTimeOut, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.TBoxTcpStart", "TBOX_CORR", "ROVIS Nullmessung");
            myRobot.ErrorReaction(TRUE);
         END_IF;
      END_IF;

      iRunMode := 0;              // alles zurücksetzen
      iType    := 0;
      bPrepare := FALSE;
      bStart   := FALSE;
      bQuit    := FALSE;
      bRovisTelegram := TRUE;
      WAIT NOT bRovisTelegram;  // Telegramm gesendet

      iRunMode := 0;
      iType    := ToolNr;
      bPrepare := TRUE;
      bStart   := FALSE;
      bQuit    := FALSE;
      bRovisTelegram := TRUE;
      WAIT NOT bRovisTelegram;  // Telegramm gesendet

      SysTimerSet(10000, timeOut);
      WAIT bRovisPrepared OR (iRovisError<>0) OR timeOut OR bTBoxSimulate; // Status Prepared = 1 erwarten
      IF (iRovisError <> 0) THEN
         myRobot.DebugPrint(eTraceVision, "TBoxTcpStart Type " + STR(ToolNr) + " Wrong Type");
         myRobot.logger.SetLoggerStep(iLoggerNumber, "ISRA TBoxTcpStart Type " + STR(ToolNr) + " Wrong Type");
         RcuSetMessageOnce(TRcVisionBk_ErrWrongType, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.TBoxTcpStart", STR(ToolNr), "TBOX_CORR");
         myRobot.ErrorReaction(TRUE);
      ELSIF timeOut THEN
         bCommError := TRUE;
         RcuSetMessageOnce(TRcVisionBk_ErrTimeOut, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.TBoxTcpStart", "TBOX_CORR", "ROVIS Prepared");
         myRobot.ErrorReaction(TRUE);
      END_IF;

      myRobot.DebugPrint(eTraceVision, "TBoxTcpStart Type " + STR(ToolNr) + " send to ISRA");
      myRobot.logger.SetLoggerStep(iLoggerNumber, "ISRA TBoxTcpStart Type " + STR(ToolNr) + " send to ISRA");
      
      
      ///////////////////////////////////////////////////////////////////////////////////////////////////////
      // Start Messung
      
      iType    := 0;
      bPrepare := FALSE;
      bStart   := TRUE;         // Strobe Start = 1 senden
      bRovisTelegram := TRUE;
      WAIT NOT bRovisTelegram;  // Telegramm gesendet

      SysTimerSet(10000, timeOut);
      WAIT (bRovisAcquisition AND bRovisMeasurement AND bRovisData) OR timeOut OR bTBoxSimulate; 
                                                                       // Status Acquisition = 0 &
                                                                       // Measurement = 1 &
                                                                       // Data = 1 erwarten
      IF timeOut THEN
         bCommError := TRUE;
         RcuSetMessageOnce(TRcVisionBk_ErrTimeOut, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.TBoxTcpStart", 
                           "TBOX_CORR", "ROVIS  Acquisition & Measurement & Data");
         myRobot.ErrorReaction(TRUE);
      END_IF;
      
      bPrepare := FALSE;
      bStart   := FALSE;        // Strobe Start = 0 senden
      bRovisTelegram := TRUE;
      WAIT NOT bRovisTelegram;  // Telegramm gesendet

      IF timeOut THEN
         RcuSetMessageOnce(TRcVisionTool_ErrTimeOutSignal, myRobot.kinListInx, 9, instId, "TRcuVisionIsraBK2.TBoxTcpStart", " ");
         myRobot.ErrorReaction(TRUE);
      END_IF;
      
      // Ablauf TCP-Kalibrierung starten
      // Hemflange-Kommunikation?????????????????????????????????????????????????
      
      BK_MODUS := Mode_AEC_Measure;
      BK_RequestCount := 1;
      BK_ScanRobPos := 1;
      BK_TriggerCount := 0;
      BK_NumberOfPoints := 0;
      bBK_SIG_TRIGGER := FALSE;

      // Aktuelle Messpositionen loeschen
      FOR i := 1 TO MaxPunkteProMessung DO
         BKMessPos[i] := NULLFRAME;
         BKMessPunkt[i] := 0;
      END_FOR;

      BK_Measure_Ok := TRUE;

      // Evtl. vorhandene Korrekturen loeschen
      FOR i := 1 TO 5 DO
       IF (BK_KORR_BAHN_ID[i] = BK_PATH) OR (BK_KORR_BAHN_ID[i] = -BK_PATH) THEN
         BK_KORR_BAHN_ID[i] := 0;
         BK_KORREKTUREN_GUELTIG[i] := 0;
         FOR j := 1 TO MaxPunkteProMessung DO
           BK_KORREKTUR[i][j] := NULLFRAME;
         END_FOR;
         IF (BK_KORR_BAHNEN > 0) THEN
           BK_KORR_BAHNEN := BK_KORR_BAHNEN - 1;
         END_IF;
       END_IF;
      END_FOR;

      //BahnIndex bestimmen
      BK_PATH_INDEX := 0;
      FOR i := 1 TO 5 DO
         IF (BK_KORR_BAHN_ID[i] = BK_PATH) THEN
            BK_PATH_INDEX := i;
         END_IF;
      END_FOR;
      //Keine aktuellen Ergebnisse fuer diese Bahn gefunden
      IF (BK_PATH_INDEX = 0) THEN
         // Erste freie Stelle suchen
         i := 1;
         bEXIT := FALSE;
         WHILE (i <= 5) AND NOT bEXIT DO
            IF (BK_KORR_BAHN_ID[i] = 0) THEN
               BK_PATH_INDEX := i;
               BK_KORR_BAHN_ID[i] := BK_PATH;
               BK_KORR_BAHNEN := BK_KORR_BAHNEN + 1;
               BK_KORREKTUREN_GUELTIG[i] := 0;
               FOR j := 1 TO MaxPunkteProMessung DO
                  BK_KORREKTUR[i][j] := NULLFRAME;
                  BK_KORR_PUNKT_ID[i][j] := 0;
               END_FOR;
               bEXIT := TRUE;
            END_IF; 
            i := i+1;
         END_WHILE;
      END_IF;

      // Kein freier Platz mehr - einen loeschen (den ersten bereits abgeholten)
      IF (BK_PATH_INDEX = 0) THEN
         // Erste freie Stelle suchen
         i := 1;
         bEXIT := FALSE;
         WHILE (i <= 5) AND NOT bEXIT DO
            IF (BK_KORR_BAHN_ID[i] < 0) THEN
               BK_PATH_INDEX := i;
               BK_KORR_BAHN_ID[i] := BK_PATH;
               BK_KORR_BAHNEN := BK_KORR_BAHNEN + 1;
               BK_KORREKTUREN_GUELTIG[i] := 0;
               FOR j := 1 TO MaxPunkteProMessung DO
                  BK_KORREKTUR[i][j] := NULLFRAME;
                  BK_KORR_PUNKT_ID[i][j] := 0;
               END_FOR;
               bEXIT := TRUE;
            END_IF; 
            i := i+1;
         END_WHILE;
      END_IF;
      
   // Werte asynchron empfangen
   bReceiveToolAEC := TRUE;
   bReceiveObjectAEC := TRUE;
      
   END_IF;
   RETURN bResult;   
END_ROUTINE


ROUTINE TBoxTcpPoint(pointNumber : DINT) : BOOL

  STOPPOINT();
  IF client.tcpConnectionState <> stateSckConnected THEN
     myRobot.DebugPrint(eTraceVision, "TBoxTcpPoint: Communication to Vision PC: ConnectionState <> stateSckConnected");
     bCommError := TRUE;         
     RETURN FALSE;
  END_IF;
   
  IF BK_ScanRobPos > 0 THEN
      myRobot.DebugPrint(eTraceVision, "TBoxTcpPoint: B point = " + STR(pointNumber));
      BKMessPos[BK_ScanRobPos].X := myRobot.readBackObjectPos.mPos.mValues[0];
      BKMessPos[BK_ScanRobPos].Y := myRobot.readBackObjectPos.mPos.mValues[1];
      BKMessPos[BK_ScanRobPos].Z := myRobot.readBackObjectPos.mPos.mValues[2];
      BKMessPos[BK_ScanRobPos].A := myRobot.readBackObjectPos.mOri.mValues[0];
      BKMessPos[BK_ScanRobPos].B := myRobot.readBackObjectPos.mOri.mValues[1];
      BKMessPos[BK_ScanRobPos].C := myRobot.readBackObjectPos.mOri.mValues[2];
      BKMessPunkt[BK_ScanRobPos] := pointNumber;
      IF bBK_SIG_TRIGGER THEN
         WAIT NOT bBK_SIG_TRIGGER;
         RcuSetMessageOnce(TRcVisionBk_ErrTrigTooFast, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBK2.TBoxTcpPoint", STR(pointNumber));
         myRobot.ErrorReaction(TRUE);
         RETURN FALSE;
      ELSE
         PULSE(bBK_SIG_TRIGGER, TRUE, BK_TriggerTime);
      END_IF;
   END_IF;
   BK_ScanRobPos := BK_ScanRobPos + 1;
   RETURN TRUE;
END_ROUTINE


ROUTINE TBoxTcpEnd(VAR_IN TBoxBase : OBJECT; VAR_IN ActTool : TOOL) : BOOL
VAR
   bResultTool   : BOOL;
   bResultObject : BOOL;
   pos_act       : FRAME;
   bTimeOut      : BOOL;
   nullTool      : TOOL;
   nullFrame     : TMcuFrame;
   timeOut       : BOOL;
   sLogText      : STRING;
END_VAR

   //init data for Userpage
   myRobot.vision.VisionTool.CorrFrame      := nullFrame;
   myRobot.vision.VisionTool.TVCorrTool     := nullTool;
   myRobot.vision.VisionTool.TVRefTool      := nullTool;
   myRobot.vision.VisionTool.TVRefToolName  := "";
   myRobot.vision.VisionTool.TVCorrToolName := "";
   myRobot.vision.VisionTool.TVToolNr       := 0;
   sAlarmLimitsUserPage.rXmin               := 0.0;
   sAlarmLimitsUserPage.rXmax               := 0.0;
   sAlarmLimitsUserPage.rYmin               := 0.0;
   sAlarmLimitsUserPage.rYmax               := 0.0;
   sAlarmLimitsUserPage.rZmin               := 0.0;
   sAlarmLimitsUserPage.rZmax               := 0.0;
   sWarnLimitsUserPage.rXmin                := 0.0;
   sWarnLimitsUserPage.rXmax                := 0.0;
   sWarnLimitsUserPage.rYmin                := 0.0;
   sWarnLimitsUserPage.rYmax                := 0.0;
   sWarnLimitsUserPage.rZmin                := 0.0;
   sWarnLimitsUserPage.rZmax                := 0.0;
   sWarnLimitsUserPage.iLabel               := 0; //"ungueltig";
   bCorrectionOkUserPage                    := FALSE;
   
   myRobot.DebugPrint(eTraceVision, "TBoxTcpEnd: ");
   
   bFinishMeasureAEC := TRUE;
   WAIT NOT bFinishMeasureAEC;
   
   // Warten auf Ergebnisse empfangen
   timeOut := FALSE;
   SysTimerSet(1000, timeOut);
   WAIT (NOT bReceiveToolAEC AND NOT bReceiveObjectAEC) OR timeOut OR bTBoxSimulate;
   IF timeOut THEN
      myRobot.DebugPrint(eTraceVision, "TimeOut in TBoxTcpEnd while waiting for (NOT bReceiveToolAEC AND NOT bReceiveObjectAEC)");
      RcuSetMessageOnce(TRcVisionBk_ErrTimeOutReceive, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBK2.TBoxTcpEnd", "111");
      RETURN FALSE;
   END_IF;
   
   // receive tool data

   myRobot.logger.SetLoggerStep(iLoggerNumber, "TBoxTcpEnd Receive Tool von ISRA:");
   myRobot.DebugPrint(eTraceVision, "TBoxTcpEnd Receive Tool von ISRA:");
   sLogText := " X = " + STR(TBOX_Tool_X) + ", Y = " + STR(TBOX_Tool_Y) + ", Z = " + STR(TBOX_Tool_Z);
   myRobot.logger.SetLoggerStep(iLoggerNumber, sLogText);
   myRobot.DebugPrint(eTraceVision, sLogText);
   sLogText := " Rx = " + STR(TBOX_Tool_RX) + ", Ry = " + STR(TBOX_Tool_RY) + ", Rz = " + STR(TBOX_Tool_RZ);
   myRobot.logger.SetLoggerStep(iLoggerNumber, sLogText);
   myRobot.DebugPrint(eTraceVision, sLogText);
   ActTool.X_mm := TBOX_Tool_X;
   ActTool.Y_mm := TBOX_Tool_Y;
   ActTool.Z_mm := TBOX_Tool_Z;
   ActTool.A_deg := TBOX_Tool_RX;
   ActTool.B_deg := TBOX_Tool_RY;
   ActTool.C_deg := TBOX_Tool_RZ;
   myRobot.vision.VisionTool.TVCorrTool.X_mm  := TBOX_Tool_X; 
   myRobot.vision.VisionTool.TVCorrTool.Y_mm  := TBOX_Tool_Y; 
   myRobot.vision.VisionTool.TVCorrTool.Z_mm  := TBOX_Tool_Z; 
   myRobot.vision.VisionTool.TVCorrTool.A_deg := TBOX_Tool_RX;
   myRobot.vision.VisionTool.TVCorrTool.B_deg := TBOX_Tool_RY;
   myRobot.vision.VisionTool.TVCorrTool.C_deg := TBOX_Tool_RZ;
   
   // receive box position

   myRobot.logger.SetLoggerStep(iLoggerNumber, "TBoxTcpEnd Receive Boxposition von ISRA:");
   myRobot.DebugPrint(eTraceVision, "TBoxTcpEnd Receive Boxposition von ISRA:");
   sLogText := " X = " + STR(TBOX_Base_X) + ", Y = " + STR(TBOX_Base_Y) + ", Z = " + STR(TBOX_Base_Z);
   myRobot.logger.SetLoggerStep(iLoggerNumber, sLogText);
   myRobot.DebugPrint(eTraceVision, sLogText);
   sLogText := " Rx = " + STR(TBOX_Base_RX) + ", Ry = " + STR(TBOX_Base_RY) + ", Rz = " + STR(TBOX_Base_RZ);
   myRobot.logger.SetLoggerStep(iLoggerNumber, sLogText);
   myRobot.DebugPrint(eTraceVision, sLogText);
   TBoxBase.X_mm := TBOX_Base_X;
   TBoxBase.Y_mm := TBOX_Base_Y;
   TBoxBase.Z_mm := TBOX_Base_Z;
   TBoxBase.A_deg := TBOX_Base_RX;
   TBoxBase.B_deg := TBOX_Base_RY;
   TBoxBase.C_deg := TBOX_Base_RZ;
   myRobot.vision.VisionTool.CorrFrame.mPos.mValues[0] := TBOX_Base_X; 
   myRobot.vision.VisionTool.CorrFrame.mPos.mValues[1] := TBOX_Base_Y; 
   myRobot.vision.VisionTool.CorrFrame.mPos.mValues[2] := TBOX_Base_Z; 
   myRobot.vision.VisionTool.CorrFrame.mOri.mValues[0] := TBOX_Base_RX;
   myRobot.vision.VisionTool.CorrFrame.mOri.mValues[1] := TBOX_Base_RY;
   myRobot.vision.VisionTool.CorrFrame.mOri.mValues[2] := TBOX_Base_RZ;
   bCorrectionOkUserPage                               := TRUE;
   
   
   // 4. Status senden und 5.Ablauf beenden (siehe Seite 20)
   myRobot.DebugPrint(eTraceVision, "TBoxTcpEnd: FinishApplicationAEC");
   bFinishApplicationAEC :=  TRUE;
   WAIT NOT bFinishApplicationAEC;
   
   timeOut := FALSE;
   SysTimerSet(10000, timeOut);
   bBkConnect := FALSE;
   WAIT NOT bBkActive OR timeOut OR bDisabledHMI;
   IF timeOut THEN
      myRobot.DebugPrint(eTraceVision, "TimeOut in TBoxTcpEnd by waiting for bBkConnect = FALSE");
      RcuSetMessageOnce(TRcVisionBk_ErrTimeOutBkEnd, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBK2.TBoxTcpEnd");
   END_IF;

   // Fehlermeldung zur Aufforderung zum manuellen Übernehmen der Objektdaten
   RcuSetMessageOnce(TRcVisionBk_ErrTakeObjVals, myRobot.kinListInx, 2, instId, "TRcuVisionIsraBK2.TBoxTcpEnd");

   RETURN bResultTool AND bResultObject;
   
END_ROUTINE


ROUTINE TBoxCorr(ToolNr : DINT; RefTool : TOOL; CorrTool : TOOL; iRetVal : VISION_STATE) : BOOL
VAR
   bResult       : BOOL;
   bTimeOut      : BOOL;
   pos_act       : FRAME;
   FrameDiff     : TMcuFrame;
   OrgFrame      : TMcuFrame;
   CorrFrame     : TMcuFrame;
   nullTool      : TOOL;
   timeOut       : BOOL;
   sText         : STRING;
   bRangeOK      : BOOL := TRUE;
   bWarnLimitOk  : BOOL;
   rXmin         : REAL;
   rXmax         : REAL;
   rYmin         : REAL;
   rYmax         : REAL;
   rZmin         : REAL;
   rZmax         : REAL;
END_VAR

   //init data for EcoScreen
   tEPS_ToolCorrOut.tDataVision.name   := "";
   tEPS_ToolCorrOut.tDataVision.x      := 0.0;
   tEPS_ToolCorrOut.tDataVision.y      := 0.0;
   tEPS_ToolCorrOut.tDataVision.z      := 0.0;
   tEPS_ToolCorrOut.tDataVision.A      := 0.0;
   tEPS_ToolCorrOut.tDataVision.B      := 0.0;
   tEPS_ToolCorrOut.tDataVision.C      := 0.0;
   tEPS_ToolCorrOut.tDataRefTool.name  := "";
   tEPS_ToolCorrOut.tDataRefTool.x     := 0.0;
   tEPS_ToolCorrOut.tDataRefTool.y     := 0.0;
   tEPS_ToolCorrOut.tDataRefTool.z     := 0.0;
   tEPS_ToolCorrOut.tDataRefTool.A     := 0.0;
   tEPS_ToolCorrOut.tDataRefTool.B     := 0.0;
   tEPS_ToolCorrOut.tDataRefTool.C     := 0.0;
   tEPS_ToolCorrOut.tDataCorrTool.name := "";
   tEPS_ToolCorrOut.tDataCorrTool.x    := 0.0;
   tEPS_ToolCorrOut.tDataCorrTool.y    := 0.0;
   tEPS_ToolCorrOut.tDataCorrTool.z    := 0.0;
   tEPS_ToolCorrOut.tDataCorrTool.A    := 0.0;
   tEPS_ToolCorrOut.tDataCorrTool.B    := 0.0;
   tEPS_ToolCorrOut.tDataCorrTool.C    := 0.0;
   //init data for Userpage
   myRobot.vision.VisionTool.CorrFrame      := FrameDiff;
   myRobot.vision.VisionTool.TVCorrTool     := nullTool;
   myRobot.vision.VisionTool.TVRefTool      := nullTool;
   myRobot.vision.VisionTool.TVRefToolName  := "";
   myRobot.vision.VisionTool.TVCorrToolName := "";
   myRobot.vision.VisionTool.TVToolNr       := 0;
   sAlarmLimitsUserPage.rXmin               := 0.0;
   sAlarmLimitsUserPage.rXmax               := 0.0;
   sAlarmLimitsUserPage.rYmin               := 0.0;
   sAlarmLimitsUserPage.rYmax               := 0.0;
   sAlarmLimitsUserPage.rZmin               := 0.0;
   sAlarmLimitsUserPage.rZmax               := 0.0;
   sWarnLimitsUserPage.rXmin                := 0.0;
   sWarnLimitsUserPage.rXmax                := 0.0;
   sWarnLimitsUserPage.rYmin                := 0.0;
   sWarnLimitsUserPage.rYmax                := 0.0;
   sWarnLimitsUserPage.rZmin                := 0.0;
   sWarnLimitsUserPage.rZmax                := 0.0;
   sWarnLimitsUserPage.iLabel               := 0; //"ungueltig";
   bCorrectionOkUserPage                    := FALSE;
   
   IF bDisabledHMI THEN
      CorrTool := RefTool;
      iRetVal  := Failure;
      bResult  := FALSE;
      myRobot.DebugPrint(eTraceVision, "ToolBox is disabled");
   ELSE   
      IF (ToolNr < 0) OR (ToolNr > 255) THEN
         RcuSetMessageOnce(TRcVisionTool_ErrInvalidTool, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBK2.TBoxCorr", myRobot.progPath.GetSource());
         myRobot.ErrorReaction(TRUE);
      END_IF;

      ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
      // Ablauf gemaess Kapitel 5.4 Beauftragung TCP-Korrektur //
      ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
      // Nummer der Messaufgabe an ISRA      
      TBOX_TOOL_NUM := ToolNr;
      bCommError                              := FALSE;
      SysTimerSet(10000, timeOut);
      bBkConnect                              := TRUE;
      WAIT bBkActive OR timeOut OR bTBoxSimulate OR bDisabledHMI;
      IF bDisabledHMI THEN
         myRobot.DebugPrint(eTraceVision, "TBOX_CORR is disabled by HMI");
         RETURN FALSE;
      ELSIF timeOut THEN
         RcuSetMessageOnce(TRcVisionBk_ErrTimeOut, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.TBoxCorr", "TBOX_CORR", "bBkActive");
         bCommError := TRUE;
         bBkConnect := FALSE;
         myRobot.ErrorReaction(TRUE);
         RETURN FALSE;
      END_IF;

      sText := "TBoxCorr: Type = "+STR(ToolNr);
      myRobot.DebugPrint(eTraceVision, sText);
      myRobot.logger.SetLoggerStep(iLoggerNumber, sText);

      SysTimerSet(10000, timeOut);
      WAIT (TelCounter <> 0) OR timeOut; // auf erstes Telegramm von ROVIS warten
      IF timeOut THEN
         myRobot.DebugPrint(eTraceVision, "TimeOut in TBoxCorr by waiting for TelCounter <> 0");
         bCommError := TRUE;
         RcuSetMessageOnce(TRcVisionBk_ErrTimeOut, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.TBoxCorr", "TBOX_CORR", "TelCounter <> 0");
         myRobot.ErrorReaction(TRUE);
      END_IF;

      // Status Ready=1 Error=0 erwarten
      SysTimerSet(10000, timeOut);
      WAIT bRovisReady OR timeOut OR (iRovisError <> 0) OR bTBoxSimulate;
      IF timeOut THEN
         myRobot.DebugPrint(eTraceVision, "TimeOut in TBoxCorr by waiting for bRovisReady");
         bCommError := TRUE;
         RcuSetMessageOnce(TRcVisionBk_ErrTimeOut, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.TBoxCorr", "TBOX_CORR", "ROVIS Ready");
         myRobot.ErrorReaction(TRUE);
      ELSIF (iRovisError <> 0) THEN
         iRunMode := 0;              // Fehler quittieren
         iType    := 0;
         bPrepare := FALSE;
         bStart   := FALSE;
         bQuit    := TRUE;
         bRovisTelegram := TRUE;
         WAIT NOT bRovisTelegram;  // Telegramm gesendet

         // WAIT bRovisReady OR timeOut;
         WAIT (bRovisReady AND (iRovisError = 0)) OR timeOut OR bTBoxSimulate; // 06.06.2016 Mai/ISRA
         IF timeOut THEN
            myRobot.DebugPrint(eTraceVision, "TimeOut in TBoxCorr by waiting for >bRovisReady AND (iRovisError = 0)<");
            bCommError := TRUE;
            RcuSetMessageOnce(TRcVisionBk_ErrTimeOut, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.TBoxCorr", "TBOX_CORR", "bRovisReady AND (iRovisError = 0)");
            myRobot.ErrorReaction(TRUE);
         END_IF;
      END_IF;

      // Runmode = 2 senden, wenn ROVIS nicht in Betriebsart "Automatik"
      IF iRovisRunMode <> 2 THEN
         iRunMode := 2;  // Betriebsart = Automatik
         iType    := 0;
         bPrepare := FALSE;
         bStart   := FALSE;
         bQuit    := FALSE;
         bRovisTelegram := TRUE;
         WAIT NOT bRovisTelegram;  // Telegramm gesendet
         // Warten bis Runmode = 2 empfangen
         SysTimerSet(10000, timeOut);
         WAIT (iRovisRunMode = 2) OR timeOut OR bTBoxSimulate;
         IF timeOut THEN
            bCommError := TRUE;
            RcuSetMessageOnce(TRcVisionBk_ErrTimeOut, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.TBoxCorr", "TBOX_CORR", "ROVIS Nullmessung");
            myRobot.ErrorReaction(TRUE);
         END_IF;
      END_IF;

      iRunMode := 0;              // alles zurücksetzen
      iType    := 0;
      bPrepare := FALSE;
      bStart   := FALSE;
      bQuit    := FALSE;
      bRovisTelegram := TRUE;
      WAIT NOT bRovisTelegram;  // Telegramm gesendet

      iRunMode := 0;
      iType    := ToolNr;
      bPrepare := TRUE;
      bStart   := FALSE;
      bQuit    := FALSE;
      bRovisTelegram := TRUE;
      WAIT NOT bRovisTelegram;  // Telegramm gesendet

      SysTimerSet(10000, timeOut);
      WAIT bRovisPrepared OR (iRovisError<>0) OR timeOut OR bTBoxSimulate; // Status Prepared = 1 erwarten
      IF (iRovisError <> 0) THEN
         myRobot.DebugPrint(eTraceVision, "TBoxCorr Type " + STR(ToolNr) + " Wrong Type");
         myRobot.logger.SetLoggerStep(iLoggerNumber, "ISRA TBoxCorr Type " + STR(ToolNr) + " Wrong Type");
         RcuSetMessageOnce(TRcVisionBk_ErrWrongType, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.TBoxCorr", STR(ToolNr), "TBOX_CORR");
         myRobot.ErrorReaction(TRUE);
      ELSIF timeOut THEN
         bCommError := TRUE;
         RcuSetMessageOnce(TRcVisionBk_ErrTimeOut, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.TBoxCorr", "TBOX_CORR", "ROVIS Prepared");
         myRobot.ErrorReaction(TRUE);
      END_IF;

      myRobot.DebugPrint(eTraceVision, "TBoxCorr Type " + STR(ToolNr) + " send to ISRA");
      myRobot.logger.SetLoggerStep(iLoggerNumber, "ISRA TBoxCorr Type " + STR(ToolNr) + " send to ISRA");
      
      
      ///////////////////////////////////////////////////////////////////////////////////////////////////////
      // Start Messung
      
      myRobot.DebugPrint(eTraceVision, "ISRA TBoxCorr position 1");
      myRobot.logger.SetLoggerStep(iLoggerNumber, "ISRA TBoxCorr position 1");

      iType    := 0;
      bPrepare := FALSE;
      bStart   := TRUE;         // Strobe Start = 1 senden
      bRovisTelegram := TRUE;
      WAIT NOT bRovisTelegram;  // Telegramm gesendet

      SysTimerSet(10000, timeOut);
      WAIT ( bRovisAcquisition AND bRovisMeasurement AND bRovisData) OR timeOut OR bTBoxSimulate; 
                                                                       // Status Acquisition = 0 &
                                                                       // Measurement = 1 &
                                                                       // Data = 1 erwarten
      IF timeOut THEN
         bCommError := TRUE;
         RcuSetMessageOnce(TRcVisionBk_ErrTimeOut, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.TBoxCorr", 
                           "TBOX_CORR", "ROVIS Acquisition & Measurement & Data");
         myRobot.ErrorReaction(TRUE);
      END_IF;
      
      bPrepare := FALSE;
      bStart   := FALSE;        // Strobe Start = 0 senden
      bRovisTelegram := TRUE;
      WAIT NOT bRovisTelegram;  // Telegramm gesendet

      IF timeOut THEN
         RcuSetMessageOnce(TRcVisionTool_ErrTimeOutSignal, myRobot.kinListInx, 9, instId, "TRcuVisionIsraBK2.TBoxCorr", "PictureFinished");
         myRobot.ErrorReaction(TRUE);
      END_IF;
      
      myRobot.DebugPrint(eTraceVision, "TBoxCorr picture finished for position 1");
      myRobot.logger.SetLoggerStep(iLoggerNumber, "ISRA TBoxCorr picture finished for position 1");

      //////////////////////////////////////////////////////////////////////////////////////////////////////////////////
      // Korrekturwerte holen
      SysTimerSet(10000, timeOut);
      WAIT (NOT bRovisAcquisition AND NOT bRovisMeasurement AND NOT bRovisData) OR timeOut OR bTBoxSimulate; 
                                                                               // Status Acquisition = 0 &
                                                                               // Measurement = 0 &
                                                                               // Data = 0 erwarten
      IF timeOut THEN
         bCommError := TRUE;
         bRangeOK := FALSE;
         RcuSetMessageOnce(TRcVisionBk_ErrTimeOut, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.TBoxCorr", 
                           "TBOX_CORR", "ROVIS NOT Acquisition & NOT Measurement & NOT Data");
      END_IF;

      IF iRovisError = 0 THEN
         // Daten von ISRA -> CorrFrame
         TBOX_Korr_X   := RovisResult.X;
         TBOX_Korr_Y   := RovisResult.Y;
         TBOX_Korr_Z   := RovisResult.Z;;
         TBOX_Korr_RX  := RovisResult.A;
         TBOX_Korr_RY  := RovisResult.B;
         TBOX_Korr_RZ  := RovisResult.C;     

         myRobot.logger.SetLoggerStep(iLoggerNumber, "TBoxCorr Receive Data von ISRA:");
         myRobot.DebugPrint(eTraceVision, "TBoxTcpEnd Receive Data von ISRA:");
         sText := " X = " + STR(TBOX_Korr_X) + ", Y = " + STR(TBOX_Korr_Y) + ", Z = " + STR(TBOX_Korr_Z);
         myRobot.logger.SetLoggerStep(iLoggerNumber, sText);
         myRobot.DebugPrint(eTraceVision, sText);
         sText := " Rx = " + STR(TBOX_Korr_RX) + ", Ry = " + STR(TBOX_Korr_RY) + ", Rz = " + STR(TBOX_Korr_RZ);
         myRobot.logger.SetLoggerStep(iLoggerNumber, sText);
         myRobot.DebugPrint(eTraceVision, sText);
         
         IF bUseWarningLimit THEN
            SetLimitsUserPage(sWarnLimits, sWarnLimitsUserPage);
         END_IF;
         SetLimitsUserPage(sAlarmLimits, sAlarmLimitsUserPage);
         //Check alarm limits
         IF NOT (sAlarmLimits.bConfigured OR sAlarmLimits.bSetByEcoTalk) THEN
            RcuSetMessageOnce(TRcToolMeasure_ErrNoTolerance, myRobot.kinListInx, 1, 0, "TRcuVisionBk.TBoxCorr");
            bRangeOK := FALSE;
         ELSIF sAlarmLimits.bSetByEcoTalk THEN
            rXmin := sAlarmLimits.rXmin_TP;
            rXmax := sAlarmLimits.rXmax_TP;
            rYmin := sAlarmLimits.rYmin_TP;
            rYmax := sAlarmLimits.rYmax_TP;
            rZmin := sAlarmLimits.rZmin_TP;
            rZmax := sAlarmLimits.rZmax_TP;
            bRangeOK := TRUE;
         ELSIF sAlarmLimits.bConfigured THEN   
            rXmin := sAlarmLimits.rXmin_Cfg;
            rXmax := sAlarmLimits.rXmax_Cfg;
            rYmin := sAlarmLimits.rYmin_Cfg;
            rYmax := sAlarmLimits.rYmax_Cfg;
            rZmin := sAlarmLimits.rZmin_Cfg;
            rZmax := sAlarmLimits.rZmax_Cfg;
            bRangeOK := TRUE;
         END_IF;

         IF bRangeOK THEN
            IF TBOX_Korr_X < rXmin THEN 
               myRobot.logger.SetLoggerStep(iLoggerNumber, "Tool curvature ("  + STR(TBOX_Korr_X)  + ") in X direction out of negative limit (" + STR(rXmin) + "). Change nozzle!!!!");
               RcuSetMessageOnce(TRcToolMeasure_WarMaxDeltaRched, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.TBoxCorr", "X", STR(TBOX_Korr_X));
               bRangeOK := FALSE;
            END_IF;
            IF TBOX_Korr_X > rXmax THEN
               myRobot.logger.SetLoggerStep(iLoggerNumber, "Tool curvature ("  + STR(TBOX_Korr_X)  + ") in X direction out of positive limit (" + STR(rXmax) + "). Change nozzle!!!!");
               RcuSetMessageOnce(TRcToolMeasure_WarMaxDeltaRched, myRobot.kinListInx, 2, 0, "TRcuVisionIsraBK2.TBoxCorr", "X", STR(TBOX_Korr_X));
               bRangeOK := FALSE;
            END_IF;

            IF TBOX_Korr_Y < rYmin THEN
               myRobot.logger.SetLoggerStep(iLoggerNumber, "Tool curvature ("  + STR(TBOX_Korr_Y)  + ") in Y direction out of negative limit (" + STR(rYmin) + "). Change nozzle!!!!");
               RcuSetMessageOnce(TRcToolMeasure_WarMaxDeltaRched, myRobot.kinListInx, 3, 0, "TRcuVisionIsraBK2.TBoxCorr", "Y", STR(TBOX_Korr_Y));
               bRangeOK := FALSE;
            END_IF;
            IF TBOX_Korr_Y > rYmax THEN
               myRobot.logger.SetLoggerStep(iLoggerNumber, "Tool curvature ("  + STR(TBOX_Korr_Y)  + ") in Y direction out of positive limit (" + STR(rYmax) + "). Change nozzle!!!!");
               RcuSetMessageOnce(TRcToolMeasure_WarMaxDeltaRched, myRobot.kinListInx, 4, 0, "TRcuVisionIsraBK2.TBoxCorr", "Y", STR(TBOX_Korr_Y));
               bRangeOK := FALSE;
            END_IF;

            IF TBOX_Korr_Z < rZmin THEN
               myRobot.logger.SetLoggerStep(iLoggerNumber, "Tool curvature ("  + STR(TBOX_Korr_Z)  + ") in Z direction out of negative limit (" + STR(rZmin) + "). Change nozzle!!!!");
               RcuSetMessageOnce(TRcToolMeasure_WarMaxDeltaRched, myRobot.kinListInx, 5, 0, "TRcuVisionIsraBK2.TBoxCorr", "Z", STR(TBOX_Korr_Z));
               bRangeOK := FALSE;
            END_IF;
            IF TBOX_Korr_Z > rZmax THEN
               myRobot.logger.SetLoggerStep(iLoggerNumber, "Tool curvature ("  + STR(TBOX_Korr_Z)  + ") in Z direction out of positive limit (" + STR(rZmax) + "). Change nozzle!!!!");
               RcuSetMessageOnce(TRcToolMeasure_WarMaxDeltaRched, myRobot.kinListInx, 6, 0, "TRcuVisionIsraBK2.TBoxCorr", "Z", STR(TBOX_Korr_Z));
               bRangeOK := FALSE;
            END_IF;

            IF (rAbs(TBOX_Korr_RX) > sAlarmLimits.rRotLimit) THEN
               myRobot.logger.SetLoggerStep(iLoggerNumber, "Tool curvature ("  + STR(TBOX_Korr_RX)  + ") in a direction out of positive limit (" + STR(sAlarmLimits.rRotLimit) + "). Change nozzle!!!!");
               RcuSetMessageOnce(TRcToolMeasure_WarMaxDeltaRched, myRobot.kinListInx, 7, 0, "TRcuVisionIsraBK2.TBoxCorr", "a", STR(TBOX_Korr_RX));
               bRangeOK := FALSE;
            END_IF;
            IF (rAbs(TBOX_Korr_RY) > sAlarmLimits.rRotLimit) THEN
               myRobot.logger.SetLoggerStep(iLoggerNumber, "Tool curvature ("  + STR(TBOX_Korr_RY)  + ") in b direction out of positive limit (" + STR(sAlarmLimits.rRotLimit) + "). Change nozzle!!!!");
               RcuSetMessageOnce(TRcToolMeasure_WarMaxDeltaRched, myRobot.kinListInx, 7, 0, "TRcuVisionIsraBK2.TBoxCorr", "b", STR(TBOX_Korr_RY));
               bRangeOK := FALSE;
            END_IF;       
            IF (rAbs(TBOX_Korr_RZ) > sAlarmLimits.rRotLimit) THEN
               myRobot.logger.SetLoggerStep(iLoggerNumber, "Tool curvature ("  + STR(TBOX_Korr_RZ)  + ") in c direction out of positive limit (" + STR(sAlarmLimits.rRotLimit) + "). Change nozzle!!!!");
               RcuSetMessageOnce(TRcToolMeasure_WarMaxDeltaRched, myRobot.kinListInx, 7, 0, "TRcuVisionIsraBK2.TBOX_ReTBoxCorrcShiftData", "c", STR(TBOX_Korr_RZ));
               bRangeOK := FALSE;
            END_IF;         
         END_IF;
         //Check warning limits and lock outlet if not ok
         bWarnLimitOk := TRUE;
         IF bRangeOK AND bUseWarningLimit THEN
            IF NOT (sWarnLimits.bConfigured OR sWarnLimits.bSetByEcoTalk) THEN
               RcuSetMessageOnce(TRcToolMeasure_ErrNoTolerance, myRobot.kinListInx, 2, 0, "TRcuVisionIsraBK2.TBoxCorr");
               bWarnLimitOk := FALSE;
            ELSIF sWarnLimits.bSetByEcoTalk THEN
               rXmin := sWarnLimits.rXmin_TP;
               rXmax := sWarnLimits.rXmax_TP;
               rYmin := sWarnLimits.rYmin_TP;
               rYmax := sWarnLimits.rYmax_TP;
               rZmin := sWarnLimits.rZmin_TP;
               rZmax := sWarnLimits.rZmax_TP;
            ELSIF sWarnLimits.bConfigured THEN   
               rXmin := sWarnLimits.rXmin_Cfg;
               rXmax := sWarnLimits.rXmax_Cfg;
               rYmin := sWarnLimits.rYmin_Cfg;
               rYmax := sWarnLimits.rYmax_Cfg;
               rZmin := sWarnLimits.rZmin_Cfg;
               rZmax := sWarnLimits.rZmax_Cfg;
            END_IF;
            IF bWarnLimitOk THEN
               IF TBOX_Korr_X < rXmin THEN 
                  myRobot.logger.SetLoggerStep(iLoggerNumber, "Tool curvature ("  + STR(TBOX_Korr_X)  + ") in X direction out of negative warniung limit (" + STR(rXmin) + "). Check application!!!");
                  RcuSetMessageOnce(TRcToolMeasure_WarnToolDelta, myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.TBoxCorr", STR(TBOX_Korr_X), "-X", STR(rXmin));
                  bWarnLimitOk := FALSE;
               END_IF;
               IF TBOX_Korr_X > rXmax THEN
                  myRobot.logger.SetLoggerStep(iLoggerNumber, "Tool curvature ("  + STR(TBOX_Korr_X)  + ") in X direction out of positive warniung limit (" + STR(rXmax) + "). Check application!!!");
                  RcuSetMessageOnce(TRcToolMeasure_WarnToolDelta, myRobot.kinListInx, 2, 0, "TRcuVisionIsraBK2.TBoxCorr", STR(TBOX_Korr_X), "+X", STR(rXmax));
                  bWarnLimitOk := FALSE;
               END_IF;

               IF TBOX_Korr_Y < rYmin THEN 
                  myRobot.logger.SetLoggerStep(iLoggerNumber, "Tool curvature ("  + STR(TBOX_Korr_Y)  + ") in Y direction out of negative warniung limit (" + STR(rYmin) + "). Check application!!!");
                  RcuSetMessageOnce(TRcToolMeasure_WarnToolDelta, myRobot.kinListInx, 3, 0, "TRcuVisionIsraBK2.TBoxCorr", STR(TBOX_Korr_Y), "-Y", STR(rYmin));
                  bWarnLimitOk := FALSE;
               END_IF;
               IF TBOX_Korr_Y > rYmax THEN
                  myRobot.logger.SetLoggerStep(iLoggerNumber, "Tool curvature ("  + STR(TBOX_Korr_Y)  + ") in Y direction out of positive warniung limit (" + STR(rYmax) + "). Check application!!!");
                  RcuSetMessageOnce(TRcToolMeasure_WarnToolDelta, myRobot.kinListInx, 4, 0, "TRcuVisionIsraBK2.TBoxCorr", STR(TBOX_Korr_Y), "+Y", STR(rYmax));
                  bWarnLimitOk := FALSE;
               END_IF;

               IF TBOX_Korr_Z < rZmin THEN 
                  myRobot.logger.SetLoggerStep(iLoggerNumber, "Tool curvature ("  + STR(TBOX_Korr_Z)  + ") in Z direction out of negative warniung limit (" + STR(rZmin) + "). Check application!!!");
                  RcuSetMessageOnce(TRcToolMeasure_WarnToolDelta, myRobot.kinListInx, 5, 0, "TRcuVisionIsraBK2.TBoxCorr", STR(TBOX_Korr_Z), "-Z", STR(rXmin));
                  bWarnLimitOk := FALSE;
               END_IF;
               IF TBOX_Korr_Z > rZmax THEN
                  myRobot.logger.SetLoggerStep(iLoggerNumber, "Tool curvature ("  + STR(TBOX_Korr_Z)  + ") in Z direction out of positive warniung limit (" + STR(rZmax) + "). Check application!!!");
                  RcuSetMessageOnce(TRcToolMeasure_WarnToolDelta, myRobot.kinListInx, 6, 0, "TRcuVisionIsraBK2.TBoxCorr", STR(TBOX_Korr_Z), "+X", STR(rZmax));
                  bWarnLimitOk := FALSE;
               END_IF;
            END_IF;
         END_IF;
         IF bUseWarningLimit AND bWarnLimitOk THEN
            bWarningToPLC := FALSE;  //release outlet
         ELSIF bUseWarningLimit AND myRobot.mainModeMgr.externControl THEN
            bWarningToPLC := TRUE;   //lock outlet
         END_IF;

         IF NOT bRangeOK THEN
            CorrFrame.mFrameTyp := eMcuFrameKardan;
            CorrFrame.mPos.mValues[0]  := 0.0;
            CorrFrame.mPos.mValues[1]  := 0.0;
            CorrFrame.mPos.mValues[2]  := 0.0;
            CorrFrame.mOri.mValues[0] := 0.0;
            CorrFrame.mOri.mValues[1] := 0.0;
            CorrFrame.mOri.mValues[2] := 0.0;
            iRetVal := Failure;
            bResult := FALSE;
         ELSE
            iRetVal := DataOk;
            CorrFrame.mFrameTyp := eMcuFrameKardan;
            CorrFrame.mPos.mValues[0] := RovisResult.X;
            CorrFrame.mPos.mValues[1] := RovisResult.Y;
            CorrFrame.mPos.mValues[2] := RovisResult.Z;
            CorrFrame.mOri.mValues[0] := RovisResult.A;
            CorrFrame.mOri.mValues[1] := RovisResult.B;
            CorrFrame.mOri.mValues[2] := RovisResult.C;
            bResult := TRUE;
         END_IF;
         myRobot.logger.SetLoggerStep(iLoggerNumber, "ISRA TBoxCorr");    
         RcuCalcTool(myRobot, RefTool, CorrFrame, CorrTool);      
         //data for EcoScreen
         tEPS_ToolCorrOut.tDataVision.name   := "";
         tEPS_ToolCorrOut.tDataVision.x      := CorrFrame.mPos.mValues[0];
         tEPS_ToolCorrOut.tDataVision.y      := CorrFrame.mPos.mValues[1];
         tEPS_ToolCorrOut.tDataVision.z      := CorrFrame.mPos.mValues[2];
         tEPS_ToolCorrOut.tDataVision.A      := CorrFrame.mOri.mValues[0];
         tEPS_ToolCorrOut.tDataVision.B      := CorrFrame.mOri.mValues[1];
         tEPS_ToolCorrOut.tDataVision.C      := CorrFrame.mOri.mValues[2];
         tEPS_ToolCorrOut.tDataRefTool.name  := RefTool.GetName();
         tEPS_ToolCorrOut.tDataRefTool.x     := RefTool.X_mm;
         tEPS_ToolCorrOut.tDataRefTool.y     := RefTool.Y_mm;
         tEPS_ToolCorrOut.tDataRefTool.z     := RefTool.Z_mm;
         tEPS_ToolCorrOut.tDataRefTool.A     := RefTool.A_deg;
         tEPS_ToolCorrOut.tDataRefTool.B     := RefTool.B_deg;
         tEPS_ToolCorrOut.tDataRefTool.C     := RefTool.C_deg;
         tEPS_ToolCorrOut.tDataCorrTool.name := CorrTool.GetName();
         tEPS_ToolCorrOut.tDataCorrTool.x    := CorrTool.X_mm; 
         tEPS_ToolCorrOut.tDataCorrTool.y    := CorrTool.Y_mm; 
         tEPS_ToolCorrOut.tDataCorrTool.z    := CorrTool.Z_mm; 
         tEPS_ToolCorrOut.tDataCorrTool.A    := CorrTool.A_deg;
         tEPS_ToolCorrOut.tDataCorrTool.B    := CorrTool.B_deg;
         tEPS_ToolCorrOut.tDataCorrTool.C    := CorrTool.C_deg;
      ELSE
         RcuSetMessageOnce(TRcVisionBk_ErrStateNotOk, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBK2.TBoxCorr");
         iRetVal := Failure;
         bResult := FALSE;
      END_IF;
                        
            
      //Disabled at HMI or no sercos communication
      IF bDisabledHMI OR bTimeOut THEN
         iRetVal := Failure;
         bResult := FALSE;
         myRobot.DebugPrint(eTraceVision, "ToolBox is disabled or communication fault");
      //displacement values out of range   
      ELSIF NOT bResult THEN
         //try once more if counter is smaller than cfg value
         IF (yTBoxCntRetry[ToolNr] < iTBoxMaxRetry) THEN
            iRetVal := Remeasure;
            yTBoxCntRetry[ToolNr] := yTBoxCntRetry[ToolNr] + 1;
         //counter expired --> skip this nozzle and go to next
         ELSE  
            //when nozzle changer is used the robot shouldn't stop with error because next nozzle should be taken automatically
            IF myRobot.nozzleChange.hasNozzleChanger THEN
               IF NOT bRangeOK THEN
                  RcuSetMessageOnce(TRcVisionBk_WarTBoxStateNotOk, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBK2.TBoxCorr");
               ELSE
                  RcuSetMessageOnce(TRcVisionBk_WarnValOutOfRange, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBK2.TBoxCorr");
               END_IF;
            ELSE
               IF NOT bRangeOK THEN
                  RcuSetMessageOnce(TRcVisionBk_ErrTBoxStateNotOk, myRobot.kinListInx, 6, instId, "TRcuVisionIsraBK2.TBoxCorr");
               ELSE
                  RcuSetMessageOnce(TRcVisionBk_ErrValOutOfRange, myRobot.kinListInx, 6, instId, "TRcuVisionIsraBK2.TBoxCorr");
               END_IF;
            END_IF;
            iRetVal := Continue;
            yTBoxCntRetry[ToolNr] := 0;
         END_IF;
      //all ok
      ELSE
         iRetVal := DataOk;
         yTBoxCntRetry[ToolNr] := 0;
      END_IF;
   END_IF;
   
   // Userpage
   myRobot.vision.VisionTool.CorrFrame      := FrameDiff;
   myRobot.vision.VisionTool.TVCorrTool     := CorrTool;
   myRobot.vision.VisionTool.TVRefTool      := RefTool;
   myRobot.vision.VisionTool.TVRefToolName  := RefTool.GetName();
   myRobot.vision.VisionTool.TVCorrToolName := CorrTool.GetName();
   myRobot.vision.VisionTool.TVToolNr       := ToolNr;
   bCorrectionOkUserPage                    := bResult; 
   
   timeOut := FALSE;
   SysTimerSet(10000, timeOut);
   bBkConnect := FALSE;
   WAIT NOT bBkActive OR timeOut OR bDisabledHMI;
   IF timeOut THEN
      myRobot.DebugPrint(eTraceVision, "TimeOut in TBoxTcpEnd by waiting for bBkConnect = FALSE");
      RcuSetMessageOnce(TRcVisionBk_ErrTimeOutBkEnd, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBK2.TBoxTcpEnd");
   END_IF;

   //error managment when no nozzle changer is used
   IF (NOT myRobot.nozzleChange.hasNozzleChanger) AND (iRetVal <> DataOk) AND (iRetVal <> Remeasure) AND myRobot.vision.bUseExtendedInterface THEN
      myRobot.logger.SetLoggerStep(iLoggerNumber, "TBoxCorr - Error detected - waiting GoDirectHome or DoRemeasure or Continue");
      myRobot.fieldbusOut.VisionError.svBool := TRUE;
      WAIT myRobot.fieldbusIn.GoDirectHome.svBool OR myRobot.fieldbusIn.DoRemeasure.svBool OR myRobot.fieldbusIn.Continue.svBool;
      IF myRobot.fieldbusIn.DoRemeasure.svBool THEN
         myRobot.logger.SetLoggerStep(iLoggerNumber, "TBoxCorr - DoRemeasure received from PLC");
         myRobot.fieldbusOut.VisionError.svBool := FALSE;
         WAIT NOT myRobot.fieldbusIn.DoRemeasure.svBool;
         iRetVal := Remeasure;
      ELSIF myRobot.fieldbusIn.GoDirectHome.svBool THEN
         myRobot.logger.SetLoggerStep(iLoggerNumber, "TBoxCorr - GoDirectHome received from PLC");
         myRobot.fieldbusOut.VisionError.svBool := FALSE;
         WAIT NOT myRobot.fieldbusIn.GoDirectHome.svBool;
         iRetVal := GoHome;
      ELSIF myRobot.fieldbusIn.Continue.svBool THEN
         myRobot.logger.SetLoggerStep(iLoggerNumber, "TBoxCorr - Continue received from PLC");
         myRobot.fieldbusOut.VisionError.svBool := FALSE;
         WAIT NOT myRobot.fieldbusIn.Continue.svBool;
         iRetVal := Continue;            
      END_IF;
      myRobot.fieldbusOut.VisionError.svBool := FALSE;
   END_IF;
  
   RETURN bResult;
   
END_ROUTINE

// Überschreiben bzw. setzen der maximal zulässigen Alarm-/Warngrenze der Toolkorrektur
ROUTINE TBOX_SetTolerance(LimitType : LIMIT_TYPE; x_min : REAL; x_max : REAL; y_min : REAL; y_max : REAL; z_min : REAL; z_max : REAL)
VAR
   diff       : REAL;
   ok         : BOOL;
   alarmLimit : BOOL;
END_VAR

   alarmLimit := (LimitType = AlarmLimit);
   ok         := TRUE;
   
   diff := (x_max - x_min) / 2.0;
   diff := rAbs(diff);
   IF (diff > cToleranceLimit) THEN
      RcuSetMessageOnce(TRcToolMeasure_ErrTolTooBig,myRobot.kinListInx, 1, 0, "TRcuVisionIsraBK2.TBOX_SetTolerance", "X", STR(diff), STR(cToleranceLimit));
      ok := FALSE;
   END_IF;
   
   diff := (y_max - y_min) / 2.0;
   diff := rAbs(diff);
   IF (diff > cToleranceLimit) THEN
      RcuSetMessageOnce(TRcToolMeasure_ErrTolTooBig,myRobot.kinListInx, 2, 0, "TRcuVisionIsraBK2.TBOX_SetTolerance", "Y", STR(diff), STR(cToleranceLimit));
      ok := FALSE;
   END_IF;
   
   diff := (z_max - z_min) / 2.0;
   diff := rAbs(diff);
   IF (diff > cToleranceLimit) THEN
      RcuSetMessageOnce(TRcToolMeasure_ErrTolTooBig,myRobot.kinListInx, 3, 0, "TRcuVisionIsraBK2.TBOX_SetTolerance", "Z", STR(diff), STR(cToleranceLimit));
      ok := FALSE;
   END_IF;
   
   IF alarmLimit THEN
      sAlarmLimits.bSetByEcoTalk := ok;
      IF ok THEN
         sAlarmLimits.rXmin_TP := x_min;
         sAlarmLimits.rXmax_TP := x_max;
         sAlarmLimits.rYmin_TP := y_min;
         sAlarmLimits.rYmax_TP := y_max;
         sAlarmLimits.rZmin_TP := z_min;
         sAlarmLimits.rZmax_TP := z_max;
         myRobot.DebugPrint(eTraceVision, "TBOX_SetTolerance - AlarmLimits = "+STR(x_min) + " , " + STR(x_max) + " , " + STR(y_min) + " , " + STR(y_max) + " , " + STR(z_min) + " , " + STR(z_max));
      ELSE
         sAlarmLimits.rXmin_TP := 0.0;
         sAlarmLimits.rXmax_TP := 0.0;
         sAlarmLimits.rYmin_TP := 0.0;
         sAlarmLimits.rYmax_TP := 0.0;
         sAlarmLimits.rZmin_TP := 0.0;
         sAlarmLimits.rZmax_TP := 0.0;
         myRobot.DebugPrint(eTraceVision, "TBOX_SetTolerance - AlarmLimits = "+STR(x_min) + " , " + STR(x_max) + " , " + STR(y_min) + " , " + STR(y_max) + " , " + STR(z_min) + " , " + STR(z_max) + " too big");
      END_IF;
   ELSE    
      sWarnLimits.bSetByEcoTalk := ok;
      IF ok THEN
         sWarnLimits.rXmin_TP := x_min;
         sWarnLimits.rXmax_TP := x_max;
         sWarnLimits.rYmin_TP := y_min;
         sWarnLimits.rYmax_TP := y_max;
         sWarnLimits.rZmin_TP := z_min;
         sWarnLimits.rZmax_TP := z_max;
         myRobot.DebugPrint(eTraceVision, "TBOX_SetTolerance -WarnLimits = "+STR(x_min) + " , " + STR(x_max) + " , " + STR(y_min) + " , " + STR(y_max) + " , " + STR(z_min) + " , " + STR(z_max));
      ELSE
         sWarnLimits.rXmin_TP := 0.0;
         sWarnLimits.rXmax_TP := 0.0;
         sWarnLimits.rYmin_TP := 0.0;
         sWarnLimits.rYmax_TP := 0.0;
         sWarnLimits.rZmin_TP := 0.0;
         sWarnLimits.rZmax_TP := 0.0;
         myRobot.DebugPrint(eTraceVision, "TBOX_SetTolerance -WarnLimits = "+STR(x_min) + " , " + STR(x_max) + " , " + STR(y_min) + " , " + STR(y_max) + " , " + STR(z_min) + " , " + STR(z_max) + " too big");
      END_IF;
   END_IF;
   
END_ROUTINE






(******************************************************************************
***  State bits to Ecopaint Screen ***************************
******************************************************************************)
ROUTINE TcSignalsToEPS() PRIVATE
VAR
   bEpsInDisable      : MAPTO BOOL;
   bMapOk             : BOOL;
   bChg               : BOOL;
END_VAR   

   bMapOk := TRUE;
   tEPS_ToolCorrIn := MAPX(cSV_EPSInToolCorr[myRobot.kinListInx]);
   IF NOT IS_MAPPED(tEPS_ToolCorrIn) THEN
      bMapOk := FALSE;
      RcuSetMessageOnce(TRcVisionBk_ErrMapEpsVar, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBk2.TcSignalsToEPS", cSV_EPSInToolCorr[myRobot.kinListInx]);
   END_IF;
   tEPS_ToolCorrOut := MAPX(cSV_EPSOutToolCorr[myRobot.kinListInx]);
   IF NOT IS_MAPPED(tEPS_ToolCorrOut) THEN
      bMapOk := FALSE;
      RcuSetMessageOnce(TRcVisionBk_ErrMapEpsVar, myRobot.kinListInx, 7, instId, "TRcuVisionIsraBk2.TcSignalsToEPS", cSV_EPSOutToolCorr[myRobot.kinListInx]);
   END_IF;
   IF NOT bMapOk THEN
      myRobot.DebugPrint(eTraceVision, "Visu from ISRA TC not running!!");
      RETURN;
   END_IF;
      
   tEPS_ToolCorrOut.bDisabled    := UPDATE(bDisabledHMI);
   bChg                          := IS_CHANGED(tEPS_ToolCorrIn.bDisable);
   
   WHILE TRUE DO
     IF tEPS_ToolCorrIn.bDisable AND NOT bDisabledHMI THEN
        bDisabledHMI   := TRUE; 
     ELSIF (NOT tEPS_ToolCorrIn.bDisable) AND bDisabledHMI THEN
        bDisabledHMI   := FALSE; 
     END_IF;  
     tEPS_ToolCorrOut.iSystemState := cgiHMI_Grey;
     bChg         := FALSE;
     WAIT bChg;
   END_WHILE;
       
END_ROUTINE








VAR PRIVATE
   myRobot        : MAPTO TRcuRobot;
   iLoggerNumber  : INT;
   instId         : DINT;    // instance identification number
   bMappingOk     : BOOL;
   
   bBK_SIG_TRIGGER : MAPTO BOOL;

   Sym_BK_Out_TRIGGER : STRING := "HWO_mBK_SIG_TRIGGER";
   
   bOverflowError     : BOOL;
   bCommError         : BOOL;
   bSyncRobots        : BOOL;  //Check PLC feedback even measuring was successful to syncronize several robots
   bBkActive          : BOOL;  // BK_INIT wurde aufgerufen, BK_ENDE noch nicht
                               // TCP/IP Verbindung geoeffnet
   bBkConnect         : BOOL;
   
   client             : TRcuNetworkTcpClient;    
   tEPS_PathCorrIn    : MAPTO tsPathCorrIn;
   tEPS_PathCorrOut   : MAPTO tsPathCorrOut;
END_VAR


//----------------------------------------------------------------------------------------
// Die empfangenen Korrekturwerte werden ueberprueft und in das Array BK_KORREKTUR
// eingetragen
//----------------------------------------------------------------------------------------
ROUTINE BK_KorrWerteInsert(CorrVal : TELEGRAM) PRIVATE

VAR
   i : INT;
   j : INT;
   timeOut : BOOL;
   bEXIT   : BOOL;
   sLogText : STRING;
   bRangeOK : BOOL;
   s : STRING;
END_VAR

   j := BK_KORREKTUREN_GUELTIG[BK_PATH_INDEX];
   IF j=0 THEN
      j := 1;
   END_IF;
   myRobot.DebugPrint(eTraceVision, "BK_KorrWerteInsert: receive correction values");
   s := StrRight(CorrVal.Label, StrLen(CorrVal.Label)-2);
   myRobot.DebugPrint(eTraceVision, "BK_KorrWerteInsert: Nummer der Korrektur = "+s);
   BK_POINT_ID := StrToInt(s); // Label = Name der Korrektur sollte Nummer sein!!!
   BK_Korr_X := CorrVal.Corr.X;
   BK_Korr_Y := CorrVal.Corr.Y;
   BK_Korr_Z := CorrVal.Corr.Z;
   BK_Korr_RX := CorrVal.Corr.C;
   BK_Korr_RY := CorrVal.Corr.B;
   BK_Korr_RZ := CorrVal.Corr.A;
   BK_STATUS := CorrVal.Error;
   
   sLogText := " X = " + STR(BK_Korr_X) + ", Y = " + STR(BK_Korr_Y) + ", Z = " + STR(BK_Korr_Z);
   myRobot.logger.SetLoggerStep(iLoggerNumber, sLogText);
   myRobot.DebugPrint(eTraceVision, sLogText);
   sLogText := " Rx = " + STR(BK_Korr_RX) + ", Ry = " + STR(BK_Korr_RY) + ", Rz = " + STR(BK_Korr_RZ);
   myRobot.logger.SetLoggerStep(iLoggerNumber, sLogText);
   myRobot.DebugPrint(eTraceVision, sLogText);
   IF (BK_MODUS = Mode_AEC_Measure) THEN
      myRobot.DebugPrint(eTraceVision, " BK_MODUS = Mode_AEC_Measure : No check of limits !!!");
      bRangeOK := TRUE;
   ELSE
      IF (rAbs(BK_Korr_X) > rLinLimit) OR
         (rAbs(BK_Korr_Y) > rLinLimit) OR
         (rAbs(BK_Korr_Z) > rLinLimit) OR
         (rAbs(BK_Korr_RX) > rRotLimit) OR
         (rAbs(BK_Korr_RY) > rRotLimit) OR
         (rAbs(BK_Korr_RZ) > rRotLimit) THEN
         bOverflowError := TRUE;
         myRobot.logger.SetLoggerStep(iLoggerNumber, "correction values out off limits");
         BK_Korr_X  := 0.0;
         BK_Korr_Y  := 0.0;
         BK_Korr_Z  := 0.0;
         BK_Korr_RX := 0.0;
         BK_Korr_RY := 0.0;
         BK_Korr_RZ := 0.0;
         bRangeOK := FALSE;
      ELSE
         bRangeOK := TRUE;
      END_IF;
   END_IF;
   IF NOT bRangeOK THEN
     BK_Measure_Ok := FALSE;
   END_IF;
   IF (BK_STATUS = 0) THEN
     myRobot.DebugPrint(eTraceVision, STR(i)+" ID= "+STR(BK_POINT_ID)+" X= "+STR(BK_Korr_X)+
                        " Y= "+STR(BK_Korr_Y)+" Z= "+STR(BK_Korr_Z)+" A= "+STR(BK_Korr_RX)+
                        " B= "+STR(BK_Korr_RY)+" C= "+STR(BK_Korr_RZ));
     IF (j <= BK_MaxKorrekturenProBahn) THEN
        BK_KORREKTUR[BK_PATH_INDEX][j].X := BK_Korr_X;
        BK_KORREKTUR[BK_PATH_INDEX][j].Y := BK_Korr_Y;
        BK_KORREKTUR[BK_PATH_INDEX][j].Z := BK_Korr_Z;
        BK_KORREKTUR[BK_PATH_INDEX][j].A := BK_Korr_RX;
        BK_KORREKTUR[BK_PATH_INDEX][j].B := BK_Korr_RY;
        BK_KORREKTUR[BK_PATH_INDEX][j].C := BK_Korr_RZ;
        BK_KORR_PUNKT_ID[BK_PATH_INDEX][j] := BK_POINT_ID;    
     END_IF;
     Sleep(BK_Wait);
     j := j + 1;
   ELSE
     IF (BK_POINT_ID <= 0) THEN
        myRobot.DebugPrint(eTraceVision, "BK_KorrWerteInsert: BK_POINT_ID <= 0");
     ELSE
        BK_KORR_PUNKT_ID[BK_PATH_INDEX][j] := -1;
        IF (BK_STATUS AND BK_ERROR_COLLISION) = BK_ERROR_COLLISION THEN
           myRobot.DebugPrint(eTraceVision, "BK_KorrWerteInsert: BK_ERROR_COLLISION");
           RcuSetMessageOnce(TRcVisionBk_WarnCollision, myRobot.kinListInx, 2, instId, "TRcuVisionIsraBK2.BK_KorrWerteInsert", STR(BK_POINT_ID));
           BK_Measure_Ok := FALSE;
        ELSIF (BK_STATUS AND BK_ERROR_LIMIT)= BK_ERROR_LIMIT THEN
           myRobot.DebugPrint(eTraceVision, "BK_KorrWerteInsert: BK_ERROR_LIMIT");
           RcuSetMessageOnce(TRcVisionBk_WarnLimit, myRobot.kinListInx, 2, instId, "TRcuVisionIsraBK2.BK_KorrWerteInsert", STR(BK_POINT_ID));
           BK_Measure_Ok := FALSE;
        ELSIF (BK_STATUS AND BK_ERROR_DETECTION) = BK_ERROR_DETECTION THEN
           myRobot.DebugPrint(eTraceVision, "BK_KorrWerteInsert: BK_ERROR_DETECTION");
           RcuSetMessageOnce(TRcVisionBk_WarnInvMeasure, myRobot.kinListInx, 2, instId, "TRcuVisionIsraBK2.BK_KorrWerteInsert", STR(BK_POINT_ID));
           BK_Measure_Ok := FALSE;
        ELSE
           myRobot.DebugPrint(eTraceVision, "BK_KorrWerteInsert: BK_MSG_GENERAL");
           RcuSetMessageOnce(TRcVisionBk_WarnGenPoint, myRobot.kinListInx, 2, instId, "TRcuVisionIsraBK2.BK_KorrWerteInsert", STR(BK_POINT_ID));
           BK_Measure_Ok := FALSE;
        END_IF;
        Sleep(BK_Wait);
        j := j + 1;
     END_IF;
   END_IF;
    IF j > BK_KORREKTUREN_GUELTIG[BK_PATH_INDEX] THEN
       BK_KORREKTUREN_GUELTIG[BK_PATH_INDEX] := j;
    END_IF;
    myRobot.DebugPrint(eTraceVision, "BK_KorrWerteInsert: END");

END_ROUTINE 


ROUTINE StoreMessPos(command : DINT) PRIVATE
  
   Sleep(10); // Delay for correct robot position
   BKMessPos[BK_ScanRobPos].X := myRobot.readBackObjectPos.mPos.mValues[0];
   BKMessPos[BK_ScanRobPos].Y := myRobot.readBackObjectPos.mPos.mValues[1];
   BKMessPos[BK_ScanRobPos].Z := myRobot.readBackObjectPos.mPos.mValues[2];
   BKMessPos[BK_ScanRobPos].A := myRobot.readBackObjectPos.mOri.mValues[0];
   BKMessPos[BK_ScanRobPos].B := myRobot.readBackObjectPos.mOri.mValues[1];
   BKMessPos[BK_ScanRobPos].C := myRobot.readBackObjectPos.mOri.mValues[2];
   BKMessPunkt[BK_ScanRobPos] := command;
  
END_ROUTINE

//;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
// Hier wird der Sensor getriggert und die jeweilige Position gespeichert
// Letzteres wird in einem Array gespeichert und ist nur fürs Messen interessant
//;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
ROUTINE BK_Aktion(commandData : TMcuUserData; pos : TRcuTrigger;
                            posInvalid : BOOL; VAR_IN triggerIdx  : DINT) PRIVATE
VAR
   command          : DINT;
   bMRTriggerSignal : BOOL;
   bTimeOut         : BOOL;
   sTriggerName     : STRING;
   sLogText         : STRING;
   timeOut          : BOOL;
   PunktIndex       : INT;
   readBackObj      : TMcuFrame;
END_VAR

  
   command         := commandData.mDataInt[3];

  IF BK_ScanRobPos > 0 THEN
    CASE BK_MODUS OF

    Mode_AEC_Measure,
    ModeMeasure:

      myRobot.DebugPrint(eTraceVision, "BK_Aktion: BK_MODUS_MEASUREMENT pointnumber = " + STR(command));

      START StoreMessPos(command);
      
      // CONTINUE
      IF bBK_SIG_TRIGGER THEN
         WAIT NOT bBK_SIG_TRIGGER;
         RcuSetMessageOnce(TRcVisionBk_ErrTrigTooFast, myRobot.kinListInx, 3, instId, "TRcuVisionIsraBK2.BK_Aktion", STR(command));
         myRobot.ErrorReaction(TRUE);
         RETURN;
      ELSE
         PULSE(bBK_SIG_TRIGGER, TRUE, BK_TriggerTime);
      END_IF;


    ModeApplication,
    Mode_AEC_Application:
      RETURN;
      
    Mode_ApplTest:
      RETURN;
      myRobot.DebugPrint(eTraceVision, "BK_Aktion: BK_MODUS_APPLTEST pointnumber = " + STR(command));

    END_CASE;

  END_IF;
  BK_ScanRobPos := BK_ScanRobPos + 1;

END_ROUTINE

ROUTINE ActCartInObjectCoord(tcp : FRAME) PRIVATE
VAR
   actPos : TMcuPosCart;
   calcPos : TMcuPosCart;
   refSysId : TMcuDbObjID;
   frame : TMcuFrame;
END_VAR;

   actPos.mFrame.mPos := myRobot.actCartVals.mPos;
   actPos.mFrame.mOri := myRobot.actCartVals.mOri;
   actPos.mRefSysID := McuGetRefSysForActCartVals(myRobot.kinematicMcuId);
   actPos.mFrame.mFrameTyp := gMcuFrameTyp;
   IF NOT RcuRefSysGetMcuId(myRobot.RcuRefSystemObject, refSysId) THEN
      myRobot.DebugPrint(eTraceVision, "ActPosInObjectCoord RcuRefSystemObject = "+STR(myRobot.RcuRefSystemObject)+" refSysId = "+STR(refSysId));
      // ERROR
   END_IF;
   IF refSysId <> actPos.mRefSysID THEN
      IF NOT McuTransformPosCart(calcPos, actPos, refSysId) THEN
         myRobot.DebugPrint(eTraceVision, "error in McuTransformPosCart in TRcuRobot");
      END_IF;
      IF calcPos.mFrame.mFrameTyp <> gMcuFrameTyp THEN
         //ERROR
      END_IF;
      tcp.X := calcPos.mFrame.mPos.mValues[0];
      tcp.Y := calcPos.mFrame.mPos.mValues[1];
      tcp.Z := calcPos.mFrame.mPos.mValues[2];
      tcp.A := calcPos.mFrame.mOri.mValues[0];
      tcp.B := calcPos.mFrame.mOri.mValues[1];
      tcp.C := calcPos.mFrame.mOri.mValues[2];
   ELSE
      tcp.X := actPos.mFrame.mPos.mValues[0];
      tcp.Y := actPos.mFrame.mPos.mValues[1];
      tcp.Z := actPos.mFrame.mPos.mValues[2];
      tcp.A := actPos.mFrame.mOri.mValues[0];
      tcp.B := actPos.mFrame.mOri.mValues[1];
      tcp.C := actPos.mFrame.mOri.mValues[2];
   END_IF;
END_ROUTINE


//;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
// BK_PP_Ref wird von der Routine Move() in TRcuProgPath beim Anhängen eines Segments
// an die Bahn aufgerufen.
// Wenn es ein Bahnpunkt mit Korrekturwert ist, dann wird seine Position hier im Array
// BKMessPos gespeichert, um an das Visionsystem übertragen werden zu können
//;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
ROUTINE BK_PP_Ref(pos : TMcuPosition)

   IF bBkKorrFlag THEN
      IF (BK_ScanRobPos > 0) AND (BK_ScanRobPos <= MaxPunkteProMessung) THEN
         IF pos.mPosTyp = eMcuPosCart THEN
            IF (BK_MODUS = Mode_PP_Ref) OR (BK_MODUS = ModeApplication) OR (BK_MODUS = Mode_AEC_Application)THEN
               myRobot.DebugPrint(eTraceVision, "BK_PP_Ref: BK_MODUS_PP_REF point = " + STR(iBkKorrPunktNr));
               BKMessPos[BK_ScanRobPos].X := pos.mPosCart.mFrame.mPos.mValues[0];
               BKMessPos[BK_ScanRobPos].Y := pos.mPosCart.mFrame.mPos.mValues[1];
               BKMessPos[BK_ScanRobPos].Z := pos.mPosCart.mFrame.mPos.mValues[2];
               BKMessPos[BK_ScanRobPos].A := pos.mPosCart.mFrame.mOri.mValues[0];
               BKMessPos[BK_ScanRobPos].B := pos.mPosCart.mFrame.mOri.mValues[1];
               BKMessPos[BK_ScanRobPos].C := pos.mPosCart.mFrame.mOri.mValues[2];
               BKMessPunkt[BK_ScanRobPos] := iBkKorrPunktNr;
               BK_ScanRobPos := BK_ScanRobPos + 1;
            END_IF;
         ELSE
            RcuSetMessageOnce(TRcVisionBk_ErrNoCartPos, myRobot.kinListInx, 2, instId, "TRcuVisionIsraBK2.BK_PP_Ref", pos.mName);
            myRobot.ErrorReaction(TRUE);
         END_IF;
      ELSE
         RcuSetMessageOnce(TRcVisionBk_ErrInternalIndex, myRobot.kinListInx, 2, instId, "TRcuVisionIsraBK2.BK_PP_Ref", STR(BK_ScanRobPos));
         myRobot.ErrorReaction(TRUE);
      END_IF;
      bBkKorrFlag := FALSE;
   END_IF;

END_ROUTINE

ROUTINE SignalVmtBk(commandData : TMcuUserData; pos : TRcuTrigger;
                            posInvalid : BOOL; VAR_IN triggerIdx  : DINT)
VAR
   triggerNumOnSeg  : DINT;
   command          : DINT;
END_VAR

   myRobot.DebugPrint(eTraceVision, "SignalVmtBk");
   triggerNumOnSeg := commandData.mDataInt[1];
   command         := commandData.mDataInt[3];
   START BK_Aktion(commandData,pos, posInvalid, triggerIdx) PRIO 1;
   myRobot.progPath.lastExecutedTrigger := triggerNumOnSeg;

END_ROUTINE


ROUTINE PULSE(bOut : MAPTO BOOL; bSig: BOOL; time : REAL ) PRIVATE
  IF NOT IS_MAPPED(bOut) THEN
     RETURN;
  END_IF; 
  bOut := bSig;
  Sleep(DINT(1000*time));
  bOut := NOT bSig;
END_ROUTINE


//;-----------------------------------------------------------
//;                  BK_GetIndex
//;-----------------------------------------------------------
ROUTINE BK_GetIndex(PathIndex : INT; PointID: DINT) : INT PRIVATE
VAR
   i          : INT;
   PointIndex : INT;
END_VAR

   PointIndex := -1;
   IF (PathIndex < 1) THEN
     RETURN -1;
   END_IF;
   IF (PathIndex > 5) THEN
     RETURN -1;
   END_IF;

   FOR i := 1 TO BK_MaxKorrekturenProBahn DO
     IF (BK_KORR_PUNKT_ID[PathIndex][i] = PointID) THEN
       PointIndex := i;
       i := BK_MaxKorrekturenProBahn;
     END_IF;
   END_FOR;
   RETURN (PointIndex);
END_ROUTINE


ROUTINE ObserveBkActive() PRIVATE
   
   WHILE TRUE DO
      WAIT bBkConnect;
      Open(sIPAddress, WORD(dPortNumber));
      IF client.tcpConnectionState = stateSckConnected THEN
         bRovisReady := FALSE;
         // nach dem Verbindungsaufbau sendet ROVIS ein aktuelles Statustelegramm!!!!
         START BK_SendData();    // Punkte an Vision uebertragen
         
         IF NOT bSimulateBK AND NOT bSimulate  THEN
            START BK_ReceiveTelegram(); // Telegramme von Vision empfangen
         ELSE
            TelCounter := 1;           
         END_IF;
         
                 
         bBkActive := TRUE; // Mit Vision verbunden 
         
         WAIT NOT bBkConnect; 
         STOP BK_ReceiveTelegram;
         STOP BK_SendData;
         Close();
         bBkActive := FALSE;
      ELSE
         RcuSetMessageOnce(TRcVisionBk_ErrTcpIpConnect, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBK2.ObserveBkActive");
         bCommError := TRUE;
         WAIT NOT bBkConnect;
      END_IF;
   END_WHILE;

END_ROUTINE


ROUTINE ObserveErrorQuit() PRIVATE
VAR
   bChg : BOOL;
END_VAR   

   bChg := IS_CHANGED(myRobot.svMotionAllowed);
   WHILE TRUE DO
      WAIT bChg;
      IF (client.tcpConnectionState = stateSckConnected) AND bBkActive AND myRobot.svMotionAllowed THEN
         IF iRovisError <> 0 THEN
            myRobot.DebugPrint(eTraceVision, "Quitt ERROR to Vision ");
            iRunMode := 0;
            iType    := 0;
            bPrepare := FALSE;
            bStart   := FALSE;
            bQuit    := TRUE;
            bRovisTelegram := TRUE;
            WAIT NOT bRovisTelegram;  // Telegramm gesendet
            bQuit    := FALSE;
         END_IF;
      END_IF;
      bChg := FALSE;
   END_WHILE;

END_ROUTINE

//-----------------------------------------------------------------------------
// Empfangen von ROVIS-Daten und von Korrekturwerten von BK ISRA. 
//-----------------------------------------------------------------------------
ROUTINE BK_ReceiveTelegram() PRIVATE
VAR
   i        : INT;
   bNewData : BOOL;
   InData1  : STRING;
   Tel      : TELEGRAM;
   sStart      : STRING := "<DataSet ";
   sEnd        : STRING := "</DataSet>";
   bStart      : BOOL;
   bOk         : BOOL;
   s           : STRING;
   bNext       : BOOL;
END_VAR


   bNewData := FALSE;
   TelCounter := 0;
   START TcpClientTask(bNewData, InData1);

   WHILE TRUE DO
      
      IF bNext THEN
         myRobot.DebugPrint(eTraceTcpIp, "Neues Dataset-Telegramm. InData1 = "+InData1);
         bOk :=  TRUE;
         bNext := FALSE;
      ELSE
         WAIT bNewData;
         bOk :=  TRUE;
         s := "<DataSet>";
         bStart := (StrFind(InData1, s) <> 0);
         IF bStart THEN
            myRobot.DebugPrint(eTraceTcpIp, "Neues Dataset-Telegramm. InData1 = "+InData1);
         ELSE
            myRobot.DebugPrint(eTraceVision, "Kein Dataset-Telegramm. InData1 = "+InData1);
            Tel.Type := eInvalidType;
            bOk := FALSE;
         END_IF;
         bNewData := FALSE;
      END_IF;
      
      WAIT bNewData;      
      IF ReadElement("TelVer", InData1, s) THEN
         Tel.TelVer := StrToInt(s);
         myRobot.DebugPrint(eTraceTcpIp, "TelVer = "+STR(Tel.TelVer));
      ELSE
         myRobot.DebugPrint(eTraceVision, "TelVer is missing in line " + InData1);
         bOk := FALSE;
      END_IF;
      bNewData := FALSE;
      
      WAIT bNewData;      
      IF ReadElement("TelType", InData1, s) THEN
         Tel.TelType := StrToInt(s);
         myRobot.DebugPrint(eTraceTcpIp, "TelType = "+STR(Tel.TelType));
         IF (Tel.TelType = 1) THEN
            Tel.Type := eRovis;
         ELSIF (Tel.TelType = 2) THEN
            Tel.Type := eCorrValue;
         ELSE
            Tel.Type := eInvalidType;
         END_IF;
      ELSE
         myRobot.DebugPrint(eTraceVision, "TelType is missing in line " + InData1);
         bOk := FALSE;
      END_IF;
      bNewData := FALSE;
      
      WAIT bNewData;      
      IF ReadElement("SendID", InData1, s) THEN
         Tel.SendID := StrToInt(s);
         myRobot.DebugPrint(eTraceTcpIp, "SendID = "+STR(Tel.SendID));
      ELSE
         myRobot.DebugPrint(eTraceVision, "SendID is missing in line " + InData1);
         bOk := FALSE;
      END_IF;
      bNewData := FALSE;

      WAIT bNewData;      
      IF ReadElement("Index", InData1, s) THEN
         Tel.Index := StrToInt(s);
         myRobot.DebugPrint(eTraceTcpIp, "Index = "+STR(Tel.Index));
      ELSE
         myRobot.DebugPrint(eTraceVision, "Index is missing in line " + InData1);
         bOk := FALSE;
      END_IF;
      bNewData := FALSE;
      
      WAIT bNewData;      
      IF ReadElement("NumIndices", InData1, s) THEN
         Tel.NumIndices := StrToInt(s);
         myRobot.DebugPrint(eTraceTcpIp, "Numindices = "+STR(Tel.NumIndices));
      ELSE
         myRobot.DebugPrint(eTraceVision, "NumIndices is missing in line " + InData1);
         bOk := FALSE;
      END_IF;
      bNewData := FALSE;
      
      WAIT bNewData;      
      IF ReadElement("Label", InData1, s) THEN
         Tel.Label := s;
         myRobot.DebugPrint(eTraceTcpIp, Tel.Label);
      ELSE
         myRobot.DebugPrint(eTraceVision, "Label is missing in line " + InData1);
         bOk := FALSE;
      END_IF;
      bNewData := FALSE;
      
      WAIT bNewData;      
      IF ReadElement("SegLabel", InData1, s) THEN
         Tel.SegLabel := s;
         myRobot.DebugPrint(eTraceTcpIp, "SegLabel = "+Tel.SegLabel);
      ELSE
         myRobot.DebugPrint(eTraceVision, "SegLabel is missing in line " + InData1);
         bOk := FALSE;
      END_IF;
      bNewData := FALSE;
      
      WAIT bNewData;      
      IF ReadFrame("Corr", InData1, Tel.Corr) THEN
         myRobot.DebugPrint(eTraceTcpIp, "Corr:");
         PrintFrame(Tel.Corr);
         IF ReadFrame("Expected", InData1, Tel.Expected) THEN // Corr und Expected in einer Zeile
            myRobot.DebugPrint(eTraceTcpIp, "Expected:");
            PrintFrame(Tel.Expected);
         END_IF;
      ELSE
         myRobot.DebugPrint(eTraceVision, "Corr is missing in line " + InData1);
         bOk := FALSE;
      END_IF;
      bNewData := FALSE;
      
      WAIT bNewData;      
      IF ReadFrame("Expected", InData1, Tel.Expected) THEN
         myRobot.DebugPrint(eTraceTcpIp, "Expected:");
         PrintFrame(Tel.Expected);
      ELSE
         myRobot.DebugPrint(eTraceVision, "Expected is missing in line " + InData1);
         bOk := FALSE;
      END_IF;
      bNewData := FALSE;
      
      WAIT bNewData;      
      IF ReadElement("Teach", InData1, s) THEN
         Tel.Teach := StrToInt(s);
         myRobot.DebugPrint(eTraceTcpIp, "Teach = "+STR(Tel.Teach));
      ELSE
         myRobot.DebugPrint(eTraceVision, "Teach is missing in line " + InData1);
         bOk := FALSE;
      END_IF;
      bNewData := FALSE;
      
      WAIT bNewData;      
      IF ReadElement("Error", InData1, s) THEN
         Tel.Error := StrToInt(s);
         myRobot.DebugPrint(eTraceTcpIp, "Error = "+STR(Tel.Error));
         PrintError(Tel.Error);
      ELSE
         myRobot.DebugPrint(eTraceVision, "Error is missing in line " + InData1);
         bOk := FALSE;
      END_IF;
      bNewData := FALSE;
      
      WAIT bNewData;      
      IF ReadElement("MeasurementID", InData1, s) THEN
         Tel.MeasurementID := StrToInt(s);
         myRobot.DebugPrint(eTraceTcpIp, "MeasurementID = "+STR(Tel.MeasurementID));
      ELSE
         myRobot.DebugPrint(eTraceVision, "MeasurementID is missing in line " + InData1);
         bOk := FALSE;
      END_IF;
      bNewData := FALSE;
      
      WAIT bNewData;
      
      IF (StrFind(InData1, "SysCmd") <> 0) THEN
         myRobot.DebugPrint(eTraceTcpIp, "SysCmd = ");
      ELSE
         myRobot.DebugPrint(eTraceVision, "SysCmd is missing in line " + InData1);
         bOk := FALSE;
      END_IF;
      bNewData := FALSE;
      
      WAIT bNewData;      
      IF ReadElement("Ready", InData1, s) THEN
         Tel.SysCmd.Ready := (StrToInt(s) = 1);
         myRobot.DebugPrint(eTraceTcpIp, "SysCmd.Ready = "+STR(Tel.SysCmd.Ready));
      ELSE
         myRobot.DebugPrint(eTraceVision, "Ready is missing in line " + InData1);
      END_IF;
      bNewData := FALSE;
      
      WAIT bNewData;      
      IF ReadElement("Runmode", InData1, s) THEN
         Tel.SysCmd.Runmode := StrToInt(s);
         myRobot.DebugPrint(eTraceTcpIp, "SysCmd.Runmode = "+STR(Tel.SysCmd.Runmode));
      ELSE
         myRobot.DebugPrint(eTraceVision, "Runmode is missing in line " + InData1);
         bOk := FALSE;
      END_IF;
      bNewData := FALSE;
      
      WAIT bNewData;      
      IF ReadElement("Prepared", InData1, s) THEN
         Tel.SysCmd.Prepared := (StrToInt(s) = 1);
         myRobot.DebugPrint(eTraceTcpIp, "SysCmd.Prepared = "+STR(Tel.SysCmd.Prepared));
      ELSE
         myRobot.DebugPrint(eTraceVision, "Prepared is missing in line " + InData1);
         bOk := FALSE;
      END_IF;
      bNewData := FALSE;
      
      WAIT bNewData;      
      IF ReadElement("Acquisition", InData1, s) THEN
         Tel.SysCmd.Acquisition := (StrToInt(s) = 1);
         myRobot.DebugPrint(eTraceTcpIp, "SysCmd.Acquisition = "+STR(Tel.SysCmd.Acquisition));
      ELSE
         myRobot.DebugPrint(eTraceVision, "Acquisition is missing in line " + InData1);
         bOk := FALSE;
      END_IF;
      bNewData := FALSE;
      
      WAIT bNewData;      
      IF ReadElement("Measurement", InData1, s) THEN
         Tel.SysCmd.Measurement := (StrToInt(s) = 1);
         myRobot.DebugPrint(eTraceTcpIp, "SysCmd.Measurement = "+STR(Tel.SysCmd.Measurement));
      ELSE
         myRobot.DebugPrint(eTraceVision, "Measurement is missing in line " + InData1);
      END_IF;
      bNewData := FALSE;
      
      WAIT bNewData;      
      IF ReadElement("Data", InData1, s) THEN
         Tel.SysCmd.Data := (StrToInt(s) = 1);
         myRobot.DebugPrint(eTraceTcpIp, "SysCmd.Data = "+STR(Tel.SysCmd.Data));
      ELSE
         myRobot.DebugPrint(eTraceVision, "Data is missing in line " + InData1);
         bOk := FALSE;
      END_IF;
      bNewData := FALSE;
      
      WAIT bNewData;      
      IF ReadElement("Error", InData1, s) THEN
         Tel.SysCmd.Error := StrToInt(s);
         myRobot.DebugPrint(eTraceTcpIp, "SysCmd.Error = "+STR(Tel.SysCmd.Error));
      ELSE
         myRobot.DebugPrint(eTraceVision, "Error is missing in line " + InData1);
         bOk := FALSE;
      END_IF;
      bNewData := FALSE;
      
      WAIT bNewData;      
      IF ReadFrame("Result", InData1, Tel.SysCmd.Result) THEN
         myRobot.DebugPrint(eTraceTcpIp, "Result:");
         PrintFrame(Tel.SysCmd.Result);
      ELSE
         myRobot.DebugPrint(eTraceVision, "Result is missing in line " + InData1);
         bOk := FALSE;
      END_IF;
      bNewData := FALSE;
      
      WAIT bNewData;      
      IF (StrFind(InData1, "SysCmd") <> 0) THEN
         myRobot.DebugPrint(eTraceTcpIp, "/SysCmd");
      ELSE
         myRobot.DebugPrint(eTraceVision, "/SysCmd is missing in line " + InData1);
         bOk := FALSE;
      END_IF;
      bNewData := FALSE;
      
      WAIT bNewData;
      IF (StrFind(InData1, "/DataSet") <> 0) THEN
         myRobot.DebugPrint(eTraceTcpIp, "/DataSet");
      ELSE
         myRobot.DebugPrint(eTraceVision, "/DataSet is missing in line " + InData1);
         bOk := FALSE;
      END_IF;
      
      TelCounter := TelCounter+1;

      IF Tel.Type = eCorrValue THEN
         myRobot.DebugPrint(eTraceVision, "H e m f l a n g e   Telegram");
         IF bReceiveToolAEC THEN   // Reihenfolge !!!!!!!!!!!!!!!
            TBOX_Tool_X := Tel.Corr.X;
            TBOX_Tool_Y := Tel.Corr.Y;
            TBOX_Tool_Z := Tel.Corr.Z;
            TBOX_Tool_RX := Tel.Corr.C;
            TBOX_Tool_RY := Tel.Corr.B;
            TBOX_Tool_RZ := Tel.Corr.A;
            bReceiveToolAEC := FALSE;
         ELSIF bReceiveObjectAEC THEN 
            TBOX_Base_X := Tel.Corr.X;
            TBOX_Base_Y := Tel.Corr.Y;
            TBOX_Base_Z := Tel.Corr.Z;
            TBOX_Base_RX := Tel.Corr.C;
            TBOX_Base_RY := Tel.Corr.B;
            TBOX_Base_RZ := Tel.Corr.A;
            bReceiveObjectAEC := FALSE;
         ELSE
            BK_KorrWerteInsert(Tel);
         END_IF;
      ELSIF Tel.Type = eRovis THEN
         myRobot.DebugPrint(eTraceTcpIp, "R O V I S   Telegram");
         // Update der Rovis-Variablen
         bRovisReady       := Tel.SysCmd.Ready;
         bRovisPrepared    := Tel.SysCmd.Prepared;
         bRovisAcquisition := Tel.SysCmd.Acquisition;
         bRovisMeasurement := Tel.SysCmd.Measurement;
         bRovisData        := Tel.SysCmd.Data;
         iRovisRunMode     := Tel.SysCmd.Runmode;
         iRovisError       := Tel.SysCmd.Error;
         RovisResult       := Tel.SysCmd.Result;
      END_IF;
      
      IF (StrFind(InData1, "<DataSet>") <> 0) THEN
         myRobot.DebugPrint(eTraceTcpIp, "</DataSet> and <Dataset> in same line");
         bNext := TRUE;
      END_IF;

      bNewData := FALSE;

   END_WHILE;
END_ROUTINE


//-----------------------------------------------------------------------------
// Senden der Messpunkte an  BK ISRA. 
//-----------------------------------------------------------------------------
ROUTINE BK_SendData() PRIVATE
VAR
   i          : INT;
   outString1 : STRING;
   outString2 : STRING;
   outString3 : STRING;
   strLen1    : INT;
END_VAR

   WHILE TRUE DO
     WAIT ((BK_RequestCount > 0) AND (BK_RequestCount < BK_ScanRobPos-1)) OR
          (bPointCountValid AND ((BK_RequestCount > 0) AND (BK_RequestCount < BK_ScanRobPos)) AND NOT (BK_MODUS = Mode_AEC_Measure)) OR
          ((BK_RequestCount > 0) AND (BK_RequestCount < BK_ScanRobPos) AND (BK_MODUS = Mode_AEC_Measure)) OR
          bFinishMeasureAEC OR
          bFinishApplicationAEC OR
          bRovisTelegram;
     IF bFinishMeasureAEC THEN
        // Abschlusstelegramm
        outString1 := "<Robot><TelVer>2</TelVer><TelType>2</TelType>";
        outString1 := outString1 + "<Index>13</Index><MeasurementPath>1</MeasurementPath><ApplicationPath>0</ApplicationPath>";
        outString1 := outString1 + "<NumIndices>1</NumIndices><Label>STATUS_ENDOFMEASPOINTS</Label><SegLabel>STATUS_NOSEGMENT</SegLabel>";
        strLen1 := StrLen(outString1); // 167
        outString1 := outString1 + "<X>0.0</X>";
        strLen1 := StrLen(outString1);
        outString1 := outString1 + "<Y>0.0</Y>";
        strLen1 := StrLen(outString1);

        outString2 := "<Z>0.0</Z>";
        strLen1 := StrLen(outString2);
        outString2 := outString2 + "<A>0.0</A>";
        strLen1 := StrLen(outString2); 
        outString2 := outString2 + "<B>0.0</B>";
        strLen1 := StrLen(outString2); 
        outString2 := outString2 + "<C>0.0</C>";
        strLen1 := StrLen(outString2); 
        outString2 := outString2 + "<MeasurementID>1</MeasurementID><Valid>1</Valid> <PointInfo>1</PointInfo>";
        strLen1 := StrLen(outString2); 

        //ROVIS
        outString3 := "<SysCmd><Runmode>2</Runmode><Type>0</Type><Prepare>0</Prepare><Start>0</Start><Quit>0</Quit></SysCmd></Robot>";
        Send(outString1, outString2, outString3);
        bFinishMeasureAEC := FALSE;
        
     ELSIF bFinishApplicationAEC THEN
     
        // Rückmeldung, dass das Tool vom Roboter verwendet wird
        outString1 := "<Robot><TelVer>2</TelVer><TelType>2</TelType>";
        outString1 := outString1 + "<Index>1</Index><MeasurementPath>0</MeasurementPath><ApplicationPath>1</ApplicationPath>";
        outString1 := outString1 + "<NumIndices>-1</NumIndices><Label>STATUS_STC</Label><SegLabel>STATUS_NOSEGMENT</SegLabel>";
        strLen1 := StrLen(outString1); // 167
        outString1 := outString1 + "<X>0.0</X>";
        strLen1 := StrLen(outString1);
        outString1 := outString1 + "<Y>0.0</Y>";
        strLen1 := StrLen(outString1);

        outString2 := "<Z>0.0</Z>";
        strLen1 := StrLen(outString2);
        outString2 := outString2 + "<A>0.0</A>";
        strLen1 := StrLen(outString2); 
        outString2 := outString2 + "<B>0.0</B>";
        strLen1 := StrLen(outString2); 
        outString2 := outString2 + "<C>0.0</C>";
        strLen1 := StrLen(outString2); 
        outString2 := outString2 + "<MeasurementID>0</MeasurementID><Valid>1</Valid> <PointInfo>2</PointInfo>";
        strLen1 := StrLen(outString2); 

        //ROVIS
        outString3 := "<SysCmd><Runmode>2</Runmode><Type>0</Type><Prepare>0</Prepare><Start>0</Start><Quit>0</Quit></SysCmd></Robot>";
        Send(outString1, outString2, outString3);
        
        
        // Applikationsbahnende senden
        outString1 := "<Robot><TelVer>2</TelVer><TelType>2</TelType>";
        outString1 := outString1 + "<Index>2</Index><MeasurementPath>0</MeasurementPath><ApplicationPath>1</ApplicationPath>";
        outString1 := outString1 + "<NumIndices>1</NumIndices><Label>STATUS_ENDOFAPPLPOINTS</Label><SegLabel>STATUS_NOSEGMENT</SegLabel>";
        strLen1 := StrLen(outString1); // 167
        outString1 := outString1 + "<X>0.0</X>";
        strLen1 := StrLen(outString1);
        outString1 := outString1 + "<Y>0.0</Y>";
        strLen1 := StrLen(outString1);

        outString2 := "<Z>0.0</Z>";
        strLen1 := StrLen(outString2);
        outString2 := outString2 + "<A>0.0</A>";
        strLen1 := StrLen(outString2); 
        outString2 := outString2 + "<B>0.0</B>";
        strLen1 := StrLen(outString2); 
        outString2 := outString2 + "<C>0.0</C>";
        strLen1 := StrLen(outString2); 
        outString2 := outString2 + "<MeasurementID>0</MeasurementID><Valid>1</Valid> <PointInfo>2</PointInfo>";
        strLen1 := StrLen(outString2); 

        //ROVIS
        outString3 := "<SysCmd><Runmode>2</Runmode><Type>0</Type><Prepare>0</Prepare><Start>0</Start><Quit>0</Quit></SysCmd></Robot>";
        Send(outString1, outString2, outString3);
        bFinishApplicationAEC := FALSE;
        
     ELSIF bRovisTelegram THEN
        
        outString1 := "<Robot><TelVer>2</TelVer><TelType>1</TelType>";
        outString1 := outString1 + "<Index>0</Index><MeasurementPath>1</MeasurementPath><ApplicationPath>0</ApplicationPath>";
        outString1 := outString1 + "<NumIndices>0</NumIndices><Label>STATUS_ENDOFMEASPOINTS</Label><SegLabel>Segment 1</SegLabel>";
        strLen1 := StrLen(outString1);
        outString1 := outString1 + "<X>0.0</X>";
        strLen1 := StrLen(outString1);
        outString1 := outString1 + "<Y>0.0</Y>";
        strLen1 := StrLen(outString1);


        outString2 := "<Z>0.0</Z>";
        strLen1 := StrLen(outString2);
        outString2 := outString2 + "<A>0.0</A>";
        strLen1 := StrLen(outString2); 
        outString2 := outString2 + "<B>0.0</B>";
        strLen1 := StrLen(outString2); 
        outString2 := outString2 + "<C>0.0</C>";
        strLen1 := StrLen(outString2); 
        outString2 := outString2 + "<MeasurementID>0</MeasurementID><Valid>1</Valid> <PointInfo>1</PointInfo>";
        strLen1 := StrLen(outString2); 

        //ROVIS
        outString3 := "<SysCmd><Runmode>" + STR(iRunMode) + "</Runmode><Type>" + STR(iType) + "</Type><Prepare>";
        IF bPrepare THEN
           outString3 := outString3 + "1</Prepare><Start>";
        ELSE
           outString3 := outString3 + "0</Prepare><Start>";
        END_IF;
        IF bStart THEN
           outString3 := outString3 + "1</Start><Quit>";
        ELSE
           outString3 := outString3 + "0</Start><Quit>";
        END_IF;
        IF bQuit THEN
           outString3 := outString3 + "1</Quit></SysCmd></Robot>";
        ELSE
           outString3 := outString3 + "0</Quit></SysCmd></Robot>";
        END_IF;
        Send(outString1, outString2, outString3);
        bRovisTelegram := FALSE;
        
        
     ELSE   
        IF ((BK_MODUS = ModeMeasure) OR (BK_MODUS = Mode_AEC_Measure) OR (BK_MODUS = Mode_MP_Ref)) THEN
           i := BK_RequestCount;
           // Triggerpunkte an ISRA senden
           outString1 := "<Robot><TelVer>2</TelVer><TelType>2</TelType>";
           outString1 := outString1 + "<Index>" + STR(i) + "</Index><MeasurementPath>1</MeasurementPath><ApplicationPath>0</ApplicationPath>";
//           outString1 := outString1 + "<NumIndices>0</NumIndices><Label>Mess " + STR(BKMessPunkt[i]) + "</Label><SegLabel>Segment 1</SegLabel>";
           outString1 := outString1 + "<NumIndices>0</NumIndices><Label>mp " + STR(BKMessPunkt[i]) + "</Label><SegLabel>Segment 1</SegLabel>";
           strLen1 := StrLen(outString1); // 167 + 38
           outString1 := outString1 + "<X>" + STR(BKMessPos[i].X) + "</X>";
           strLen1 := StrLen(outString1); // 185 + 38
           outString1 := outString1 + "<Y>" + STR(BKMessPos[i].Y) + "</Y>";
           strLen1 := StrLen(outString1); // 202 + 38

           outString2 := "<Z>" + STR(BKMessPos[i].Z) + "</Z>";
           strLen1 := StrLen(outString2);
           outString2 := outString2 + "<A>" + STR(BKMessPos[i].C) + "</A>";
           strLen1 := StrLen(outString2); 
           outString2 := outString2 + "<B>" + STR(BKMessPos[i].B) + "</B>";
           strLen1 := StrLen(outString2); 
           outString2 := outString2 + "<C>" + STR(BKMessPos[i].A) + "</C>";
           strLen1 := StrLen(outString2); 
           outString2 := outString2 + "<MeasurementID>" + STR(BK_PATH) + "</MeasurementID><Valid>1</Valid> <PointInfo>1</PointInfo>";
           strLen1 := StrLen(outString2);

           outString3 := "<SysCmd><Runmode>2</Runmode><Type>0</Type><Prepare>0</Prepare><Start>0</Start><Quit>0</Quit></SysCmd></Robot>";
           Send(outString1, outString2, outString3);
   (*        
   <Robot>
     <Index>1</Index>
     <MeasurementPath>1</MeasurementPath>	//Messpunkt ?
     <ApplicationPath>0</ApplicationPath>	//Applikationspunkt ?
     <NumIndices>0</NumIndices>		//Normalerweise nicht in Verwendung
     <Label>Messpunkt 1</Label>		//Name des Messpunkts
     <SegLabel>Segment 1</SegLabel>	//Segmente werden bei Messpunkten nicht verwendet, bei Applikationspunkten hingegen schon.
     <X>1.0</X>				//Punktkoordinate
     <Y>2.0</Y>
     <Z>3.0</Z>
     <A>4.0</A>
     <B>5.0</B>
     <C>6.0</C>
     <MeasurementID>1</MeasurementID>	//Beauftragte Mess-ID
     <Valid>1</Valid>			//Dieser Punkt ist "gültig"
     <PointInfo>1</PointInfo>		//Bitfeld für Zusatzinfos: s.u.
   </Robot>

   Pointinfo:

   =1 ; Punktinformation "Punkt ist Bestandteil der Messbahn (identisch zu <MeasurementPath>1</MeasurementPath>)
   =2 ; Punktinformation "Punkt ist Bestandteil der Applikationsbahn (identisch zu <ApplicationPath>1</ApplicationPath>)
   =4 ; Punktinformation "Punkt ist fuer Gap und Flush - Pruefung vorgesehen"

     *)      
           myRobot.DebugPrint(eTraceVision, "Triggerpoint "+STR(BKMessPunkt[i])+":");
           myRobot.DebugPrint(eTraceVision, "  X = "+STR(BKMessPos[i].X)+"  Y = "+STR(BKMessPos[i].Y)+"  Z = "+STR(BKMessPos[i].Z));
           myRobot.DebugPrint(eTraceVision, "  A = "+STR(BKMessPos[i].A)+"  B = "+STR(BKMessPos[i].B)+"  C = "+STR(BKMessPos[i].C));

           IF bPointCountValid AND (BK_RequestCount = BK_TriggerCount) THEN
              // Ende der Triggerpunkte an ISRA senden
              outString1 := "<Robot><TelVer>2</TelVer><TelType>2</TelType>";
              outString1 := outString1 + "<Index>" + STR(i+1) + "</Index><MeasurementPath>1</MeasurementPath><ApplicationPath>0</ApplicationPath>";
              outString1 := outString1 + "<NumIndices>0</NumIndices><Label>STATUS_ENDOFMEASPOINTS</Label><SegLabel>Segment 1</SegLabel>";
              strLen1 := StrLen(outString1);
              outString1 := outString1 + "<X>0.0</X>";
              strLen1 := StrLen(outString1);
              outString1 := outString1 + "<Y>0.0</Y>";
              strLen1 := StrLen(outString1);


              outString2 := "<Z>0.0</Z>";
              strLen1 := StrLen(outString2);
              outString2 := outString2 + "<A>0.0</A>";
              strLen1 := StrLen(outString2); 
              outString2 := outString2 + "<B>0.0</B>";
              strLen1 := StrLen(outString2); 
              outString2 := outString2 + "<C>0.0</C>";
              strLen1 := StrLen(outString2); 
              outString2 := outString2 + "<MeasurementID>" + STR(BK_PATH) + "</MeasurementID><Valid>1</Valid> <PointInfo>1</PointInfo>";
              strLen1 := StrLen(outString2); 

              //ROVIS
              outString3 := "<SysCmd><Runmode>2</Runmode><Type>0</Type><Prepare>0</Prepare><Start>0</Start><Quit>0</Quit></SysCmd></Robot>";
              Send(outString1, outString2, outString3);
           END_IF;

           IF (BK_RequestCount > 0) THEN
              BK_RequestCount := BK_RequestCount + 1;
           ELSE
              myRobot.DebugPrint(eTraceVision,"BK_SendData: BK_RequestCount invalid");
           END_IF;
        ELSIF ((BK_MODUS = ModeApplication) OR (BK_MODUS = Mode_PP_Ref) OR (BK_MODUS = Mode_AEC_Application)) THEN
           i := BK_RequestCount;
           IF (BK_MODUS = Mode_AEC_Application) THEN
              // Abschlusstelegramm
              outString1 := "<Robot><TelVer>2</TelVer><TelType>2</TelType>";
              outString1 := outString1 + "<Index>" + STR(i+1) + "</Index><MeasurementPath>0</MeasurementPath><ApplicationPath>1</ApplicationPath>";
              outString1 := outString1 + "<NumIndices>0</NumIndices><Label>STATUS_STC</Label><SegLabel>Segment 1</SegLabel>";
              strLen1 := StrLen(outString1); // 167
              outString1 := outString1 + "<X>0.0</X>";
              strLen1 := StrLen(outString1);
              outString1 := outString1 + "<Y>0.0</Y>";
              strLen1 := StrLen(outString1);

              outString2 := "<Z>0.0</Z>";
              strLen1 := StrLen(outString2);
              outString2 := outString2 + "<A>0.0</A>";
              strLen1 := StrLen(outString2); 
              outString2 := outString2 + "<B>0.0</B>";
              strLen1 := StrLen(outString2); 
              outString2 := outString2 + "<C>0.0</C>";
              strLen1 := StrLen(outString2); 
              outString2 := outString2 + "<MeasurementID>" + STR(BK_PATH) + "</MeasurementID><Valid>0</Valid> <PointInfo>2</PointInfo>";
              strLen1 := StrLen(outString2); 

              //ROVIS
              outString3 := "<SysCmd><Runmode>2</Runmode><Type>0</Type><Prepare>0</Prepare><Start>0</Start><Quit>0</Quit></SysCmd></Robot>";
              Send(outString1, outString2, outString3);
           ELSE
              // BKMessPos[i] ... hier stehen die Punktkoordinaten der Bahnpunkte nach BK_KORR
              outString1 := "<Robot><TelVer>2</TelVer><TelType>2</TelType>";
              outString1 := outString1 + "<Index>" + STR(i) + "</Index><MeasurementPath>0</MeasurementPath><ApplicationPath>1</ApplicationPath>";
              outString1 := outString1 + "<NumIndices>0</NumIndices><Label>A_" + STR(BKMessPunkt[i]) + "</Label><SegLabel>Segment 1</SegLabel>";
              strLen1 := StrLen(outString1); // 167
              outString1 := outString1 + "<X>" + STR(BKMessPos[i].X) + "</X>";
              strLen1 := StrLen(outString1); // 185
              outString1 := outString1 + "<Y>" + STR(BKMessPos[i].Y) + "</Y>";
              strLen1 := StrLen(outString1); // 202

              outString2 := "<Z>" + STR(BKMessPos[i].Z) + "</Z>";
              strLen1 := StrLen(outString2);
              outString2 := outString2 + "<A>" + STR(BKMessPos[i].C) + "</A>";
              strLen1 := StrLen(outString2); 
              outString2 := outString2 + "<B>" + STR(BKMessPos[i].B) + "</B>";
              strLen1 := StrLen(outString2); 
              outString2 := outString2 + "<C>" + STR(BKMessPos[i].A) + "</C>";
              strLen1 := StrLen(outString2); 
              outString2 := outString2 + "<MeasurementID>" + STR(BK_PATH) + "</MeasurementID><Valid>1</Valid> <PointInfo>2</PointInfo>";
              strLen1 := StrLen(outString2); 

              //ROVIS
              outString3 := "<SysCmd><Runmode>2</Runmode><Type>0</Type><Prepare>0</Prepare><Start>0</Start><Quit>0</Quit></SysCmd></Robot>";
              Send(outString1, outString2, outString3);
      (*
                 ROUTINE Send(outData1 : STRING; outData2 : STRING) 
      ----------------------------------------------------------------
      Applikationspunkte (nach Übertragung der Ergebnisse):
      ----------------------------------------------------------------
      <Robot>
        <Index>1</Index>
        <MeasurementPath>0</MeasurementPath>
        <ApplicationPath>1</ApplicationPath>
        <NumIndices>0</NumIndices>
        <Label>Applikationspunkt 1</Label>
        <SegLabel>Segment 1</SegLabel>
        <X>1.0</X>
        <Y>2.0</Y>
        <Z>3.0</Z>
        <A>4.0</A>
        <B>5.0</B>
        <C>6.0</C>
        <MeasurementID>1</MeasurementID>
        <Valid>1</Valid>
        <PointInfo>2</PointInfo>
      </Robot>
                 *)
              myRobot.DebugPrint(eTraceVision, "Pathpoint "+STR(BKMessPunkt[i])+":");
              myRobot.DebugPrint(eTraceVision, "  X = "+STR(BKMessPos[i].X)+"  Y = "+STR(BKMessPos[i].Y)+"  Z = "+STR(BKMessPos[i].Z));
              myRobot.DebugPrint(eTraceVision, "  A = "+STR(BKMessPos[i].A)+"  B = "+STR(BKMessPos[i].B)+"  C = "+STR(BKMessPos[i].C));
           END_IF;

           IF bPointCountValid AND (BK_RequestCount = BK_NumberOfPoints) THEN // Abschluss Telegramme mit Bahnpunkten
              outString1 := "<Robot><TelVer>2</TelVer><TelType>2</TelType>";
              outString1 := outString1 + "<Index>" + STR(i+1) + "</Index><MeasurementPath>0</MeasurementPath><ApplicationPath>1</ApplicationPath>";
              outString1 := outString1 + "<NumIndices>0</NumIndices><Label>STATUS_ENDOFAPPLPOINTS</Label><SegLabel>Segment 1</SegLabel>";
              strLen1 := StrLen(outString1); // 167
              outString1 := outString1 + "<X>0.0</X>";
              strLen1 := StrLen(outString1);
              outString1 := outString1 + "<Y>0.0</Y>";
              strLen1 := StrLen(outString1);

              outString2 := "<Z>0.0</Z>";
              strLen1 := StrLen(outString2);
              outString2 := outString2 + "<A>0.0</A>";
              strLen1 := StrLen(outString2); 
              outString2 := outString2 + "<B>0.0</B>";
              strLen1 := StrLen(outString2); 
              outString2 := outString2 + "<C>0.0</C>";
              strLen1 := StrLen(outString2); 
              outString2 := outString2 + "<MeasurementID>" + STR(BK_PATH) + "</MeasurementID><Valid>1</Valid> <PointInfo>2</PointInfo>";
              strLen1 := StrLen(outString2); 

              //ROVIS
              outString3 := "<SysCmd><Runmode>2</Runmode><Type>0</Type><Prepare>0</Prepare><Start>0</Start><Quit>0</Quit></SysCmd></Robot>";
              Send(outString1, outString2, outString3);
           END_IF;

           IF (BK_RequestCount > 0) THEN
              BK_RequestCount := BK_RequestCount + 1;
           ELSE
              myRobot.DebugPrint(eTraceVision,"BK_SendData: BK_RequestCount invalid");
           END_IF;

        ELSE
           myRobot.WaitMcMicroCycles(1);
        END_IF;
     END_IF;     
   END_WHILE;
END_ROUTINE


//----------------------------------------------------------------------------------------
// Map all In- and Outputs from one robot to ISRA BK
//----------------------------------------------------------------------------------------
ROUTINE MapBkSignals() PRIVATE
   
   bMappingOk := TRUE;
   RcuReadSymbols(myRobot.kinListInx);   
   bBK_SIG_TRIGGER := MAPX(Sym_BK_Out_TRIGGER);
      
   IF NOT IS_MAPPED(bBK_SIG_TRIGGER) THEN
      bMappingOk := FALSE;
      gbBootupError := TRUE;
      RcuSetMessageOnce(RcuFieldbusSlave_ErrMappingIOs, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBK2.MapBkSignals");
   END_IF;   
   
   IF bMappingOk AND NOT myRobot.bFieldbusSlaveReady THEN
      bMappingOk    := FALSE;
      gbBootupError := TRUE;
      RcuSetMessageOnce(TRcuVision_ErrFieldbus, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBK2.MapBkSignals");
   END_IF;
      
   IF bMappingOk AND NOT myRobot.vision.bUseExtendedInterface THEN
      bMappingOk    := FALSE;
      gbBootupError := TRUE;
      RcuSetMessageOnce(TRcVisionBk_ErrNoExtendedConfig, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBk2.MapBkSignals");
   END_IF;
   
END_ROUTINE


ROUTINE RcuReadSymbolsOld(kinListIndex : DINT) : BOOL PRIVATE
   VAR
      dirHdl : DINT;    // handle of a subdirectory
      name : STRING;
      i      : SINT;
   END_VAR

   WAIT gbRcHandleOk;
   IF giRcBaseHdl = 0 THEN
      RcuSetMessageOnce(_systemvars_ErrCnfSymbol, -1, 1, 0, "TRcuVisionIsraBK2.RcuReadSymbols");
      RETURN FALSE;
   END_IF;

   IF CatalogGetHandleRelative(giRcBaseHdl, "Symbols", dirHdl) THEN
      IF NOT CatalogReadString(dirHdl, "Sym_BK_Out_TRIGGER", Sym_BK_Out_TRIGGER, TRUE) THEN
         Sym_BK_Out_TRIGGER := "HWO_mBK_SIG_TRIGGER";
      END_IF;
   ELSE
      RcuSetMessageOnce(_systemvars_ErrCnfSymbol, -1, 1, 0, "TRcuVisionIsraBK2.RcuReadSymbols");
      RETURN FALSE;
   END_IF;

RETURN TRUE;

END_ROUTINE

ROUTINE RcuReadSymbols(kinListIndex : DINT) : BOOL PRIVATE
   VAR
      dirHdl : DINT;    // handle of a subdirectory
      name  : STRING;
      i      : SINT;
   END_VAR

   WAIT gbRcHandleOk;
   IF giRcBaseHdl = 0 THEN
      RcuSetMessageOnce(_systemvars_ErrCnfSymbol, -1, 1, 0, "TRcuVisionIsraBK2.RcuReadSymbols");
      RETURN FALSE;
   END_IF;

   IF CatalogGetHandleRelative(giRcBaseHdl, "Symbols", dirHdl) THEN
      IF NOT CatalogReadString(dirHdl, "Sym_BK_Out_TRIGGER", name, TRUE) THEN
         Sym_BK_Out_TRIGGER := "RCU1.HWO_mBK_SIG_TRIGGER";
      ELSE
         Sym_BK_Out_TRIGGER := "RCU" + STR(gyiNrRcu[i]) + "." + name;
      END_IF;
   ELSE
      RcuSetMessageOnce(_systemvars_ErrCnfSymbol, -1, 1, 0, "TRcuVisionIsraBK2.RcuReadSymbols");
      RETURN FALSE;
   END_IF;

RETURN TRUE;

END_ROUTINE



//----------------------------------------------------------------------------------------
// calculate object and correction values for teachview
//----------------------------------------------------------------------------------------
ROUTINE CalcActualObject(corrFrame : TMcuFrame; bMRFlag : BOOL) PRIVATE

VAR
   mRefSysId  : TMcuDbObjID;
   tVmtObject : TMcuTransformation;
   tObject    : TMcuTransformation;
   lCorrFrame : TMcuFrame;
   iLocNr     : INT;
END_VAR

   iLocNr := iBkPPNrPreRun;
   lCorrFrame := corrFrame;
   RcuRefSysGetMcuId(myRobot.RcuRefSystemObject, tVmtObject.mRefSysID);
   McuCreateTrsf(mRefSysId, tVmtObject);
   IF bMRFlag THEN
      WAIT MAIN_RUN;
   END_IF;
   myRobot.vision.VisionBK.iBkPPNr := iLocNr;
   corrFrameMR := lCorrFrame;
   myRobot.vision.VisionBK.tVmtCorr.X_mm  := lCorrFrame.mPos.mValues[0];
   myRobot.vision.VisionBK.tVmtCorr.Y_mm  := lCorrFrame.mPos.mValues[1];
   myRobot.vision.VisionBK.tVmtCorr.Z_mm  := lCorrFrame.mPos.mValues[2];
   myRobot.vision.VisionBK.tVmtCorr.A_deg := lCorrFrame.mOri.mValues[0];
   myRobot.vision.VisionBK.tVmtCorr.B_deg := lCorrFrame.mOri.mValues[1];
   myRobot.vision.VisionBK.tVmtCorr.C_deg := lCorrFrame.mOri.mValues[2];
   IF McuReadTrsfInWorld(mRefSysId, tObject) THEN
      myRobot.vision.VisionBK.tObjectData.X_mm  := tObject.mFrame.mPos.mValues[0];
      myRobot.vision.VisionBK.tObjectData.Y_mm  := tObject.mFrame.mPos.mValues[1];
      myRobot.vision.VisionBK.tObjectData.Z_mm  := tObject.mFrame.mPos.mValues[2];
      myRobot.vision.VisionBK.tObjectData.A_deg := tObject.mFrame.mOri.mValues[0];
      myRobot.vision.VisionBK.tObjectData.B_deg := tObject.mFrame.mOri.mValues[1];
      myRobot.vision.VisionBK.tObjectData.C_deg := tObject.mFrame.mOri.mValues[2];
   END_IF;

   McuReleaseDbObj(mRefSysId);

END_ROUTINE 

(******************************************************************************
***  build the text for teachview *********************************************
******************************************************************************)
ROUTINE ObserveBkModus() PRIVATE
VAR
   chgValid  : BOOL;
END_VAR

   chgValid  := IS_CHANGED(BK_MODUS);
   WHILE TRUE DO
      CASE BK_MODUS OF
      Mode_AEC_Measure,
      ModeMeasure:
         myRobot.vision.VisionBK.sBkModus := "Messfahrt        Typ = "+STR(BK_TYPE)+" Bahn = "+STR(BK_PATH);
         myRobot.vision.VisionBK.iBkState := 1;
      Mode_AEC_Application,
      ModeApplication:
         myRobot.vision.VisionBK.sBkModus := "Applikation      Typ = "+STR(BK_TYPE)+" Bahn = "+STR(BK_PATH);
         myRobot.vision.VisionBK.iBkState := 2;
      Mode_MP_Ref:
         myRobot.vision.VisionBK.sBkModus := "Messpunkt-Referenzfahrt Typ = "+STR(BK_TYPE)+" Bahn = "+STR(BK_PATH);
         myRobot.vision.VisionBK.iBkState := 3;
      Mode_PP_Ref:
         myRobot.vision.VisionBK.sBkModus := "Bahnpunkt-Referenzfahrt Typ = "+STR(BK_TYPE)+" Bahn = "+STR(BK_PATH);
         myRobot.vision.VisionBK.iBkState := 4;
      Mode_ApplTest:
      Mode_Off:
         myRobot.vision.VisionBK.sBkModus := "";
         myRobot.vision.VisionBK.iBkState := 0;
         iBkPPNrPreRun := 0;
         myRobot.vision.VisionBK.iBkPPNr := 0;
      END_CASE;
      WAIT chgValid;
      chgValid := FALSE;
   END_WHILE;
END_ROUTINE


(******************************************************************************
***  State bits from ISRA BK to Ecopaint Screen *******************************
******************************************************************************)
ROUTINE BkSignalsToEPS() PRIVATE
VAR
   bEpsInDisable      : MAPTO BOOL;
   bMapOk             : BOOL;
   bChgDisable        : BOOL;
   bChgState          : BOOL;
   bChgType           : BOOL;
   bChgPath           : BOOL;
   bChgCommFault      : BOOL;
END_VAR   

   bMapOk := TRUE;
   tEPS_PathCorrIn := MAPX(cSV_EPSInPathCorr[myRobot.kinListInx]);
   IF NOT IS_MAPPED(tEPS_PathCorrIn) THEN
      bMapOk := FALSE;
      RcuSetMessageOnce(TRcVisionBk_ErrMapEpsVar, myRobot.kinListInx, 1, instId, "TRcuVisionIsraBk2.BkSignalsToEPS", cSV_EPSInPathCorr[myRobot.kinListInx]);
   END_IF;
   tEPS_PathCorrOut := MAPX(cSV_EPSOutPathCorr[myRobot.kinListInx]);
   IF NOT IS_MAPPED(tEPS_PathCorrOut) THEN
      bMapOk := FALSE;
      RcuSetMessageOnce(TRcVisionBk_ErrMapEpsVar, myRobot.kinListInx, 7, instId, "TRcuVisionIsraBk2.BkSignalsToEPS", cSV_EPSOutPathCorr[myRobot.kinListInx]);
   END_IF;
   IF NOT bMapOk THEN
      myRobot.DebugPrint(eTraceVision, "Visu from ISRA BK not running!!");
      RETURN;
   END_IF;
   
   tEPS_PathCorrOut.bDisabled    := UPDATE(bDisabledHMI);
   tEPS_PathCorrOut.bCommFault   := UPDATE(bCommError);
   IF IS_MAPPED(myRobot.fieldbusOut.VisionError.svBool) THEN
      tEPS_PathCorrOut.bFailure := UPDATE(myRobot.fieldbusOut.VisionError.svBool);   
   END_IF;

   bChgCommFault                 := IS_CHANGED(bCommError);  
   bChgDisable                   := IS_CHANGED(tEPS_PathCorrIn.bDisable);
   bChgState                     := IS_CHANGED(myRobot.vision.VisionBK.iBkState);
   bChgType                      := IS_CHANGED(BK_TYPE);
   bChgPath                      := IS_CHANGED(BK_PATH);
   WHILE TRUE DO
     IF tEPS_PathCorrIn.bDisable AND NOT bDisabledHMI THEN
        bDisabledHMI   := TRUE; 
     ELSIF (NOT tEPS_PathCorrIn.bDisable) AND bDisabledHMI THEN
        bDisabledHMI   := FALSE; 
     END_IF;  
     IF bCommError THEN
        tEPS_PathCorrOut.iSystemState := cgiHMI_Red;
     ELSE
        tEPS_PathCorrOut.iSystemState := cgiHMI_Grey;
     END_IF;
     tEPS_PathCorrOut.iSystemState := cgiHMI_Grey;
     tEPS_PathCorrOut.iOpertingMode := myRobot.vision.VisionBK.iBkState;
     tEPS_PathCorrOut.iType         := BK_TYPE;
     tEPS_PathCorrOut.iPath         := BK_PATH;
     bChgDisable   := FALSE;
     bChgState     := FALSE;
     bChgType      := FALSE;
     bChgPath      := FALSE;
     bChgCommFault := FALSE;
     WAIT bChgDisable OR bChgState OR bChgType OR bChgPath OR bChgCommFault;
   END_WHILE;
       
END_ROUTINE


(*******************************************************************************
*
*  TCP/IP Kommunikation
*
*******************************************************************************)

ROUTINE Open(strIpAddress : STRING; remotePort : WORD ) PRIVATE
   VAR
      result : DINT;
   END_VAR
   
   client.tcpConnectionState := stateSckConnecting;
   IF NOT bSimulateBK AND NOT bSimulate THEN
      result := client.GetIPaddressAndOpen( strIpAddress, remotePort);
   ELSE
      result := 0;
   END_IF;
   DebugPrint(eTraceVision, "TCP Client: "+ strIpAddress + " "+STR(remotePort));
   CASE result OF
   0: myRobot.DebugPrint(eTraceVision, "TCP Client: Connect ok"); 
      client.tcpConnectionState := stateSckConnected;

   1: myRobot.DebugPrint(eTraceVision, "TCP Client: Connect not ok - Internal error");    client.tcpConnectionState := stateSckError;         
   2: myRobot.DebugPrint(eTraceVision, "TCP Client: Connect not ok - Socket failed");     client.tcpConnectionState := stateSckError;
   3: myRobot.DebugPrint(eTraceVision, "TCP Client: Connect not ok - Connect failed");    client.tcpConnectionState := stateSckError;
   8: myRobot.DebugPrint(eTraceVision, "TCP Client: Connect not ok - Param error (invalid notification mode or notification handle)");
                                                               client.tcpConnectionState := stateSckError;
   16:myRobot.DebugPrint(eTraceVision, "TCP Client: Connect not ok - Wrong IP address");  client.tcpConnectionState := stateSckError;
   ELSE
      myRobot.DebugPrint(eTraceVision, "TCP Client: Connect not ok - Unknown error");     client.tcpConnectionState := stateSckError;
   END_CASE;

END_ROUTINE


ROUTINE Close() PRIVATE
   VAR
      result : DINT;
   END_VAR
   
   client.tcpConnectionState := stateSckClosing;
   IF NOT bSimulateBK AND NOT bSimulate THEN
      result := client.Close();
   ELSE
       result := 0;
   END_IF;
   CASE result OF
   0: myRobot.DebugPrint(eTraceVision, "TCP Client: Close ok");                             client.tcpConnectionState := stateSckClosed;
   1: myRobot.DebugPrint(eTraceVision, "TCP Client: Close not ok - Internal error");        client.tcpConnectionState := stateSckError;
   2: myRobot.DebugPrint(eTraceVision, "TCP Client: Close not ok - Socket failed");         client.tcpConnectionState := stateSckError;
   9: myRobot.DebugPrint(eTraceVision, "TCP Client: Close not ok - invalid socket handle"); client.tcpConnectionState := stateSckError;
   ELSE
      myRobot.DebugPrint(eTraceVision, "TCP Client: Close not ok - Unknown error");         client.tcpConnectionState := stateSckError;
   END_CASE;
END_ROUTINE


ROUTINE Send(outData1 : STRING; outData2 : STRING; outData3 : STRING) PRIVATE
   VAR
      result   : DINT;
      data     : ARRAY[1..768] OF BYTE;
      dataLen1 : DINT;
      dataLen2 : DINT;
      dataLen3 : DINT;
      i        : DINT;
      chr      : STRING;
   END_VAR 
   
   myRobot.DebugPrint(eTraceTcpIp, "SEND "+outData1);
   myRobot.DebugPrint(eTraceTcpIp, "SEND "+outData2);
   myRobot.DebugPrint(eTraceTcpIp, "SEND "+outData3);
   dataLen1 := StrLen(outData1);
   FOR i:= 1 TO dataLen1 DO  
      chr := StrMid(outData1, 1, i);
      data[i] := ORD(chr);     
   END_FOR;
   dataLen2 := StrLen(outData2);
   FOR i:= 1 TO dataLen2 DO  
      chr := StrMid(outData2, 1, i);
      data[dataLen1 + i] := ORD(chr);     
   END_FOR;
   dataLen3 := StrLen(outData3);
   FOR i:= 1 TO dataLen3 DO  
      chr := StrMid(outData3, 1, i);
      data[dataLen1 + dataLen2 + i] := ORD(chr);     
   END_FOR;
   IF NOT bSimulateBK AND NOT bSimulate THEN
      result := client.Send(dataLen1+dataLen2+dataLen3, data);
   ELSE
       result := 0;
   END_IF;
  
   CASE result OF
   0: myRobot.DebugPrint(eTraceTcpIp, "TCP Client: Send ok");
   1: myRobot.DebugPrint(eTraceVision, "TCP Client: Send not ok - Internal error");        client.tcpConnectionState := stateSckError;
   2: myRobot.DebugPrint(eTraceVision, "TCP Client: Send not ok - Send error");            client.tcpConnectionState := stateSckError;
   8: myRobot.DebugPrint(eTraceVision, "TCP Client: Send not ok - Param error (invalid notification mode or notification handle)");
   9: myRobot.DebugPrint(eTraceVision, "TCP Client: Send not ok - invalid socket handle"); client.tcpConnectionState := stateSckError;
   ELSE
      myRobot.DebugPrint(eTraceVision, "TCP Client: Send not ok - Unknown error");         client.tcpConnectionState := stateSckError;
   END_CASE;
END_ROUTINE


//-----------------------------------------------------------------------------
// Empfangen der Telegramme über die TCP/IP-Schnittstelle. Ein empfangenes Telegramm
// wird zeilenweise in einen String konvertiert. Der Empfang wird mit der
// Variablen bNotification an die Verarbeitung der Telegramme gemeldet (BK_ReceiveTelegram)
//-----------------------------------------------------------------------------
ROUTINE TcpClientTask(bNotification : BOOL; inData1 : STRING) PRIVATE
VAR
   buf           : ARRAY [1..256] OF BYTE;
   bytesReceived : DINT;
   i             : DINT;
   rv            : DINT;
   lastChr       : BYTE := 0;
END_VAR
   
   WHILE TRUE DO
      // collect
      WAIT NOT bNotification;
      rv := client.Receive(255, buf, bytesReceived);
      myRobot.DebugPrint(eTraceTcpIp, "TCP client 1 : bytesReceived = " + STR(bytesReceived));
      IF rv <> 0 THEN
          myRobot.DebugPrint(eTraceTcpIp, "TCP client: Server disconnected");
          client.tcpConnectionState := stateSckClosed;
          RETURN;
      END_IF;

      i := 1;
      WHILE (i < bytesReceived) DO
         IF lastChr <> 0 THEN
            inData1 := CHR(lastChr);
         ELSE
            inData1 := "";
         END_IF;
//         WHILE ((buf[i] <> 10) OR ( i <= 1))  DO // LF Zeilenende
         WHILE ((buf[i] <> 10))  DO // LF Zeilenende
            inData1 := inData1 +  CHR(buf[i]);
            i := i + 1;
            IF (i > bytesReceived) THEN
               IF (StrFind(inData1, "</DataSet>") <> 0) THEN // LF fehlt bei </DataSet>
                  bNotification := TRUE;
                  WAIT NOT bNotification;
                  inData1 := "";
               END_IF;
               rv := client.Receive(255, buf, bytesReceived);
               myRobot.DebugPrint(eTraceTcpIp, "TCP client 2: bytesReceived = " + STR(bytesReceived));
               IF rv <> 0 THEN
                   myRobot.DebugPrint(eTraceVision, "TCP client: Server disconnected");
                   client.tcpConnectionState := stateSckClosed;
                   RETURN;
               END_IF;
               i := 1;
            END_IF;
         END_WHILE;
         i := i+1;
         myRobot.DebugPrint(eTraceTcpIp, "TCP client: next line = " + inData1);
         bNotification := TRUE;
         WAIT NOT bNotification;
         IF (i = bytesReceived) THEN
            lastChr := buf[i];
            rv := client.Receive(255, buf, bytesReceived);
            myRobot.DebugPrint(eTraceTcpIp, "TCP client 3: bytesReceived = " + STR(bytesReceived));
            IF rv <> 0 THEN
                myRobot.DebugPrint(eTraceVision, "TCP client: Server disconnected");
                client.tcpConnectionState := stateSckClosed;
                RETURN;
            END_IF;
            i := 1;
         ELSE
            lastChr := 0;
         END_IF;
      END_WHILE;
      
      //bNotification := TRUE;
   END_WHILE;
END_ROUTINE


(*******************************************************************************
*
*  Decodieren der Telegramme
*
*******************************************************************************)


(*-----------------------------------------------------------------------------
* Liest den Wert des Attributs "attr" im Telegramm InData1
* ab der Position p  in Indata1. Der Wert wird als String in val zurueckgegeben.
*)
ROUTINE ReadAttribute(CONST attr : STRING; CONST InData1 : STRING;  val :STRING; 
                      OPTIONAL CONST p : DINT ) : BOOL PRIVATE
VAR
   s  : STRING;
   s1 : STRING;
   s2 : STRING;
   p1 : DINT;
   p2 : DINT;
   p3 : DINT;
END_VAR
   
   s :=attr +"=";
//   myRobot.DebugPrint(eTraceVision, "ReadAttribute " + s);
   p1 := StrFind(InData1, s, p);
   IF (p1 > 0) THEN
      p1 := StrFind(InData1, s, p);
      p2 := StrFind(InData1, ">", p1);
      p3 := StrFind(InData1, " ", p1);
      IF (p2 = 0) AND (p3 = 0) THEN
         RETURN FALSE;
      END_IF;
      p1 := p1 + StrLen(s);
      IF (p3 < p2) AND (p3 <> 0) THEN
         p2 := p3;
      END_IF;
      val  := StrMid(InData1, p2-p1-2, p1+1);
      RETURN TRUE;
   ELSE
      RETURN FALSE;
   END_IF;
   
END_ROUTINE

(*-----------------------------------------------------------------------------
* Liest den Wert des Elements "elem" im Telegramm InData1.
* Der Wert wird als String in val zurueckgegeben. 
*)
ROUTINE ReadElement(CONST elem : STRING; InData1 : STRING; val :STRING) : BOOL PRIVATE
VAR
   s  : STRING;
   s1 : STRING;
   s2 : STRING;
   p1 : DINT;
   p2 : DINT;
   l  : DINT;
END_VAR
   
   s := "<" + elem + ">";
   IF (StrFind(InData1, s) > 0) THEN
      p1 := StrFind(InData1, s) + StrLen(s);
//      s  := "</" + elem + ">";
      s  := "</" + elem;  // da ">" bei /SegLabel und beim letzten /Dataset fehlt
      p2 := StrFind(InData1, s);
      IF (p2 = 0) THEN
         RETURN FALSE;
      END_IF;
      val  := StrMid(InData1, p2-p1, p1);
      RETURN TRUE;
   ELSE
      RETURN FALSE;
   END_IF;
   
END_ROUTINE

(*-----------------------------------------------------------------------------
* Liest die Framedaten X, Y, Z, A, B, C aus dem Element "name" im Telegramm 
* Der Wert wird als FRAME in val zurueckgegeben. 
*)
ROUTINE ReadFrame(CONST name : STRING; CONST InData1 : STRING; val : FRAME) : BOOL PRIVATE
VAR
   s  : STRING;
   s1 : STRING;
   s2 : STRING;
   p1 : DINT;
   p2 : DINT;
   l  : DINT;
END_VAR
   
   s := "<" + name;
//   myRobot.DebugPrint(eTraceVision, "ReadFrame " + s);
   IF (StrFind(InData1, s) > 0) THEN
      p1 := StrFind(InData1, s) + StrLen(s);
      IF ReadAttribute("X", InData1, s, p1) THEN
         val.X := StrToReal(s);
      END_IF;
      IF ReadAttribute("Y", InData1, s, p1) THEN
         val.Y := StrToReal(s);
      END_IF;
      IF ReadAttribute("Z", InData1, s, p1) THEN
         val.Z := StrToReal(s);
      END_IF;
      IF ReadAttribute("A", InData1, s, p1) THEN
         val.A := StrToReal(s);
      END_IF;
      IF ReadAttribute("B", InData1, s, p1) THEN
         val.B := StrToReal(s);
      END_IF;
      IF ReadAttribute("C", InData1, s, p1) THEN
         val.C := StrToReal(s);
      END_IF;

      RETURN TRUE;
   ELSE
      RETURN FALSE;
   END_IF;
   
END_ROUTINE

(*-----------------------------------------------------------------------------
* Testausgabe
*)
ROUTINE PrintFrame(val : FRAME) PRIVATE
   myRobot.DebugPrint(eTraceTcpIp, "  X = "+STR(val.X));
   myRobot.DebugPrint(eTraceTcpIp, "  Y = "+STR(val.Y));
   myRobot.DebugPrint(eTraceTcpIp, "  Z = "+STR(val.Z));
   myRobot.DebugPrint(eTraceTcpIp, "  A = "+STR(val.A));
   myRobot.DebugPrint(eTraceTcpIp, "  B = "+STR(val.B));
   myRobot.DebugPrint(eTraceTcpIp, "  C = "+STR(val.C));
END_ROUTINE

(*-----------------------------------------------------------------------------
* Testausgabe
*)
ROUTINE PrintError(Error : INT) PRIVATE
VAR
   tmp : INT;
END_VAR
  
   IF (Error = 0) THEN
      myRobot.DebugPrint(eTraceTcpIp, "Keine Fehler");
      RETURN;
   END_IF;
   tmp := Error;
   IF ((tmp AND 16#0000000000000001) = 1) THEN
      myRobot.DebugPrint(eTraceVision, "Messfehler bei Messung");
   END_IF;
   tmp := SHR(Error,1);
   IF ((tmp AND 16#0000000000000001) = 1) THEN
      myRobot.DebugPrint(eTraceVision, "Toleranzueberschreitung bei Messung");
   END_IF;
   tmp := SHR(Error,2);
   IF ((tmp AND 16#0000000000000001) = 1) THEN
      myRobot.DebugPrint(eTraceVision, "Messfehler bei Spalt-Buendigkeitsmessung");
   END_IF;
   tmp := SHR(Error,3);
   IF ((tmp AND 16#0000000000000001) = 1) THEN
      myRobot.DebugPrint(eTraceVision, "Toleranzueberschreitung bei Spalt-Buendigkeitsmessung");
   END_IF;
   tmp := SHR(Error,4);
   IF ((tmp AND 16#0000000000000001) = 1) THEN
      myRobot.DebugPrint(eTraceVision, "Toleranzueberschreitung Roboter");
   END_IF;
END_ROUTINE


//------------------------------------------------------------------------------------------------------------------
// Grenzwerte auf UserPage aktualisieren
//------------------------------------------------------------------------------------------------------------------
ROUTINE SetLimitsUserPage(limit : tLimits; limitUserPage : tLimitsUserPage) PRIVATE
  IF NOT (limit.bConfigured OR limit.bSetByEcoTalk) THEN
     limitUserPage.rXmin   := 0.0;
     limitUserPage.rXmax   := 0.0;
     limitUserPage.rYmin   := 0.0;
     limitUserPage.rYmax   := 0.0;
     limitUserPage.rZmin   := 0.0;
     limitUserPage.rZmax   := 0.0;
     limitUserPage.iLabel  := 0; //"ungueltig";
  ELSIF limit.bSetByEcoTalk THEN
     limitUserPage.rXmin   := limit.rXmin_TP;
     limitUserPage.rXmax   := limit.rXmax_TP;
     limitUserPage.rYmin   := limit.rYmin_TP ;
     limitUserPage.rYmax   := limit.rYmax_TP;
     limitUserPage.rZmin   := limit.rZmin_TP;
     limitUserPage.rZmax   := limit.rZmax_TP;
     limitUserPage.iLabel  := 1; //"Teachprogramm";
  ELSIF limit.bConfigured THEN
     limitUserPage.rXmin   := limit.rXmin_Cfg;
     limitUserPage.rXmax   := limit.rXmax_Cfg;
     limitUserPage.rYmin   := limit.rYmin_Cfg ;
     limitUserPage.rYmax   := limit.rYmax_Cfg;
     limitUserPage.rZmin   := limit.rZmin_Cfg;
     limitUserPage.rZmax   := limit.rZmax_Cfg;
     limitUserPage.iLabel  := 2; //"RobotControl.cfg";
  END_IF;
END_ROUTINE

(******************************************************************************
***  State bits from VMT Toolbox to Ecopaint Screen ***************************
******************************************************************************)
ROUTINE TBoxSignalsToEPS() PRIVATE
VAR
   bEpsInDisable      : MAPTO BOOL;
   bMapOk             : BOOL;
   bChg               : BOOL;
END_VAR   

   bMapOk := TRUE;
   tEPS_ToolCorrIn := MAPX(cSV_EPSInToolCorr[myRobot.kinListInx]);
   IF NOT IS_MAPPED(tEPS_ToolCorrIn) THEN
      bMapOk := FALSE;
      RcuSetMessageOnce(TRcVisionBk_ErrMapEpsVar, myRobot.kinListInx, 1, instId, "TRcuVisionBk.TBoxSignalsToEPS", cSV_EPSInToolCorr[myRobot.kinListInx]);
   END_IF;
   tEPS_ToolCorrOut := MAPX(cSV_EPSOutToolCorr[myRobot.kinListInx]);
   IF NOT IS_MAPPED(tEPS_ToolCorrOut) THEN
      bMapOk := FALSE;
      RcuSetMessageOnce(TRcVisionBk_ErrMapEpsVar, myRobot.kinListInx, 7, instId, "TRcuVisionBk.TBoxSignalsToEPS", cSV_EPSOutToolCorr[myRobot.kinListInx]);
   END_IF;
   IF NOT bMapOk THEN
      myRobot.DebugPrint(eTraceVision, "Visu from Toolbox not running!!");
      RETURN;
   END_IF;
      
   tEPS_ToolCorrOut.bDisabled    := UPDATE(bDisabledHMI);
   bChg                          := IS_CHANGED(tEPS_ToolCorrIn.bDisable);
   
   WHILE TRUE DO
     IF tEPS_ToolCorrIn.bDisable AND NOT bDisabledHMI THEN
        bDisabledHMI   := TRUE; 
     ELSIF (NOT tEPS_ToolCorrIn.bDisable) AND bDisabledHMI THEN
        bDisabledHMI   := FALSE; 
     END_IF;  
     bChg         := FALSE;
     WAIT bChg;
   END_WHILE;
       
END_ROUTINE


//----------------------------------------------------------------------------------------
// Map EcoTalk var KinX.SENSOR_CHECK when _GlobalVars.tid is reloaded at Teachpendant
//----------------------------------------------------------------------------------------
ROUTINE MapSensorCheck() PRIVATE
 VAR
   s : STRING;
 END_VAR
 
  WHILE TRUE DO
     WAIT myRobot.fixPosReady;
     s := "Kin"+STR(myRobot.kinListInx+1)+".SENSOR_CHECK";
     bSensorCheck := MAPX(s);
     IF NOT IS_MAPPED(bSensorCheck) THEN
        myRobot.DebugPrint(eTraceVision,"SENSOR_CHECK = " + s + " not mapped");
        RcuSetMessageOnce(TRcVisionBk_ErrBkInit, myRobot.kinListInx, 3, instId, "TRcuVisionIsraBk2.MapSensorCheck");
     ELSIF IS_MAPPED(bOutSensorCheckHMI) THEN
        bOutSensorCheckHMI := UPDATE(bSensorCheck);
     END_IF;
     WAIT NOT myRobot.fixPosReady;  
     IF IS_MAPPED(bOutSensorCheckHMI) THEN
        bOutSensorCheckHMI := UPDATE(FALSE);
     END_IF; 
  END_WHILE;
END_ROUTINE

ROUTINE SensorCheckHMI() PRIVATE
  WHILE TRUE DO
     WAIT bInSensorCheckHMI;
     bInSensorCheckHMI := FALSE;
     IF IS_MAPPED(bSensorCheck) THEN
        bSensorCheck    := FALSE;  //mapped to EcoTalk _GlobalVars.tid SENSOR_CHECK
     END_IF;
     myRobot.DebugPrint(eTraceVision, "Order from HMI - execute sensor check at next programm start");
  END_WHILE;
END_ROUTINE


//------------------------------------------------------------------------------------------------------------------
// set output to PLC when ToolCorrection exeeds warning limit (min. 1 sec.) - reset at prog end
//------------------------------------------------------------------------------------------------------------------
ROUTINE WarningToPLC() PRIVATE
 VAR
  chg              : BOOL;
  fin              : BOOL;
  bWarningToPLCSet : BOOL;
 END_VAR
    
  chg := IS_CHANGED(bWarningToPLC);
  WHILE TRUE DO
    WAIT chg;
    chg := FALSE;
    IF bWarningToPLC AND NOT bWarningToPLCSet THEN
       myRobot.fieldbusOut.bWarnToolRange.svBool := TRUE;
       bWarningToPLCSet := TRUE;
       fin := FALSE;
       SysTimerSet(1000, fin);
    ELSIF bWarningToPLCSet THEN
       WAIT fin OR bWarningToPLC;
       SysTimerClear(fin);
       fin := FALSE;
       IF NOT bWarningToPLC THEN
          bWarningToPLCSet := FALSE;
          myRobot.fieldbusOut.bWarnToolRange.svBool := FALSE;
          myRobot.DebugPrint(eTraceVision, "T-Box: Warning to PLC reset");
       END_IF;
    END_IF; 
  END_WHILE;
END_ROUTINE


(******************************************************************************
* systemroutines
*)


ROUTINE NEW()

   instId := RcuGetInstanceId(); // instance identification number (for alarms)

END_ROUTINE

ROUTINE RESERVE()
   IF myRobot.bReleaseBlockedByHandler THEN   
      myRobot.DebugPrint(eTraceAutoControl, "TRcuVisionIsraBK2.RESERVE: not executed - releaseBlockedByHandler");
   ELSE
      sAlarmLimits.rXmin_TP      := 0.0;
      sAlarmLimits.rXmax_TP      := 0.0;
      sAlarmLimits.rYmin_TP      := 0.0;
      sAlarmLimits.rYmax_TP      := 0.0;
      sAlarmLimits.rZmin_TP      := 0.0;
      sAlarmLimits.rZmax_TP      := 0.0;
      sAlarmLimits.bSetByEcoTalk := FALSE;
      sWarnLimits.rXmin_TP       := 0.0;
      sWarnLimits.rXmax_TP       := 0.0;
      sWarnLimits.rYmin_TP       := 0.0;
      sWarnLimits.rYmax_TP       := 0.0;
      sWarnLimits.rZmin_TP       := 0.0;
      sWarnLimits.rZmax_TP       := 0.0;
      sWarnLimits.bSetByEcoTalk  := FALSE;
   END_IF;
END_ROUTINE

(******************************************************************************
* systemroutine - kinematic is released by RDESELECT
******************************************************************************)
ROUTINE RELEASE()
VAR
   corrFrame : TMcuFrame;
   timeOut   : BOOL;
END_VAR

   IF NOT bMappingOk THEN
      RETURN;
   END_IF;
   IF myRobot.bReleaseBlockedByHandler THEN   
      myRobot.DebugPrint(eTraceVision, "TRcuVisionIsraBK2.RELEASE: not executed - releaseBlockedByHandler");
   ELSE
       corrFrame.mFrameTyp := eMcuFrameKardan;
       corrFrame.mPos.mValues[0] := 0.0;
       corrFrame.mPos.mValues[1] := 0.0;
       corrFrame.mPos.mValues[2] := 0.0;
       corrFrame.mOri.mValues[0] := 0.0;
       corrFrame.mOri.mValues[1] := 0.0;
       corrFrame.mOri.mValues[2] := 0.0;
       RcuRefSysSetKardan(myRobot.RcuRefSystemObject, corrFrame, myRobot.RcuRefSystemVisionRel, FALSE, "Object");
       myRobot.homing.StoreRefSystemVision(FALSE, corrFrame);
       CalcActualObject(corrFrame, FALSE);
       IF IS_MAPPED(myRobot.fieldbusOut.VisionError.svBool) THEN
          myRobot.fieldbusOut.VisionError.svBool := FALSE;
       END_IF;
       bCommError := FALSE;
       BK_MODUS   := Mode_Off;
       bReceiveToolAEC := FALSE;
       bReceiveObjectAEC := FALSE;
       IF bBkActive THEN
          SysTimerSet(1000, timeOut);
          bBkConnect := FALSE;
          WAIT NOT bBkActive OR timeOut;
          IF timeOut THEN
             myRobot.DebugPrint(eTraceVision, "TRcuVisionIsraBK2.RELEASE: timeOut bei Close TCP/IP");
          END_IF;
       END_IF;
   END_IF;
END_ROUTINE

ROUTINE SETPC()

   IF NOT bMappingOk OR NOT myRobot.vision.bBKBootUpOk THEN
      RETURN;
   END_IF;
   IF (iBkPPNrPreRun <> 0) AND (BK_MODUS = ModeApplication) THEN // Prerun has executed BK_CORR macro
       RcuRefSysSetKardan(myRobot.RcuRefSystemObject, corrFrameMR, myRobot.RcuRefSystemVisionRel, FALSE, "Object");
       myRobot.homing.StoreRefSystemVision(FALSE, corrFrameMR);
   END_IF;
END_ROUTINE
