<VIEW>
   <MASKDEF key="TeachView.mask.pneuTool" textfile="userTx"  permissiondef="userMenuPermission">
       <GROUP key="pneuTool.group.main" rows="40" columns="5" row="1" col="1" halign="stretch" valign="stretch">
       
           <!-- Fixation cylinder -->
           <GROUP key="pneuTool.group.bolt" rows="15" columns="20" row="1" col="1" rspan="15" cspan="5" halign="stretch" valign="stretch">
           
              <IMAGE file="pneutoolinion.gif"              col="4" row="9" visiblevar="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bBoltIsIn"          visiblevartype="TT"/>
              <IMAGE file="pneutoolinioff.gif"             col="4" row="9" visiblevar="!_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bBoltIsIn"         visiblevartype="TT"/>
                                                      
              <IMAGE file="pneutoolinion.gif"              col="7" row="9" visiblevar="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bBoltIsOut"         visiblevartype="TT"/>
              <IMAGE file="pneutoolinioff.gif"             col="7" row="9" visiblevar="!_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bBoltIsOut"        visiblevartype="TT"/>
             
              <IMAGE file="pneutoolcylinderin.gif"         col="2" row="2" visiblevar="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bBoltIsIn"          visiblevartype="TT"/>
              <IMAGE file="pneutoolcylinderout.gif"        col="2" row="2" visiblevar="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bBoltIsOut"         visiblevartype="TT"/>  
              <IMAGE file="pneutoolcylinderundef.gif"      col="2" row="2" visiblevar="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bBoltIsUndef"       visiblevartype="TT"/>   
              
              <BUTTON key="pneuTool.button.moveIn"         col="10" row="3" cspan="4" rspan="8" halign="stretch" valign="stretch"
				                           var="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bMoveBoltIn"                               vartype="TT" 
				                           enablevar="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bRelMoveBoltIn"                      enablevartype="TT"/>
              <BUTTON key="pneuTool.button.moveOut"        col="15" row="3" cspan="4" rspan="8" halign="stretch" valign="stretch"
				                           var="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bMoveBoltOut"                              vartype="TT" 
				                           enablevar="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bRelMoveBoltOut"                     enablevartype="TT"/>
				                    
              <LABEL key="pneuTool.label.order1"           col="10" row="12" halign="left" valign="stretch" rspan="3" cspan="3"/> 	                        
	      <LABEL key="pneuTool.label.order2"           var="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].eCylinderOrder" vartype="TT"
	                                                   col="13" row="12" halign="left" valign="stretch" rspan="3" cspan="5"/>				                    
           </GROUP>
           
           <!-- Swivel drive -->
           <GROUP key="pneuTool.group.swivel" rows="25" columns="20" row="16" col="1" rspan="25" cspan="5" halign="stretch" valign="stretch">   
               
              <IMAGE file="pneutoolinion.gif"              col="1" row="4"  visiblevar="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bToolIsUp"         visiblevartype="TT"/>
              <IMAGE file="pneutoolinioff.gif"             col="1" row="4"  visiblevar="!_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bToolIsUp"        visiblevartype="TT"/> 
              
              <IMAGE file="pneutoolinion.gif"              col="1" row="10" visiblevar="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bToolIsInCentre"   visiblevartype="TT"/>
              <IMAGE file="pneutoolinioff.gif"             col="1" row="10" visiblevar="!_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bToolIsInCentre"  visiblevartype="TT"/>
              
              <IMAGE file="pneutoolinion.gif"              col="1" row="16" visiblevar="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bToolIsDown"       visiblevartype="TT"/>
              <IMAGE file="pneutoolinioff.gif"             col="1" row="16" visiblevar="!_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bToolIsDown"      visiblevartype="TT"/>
                           
              <IMAGE file="pneutoolup.gif"                 col="3" row="2" visiblevar="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bToolIsUp"          visiblevartype="TT"/>
              <IMAGE file="pneutoolcentre.gif"             col="3" row="2" visiblevar="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bToolIsInCentre"    visiblevartype="TT"/>
              <IMAGE file="pneutooldown.gif"               col="3" row="2" visiblevar="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bToolIsDown"        visiblevartype="TT"/>
              <IMAGE file="pneutoolundef.gif"              col="3" row="2" visiblevar="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bToolIsUndef"       visiblevartype="TT"/>        
               
              <BUTTON key="pneuTool.button.moveup"         col="12" row="2" cspan="4" rspan="5" halign="stretch" valign="stretch"
				                           var="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bMoveToolUp"                               vartype="TT" 
				                           enablevar="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bRelMoveUp"                          enablevartype="TT"/>
	      <BUTTON key="pneuTool.button.movecentre"     col="12" row="11" cspan="4" rspan="5" halign="stretch" valign="stretch"
				                           var="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bMoveToolCentre"                           vartype="TT" 
				                           enablevar="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bRelMoveCentre"                      enablevartype="TT"
				                           visiblevar="!_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bShowReleases"                     visiblevartype="TT"/>
              <BUTTON key="pneuTool.button.movedown"       col="12" row="20" cspan="4" rspan="5" halign="stretch" valign="stretch"
				                           var="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bMoveToolDown"                             vartype="TT" 
				                           enablevar="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bRelMoveDown"                        enablevartype="TT"
				                           visiblevar="!_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bShowReleases"                     visiblevartype="TT"/>
				                        
              <LABEL key="pneuTool.label.angle"            col="17" row="1" halign="left" valign="stretch" rspan="3" cspan="3"
                                                           visiblevar="!_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bShowReleases"                     visiblevartype="TT"/> 
              <NUMFIELD key="handlerTool.numfield.type"    col="17" row="4" halign="stretch" valign="stretch" rspan="3" cspan="2"   
                                                           var="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.iAngleTool"                                vartype="TT"
                                                           visiblevar="!_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bShowReleases"                     visiblevartype="TT"/>	
                                                        
              <LABEL key="pneuTool.label.order3"           col="17" row="12" halign="left" valign="stretch" rspan="3" cspan="3"
                                                           visiblevar="!_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bShowReleases"                     visiblevartype="TT"/> 	                        
	      <LABEL key="pneuTool.label.order4"           var="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].eToolOrder"                                           vartype="TT"
	                                                   col="17" row="15" halign="left" valign="stretch" rspan="3" cspan="3"
	                                                   visiblevar="!_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bShowReleases"                     visiblevartype="TT"/>
	      
	      <!-- Conditions to get release for moving tool -->
	      <GROUP key="pneuTool.group.releases"         rows="17" columns="11" row="7" col="11" rspan="17" cspan="10" halign="stretch" valign="stretch"
	                                                   visiblevar="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bShowReleases"                      visiblevartype="TT">         
	             <!-- Error pending from message system -->
	             <IMAGE file="pneutoolerrorok.gif"     col="1" row="2"  visiblevar="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bErrorOk"          visiblevartype="TT"/>
	             <IMAGE file="pneutoolerrornok.gif"    col="1" row="2"  visiblevar="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bErrorNOk"         visiblevartype="TT"/>
	             <LABEL key="pneuTool.label.error"     col="1" row="14" halign="left" valign="stretch" rspan="3" cspan="10"
                                                           visiblevar="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bErrorNOk"                          visiblevartype="TT"/> 
	             <!-- Air supply switched on -->
	             <IMAGE file="pneutoolairok.gif"       col="4" row="3"  visiblevar="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bAirOk"            visiblevartype="TT"/>
	             <IMAGE file="pneutoolairnok.gif"      col="4" row="3"  visiblevar="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bAirNOk"           visiblevartype="TT"/>
	             <LABEL key="pneuTool.label.airsupply" col="1" row="14" halign="left" valign="stretch" rspan="3" cspan="10"
                                                           visiblevar="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bAirNOk"                            visiblevartype="TT"/>
	             <!-- Robot selected on HMI -->
	             <IMAGE file="pneutoolrobselok.gif"    col="6" row="3"  visiblevar="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bRobSelOk"         visiblevartype="TT"/>
	             <IMAGE file="pneutoolrobselnok.gif"   col="6" row="3"  visiblevar="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bRobSelNOk"        visiblevartype="TT"/>
	             <LABEL key="pneuTool.label.robsel"    col="1" row="14" halign="left" valign="stretch" rspan="3" cspan="10"
                                                           visiblevar="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bRobSelNOk"                         visiblevartype="TT"/>
	             <!-- No E-Stop, no fire alarm -->
	             <IMAGE file="pneutoolestopok.gif"     col="9" row="2"  visiblevar="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bEStopOK"          visiblevartype="TT"/>
	             <IMAGE file="pneutoolestopnok.gif"    col="9" row="2"  visiblevar="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bEStopNOK"         visiblevartype="TT"/>
	             <LABEL key="pneuTool.label.estop"     col="1" row="14" halign="left" valign="stretch" rspan="3" cspan="10"
                                                           visiblevar="_system.gRcuFocusedRobot.handler.tool.yPneuTool[0].sTeachView.bEStopNOK"                          visiblevartype="TT"/>
	      </GROUP>	                        
           </GROUP>
       </GROUP>
   </MASKDEF>
</VIEW>