Max_Data_Len = 488
;
User_Prm_Data_Len=0
;
; Module-Definitions:
;
; für Module <= 16 Byte:
; bit 7 = konsistent
; bit 6 = ?
; bit 5 = Ausgang
; bit 4 = Eingang
; bit 3-0 = Anzahl Bytes + 1  F=16
;
; für Module > 16 Byte:
; zwei hex-Zahlen
; bit 11 = Ausgang
; bit 10 = Eingang
; bit 9  = ?
; bit 8  = ?
; bit 7  = konsistent
; bit 6-0 = Anzahl Bytes + 1 
;
; Beispiele:
;
;Module = "4 Bytes Eingang" 0x13
;Module = "4 Bytes Eingang konsistent" 0x93
;Module = "32 Bytes Eingang" 0x40,0x1F
;Module = "32 Bytes Eingänge konsistent" 0x40,0x9F
;Module = "4 Bytes Ausgang" 0x23
;Module = "4 Bytes Ausgang konsistent" 0xA3
;Module = "32 Bytes Ausgang" 0x80,0x1F
;Module = "32 Bytes Ausgang konsistent" 0x80,0x9F

; 4Byte Ein/Aus konsistent + 32Byte Ein/Aus konsistent
;MODULE = "BK" 0xB3, 0x40,0x9F, 0x80,0x9F      
;ENDMODULE
