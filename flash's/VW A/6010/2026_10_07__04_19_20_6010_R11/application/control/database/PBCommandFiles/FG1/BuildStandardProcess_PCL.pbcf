SubRoutine PCL_ConfigureTriggerBrush
	SelectNode RPC1.R11.PCU1
	SelectTab [BrushTrigger]
	// ************Set paint relevant devices for PCL*************
//	SelectTab [BrushTriggerSetValuesPaintRelDevices]
	// Set boolean signals for paint relevant devices
	// ************Set trigger devices for PCL*************
	SelectTab [BrushTriggerSetValuesBrushGunTrigger]
	// Set analog signals for paint relevant devices
	NotResetBrushAtEnd AMV2FC.ControlType 0
	BrushSource AMV2FC.ControlType ControlType1
	NotResetBrushAtEnd AMV2FC.SetFlow 0
	BrushSource AMV2FC.SetFlow PaintFlow1
	IdleBrush1Enable AMV2FC.SetFlow 1
	IdleBrush1Value AMV2FC.SetFlow 5
	IdleBrush2Enable AMV2FC.SetFlow 1
	IdleBrush2Value AMV2FC.SetFlow 5
	OverrideEnable AMV2FC.SetFlow 1
	NotResetBrushAtEnd AMV2FC.SetPressure 0
	BrushSource AMV2FC.SetPressure PaintPressure1
	IdleBrush1Enable AMV2FC.SetPressure 1
	IdleBrush1Value AMV2FC.SetPressure 20
	IdleBrush2Enable AMV2FC.SetPressure 1
	IdleBrush2Value AMV2FC.SetPressure 20
	OverrideEnable AMV2FC.SetPressure 1
	NotResetBrushAtEnd AMV2FC.SetPressureOffsetAirFlow 0
	BrushSource AMV2FC.SetPressureOffsetAirFlow OffsetInitialPressure1
	// Set boolean signals for trigger devices (AMV2FC)
	NotResetTriggerAtEnd AMV2FC.OrderSet 0
	SetInverseTrigger AMV2FC.OrderSet 0
Return

SubRoutine PCL_ConfigurePCUCfg
	SelectNode RPC1.R11.PCU1
	// Select tab cfg parameter 
	SelectTab [CfgParameter]
	//************* Enable PotTime cfg group ********************
	// Enable optional cfg group PotTime
	SelectCfg PCU1.PotTime
	OptionalUsed 1
	SelectCfg PCU1.PotTime.Enable
	Value 1
	SelectCfg PCU1.PotTime.UsePcaTimeout
	Value 0
	SelectCfg PCU1.PotTime.AlarmTime
	OptionalUsed 1
	SelectCfg PCU1.PotTime.WarnTime
	OptionalUsed 1
	SelectCfg PCU1.Trigger_Brush.Global.BrushConcept
	Value 1
	SelectCfg PCU1.Releases
	OptionalUsed 1
	// Enable optional cfg group Statistics
	SelectCfg PCU1.Statistics
	OptionalUsed 1
	SelectCfg PCU1.Statistics.DefaultSeamTolerance
	Value 20
	SelectCfg PCU1.Statistics.EnableModulName
	OptionalUsed 1
Return

//**************End routines to set PCL specific PCU properties*************
