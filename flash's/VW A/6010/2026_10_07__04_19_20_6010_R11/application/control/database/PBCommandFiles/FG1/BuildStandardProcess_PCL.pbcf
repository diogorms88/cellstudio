	//Add physical channels to logical main channel
	//*********** Add physical Material2*****************
	SelectNode RPC1.R11.PCU1
	SelectTab [LogicChannelsSupplyGroups]
	SelectLogChannel PCU1.LogMainChannel
	LogChannelAddPhysChannel Material2
	//Parameter 1: Channelgroup or Channelgroup.Channel
	LogChannelPropertyLogMainChannel 0
	LogChannelPropertyOverallStateRelevant 0
Return

SubRoutine PCL_ConfigureLogChannels_Material1
	//Add logical channels
	//*********** Logic Material1***************
	SelectNode RPC1.R11.PCU1
	SelectTab [LogicChannelsSupplyGroups]
	SelectLogChannel PCU1
	AddLogChannel LogMaterial1
	LogChannelDescription Logical channel for material 1
	LogChannelPropertyPaintRelevant 0
	LogChannelPropertyMixedMaterial 0
	//*********** Add physical Material1************************
	SelectLogChannel PCU1.LogMaterial1
	LogChannelAddPhysChannel Material1
	//Parameter 1: Channelgroup or Channelgroup.Channel
	LogChannelPropertyLogMainChannel 0
	LogChannelPropertyOverallStateRelevant 1
Return

SubRoutine PCL_ConfigureLogChannels_Material2
	//Add logical channels
	//*********** Logic Material2***************
	SelectNode RPC1.R11.PCU1
	SelectTab [LogicChannelsSupplyGroups]
	SelectLogChannel PCU1
	AddLogChannel LogMaterial2
	LogChannelDescription Logical channel for material 2
	LogChannelPropertyPaintRelevant 0
	LogChannelPropertyMixedMaterial 0
	//*********** Add physical Material2************************
	SelectLogChannel PCU1.LogMaterial2
	LogChannelAddPhysChannel Material2
	//Parameter 1: Channelgroup or Channelgroup.Channel
