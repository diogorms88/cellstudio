@TL(0)

@@@END_Comment@@@ 

@BEG_Body 
@TL(20)
CASE i_Destination OF
  SFC_InAutomatic     : zTemp:='SFC_InAutomatic';
  SFC_InHand          : zTemp:='SFC_InHand';
  SFC_PotTime         : zTemp:='SFC_PotTime';
END_CASE;

fbSetProtocol(0, 0, "AB_ControlAllSfc.fResetBody", CONCAT(' Destination = ',zTemp,' set mSFCAbort := TRUE (Abort all SFC)'));

CASE i_Destination OF
  
  SFC_InAutomatic:
  
    abSFC_MainChannel.fResetBody(FALSE);
  
  SFC_InHand:
  
    abSFC_MainChannel.fResetBody(TRUE);
  
END_CASE;

@END_Body 

