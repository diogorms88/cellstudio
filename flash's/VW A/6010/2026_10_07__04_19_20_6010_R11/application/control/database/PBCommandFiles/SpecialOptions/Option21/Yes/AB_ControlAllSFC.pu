@BEG_Body 
@TL(17)
mInitDone := F_Version_String(i_zRoot    := cCatRootVersion,
                              i_zPath    := cCatPathVersion,
                              i_zName    := 'AB_ControlAllSFC',
                              i_zVersion := Ag_zVersion);


mInitDone := mInitDone AND abSFC_MainChannel.fInit(i_iLogicalChannelNr  := abChannels.fGetLogChannelsNrOfMainChannel(),
                                                   i_zMyName            := "abSFC_MainChannel");

mInitDone := mInitDone AND abSFC_PostProcess.fInit(i_iLogicalChannelNr     := abChannels.fGetLogChannelsNrOfMainChannel(),
                                                   i_zMyName               := "abSFC_PostProcess",
                                                   i_mEnableAtomizerClean  := TRUE,
                                                   i_mEnableTankDisposal   := FALSE);


fInit := mInitDone;

@END_Body 

