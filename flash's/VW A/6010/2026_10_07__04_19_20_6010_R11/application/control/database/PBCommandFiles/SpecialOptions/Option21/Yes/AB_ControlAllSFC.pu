(*
Version    | ReleaseDate | Respon | Changes
----------------------------------------------------------
v2_01.00.00 | 29.03.2010  |  koi   | tagged as v2_01.00.00; version info is kept in a string var now   
V2_01.01.00 | 07.12.2010  |  BEJ   | fCheckGoOn removed
v2_01.02.00 | 11.03.2011  |  BEJ   | change enum enControlAll (SFC-Handling)
v2_01.03.00 | 12.05.2011  |  PZB   | Add SFC for post processes
V2_01.04.00 | 19.05.2011  |  BEJ   | new paramter i_mCheck in fResetBody
V2_01.05.00 | 19.06.2013  |  KLCH  | Change: replace cIndexLog_LogicChannel1 (main channel) by abChannels.fGetLogChannelsNrOfMainChannel()
V2_02.00.00 | 26.06.2013  |  KLCH  | Change: delete input variables; delete fCheckSfcAbortState
*)

IMPORT_OVER_LISTFILE
 F_Version_String
, Hold
, HandControl
, FreeRun
, SFC_InAutomatic
, SFC_InHand
, SFC_PotTime
, cCatRootVersion
, cCatPathVersion
, AB_Channels
, AB_SFC_MainChannel
, AB_SFC_PostProcess
, FB_SetProtocolAdv
, enControlAll
, enSFC_ControlMode

END_IMPORT

ALGORITHM_BLOCK AB_ControlAllSFC #DUMMY_EDIT_BLOCK

VAR_EXTERNAL
 abChannels : AB_Channels;
 abSFC_MainChannel : AB_SFC_MainChannel;
 abSFC_PostProcess : AB_SFC_PostProcess;
 GV_mInitDone : BOOL;
 fbSetProtocol : FB_SetProtocolAdv;
END_VAR

VAR CONSTANT
 Ag_zVersion : STRING(15) := 'V2_02.00.00';
END_VAR

ALGORITHM fSetControlMode


VAR_INPUT
 i_Destination : enControlAll;
 i_ControlMode : enSFC_ControlMode;
END_VAR

VAR
 zTemp : STRING(255);
 zControlModeProtocol : STRING(255);
END_VAR
#BEGIN_EDIT_BLOCK
CASE i_ControlMode OF
  Hold       : zControlModeProtocol := 'Hold';
  HandControl: zControlModeProtocol := 'HandControl';
  FreeRun    : zControlModeProtocol := 'FreeRun';
ELSE
  zControlModeProtocol := 'Unknown';
END_CASE;

CASE i_Destination OF
  SFC_InAutomatic     : zTemp:='SFC_InAutomatic';
  SFC_InHand          : zTemp:='SFC_InHand';
  SFC_PotTime         : zTemp:='SFC_PotTime';
END_CASE;


CASE i_Destination OF
  
  SFC_InAutomatic:
     abSFC_MainChannel.fSetControlMode(i_ControlMode);
     abSFC_PostProcess.fSetControlMode(i_ControlMode);
  
  SFC_InHand:
     abSFC_MainChannel.fSetControlMode(i_ControlMode);
     abSFC_PostProcess.fSetControlMode(i_ControlMode);
  
END_CASE;

fbSetProtocol(0, 0, "AB_ControlAllSFC.fSetControlMode", CONCAT(" Destination = ", zTemp, ' SFC´s are set on ControlMode : ', zControlModeProtocol));


;#END_EDIT_BLOCK END_ALGORITHM

ALGORITHM fResetBody


VAR_INPUT
 i_Destination : enControlAll;
END_VAR

VAR
 zTemp : STRING(255);
END_VAR
#BEGIN_EDIT_BLOCK
CASE i_Destination OF
  SFC_InAutomatic     : zTemp:='SFC_InAutomatic';
  SFC_InHand          : zTemp:='SFC_InHand';
  SFC_PotTime         : zTemp:='SFC_PotTime';
END_CASE;

fbSetProtocol(0, 0, "AB_ControlAllSfc.fResetBody", CONCAT(' Destination = ',zTemp,' set mSFCAbort := TRUE (Abort all SFC)'));

CASE i_Destination OF
  
  SFC_InAutomatic:
  
    abSFC_MainChannel.fResetBody(FALSE);
  
  SFC_InHand:
  
    abSFC_MainChannel.fResetBody(TRUE);
  
END_CASE;


;#END_EDIT_BLOCK END_ALGORITHM

ALGORITHM Refresh

#BEGIN_EDIT_BLOCK
IF GV_mInitDone THEN
  
  abSFC_MainChannel.BodyRefresh();
  
  abSFC_PostProcess.BodyRefresh();
  
END_IF;


;#END_EDIT_BLOCK END_ALGORITHM

FUNCTION fInit : BOOL
 #DUMMY_EDIT_BLOCK

VAR
 mInitDone : BOOL;
END_VAR
#BEGIN_EDIT_BLOCK
mInitDone := F_Version_String(i_zRoot    := cCatRootVersion,
                              i_zPath    := cCatPathVersion,
                              i_zName    := 'AB_ControlAllSFC',
                              i_zVersion := Ag_zVersion);


mInitDone := mInitDone AND abSFC_MainChannel.fInit(i_iLogicalChannelNr  := abChannels.fGetLogChannelsNrOfMainChannel(),
                                                   i_zMyName            := "abSFC_MainChannel");

mInitDone := mInitDone AND abSFC_PostProcess.fInit(i_iLogicalChannelNr     := abChannels.fGetLogChannelsNrOfMainChannel(),
                                                   i_zMyName               := "abSFC_PostProcess",
                                                   i_mEnableAtomizerClean  := TRUE,
                                                   i_mEnableTankDisposal   := FALSE);


fInit := mInitDone;


;#END_EDIT_BLOCK END_FUNCTION



END_ALGORITHM_BLOCK



#END_OF_IEC_PART

