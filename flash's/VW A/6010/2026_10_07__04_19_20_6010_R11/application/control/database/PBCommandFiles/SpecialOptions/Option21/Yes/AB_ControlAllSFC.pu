@BEG_Body 
@TL(29)
CASE i_ControlMode OF
  Hold       : zControlModeProtocol := 'Hold';
  HandControl: zControlModeProtocol := 'HandControl';
  FreeRun    : zControlModeProtocol := 'FreeRun';
ELSE
  zControlModeProtocol := 'Unknown';
END_CASE;

CASE i_Destination OF
  SFC_InAutomatic     : zTemp:='SFC_InAutomatic';
  SFC_InHand          : zTemp:='SFC_InHand';
  SFC_PotTime         : zTemp:='SFC_PotTime';
END_CASE;


CASE i_Destination OF
  
  SFC_InAutomatic:
     abSFC_MainChannel.fSetControlMode(i_ControlMode);
     abSFC_PostProcess.fSetControlMode(i_ControlMode);
  
  SFC_InHand:
     abSFC_MainChannel.fSetControlMode(i_ControlMode);
     abSFC_PostProcess.fSetControlMode(i_ControlMode);
  
END_CASE;

fbSetProtocol(0, 0, "AB_ControlAllSFC.fSetControlMode", CONCAT(" Destination = ", zTemp, ' SFC´s are set on ControlMode : ', zControlModeProtocol));

@END_Body 

