TYPE GLOBAL USER


//-----------------------------------------------------------------------------
// Symbolic-names for the macro "GET_DEGRADE_MODE"
// maximum 16 Robots allowed
//-----------------------------------------------------------------------------
DEGRADEROB : (

  Robot11               :=  1,
  Robot21               :=  2,
  Robot12		:=  3,
  Robot22		:=  4,
  Robot13		:=  5,
  Robot23               :=  6,
  Robot14               :=  7,
  Robot24		:=  8,
  Robot15		:=  9,
  Robot25		:= 10,
  DoorOpener11          := 11,
  DoorOpener21          := 12,
  DoorOpener12          := 13,
  DoorOpener22          := 14,
  HoodOpener11          := 15,
  HoodOpener21          := 16 );
  


//-----------------------------------------------------------------------------
// Symbolic-names for the macro "GET_VARIANT"
// maximum 32 Variants allowed
// 2012-02-09 : now 64 Variants are possible
//-----------------------------------------------------------------------------
VARIANT : (


  RightHandDrive      :=  1,
  SunRoof             :=  2,
  FourWheelDrive      :=  3,
  Fair_Press          :=  4 );
 


//-----------------------------------------------------------------------------
// Symbolic-names for the macro "GET_REPAIRTYPE"
// maximum 32 Repairtypes allowed (Type 0 = No repairtype is set)
//-----------------------------------------------------------------------------
REPAIRTYPE : (

  NoRepair            :=   0,
  FrontDoor_Int_L     :=   1,
  RearDoor_Int_L      :=   2,
  FrontDoor_Int_R     :=   3,
  RearDoor_Int_R      :=   4,
  Hood_Int            :=   5,
  TrunkLid_Int        :=   6,
  Spare_7             :=   7,
  Spare_8             :=   8,
  Hood_Ext            :=   9,
  Roof_Ext            :=  10,
  Spare_11            :=  11,
  TrunkLid_Ext        :=  12,
  Spare_13            :=  13,
  Spare_14            :=  14,
  Spare_15            :=  15,
  Spare_16            :=  16,
  FrontFender_Ext_L   :=  17,
  FrontDoor_Ext_L     :=  18,
  RearDoor_Ext_L      :=  19,
  RearFender_Ext_L    :=  20,
  Spare_21            :=  21,
  Spare_22            :=  22,
  Spare_23            :=  23,
  Spare_24            :=  24,  
  FrontFender_Ext_R   :=  25,
  FrontDoor_Ext_R     :=  26,
  RearDoor_Ext_R      :=  27,
  RearFender_Ext_R    :=  28,
  Spare_29            :=  29,
  Spare_30            :=  30,
  Spare_31            :=  31,
  Spare_32            :=  32);


//-----------------------------------------------------------------------------
// Symbolic-names for the macro "SET / RECEIVE"
// maximum 16 Collisonbits + Vision allowed      
//-----------------------------------------------------------------------------
IONAME : (

  Collision1                    := 1,  
  Collision2                    := 2,
  Collision3                    := 3,
  Collision4                    := 4,
  Collision5                    := 5,
  Collision6                    := 6,
  Collision7                    := 7,
  Collision8                    := 8,
  Collision9                    := 9,
  Collision10                   := 10,
  Collision11                   := 11,
  Collision12                   := 12,
  Collision13                   := 13,
  Collision14                   := 14,
  Collision15                   := 15,
  Collision16                   := 16,
  VISION                        := 17); 
 
//-----------------------------------------------------------------------------
// Symbolic-names for the macro "SET_VISION"
//-----------------------------------------------------------------------------
VISIONORDER : ( 
  
  //----  1..100 Path number (1..100 to PLC) ----------------------------------
  JobNo_1             :=   1,    //Path number 1 to PLC
  JobNo_2             :=   2,
  JobNo_3             :=   3,
  JobNo_100           := 100,    //Path number 100 to PLC
  
  //----  101..200 Multiobject (1..100 to PLC) --------------------------------
  ReqDataNo_1         := 101,  //Multiobject number 1 to PLC
  ReqDataNo_2         := 102,
  ReqDataNo_3         := 103,
  ReqDataNo_100       := 200,  //Multiobject number 100 to PLC
  
  //----  Don't change 201 ..255, these numbers they're coded -----------------
  SyncRobots          := 250,   //Wait for feedback of PLC to synchronize path correction
  CamPos              := 251,   //Robot is in position to take a picture
  LastCamPos          := 252,   //Robot is in last position of measuring
  NextCamPos          := 253,   //Picture taken release of next position
  VisionData          := 254,   //Displacement values
  ResetData           := 255);  //Delete vision frame
  
//-----------------------------------------------------------------------------
// Symbolic-names for Handler-macro - Type "ROBOT"
// maximum 7 robots allowed
//-----------------------------------------------------------------------------
ROBOT : (
     
   NotUsed        := 0,                   
   UnusedRob1     := 1,
   R12            := 2,
   UnusedRob3     := 3,
   UnusedRob4     := 4,
   R11            := 5,
   UnusedRob6     := 6);
     
//-----------------------------------------------------------------------------
// Symbolic-names for Handler-macro - Type "HANDLER"
// maximum 6 handlers allowed
//-----------------------------------------------------------------------------
HANDLER : (

   ReservedHandler := 0,
   H12             := 1,
   UnusedHan2      := 2,
   D12             := 3,
   D11             := 4,
   UnusedHan5      := 5,
   H21             := 6);

//-----------------------------------------------------------------------------
// Symbolic-names for Handler-macro - Type "PART"
// maximum 9 parts allowed
//-----------------------------------------------------------------------------
PART : ( 

   ReservedPart      := 0,
   FrontHood         := 1,
   FrontDoorL        := 2,
   RearDoorL         := 3,
   FrontDoorR        := 4,
   RearDoorR         := 5,
   RearHood          := 6,
   UnusedPart7       := 7,
   UnusedPart8       := 8);


//-----------------------------------------------------------------------------
// Symbolic-names for Handler-macro - Type "POSITION"
// maximum 9 positions allowed - position 8 is reserved to release high tension
//-----------------------------------------------------------------------------
POSITION : (

   Delete          := 0,
   HalfOpen        := 1,
   FullOpen        := 2,
   HalfClose       := 3,
   FullClose       := 4,
   SparePos5       := 5,
   SparePos6       := 6,
   SparePos7       := 7,
   HandlingOff     := 8);
   
//-----------------------------------------------------------------------------
// Symbolic-names for Handler-macro - SET_CHECK, GET_PART, ...
// maximum 5 units allowed
//-----------------------------------------------------------------------------   
UNIT  : (Unit1, 
         Unit2, 
         Unit3, 
         Unit4, 
         Unit5);   
   
//-----------------------------------------------------------------------------
// Symbolic-names for macros SET_PLC_ORDER and RECEIVE_PLC_STATE
//-----------------------------------------------------------------------------   

PLCORDER : ( 
               M002_Load_UnlockFixingUnit        :=2,
               M003_Load_IPTinWorkpos            :=3,   // Input table
               M004_Load_GripperOn               :=4,
               M005_Load_SetVisionTask1          :=5,
               M006_Load_LockIPT                 :=6,
               M007_Load_UnlockIPT               :=7,
               M008_Load_SetVisionTask_TCP       :=8,
               M009_Load_GripperOnStep2          :=9,
               M010_Check_AirShield              :=10,
               M011_Check_TransportSafety        :=11,
               M012_Check_RoofConvCameraInHome   :=12,

               M019_Unload_IPTinWorkpos          :=19,   // Input table
               M020_Unload_VaccumOffStartBlow    :=20,
               M021_Unload_Step2                 :=21,
               M024_Unload_StopBlow              :=24,
               M025_Unload_MoveCSToHomePos       :=25,

               M033_CLHandling_CLEnabled         :=33,
               M034_CLHandling_AppOk             :=34,
               M035_CLHandling_GoShow            :=35,

               M051_Glue_ActivateBeadCheck       :=51,
               M052_Glue_DeactivateBeadCheck     :=52,
               M053_Glue_BeadCheckState          :=53,
               M054_Glue_BeadCheckEnabled        :=54,
               M055_Glue_GoShow                  :=55,
               M056_Glue_VisionAssemblyEnabled   :=56,

               M065_Assembly_BodyInPos           :=65,
               M066_Assembly_SetVisionTask2      :=66,
               M068_Assembly_VaccumOffStartBlow  :=68,
               M069_Assembly_Step2               :=69,
               M072_Assembly_StopBlow            :=72,
               M074_Assembly_SetVisionTask3      :=74,
               M076_Assembly_GetGlassOutOfCar    :=76,

               M084_Show_WaitPrimer              :=84,
               M085_Show_WaitGlue                :=85,

               M099_Output_OPTinWorkpos          :=99,
               M100_Output_VaccumOffStartBlow    :=100,
               M104_Output_StopBlow              :=104,
               M105_Output_LockOPT               :=105,
               M106_Output_UnlockOPT             :=106,

               M128_CLProc_FeltPresentCheck       :=128,
               M129_CLProc_FeltAttemptsExceeded   :=129,
               M130_CLProc_FeltCycleExceeded      :=130,
               M131_CLProc_Wet_Felt               :=131,
               M132_CLProc_Humidity_OK            :=132,
               M133_CLProc_HandlingRob_inCL_Pos   :=133,
               M134_CLProc_RemoveFelt             :=134,

               M137_CLProc_FeltPresentService     :=137,
               M138_CLProc_FeltPresentGripper     :=138,
               M139_CLProc_FeltHumiAttempts       :=139,

               M231_Vision_CheckCamera1           :=231,
               M232_Vision_CheckCamera2           :=232,
               M233_Vision_CheckCamera3           :=233,
               M234_Vision_CheckCamera4           :=234,
               M235_Vision_CheckCamera5           :=235,
               M236_Vision_CheckCamera6           :=236,
               M237_Vision_CheckCamera7           :=237
);


//-----------------------------------------------------------------------------
// Symbolic-names for SETPROCESSCOMMAND
// 0  - 19   Process commands (IEC)
// 20 - 39   PLC interface (names can be modified by engineering)
// 40 - 99   misc          (names can be modified by engineering)
// 100 - 119 vision system (do not modify these names!!!)
//-----------------------------------------------------------------------------   
COMMAND    : (EndOfBody            :=0, 
              DoSoftPurge          :=1, 
              TurningMaskOn        :=2, 
              TurningMaskOff       :=3, 
              BlowingAirOn         :=4,
              BlowingAirOff        :=5,
              
              GluingPrimerGunOn    :=20,
              GluingPrimerGunOff   :=21,
              PLCTriger2On         :=22,
              PLCTriger2Off        :=23,
              PLCTriger3On         :=24,
              PLCTriger3Off        :=25,
              GluingPrimerPumpOn   :=26,
              GluingPrimerPumpOff  :=27,
              
              BeadCheckOn          :=40,
              BeadCheckOff         :=41,

              // Vision system
              VisionTrigger        :=101,
              LastVisionTrigger    :=102        
);

//-----------------------------------------------------------------------------
// Symbolic-names for SET_PROCESS_ORDER and RECEIVE_PROCESS_STATE
// for command-interface to process
// Do not use command "xyz := 0"
//-----------------------------------------------------------------------------   
ProcessOrder  : (Reset                :=1000,     
                 RunTimeprogSequence  :=1001, //Automatic Sequence to pause painting and start timeprogram
	         RunCircAllMaterials  :=2001, //Automatic Sequence to pause painting and start timeprogram circulation all materials
	         RunCircMaterial1     :=3001, //Automatic Sequence to pause painting and start timeprogram circulation material 1 
	         RunCircMaterial2     :=3002  //Automatic Sequence to pause painting and start timeprogram circulation material 2         
);


//------------------------------------------------------------------------------------
// This structure is needed with label 1504 or higher
// Symbolic-names for Nozzlechanger commands (first nozzle starts with 1 to max=20)
// Please don't delete parameters (NoNozzle:=0)
//------------------------------------------------------------------------------------   
NOZZLE : (
  
  NoNozzle         := 0,
  Nozzle_M09100063 := 1,
  Nozzle_M09100059 := 2,
  Nozzle_M09100060 := 3,
  Nozzle_M09100058 := 4,
  Nozzle_M09100065 := 5,
  Nozzle_M09100066 := 6,
  Nozzle_7         := 7,
  Nozzle_8         := 8,
  Nozzle_9         := 9,
  Nozzle_10        := 10,
  Nozzle_11        := 11,
  Nozzle_12        := 12,
  Nozzle_13        := 13,
  Nozzle_14        := 14,
  Nozzle_15        := 15,
  Nozzle_16        := 16,
  Nozzle_17        := 17,
  Nozzle_18        := 18,
  Nozzle_19        := 19,
  Nozzle_20        := 20);
  
  
  
END_TYPE