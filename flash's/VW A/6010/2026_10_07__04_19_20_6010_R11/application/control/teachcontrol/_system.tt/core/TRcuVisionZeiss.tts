//----------------------------------------------------------------------------------------
// calculate object and correction values for teachview
//----------------------------------------------------------------------------------------
ROUTINE CalcActualObject(corrFrame : TMcuFrame; bMRFlag : BOOL) PRIVATE

VAR
   mRefSysId  : TMcuDbObjID;
   tVmtObject : TMcuTransformation;
   tObject    : TMcuTransformation;
   lCorrFrame : TMcuFrame;
   iLocNr     : INT;
END_VAR

   lCorrFrame := corrFrame;
   RcuRefSysGetMcuId(myRobot.RcuRefSystemObject, tVmtObject.mRefSysID);
   McuCreateTrsf(mRefSysId, tVmtObject);
   IF bMRFlag THEN
      WAIT MAIN_RUN;
   END_IF;
   myRobot.vision.VisionBK.iBkPPNr := iLocNr;
   myRobot.vision.VisionBK.tVmtCorr.X_mm  := lCorrFrame.mPos.mValues[0];
   myRobot.vision.VisionBK.tVmtCorr.Y_mm  := lCorrFrame.mPos.mValues[1];
   myRobot.vision.VisionBK.tVmtCorr.Z_mm  := lCorrFrame.mPos.mValues[2];
   myRobot.vision.VisionBK.tVmtCorr.A_deg := lCorrFrame.mOri.mValues[0];
   myRobot.vision.VisionBK.tVmtCorr.B_deg := lCorrFrame.mOri.mValues[1];
   myRobot.vision.VisionBK.tVmtCorr.C_deg := lCorrFrame.mOri.mValues[2];
   IF McuReadTrsfInWorld(mRefSysId, tObject) THEN
      myRobot.vision.VisionBK.tObjectData.X_mm  := tObject.mFrame.mPos.mValues[0];
      myRobot.vision.VisionBK.tObjectData.Y_mm  := tObject.mFrame.mPos.mValues[1];
      myRobot.vision.VisionBK.tObjectData.Z_mm  := tObject.mFrame.mPos.mValues[2];
      myRobot.vision.VisionBK.tObjectData.A_deg := tObject.mFrame.mOri.mValues[0];
      myRobot.vision.VisionBK.tObjectData.B_deg := tObject.mFrame.mOri.mValues[1];
      myRobot.vision.VisionBK.tObjectData.C_deg := tObject.mFrame.mOri.mValues[2];
   END_IF;

   McuReleaseDbObj(mRefSysId);

END_ROUTINE 



(*******************************************************************************
*
*  TCP/IP Kommunikation
*
*******************************************************************************)

ROUTINE Open(strIpAddress : STRING; remotePort : WORD ) PRIVATE
   VAR
      result : DINT;
   END_VAR
   
   client.tcpConnectionState := stateSckConnecting;
   IF NOT bSimulate THEN
      result := client.GetIPaddressAndOpen( strIpAddress, remotePort);
   ELSE
      result := 0;
   END_IF;
   DebugPrint(eTraceVision, "TCP Client: "+ strIpAddress + " "+STR(remotePort));
   CASE result OF
   0: myRobot.DebugPrint(eTraceVision, "TCP Client: Connect ok"); 
      client.tcpConnectionState := stateSckConnected;

   1: myRobot.DebugPrint(eTraceVision, "TCP Client: Connect not ok - Internal error");    client.tcpConnectionState := stateSckError;         
   2: myRobot.DebugPrint(eTraceVision, "TCP Client: Connect not ok - Socket failed");     client.tcpConnectionState := stateSckError;
   3: myRobot.DebugPrint(eTraceVision, "TCP Client: Connect not ok - Connect failed");    client.tcpConnectionState := stateSckError;
   8: myRobot.DebugPrint(eTraceVision, "TCP Client: Connect not ok - Param error (invalid notification mode or notification handle)");
                                                               client.tcpConnectionState := stateSckError;
   16:myRobot.DebugPrint(eTraceVision, "TCP Client: Connect not ok - Wrong IP address");  client.tcpConnectionState := stateSckError;
   ELSE
      myRobot.DebugPrint(eTraceVision, "TCP Client: Connect not ok - Unknown error");     client.tcpConnectionState := stateSckError;
   END_CASE;

END_ROUTINE


ROUTINE Close() PRIVATE
   VAR
      result : DINT;
   END_VAR
   
   client.tcpConnectionState := stateSckClosing;
   IF NOT bSimulate AND NOT bSimulate THEN
      result := client.Close();
   ELSE
       result := 0;
   END_IF;
   CASE result OF
   0: myRobot.DebugPrint(eTraceVision, "TCP Client: Close ok");                             client.tcpConnectionState := stateSckClosed;
   1: myRobot.DebugPrint(eTraceVision, "TCP Client: Close not ok - Internal error");        client.tcpConnectionState := stateSckError;
   2: myRobot.DebugPrint(eTraceVision, "TCP Client: Close not ok - Socket failed");         client.tcpConnectionState := stateSckError;
   9: myRobot.DebugPrint(eTraceVision, "TCP Client: Close not ok - invalid socket handle"); client.tcpConnectionState := stateSckError;
   ELSE
      myRobot.DebugPrint(eTraceVision, "TCP Client: Close not ok - Unknown error");         client.tcpConnectionState := stateSckError;
   END_CASE;
END_ROUTINE


ROUTINE Send(outData1 : STRING) PRIVATE
   VAR
      result   : DINT;
      data     : ARRAY[1..768] OF BYTE;
      dataLen1 : DINT;
      dataLen2 : DINT;
      dataLen3 : DINT;
      i        : DINT;
      chr      : STRING;
   END_VAR 
   
   myRobot.DebugPrint(eTraceVision, "SEND "+outData1);
   dataLen1 := StrLen(outData1);
   FOR i:= 1 TO dataLen1 DO  
      chr := StrMid(outData1, 1, i);
      data[i] := ORD(chr);     
   END_FOR;
   data[dataLen1+1] := 13; // CR
   data[dataLen1+2] := 10; // LF
   IF NOT bSimulate THEN
      result := client.Send(dataLen1+2, data);
   ELSE
       result := 0;
   END_IF;
  
   CASE result OF
   0: myRobot.DebugPrint(eTraceVision, "TCP Client: Send ok");
   1: myRobot.DebugPrint(eTraceVision, "TCP Client: Send not ok - Internal error");        client.tcpConnectionState := stateSckError;
   2: myRobot.DebugPrint(eTraceVision, "TCP Client: Send not ok - Send error");            client.tcpConnectionState := stateSckError;
   8: myRobot.DebugPrint(eTraceVision, "TCP Client: Send not ok - Param error (invalid notification mode or notification handle)");
   9: myRobot.DebugPrint(eTraceVision, "TCP Client: Send not ok - invalid socket handle"); client.tcpConnectionState := stateSckError;
   ELSE
      myRobot.DebugPrint(eTraceVision, "TCP Client: Send not ok - Unknown error");         client.tcpConnectionState := stateSckError;
   END_CASE;
END_ROUTINE


//-----------------------------------------------------------------------------
// Empfangen der Telegramme über die TCP/IP-Schnittstelle. Ein empfangenes Telegramm
// wird zeilenweise in einen String konvertiert. Der Empfang wird mit der
// Variablen bNotification an die Verarbeitung der Telegramme gemeldet (ReceiveTelegram)
//-----------------------------------------------------------------------------
ROUTINE TcpClientTask(bNotification : BOOL; inData1 : STRING) PRIVATE
VAR
   buf           : ARRAY [1..256] OF BYTE;
   bytesReceived : DINT;
   i             : DINT;
   rv            : DINT;
   lastChr       : BYTE := 0;
END_VAR
   
   WHILE TRUE DO
      // collect
      WAIT NOT bNotification;
      rv := client.Receive(255, buf, bytesReceived);
      myRobot.DebugPrint(eTraceVision, "TCP client 1 : bytesReceived = " + STR(bytesReceived));
      IF rv <> 0 THEN
          myRobot.DebugPrint(eTraceVision, "TCP client: Server disconnected");
          client.tcpConnectionState := stateSckClosed;
          RETURN;
      END_IF;

      i := 1;
      WHILE (i < bytesReceived) DO
         IF lastChr <> 0 THEN
            inData1 := CHR(lastChr);
         ELSE
            inData1 := "";
         END_IF;
//         WHILE ((buf[i] <> 10) OR ( i <= 1))  DO // LF Zeilenende
         WHILE ((buf[i] <> 10))  DO // LF Zeilenende
            myRobot.DebugPrint(eTraceVision, " inData1 buf[" + STR(i) + "] = " + STR(buf[i]));
            IF (buf[i] <> 13) THEN
               inData1 := inData1 +  CHR(buf[i]);
            END_IF;
//            inData1 := inData1 +  CHR(buf[i]);
            i := i + 1;
            IF (i > bytesReceived) THEN
               rv := client.Receive(255, buf, bytesReceived);
               myRobot.DebugPrint(eTraceVision, "TCP client 2: bytesReceived = " + STR(bytesReceived));
               IF rv <> 0 THEN
                   myRobot.DebugPrint(eTraceVision, "TCP client: Server disconnected");
                   client.tcpConnectionState := stateSckClosed;
                   RETURN;
               END_IF;
               i := 1;
            END_IF;
         END_WHILE;
         i := i+1;
         myRobot.DebugPrint(eTraceVision, "TCP client: next line = " + inData1);
         bNotification := TRUE;
         WAIT NOT bNotification;
         IF (i = bytesReceived) THEN
            myRobot.DebugPrint(eTraceVision, "lastchr buf[" + STR(i) + "] = " + STR(buf[i]));
            lastChr := buf[i];
            rv := client.Receive(255, buf, bytesReceived);
            myRobot.DebugPrint(eTraceVision, "TCP client 3: bytesReceived = " + STR(bytesReceived));
            IF rv <> 0 THEN
                myRobot.DebugPrint(eTraceVision, "TCP client: Server disconnected");
                client.tcpConnectionState := stateSckClosed;
                RETURN;
            END_IF;
            i := 1;
         ELSE
            lastChr := 0;
         END_IF;
      END_WHILE;
      
      //bNotification := TRUE;
   END_WHILE;
END_ROUTINE


(*******************************************************************************
*
*  Decodieren der Telegramme
*
*******************************************************************************)


(*-----------------------------------------------------------------------------
* Liest den Wert des Attributs "attr" im Telegramm InData1
* ab der Position p  in Indata1. Der Wert wird als String in val zurueckgegeben.
*)
ROUTINE ReadAttribute(CONST attr : STRING; CONST InData1 : STRING;  val :STRING; 
                      OPTIONAL CONST p : DINT ) : BOOL PRIVATE
VAR
   s  : STRING;
   s1 : STRING;
   s2 : STRING;
   p1 : DINT;
   p2 : DINT;
   p3 : DINT;
END_VAR
   
   s :=attr +" ";
   myRobot.DebugPrint(eTraceVision, "ReadAttribute " + s);
   p1 := StrFind(InData1, s, p);
   IF (p1 > 0) THEN
      p1 := StrFind(InData1, s, p);
      p2 := StrFind(InData1, "}", p1);
      p3 := StrFind(InData1, ",", p1);
      IF (p2 = 0) AND (p3 = 0) THEN
         RETURN FALSE;
      END_IF;
      p1 := p1 + StrLen(s);
      IF (p3 < p2) AND (p3 <> 0) THEN
         p2 := p3;
      END_IF;
      val  := StrMid(InData1, p2-p1, p1);
      RETURN TRUE;
   ELSE
      RETURN FALSE;
   END_IF;
   
END_ROUTINE

(*-----------------------------------------------------------------------------
* Liest den Wert des Elements "elem" im Telegramm InData1.
* Der Wert wird als String in val zurueckgegeben. 
*)
ROUTINE ReadElement(CONST elem : STRING; InData1 : STRING; val :STRING) : BOOL PRIVATE
VAR
   s  : STRING;
   s1 : STRING;
   s2 : STRING;
   p1 : DINT;
   p2 : DINT;
   l  : DINT;
END_VAR
   
   s := elem;
   IF (StrFind(InData1, s) > 0) THEN
      p1 := StrFind(InData1, s) + StrLen(s);
      p2 := StrFindRight(InData1, " ");
      IF (p2 <> 0) THEN
         p1 := p2;
      END_IF;
      val  := StrMid(InData1, StrLen(InData1)-p1, p1+1);
      RETURN TRUE;
   ELSE
      RETURN FALSE;
   END_IF;
   
END_ROUTINE


(*-----------------------------------------------------------------------------
* Liest den Status im Telegramm InData1.
* Der Wert wird als String in val zurueckgegeben. 
*)
ROUTINE ReadStatus(InData1 : STRING; val :STRING) : BOOL PRIVATE
VAR
   s  : STRING;
   s1 : STRING;
   s2 : STRING;
   p1 : DINT;
   p2 : DINT;
   l  : DINT;
END_VAR
   
   l := StrLen(InData1);
   IF (StrFind(InData1, ",") > 0) THEN
      p1 := StrFind(InData1,",");
      p2 := StrFind(InData1, ",", p1+1);
      IF (p2 <> 0) THEN
         val := StrMid(InData1, p2-p1-1, p1+1);
      ELSE
         val := StrMid(InData1, l-p1, p1+1);
      END_IF;
      RETURN TRUE;
   ELSE
      RETURN FALSE;
   END_IF;
   
END_ROUTINE

ROUTINE ReadValues(InData1 : STRING; iNrValues : INT; arValues : R16) : BOOL PRIVATE
VAR
   s  : STRING;
   s1 : STRING;
   s2 : STRING;
   p1 : DINT;
   p2 : DINT;
   l  : DINT;
   j  : INT;
END_VAR

   l := StrLen(InData1);
   j := 0;
   p1 := StrFind(InData1,",");
   p2 := StrFind(InData1, ",", p1+1);
   IF p2 = 0 THEN
      iNrValues := 0;
      RETURN FALSE;
   END_IF;
   WHILE (StrFind(InData1, ",", p1+1)<>0) DO
      p1 := StrFind(InData1, ",", p1+1);
      p2 := StrFind(InData1, ",", p1+1);
      IF (p2 <> 0) THEN
         s2 := StrMid(InData1, p2-p1-1, p1+1);
      ELSE
         s2 := StrMid(InData1, l-p1, p1+1);
      END_IF;
      j := j+1;
      arValues[j] := StrToReal(s2);
   END_WHILE;
   iNrValues := j;
   RETURN TRUE;
END_ROUTINE
(*
   // erste Position von String s2 in String s1, ab Position p, 0 wenn nicht
   // vorhanden
   StrFind : ROUTINE (CONST s1 : STRING; CONST s2 : STRING;
      OPTIONAL CONST p : DINT) : DINT := MAPX("TC/String/StrFind");

   // l Zeichen beginnend ab Position p
   StrMid : ROUTINE (CONST s : STRING; CONST l : DINT; CONST p : DINT)
      : STRING := MAPX("TC/String/StrMid");
*)


(*-----------------------------------------------------------------------------
* Liest die Framedaten X, Y, Z, A, B, C aus dem Element "name" im Telegramm 
* Der Wert wird als FRAME in val zurueckgegeben. 
*)
ROUTINE ReadFrame(CONST name : STRING; CONST InData1 : STRING; val : FRAME) : BOOL PRIVATE
VAR
   s  : STRING;
   s1 : STRING;
   s2 : STRING;
   p1 : DINT;
   p2 : DINT;
   l  : DINT;
END_VAR
   
      p1 := 1;
      IF ReadAttribute("X", InData1, s, p1) THEN
         val.X := StrToReal(s);
      END_IF;
      IF ReadAttribute("Y", InData1, s, p1) THEN
         val.Y := StrToReal(s);
      END_IF;
      IF ReadAttribute("Z", InData1, s, p1) THEN
         val.Z := StrToReal(s);
      END_IF;
      IF ReadAttribute("A", InData1, s, p1) THEN
         val.A := StrToReal(s);
      END_IF;
      IF ReadAttribute("B", InData1, s, p1) THEN
         val.B := StrToReal(s);
      END_IF;
      IF ReadAttribute("C", InData1, s, p1) THEN
         val.C := StrToReal(s);
      END_IF;

      RETURN TRUE;
   
END_ROUTINE

(*-----------------------------------------------------------------------------
* Testausgabe
*)
ROUTINE PrintFrame(val : FRAME) PRIVATE
   myRobot.DebugPrint(eTraceVision, "  X = "+STR(val.X));
   myRobot.DebugPrint(eTraceVision, "  Y = "+STR(val.Y));
   myRobot.DebugPrint(eTraceVision, "  Z = "+STR(val.Z));
   myRobot.DebugPrint(eTraceVision, "  A = "+STR(val.A));
   myRobot.DebugPrint(eTraceVision, "  B = "+STR(val.B));
   myRobot.DebugPrint(eTraceVision, "  C = "+STR(val.C));
END_ROUTINE


(******************************************************************************
* systemroutines
*)


ROUTINE NEW()

   instId := RcuGetInstanceId(); // instance identification number (for alarms)

END_ROUTINE

(******************************************************************************
* systemroutine - kinematic is released by RDESELECT
******************************************************************************)
ROUTINE RELEASE()
VAR
   corrFrame : TMcuFrame;
   timeOut   : BOOL;
END_VAR


   IF myRobot.bReleaseBlockedByHandler THEN   
      myRobot.DebugPrint(eTraceVision, "TRcuVisionZeiss.RELEASE: not executed - releaseBlockedByHandler");
   ELSE
       corrFrame.mFrameTyp := eMcuFrameKardan;
       corrFrame.mPos.mValues[0] := 0.0;
       corrFrame.mPos.mValues[1] := 0.0;
       corrFrame.mPos.mValues[2] := 0.0;
       corrFrame.mOri.mValues[0] := 0.0;
       corrFrame.mOri.mValues[1] := 0.0;
       corrFrame.mOri.mValues[2] := 0.0;
       bFrameReadMR      := FALSE;
       bReleaseMR        := FALSE;
       bTriggerPending   := FALSE;
       bXYZReadMR        := FALSE;
       bCorrMatrixReadMR := FALSE;
       bCommError := FALSE;
       
       bCorrActive := FALSE;
       
       IF FileHandle <> 0 THEN
         StreamClose(FileHandle);                    //close file
         FileHandle := 0;
       END_IF;


       RcuRefSysSetKardan(myRobot.RcuRefSystemObject, corrFrame, myRobot.RcuRefSystemVisionRel, FALSE, "Object");
       myRobot.homing.StoreRefSystemVision(FALSE, corrFrame);
       CalcActualObject(corrFrame, FALSE);
       IF IS_MAPPED(myRobot.fieldbusOut.VisionError.svBool) THEN
          myRobot.fieldbusOut.VisionError.svBool := FALSE;
       END_IF;
       IF bActive THEN
          SysTimerSet(1000, timeOut);
          bConnect := FALSE;
          WAIT NOT bActive OR timeOut;
          IF timeOut THEN
             myRobot.DebugPrint(eTraceVision, "TRcuVisionZeiss.RELEASE: timeOut bei Close TCP/IP");
          END_IF;
       END_IF;
   END_IF;
END_ROUTINE

