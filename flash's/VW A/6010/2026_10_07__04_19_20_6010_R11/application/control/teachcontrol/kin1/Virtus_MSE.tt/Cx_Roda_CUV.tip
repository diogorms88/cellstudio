RSELECT("R11")
  //
  SETOBJECT(Virtus_Isra)
  SETTOOL(GUN_2_75_MSE)
  //
  VEL(V1000)
  ACC(A5500)
  OVERLAP(NODEC10)
  //
  SETTOOL(GUN_1_75_MSE)
  //
  LIN(P1)
  SETBRUSH(GUN1, 104, PT1, TR1)
  //
  //Collision centro assoalho R11 - R21
  //
  VEL(V1000)
  LIN(P2)
  GUN(GUN1, GunOn, PT2, TR2)
  LIN(P3)
  LIN(P4)
  GUN(GUN1, GunOff, PT3, TR3)
  LIN(P5)
  //
  //BIT COLLISION R11/R21
  SET(Collision3, High)
  RECEIVE(Collision3, High)
  //
  LIN(P6)
  GUN(GUN1, GunOn, PT4, TR4)
  LIN(P7)
  LIN(P8)
  GUN(GUN1, GunOff, PT5, TR5)
  LIN(P9)
  //
  PTP(P85)
  //
  //BIT COLLISION R11/R21
  SET(Collision3, Low)
  //
  //BIT COLLISION R11/R21
  SET(Collision1, Low)
  //
RDESELECT("R11")
