//  -------------------------------------------------------------------------------------
//  v2_01.00.00  | 30.09.2013  | STL    | First release
//  v2_01.01.00  | 28.01.2014  | SMOH   | Combine LASD Options 27 and 18 + Option14(BMV1T)--> Option27 + Busmaster--> Option14
//  v2_01.02.00  | 28.04.2014  | KLCH   | Bugfix: correction of Option14 (export for HMI not ok)
//  v2_01.03.00  | 12.09.2014  | KLCH   | Change: adaptions for new type T004 of ATC; move SubRoutines to CommonTempControl
//  v2_01.04.00  | 21.11.2016  | KLCH   | Change: redesign

Imports Common CommonTempControl

Parameter Option14 TempHE

Call Main_TempHE
// Select tab VariantConfiguration again
SelectNode RPC1.R11
SelectTab [VariantConfiguration]
END

SubRoutine Main_TempHE
	Call TempHE_AddDeviceToMaterial1
Return

SubRoutine TempHE_AddDeviceToMaterial1
	IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].Material1.ATC1
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].Material1.ATC1
		Delete
	Endif
	SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].Material1
	SelectCase TempHE
		Case 1
			Call Common_AddDevice_ATC1
//		CaseElse
//			FSCopy ..\SpecialOptions\TempHE_Sercos3\No\profinetslave.cfgr ..\..\..\..\..\application\control\config
	EndSelect
	
	IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].Material1.ATC1
		
		Call CommonTempCtrl_SetConfigMaterial1_AMatManager1
		
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].Material1.ATC1
		SelectCase Option14 // Variant of bus system
			Case SercosIII	//With sercos III single is connected to PLC
				SelectTab [HWSignals]
				SelectHWSignal HWI_bATC1_ActRegRatio
	  			BusType 1 //Profibus-DP
	  			Vendor  7 //Single
	  			Card    1 //Input module - ???
				SelectTab [HWSignals]
				SelectHWSignal HWI_wATC1_ActTemp
	  			BusType 1 //Profibus-DP
	  			Vendor  7 //Single
	  			Card    1 //Input module - ???
				SelectTab [HWSignals]
				SelectHWSignal HWO_wATC1_SetTemp
	  			BusType 1 //Profibus-DP
	  			Vendor  7 //Single
	  			Card    1 //Output module - ???
				
//				FSCopy ..\SpecialOptions\TempHE_Sercos3\Yes\profinetslave.cfgr ..\..\..\..\..\application\control\config
	  			Message Signals for ATC1 have to be added to profinetslave.cfgr
				
			Case Profibus
				SelectTab [HWSignals]
				SelectHWSignal HWI_bATC1_ActRegRatio
	  			BusType 1 //Profibus-DP
	  			Vendor  7 //Single
	  			Card    1 //Input module - ???
				SelectTab [HWSignals]
				SelectHWSignal HWI_wATC1_ActTemp
	  			BusType 1 //Profibus-DP
	  			Vendor  7 //Single
	  			Card    1 //Input module - ???
				SelectTab [HWSignals]
				SelectHWSignal HWO_wATC1_SetTemp
	  			BusType 1 //Profibus-DP
	  			Vendor  7 //Single
	  			Card    1 //Output module - ???
	  			
//				FSCopy ..\SpecialOptions\TempHE_Sercos3\No\profinetslave.cfgr ..\..\..\..\..\application\control\config
	  			
			CaseElse
				Message Wrong bus master (ATC1)!! Only Profibus and Sercos III supported
		EndSelect
	Endif
Return