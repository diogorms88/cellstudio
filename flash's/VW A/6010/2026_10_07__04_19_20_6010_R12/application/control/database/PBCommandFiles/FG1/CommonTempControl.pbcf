				Card    2 //Analog input current - 6ES7 134-4GB01-0AB0
			CaseElse
				Message Wrong bus master !! Only Profibus and Sercos III supported (CommonTempCtrl_ConfigureMaterial1_ATCP1_1)
		EndSelect
	Endif
Return

