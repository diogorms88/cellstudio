SubRoutine CommonTempCtrl_SetConfigMaterial1_AMatManager1
	IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].Material1.AMatManager1
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].Material1.AMatManager1
		SelectTab [CfgParameter]
		SelectCfg AMatManager1.Temperature
		OptionalUsed 1
		SelectCfg AMatManager1.Temperature.ControlParam
		OptionalUsed 1
		SelectCfg AMatManager1.Temperature.MonitorStatic
		OptionalUsed 1
		SelectCfg AMatManager1.Temperature.SampleRate
		OptionalUsed 1
		SelectCfg AMatManager1.Temperature.TimeGunOn
		OptionalUsed 1
	Endif
Return

