//  v2_01.00.00  | 12.09.2013  | KLCH   | First release
//  v2_01.01.00  | 21.11.2016  | KLCH   | AddOn: new TempHeatZone9; EcoTemp PT
//  v2_01.02.00  | 31.01.2017  | KLCH   | Change: configuration of EcoTemp PT
//  v2_01.03.00  | 28.09.2017  | KLCH   | Bugfix: correction of case-selection

// Script includes all SubRoutines for common use of temperature control units

Parameter Option1 Option2 Option14 EcoTempAxis1 EcoTempAxis3 TempHeatZone1 TempHeatZone2 TempHeatZone3 TempHeatZone4 TempHeatZone5 TempHeatZone6 TempHeatZone7 TempHeatZone8 TempHeatZone9

SubRoutine CommonTempCtrl_MatHeater
	Call CommonTempCtrl_DeviceOnMaterial1_AMH1
Return

SubRoutine CommonTempCtrl_DeviceOnMaterial1_AMH1
	IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].Material1.AMH1
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].Material1.AMH1
		Delete
	Endif
	
	SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].Material1
	SelectCase TempHeatZone1
		Case 1
			Call Common_AddDevice_AMH1
		CaseElse
			SelectCase TempHeatZone2
				Case 1
					Call Common_AddDevice_AMH1
				CaseElse
					SelectCase TempHeatZone3
						Case 1
							Call Common_AddDevice_AMH1
						CaseElse
							SelectCase TempHeatZone4
								Case 1
									Call Common_AddDevice_AMH1
								CaseElse
									SelectCase TempHeatZone5
										Case 1
											Call Common_AddDevice_AMH1
										CaseElse
											SelectCase TempHeatZone6
												Case 1
													Call Common_AddDevice_AMH1
												CaseElse
													SelectCase TempHeatZone7
														Case 1
															Call Common_AddDevice_AMH1
														CaseElse
															SelectCase TempHeatZone8
																Case 1
																	Call Common_AddDevice_AMH1
																CaseElse
																	SelectCase TempHeatZone9
																		Case 1
																			Call Common_AddDevice_AMH1
																	EndSelect
															EndSelect
													EndSelect
											EndSelect
									EndSelect
							EndSelect
					EndSelect
			EndSelect
	EndSelect
Return

SubRoutine CommonTempCtrl_TempCtrlSupply
	SelectCase Option1 // Process type
		Case EcoDose_ES
			Call CommonTempCtrl_DeviceOnMaterial1_ATCP1
		Case EcoDose_PM
			Call CommonTempCtrl_DeviceOnMaterial1_ATCP1
		Case EcoDose_PCL
			Call CommonTempCtrl_DeviceOnMaterial1_ATCP1
		Case EcoDose_PCL_PCL
			Call CommonTempCtrl_DeviceOnMaterial1_ATCP1_1
			Call CommonTempCtrl_DeviceOnMaterial2_ATCP1_2
		Case EcoDose_SM_PCL
			Call CommonTempCtrl_DeviceOnMaterial1_ATCP1_1
			Call CommonTempCtrl_DeviceOnMaterial2_ATCP1_2
		Case EcoDose_SM_SM
			Call CommonTempCtrl_DeviceOnMaterial1_ATCP1_1
			Call CommonTempCtrl_DeviceOnMaterial2_ATCP1_2
		Case EcoDose_SM
			Call CommonTempCtrl_DeviceOnMaterial1_ATCP1
		CaseElse
			Message Wrong process type !! (CommonTempCtrl_TempCtrlSupply)
	EndSelect
Return

SubRoutine CommonTempCtrl_DeviceOnMaterial1_ATCP1
	IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].Material1.ATCP1
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].Material1.ATCP1
		Delete
	Endif
	
	SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].Material1
	SelectCase EcoTempAxis1
		Case No_EcoTempAxis1
			SelectCase EcoTempAxis3
				Case No_EcoTempAxis3
				CaseElse
					Call Common_AddDevice_Supply_ATCP1
					Call CommonTempCtrl_ConfigureMaterial1_ATCP1
			EndSelect
		CaseElse
			Call Common_AddDevice_Supply_ATCP1
			Call CommonTempCtrl_ConfigureMaterial1_ATCP1
	EndSelect
Return

SubRoutine CommonTempCtrl_DeviceOnMaterial1_ATCP1_1
	IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].Material1.ATCP1_1
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].Material1.ATCP1_1
		Delete
	Endif
	
	SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].Material1
	SelectCase EcoTempAxis1
		Case No_EcoTempAxis1
			SelectCase EcoTempAxis3
				Case No_EcoTempAxis3
				CaseElse
					Call Common_AddDevice_Supply_ATCP1_1
					Call CommonTempCtrl_ConfigureMaterial1_ATCP1_1
			EndSelect
		CaseElse
			Call Common_AddDevice_Supply_ATCP1_1
			Call CommonTempCtrl_ConfigureMaterial1_ATCP1_1
	EndSelect
Return

SubRoutine CommonTempCtrl_DeviceOnMaterial2_ATCP1_2
	IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].Material2.ATCP1_2
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].Material2.ATCP1_2
		Delete
	Endif
	
	SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].Material2
	SelectCase EcoTempAxis1
		Case No_EcoTempAxis1
			SelectCase EcoTempAxis3
				Case No_EcoTempAxis3
				CaseElse
					Call Common_AddDevice_Supply_ATCP1_2
					Call CommonTempCtrl_ConfigureMaterial2_ATCP1_2
			EndSelect
		CaseElse
			Call Common_AddDevice_Supply_ATCP1_2
			Call CommonTempCtrl_ConfigureMaterial2_ATCP1_2
	EndSelect
Return

SubRoutine CommonTempCtrl_ConfigureMaterial1_ATCP1
	IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].Material1.ATCP1
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].Material1.ATCP1
		SelectTab [CfgParameter]
		SelectCfg ATCP1.ControlMode
		Value 2
		
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].Material1.ATCP1
		SelectCase Option14 // Variant of bus master
			Case SercosIII
				SelectTab [HWSignals]
				SelectHWSignal HWO_wATCP1_SetCurrent
				BusType 6 //Sercos III
				Vendor  2 //Phoenix Contact
				Card    1 //Analog output current - 28 61 31 5
				SelectHWSignal HWI_wATCP1_ActVoltage
				BusType 6 //Sercos III
				Vendor  2 //Phoenix Contact
				Card    1 //Analog input current/voltage
			Case Profibus
				SelectTab [HWSignals]
				SelectHWSignal HWO_wATCP1_SetCurrent
				BusType 1 //Profibus-DP
				Vendor  1 //Siemens
				Card    2 //Analog output current - 6ES7 135-4GB01-0AB0
				SelectHWSignal HWI_wATCP1_ActVoltage
				BusType 1 //Profibus-DP
				Vendor  1 //Siemens
				Card    2 //Analog input current - 6ES7 134-4GB01-0AB0
			CaseElse
				Message Wrong bus master !! Only Profibus and Sercos III supported (CommonTempCtrl_ConfigureMaterial1_ATCP1)
		EndSelect
	Endif
Return

