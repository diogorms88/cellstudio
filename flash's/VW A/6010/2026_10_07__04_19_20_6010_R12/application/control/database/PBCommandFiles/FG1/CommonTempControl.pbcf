SubRoutine CommonTempCtrl_SetConfigMaterial1_EcoTempPT
	IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].Material1.ATCP1_WT12
		SelectCase EcoTempAxis3	//Peltier type
			Case No_EcoTempAxis3
				SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].Material1.ATCP1_WT12
				SelectTab [CfgParameter]
				SelectCfg ATCP1_WT12.MasterOrder
				Value 1
			CaseElse
				SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].Material1.ATCP1_WT12
				SelectTab [CfgParameter]
				SelectCfg ATCP1_WT12.MasterOrder
				Value 2
		EndSelect
	Endif
	IfNodeExists RPC1.R11.PCU1.[ChannelsChannelgroups].Material1.ATCP1_WT51
		SelectNode RPC1.R11.PCU1.[ChannelsChannelgroups].Material1.ATCP1_WT51
		SelectTab [CfgParameter]
		SelectCfg ATCP1_WT51.MasterOrder
		Value 1
	Endif
Return

