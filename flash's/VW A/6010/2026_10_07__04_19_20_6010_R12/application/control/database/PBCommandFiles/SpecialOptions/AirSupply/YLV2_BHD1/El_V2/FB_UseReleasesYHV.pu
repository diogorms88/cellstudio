(*
Version     | ReleaseDate  | Respon | Changes
----------- ------------------------------------------------
V2_01.00.00 | 04.11.2010   |  PZB   | First release
V2_01.01.00 | 25.01.2012   |  STL   | If a nozzle exchanger is used the valve YLV1 is replaced by YLV2
V2_01.02.00 | 23.10.2015   |  RHI   | Change: Changed LV1/2 from AB_Valve_T001 to AB_MainValve_T001
V2_01.03.00 | 08.12.2016   |  KLCH  | Change: BLV1 from AB_Initiator_T001 to AB_Initiator_T007


<Functional description>
Switch on air supply (YLV1) with ...Internal.PreReleaseSetValueAirSupply
before all other process devices (LL1,LL2,turbine speed e.g) 
will be switched on.
After pressure initiator BLV1 gets 'TRUE' (FB_Interlocks) give the
release for all other process devices (AB_Releases).
<End functional description> 

*)

IMPORT_OVER_LISTFILE
 Nobody
, nReleasesOut
, tsGenSysCfg
, tsReleases
, AB_Channels
, FB_SetProtocolAdv
, AB_MainValve_T001
, AB_Initiator_T007

END_IMPORT

FUNCTION_BLOCK FB_UseReleasesYHV #DUMMY_EDIT_BLOCK

SYSTEM_VAR
 SV_sGeneralSystemCfg : tsGenSysCfg;
END_VAR

VAR_EXTERNAL
 GV_mInitDone : BOOL;
 GV_sReleases : tsReleases;
 abChannels : AB_Channels;
 fbSetProtocol : FB_SetProtocolAdv;
 abYLV1 : AB_MainValve_T001;
 abYLV2 : AB_MainValve_T001;
 abBLV1 : AB_Initiator_T007;
END_VAR

VAR
 iChannel : INT;
 mFirst : BOOL;
 mYLV1_Set : BOOL;
 mYLV1_Set_old : BOOL;
END_VAR
#BEGIN_EDIT_BLOCK
IF GV_mInitDone THEN

  IF (NOT mFirst) THEN
    mFirst := TRUE;
    // get iChannel only once
    iChannel :=  abYLV1.fGet_ChannelNr();
    // if a nozzle exchanger is used
       iChannel :=  abYLV2.fGet_ChannelNr();
  END_IF;
  
  IF GV_sReleases.sReleases.Internal.PreReleaseSetValueAirSupply
     AND 
     (NOT abChannels.fGetChannelAnyError(i_iChannelIdx:=iChannel))
     AND
     abChannels.fGetChannelEnabled(i_iChannelIdx:=iChannel)
     AND
     (abChannels.fGetChannelReservedBy(iChannel) = Nobody)
     AND NOT abYLV1.fGet_Interlock()
     // if a nozzle exchanger is used
        AND NOT abYLV2.fGet_Interlock()
  THEN
    // If no release and no error flag is on the channel write InterlocksOut to ReleasesOut 
     abYLV1.aSetDev_Set(i_mValue      := TRUE,
                        i_nSignalNode := nReleasesOut);
     // if a nozzle exchanger is used
       abYLV2.aSetDev_Set(i_mValue      := TRUE,
                          i_nSignalNode := nReleasesOut);
  END_IF;
 
  mYLV1_Set := abYLV1.fGetDevSet_Set(i_nSignalNode:= nReleasesOut);
 // if a nozzle exchanger is used
   mYLV1_Set := abYLV2.fGetDevSet_Set(i_nSignalNode:= nReleasesOut);

  //***** set feedback air supply in simulation and set protocol entries when device is switched ******* 
  IF SV_sGeneralSystemCfg.mSimulateProcess THEN

    IF mYLV1_Set AND NOT mYLV1_Set_old THEN
    
      abBLV1.aSet_SimValue(i_mValue:=TRUE); 
      fbSetProtocol(Ident    := 1,
                    BodyID   := 0,
                    Location := 'FB_UseReleasesYHV',
                    Message  := 'Set feedback air supply in simulation');
     
    ELSIF mYLV1_Set_old AND NOT mYLV1_Set THEN
       
      abBLV1.aSet_SimValue(i_mValue:=FALSE); 
      fbSetProtocol(Ident    := 1,
                    BodyID   := 0,
                    Location := 'FB_UseReleasesYHV',
                    Message  := 'Reset feedback air supply in simulation');
    END_IF;
    
  ELSE  // set protocol entries in real mode when valve is switched
   
    IF mYLV1_Set AND NOT mYLV1_Set_old THEN
     
      fbSetProtocol(Ident    := 1,
                    BodyID   := 0,
                    Location := 'FB_UseReleasesYHV',
                    Message  := 'Rising edge of switch on YLV1');
     
    ELSIF mYLV1_Set_old AND NOT mYLV1_Set THEN
     
      fbSetProtocol(Ident    := 1,
                    BodyID   := 0,
                    Location := 'FB_UseReleasesYHV',
                    Message  := 'Falling edge of switch on YLV1');
     
    END_IF;
      
  END_IF;
  
  mYLV1_Set_old := mYLV1_Set;

END_IF; // GV_mInitDone


;#END_EDIT_BLOCK END_FUNCTION_BLOCK



#END_OF_IEC_PART

