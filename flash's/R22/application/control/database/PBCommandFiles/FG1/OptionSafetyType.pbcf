Imports Common

Parameter SafetyType

Call Main_SafetyType
END

SubRoutine Main_SafetyType
	SelectCase SafetyType // Variant of safety type
		Case SafeRobotics
			Call Common_Enable_SCP_Fixpos
		CaseElse
			Call Common_Disable_SCP_Fixpos
	EndSelect
Return
