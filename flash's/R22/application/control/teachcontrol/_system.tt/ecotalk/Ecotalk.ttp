ROUTINE CALC_TOOL_OFFSET(Org : TOOL; Dir : TOOLDIR; Offset : REAL; Result : TOOL) GLOBAL USER { macro="GEOMETRIC"}
   VAR
     elem        : TRcuKinListElem; // element with the kinematicreference
     OffsetFrame : TMcuFrame;
   END_VAR
   
   IF RcData.CheckKin(elem, "CALC_TOOL_ZOFFSET") THEN
      DebugPrint(eTraceVision, "CALC_TOOL_OFFSET Dir=" + STR(Dir) + " " + Org.GetName() + " X=" + STR(Org.X_mm) + " Y=" + STR(Org.Y_mm) + " Z=" + STR(Org.Z_mm));
      OffsetFrame.mPos.mValues[Dir] := Offset; 
      RcuCalcTool(elem.kin, Org, OffsetFrame, Result);
   END_IF;

END_ROUTINE


ROUTINE CALC_DISPLACED_POINT(VAR_IN SubSystemType  : TVisionSubSystemType;
                            Org                   : POINT;                      
                            Result                : POINT;
                            iRetVal               : VISION_STATE)  : BOOL GLOBAL USER { macro="OTHER" | enable="_system.gRcuFocusedRobot.vision.bUseExtendedInterface"}
   VAR
      elem : TRcuKinListElem; // element with the kinematicreference
   END_VAR
   
   IF RcData.CheckKin(elem, "CALC_DISPLACED_POINT") THEN	
      RETURN elem.kin.vision.MacroCalcPointDisplacement(SubSystemType, Org, Result, iRetVal);
   END_IF;
   RETURN FALSE;
END_ROUTINE


ROUTINE CALC_TRANSFORMED_POINT(Org                   : POINT;                      
                               Result                : POINT;
                               Frame                 : FRAMESHIFT)  : BOOL GLOBAL USER { macro="OTHER"}
   VAR
      elem : TRcuKinListElem; // element with the kinematicreference
   END_VAR
   
   IF RcData.CheckKin(elem, "CALC_TRANSFORMED_POINT") THEN	
      RETURN MacroCalcTransformedPoint(elem.kin, Org, Result, Frame);
   END_IF;
   RETURN FALSE;
END_ROUTINE


ROUTINE MacroCalcTransformedPoint(lkin     : MAPTO TRCuKinematic;
                                  i_Org    : POINT;                      
                                  i_Result : POINT;
                                  Frame    : FRAMESHIFT)  : BOOL
VAR
   OrgFrame : TMcuFrame;
   NewFrame : TMcuFrame;
   IntFrame : TMcuFrame;
END_VAR
   
   IF i_Org.Coord <> Object THEN
      STOPPOINT();
      lkin.DebugPrint(eTraceVision, "Parameter i_Org = " + i_Org.GetName() + " ist kein Objektpunkt");
      RcuSetMessageOnce(TRcuObjMeasure_ErrObjPoint, lkin.kinListInx, 7, 0, "EcoTalk.MacroCalcTransformedPoint", "1", 
                        i_Org.GetName(), "CALC_TRANSFORMED_POINT");
      lkin.ErrorReaction(TRUE);
      RETURN FALSE;
   END_IF;

   OrgFrame.mFrameTyp := eMcuFrameKardan;
   OrgFrame.mPos.mValues[0] := i_Org.A;
   OrgFrame.mPos.mValues[1] := i_Org.B;
   OrgFrame.mPos.mValues[2] := i_Org.C;
   OrgFrame.mOri.mValues[0] := i_Org.D;
   OrgFrame.mOri.mValues[1] := i_Org.E;
   OrgFrame.mOri.mValues[2] := i_Org.F;
            
   IntFrame.mFrameTyp := eMcuFrameKardan;
   IntFrame.mPos.mValues[0] := Frame.X_mm;
   IntFrame.mPos.mValues[1] := Frame.Y_mm;
   IntFrame.mPos.mValues[2] := Frame.Z_mm;
   IntFrame.mOri.mValues[0] := Frame.A_deg;
   IntFrame.mOri.mValues[1] := Frame.B_deg;
   IntFrame.mOri.mValues[2] := Frame.C_deg;

   McuMultiplyFrames(NewFrame, OrgFrame, IntFrame);

   i_Result := i_Org;
   i_Result.A  := NewFrame.mPos.mValues[0];
   i_Result.B  := NewFrame.mPos.mValues[1];
   i_Result.C  := NewFrame.mPos.mValues[2];
   i_Result.D  := NewFrame.mOri.mValues[0];
   i_Result.E  := NewFrame.mOri.mValues[1];
   i_Result.F  := NewFrame.mOri.mValues[2];
            
   RETURN TRUE;
END_ROUTINE


