ROUTINE TC_RECEIVE_TOOL(refTool : TOOL; corrTool : TOOL; OPTIONAL iRetVal : VISION_STATE) : BOOL GLOBAL USER { macro="TC" | enable="_system.gRcuFocusedRobot.vision.bTCBootUpOk" }
VAR
   elem : TRcuKinListElem; // element with the kinematicreference
   dummy : VISION_STATE;
END_VAR
   
   IF RcData.CheckKin(elem, "TC_RECEIVE_TOOL") THEN
      IF NOT elem.kin.vision.bTCBootUpOk THEN
         RcuResetMessage(EcoTalk_WarBKMacroIgnored, elem.kin.kinListInx, 16, 0, "EcoTalk.TC_RECEIVE_TOOL", "TC_RECEIVE_TOOL"); // EcoTalk_WarBKMacroIgnored !!!!!!
         RETURN FALSE;
      END_IF;
      STOPPOINT();
      IF IS_USED(iRetVal) THEN
         RETURN elem.kin.vision.Macro_TC_ReceiveTool(refTool, corrTool, iRetVal);
      ELSE
         RETURN elem.kin.vision.Macro_TC_ReceiveTool(refTool, corrTool, dummy);
      END_IF;
   ELSE
      RETURN FALSE;
   END_IF;
   
END_ROUTINE


