                            Org                   : TOOL;                      
                            Result                : TOOL;
                            OPTIONAL iRetVal      : VISION_STATE)  : BOOL GLOBAL USER { macro="GEOMETRIC"}
   VAR
      elem : TRcuKinListElem; // element with the kinematicreference
      dummy : VISION_STATE;
   END_VAR
   
   IF RcData.CheckKin(elem, "CALC_DISPLACED_TOOL") THEN	
      IF IS_USED(iRetVal) THEN
         RETURN elem.kin.vision.MacroCalcToolDisplacement(SubSystemType, Org, Result, iRetVal);
      ELSE
         RETURN elem.kin.vision.MacroCalcToolDisplacement(SubSystemType, Org, Result, dummy);
      END_IF;
   END_IF;
