   END_VAR
   
   IF RcData.CheckKin(elem, "CHECK_SFA_COUNTER") THEN
      STOPPOINT();
      RETURN elem.kin.sfa.MacroCheckCounter(min,max);
   ELSE
      RETURN FALSE;
   END_IF;
END_ROUTINE 


