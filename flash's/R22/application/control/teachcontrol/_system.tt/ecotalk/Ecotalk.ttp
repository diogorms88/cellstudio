// macro for tracking
ROUTINE CONVEYOR_START() GLOBAL USER { macro="Tracking" | enable="_system.gbIsTrackingStation"}
   VAR
      elem : TRcuKinListElem; // element with the kinematicreference
   END_VAR

   IF RcData.CheckKin(elem, "CONVEYOR_START") THEN
      IF NOT (elem.kin.lineTracking OR elem.kin.railTracking) THEN
         RcuResetMessage(EcoTalk_WarMacroIgnored, elem.kin.kinListInx, 7, 0, "EcoTalk.CONVEYOR_START", "CONVEYOR_START");
         RETURN;
      END_IF;
      IF elem.kin.homing.SimulateMacro("CONVEYOR_START") THEN
