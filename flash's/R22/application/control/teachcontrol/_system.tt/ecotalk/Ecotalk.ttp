// Test, wenn Simulate = TRUE
ROUTINE Z_TESTDATA(pointNumber : DINT; DX : REAL; DY : REAL; DZ : REAL) GLOBAL USER { macro="ZEISS" | enable="_system.gRcuFocusedRobot.vision.VisionZeiss.bZeissBootUpOk" }
VAR
   elem : TRcuKinListElem; // element with the kinematicreference
END_VAR   

   IF RcData.CheckKin(elem, "Z_TESTDATA") THEN
      IF NOT elem.kin.vision.VisionZeiss.bZeissBootUpOk THEN
         RcuSetMessageOnce(EcoTalk_ErrZeissMacroIgnored, elem.kin.kinListInx, 14, 0, "EcoTalk.Z_TESTDATA", "Z_TESTDATA");
	      elem.kin.ErrorReaction(TRUE);
         RETURN;
      END_IF;
      IF NOT elem.kin.vision.VisionZeiss.bSimulate THEN
         RcuSetMessageOnce(EcoTalk_ErrTestMakroZeiss, elem.kin.kinListInx, 1, 0, "EcoTalk.Z_RESET", "Z_RESET");
	      elem.kin.ErrorReaction(TRUE);
         RETURN;
      END_IF;
      IF elem.kin.vision.VisionZeiss.bGhostMode THEN
         RETURN; // ignore all Zeiss macros in Ghostmode
      END_IF;
      STOPPOINT();
      elem.kin.vision.VisionZeiss.Z_TestData(pointNumber, DX, DY, DZ);
   END_IF;
END_ROUTINE


// Test, wenn Simulate = TRUE
ROUTINE Z_RESET() GLOBAL USER { macro="ZEISS" | enable="_system.gRcuFocusedRobot.vision.VisionZeiss.bZeissBootUpOk" }
VAR
   elem : TRcuKinListElem; // element with the kinematicreference
END_VAR   

   IF RcData.CheckKin(elem, "Z_RESET") THEN
      IF NOT elem.kin.vision.VisionZeiss.bZeissBootUpOk THEN
         RcuSetMessageOnce(EcoTalk_ErrZeissMacroIgnored, elem.kin.kinListInx, 15, 0, "EcoTalk.Z_RESET", "Z_RESET");
	      elem.kin.ErrorReaction(TRUE);
         RETURN;
      END_IF;
      IF NOT elem.kin.vision.VisionZeiss.bSimulate THEN
         RcuSetMessageOnce(EcoTalk_ErrTestMakroZeiss, elem.kin.kinListInx, 2, 0, "EcoTalk.Z_RESET", "Z_RESET");
	      elem.kin.ErrorReaction(TRUE);
         RETURN;
      END_IF;
      IF elem.kin.vision.VisionZeiss.bGhostMode THEN
         RETURN; // ignore all Zeiss macros in Ghostmode
      END_IF;
      STOPPOINT();
      elem.kin.vision.VisionZeiss.Z_ResetTestData();
   END_IF;
END_ROUTINE

