ROUTINE TBOX_CHECK(nozzle : NOZZLE; ToolDiff : TOOL; OPTIONAL iRetVal : VISION_STATE) : BOOL GLOBAL USER { macro="TBOX" | enable="_system.gRcuFocusedRobot.vision.bTBoxBootUpOk" }
VAR
   elem : TRcuKinListElem; // element with the kinematicreference
   dummy : VISION_STATE;
   nozzleNr : DINT;
   info          : TUserProgStackInfo;
   iLine : DINT;
END_VAR
   
   IF RcData.CheckKin(elem, "TBOX_CHECK") THEN
      IF NOT elem.kin.vision.bTBoxBootUpOk THEN
         RcuResetMessage(EcoTalk_ErrBKMacroIgnored, elem.kin.kinListInx, 8, 0, "EcoTalk.TBOX_CHECK", "TBOX_CHECK");
	      elem.kin.ErrorReaction(TRUE);
         RETURN FALSE;
      END_IF;
      // Get Line of Teachprog for Error-Msg
      IF GetUserProgCallStackInfo(0, info) THEN
         IF info.depth > 0 THEN
            iLine := info.lineNrs[info.depth-1]; 
         ELSE
            iLine := info.lineNrs[0]; 
         END_IF;
      END_IF;
      nozzleNr := nozzle;
      STOPPOINT();
      IF (nozzleNr < 1) OR (nozzleNr > 255) THEN
         RcuSetMessageOnce(EcoTalk_ErrParamOutOfRange, elem.kin.kinListInx, 36, 0, "Ecotalk.TBOX_CHECK",  STR(iLine), "value=", STR(nozzleNr) + " (1..255)");
         elem.kin.ErrorReaction(TRUE);
         RETURN FALSE;
      END_IF;
      IF elem.kin.vision.TBOX_GhostNoVision THEN
         RETURN TRUE;
      END_IF;
      IF IS_USED(iRetVal) THEN
         RETURN elem.kin.vision.Macro_TBoxCheck(nozzleNr, ToolDiff, iRetVal);
      ELSE
         RETURN elem.kin.vision.Macro_TBoxCheck(nozzleNr, ToolDiff, dummy);
      END_IF;
   END_IF;
   RETURN FALSE;
END_ROUTINE

ROUTINE TBOX_CORR(nozzle : NOZZLE; RefTool : TOOL; CorrTool : TOOL; OPTIONAL iRetVal : VISION_STATE) : BOOL GLOBAL USER { macro="TBOX" | enable="_system.gRcuFocusedRobot.vision.bTBoxBootUpOk" }
VAR
   elem : TRcuKinListElem; // element with the kinematicreference
   dummy : VISION_STATE;
   nozzleNr : DINT;
   info          : TUserProgStackInfo;
   iLine : DINT;
END_VAR
   
   IF RcData.CheckKin(elem, "TBOX_CORR") THEN
      IF NOT elem.kin.vision.bTBoxBootUpOk THEN
         RcuResetMessage(EcoTalk_ErrBKMacroIgnored, elem.kin.kinListInx, 8, 0, "EcoTalk.TBOX_CORR", "TBOX_CORR");
	      elem.kin.ErrorReaction(TRUE);
         RETURN FALSE;
      END_IF;
      nozzleNr := nozzle;
      STOPPOINT();
      // Get Line of Teachprog for Error-Msg
      IF GetUserProgCallStackInfo(0, info) THEN
         IF info.depth > 0 THEN
            iLine := info.lineNrs[info.depth-1]; 
         ELSE
            iLine := info.lineNrs[0]; 
         END_IF;
      END_IF;
      IF (nozzleNr < 1) OR (nozzleNr > 255) THEN
         RcuSetMessageOnce(EcoTalk_ErrParamOutOfRange, elem.kin.kinListInx, 35, 0, "Ecotalk.TBOX_CORR",  STR(iLine), "value=", STR(nozzleNr) + " (1..255)");
         elem.kin.ErrorReaction(TRUE);
         RETURN FALSE;
      END_IF;
      IF elem.kin.vision.TBOX_GhostNoVision THEN
         RETURN TRUE;
      END_IF;
      IF IS_USED(iRetVal) THEN
         RETURN elem.kin.vision.Macro_TBoxCorr(nozzleNr, RefTool, CorrTool, iRetVal);
      ELSE
         RETURN elem.kin.vision.Macro_TBoxCorr(nozzleNr, RefTool, CorrTool, dummy);
      END_IF;
   END_IF;
   RETURN FALSE;
END_ROUTINE

// Überschreiben bzw. setzen der maximal zulässigen Alarm-/Warngrenze der Toolkorrektur
ROUTINE TBOX_SETTOLERANCE(LimitType : LIMIT_TYPE; x_min : REAL; x_max : REAL; y_min : REAL; y_max : REAL; z_min : REAL; z_max : REAL)
                 GLOBAL USER { macro="TBOX" | enable="_system.gRcuFocusedRobot.vision.bTBoxBootUpOk" }
   VAR
      elem : TRcuKinListElem; // element with the kinematicreference
      iLine : DINT;
      info  : TUserProgStackInfo;
   END_VAR
   
   IF RcData.CheckKin(elem, "TBOX_SETTOLERANCE") THEN
      IF NOT elem.kin.vision.bTBoxBootUpOk THEN
         RcuResetMessage(EcoTalk_WarBKMacroIgnored, elem.kin.kinListInx, 13, 0, "EcoTalk.TBOX_SETTOLERANCE", "TBOX_SETTOLERANCE");
         RETURN;
      END_IF;
      elem.kin.vision.Macro_TBOX_SetTolerance(LimitType, x_min, x_max, y_min, y_max, z_min, z_max);
   END_IF;
END_ROUTINE


