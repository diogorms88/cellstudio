         elem.kin.ErrorReaction(TRUE);
         RETURN;
      END_IF;
      IF elem.kin.vision.bBKGhostMode THEN
         RETURN; // ignore all BK macros in Ghostmode
      END_IF;
      STOPPOINT();
      elem.kin.vision.Macro_BK_Init();
   END_IF;
   
END_ROUTINE


ROUTINE BK_START(typeNr : DINT; pathID : DINT; mode : BK_MODE_TYPE) GLOBAL USER { macro="BK" | enable="_system.gRcuFocusedRobot.vision.bBKBootUpOk" }
VAR
