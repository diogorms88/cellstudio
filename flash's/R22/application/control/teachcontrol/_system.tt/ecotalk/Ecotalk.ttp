   END_IF;
   
END_ROUTINE


ROUTINE BK_CORR(pointNumber : DINT) GLOBAL USER { macro="BK" | enable="_system.gRcuFocusedRobot.vision.bBKBootUpOk" } 
VAR
   elem : TRcuKinListElem; // element with the kinematicreference
END_VAR
   
   IF RcData.CheckKin(elem, "BK_CORR") THEN
