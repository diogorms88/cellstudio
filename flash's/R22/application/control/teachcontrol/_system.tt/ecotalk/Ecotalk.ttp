ROUTINE RECEIVECORR(point : POINT; pointID : DINT) : BOOL GLOBAL USER { macro="ZEISS" | enable="_system.gRcuFocusedRobot.vision.VisionZeiss.bZeissBootUpOk" }
VAR
   elem : TRcuKinListElem; // element with the kinematicreference
END_VAR
   
   IF RcData.CheckKin(elem, "RECEIVECORR") THEN
      IF NOT elem.kin.vision.VisionZeiss.bZeissBootUpOk THEN
         RcuResetMessage(EcoTalk_ErrZeissMacroIgnored, elem.kin.kinListInx, 3, 0, "EcoTalk.RECEIVECORR", "RECEIVECORR");
	      elem.kin.ErrorReaction(TRUE);
         RETURN FALSE;
      END_IF;
      IF elem.kin.vision.VisionZeiss.bGhostMode THEN
         RETURN TRUE; // ignore all Zeiss macros in Ghostmode
      END_IF;
      IF elem.kin.vision.VisionZeiss.bTriggerPending THEN
         elem.kin.DebugPrint(eTraceVision, "PreTrigger: Waiting last Trigger is executed");
         WAIT NOT elem.kin.vision.VisionZeiss.bTriggerPending;
      END_IF;
      STOPPOINT();
      RETURN elem.kin.vision.VisionZeiss.Z_ReceiveCorr(point, pointID);
   END_IF;
   RETURN FALSE;
END_ROUTINE

