         RcuResetMessage(EcoTalk_ErrBKMacroIgnored, elem.kin.kinListInx, 9, 0, "EcoTalk.BK_START", "BK_START");
	 elem.kin.ErrorReaction(TRUE);
         RETURN;
      END_IF;
      IF elem.kin.vision.bBKGhostMode THEN
         RETURN; // ignore all BK macros in Ghostmode
      END_IF;
      STOPPOINT();
      elem.kin.vision.Macro_BK_Start(itypeNr, ipathID, mode);
   END_IF;
   
END_ROUTINE


ROUTINE BK_FINISH(numberOfTrPoint : DINT; OPTIONAL iRetVal : VISION_STATE; OPTIONAL numberOfCorr : DINT) : BOOL GLOBAL USER { macro="BK" | enable="_system.gRcuFocusedRobot.vision.bBKBootUpOk" } 
VAR
   elem : TRcuKinListElem; // element with the kinematicreference
   inumberOfPoint : INT;
   inumberOfCorr  : INT;
END_VAR
   
   inumberOfPoint := numberOfTrPoint;
   IF IS_USED(numberOfCorr) THEN
      inumberOfCorr := numberOfCorr;
   END_IF;
   IF RcData.CheckKin(elem, "BK_FINISH") THEN
      IF NOT elem.kin.vision.bBKBootUpOk THEN
         RcuResetMessage(EcoTalk_ErrBKMacroIgnored, elem.kin.kinListInx, 10, 0, "EcoTalk.BK_FINISH", "BK_FINISH");
	 elem.kin.ErrorReaction(TRUE);
         RETURN TRUE;
      END_IF;
      IF elem.kin.vision.bBKGhostMode THEN
         RETURN TRUE; // ignore all BK macros in Ghostmode
      END_IF;
      elem.kin.vision.PreRun_Macro_BK_Ende(inumberOfPoint);
      STOPPOINT();
      IF IS_USED(iRetVal) THEN 
         IF IS_USED(numberOfCorr) THEN
            RETURN elem.kin.vision.Macro_BK_Ende(inumberOfPoint, inumberOfCorr, iRetVal);
         ELSE
            RETURN elem.kin.vision.Macro_BK_Ende(inumberOfPoint, , iRetVal);
         END_IF;
      ELSE
         IF IS_USED(numberOfCorr) THEN
            RETURN elem.kin.vision.Macro_BK_Ende(inumberOfPoint, inumberOfCorr);
         ELSE
            RETURN elem.kin.vision.Macro_BK_Ende(inumberOfPoint);
         END_IF;
      END_IF;
   END_IF;
   RETURN FALSE;  
END_ROUTINE


ROUTINE BK_FINISH_ISRA2(numberOfTrPoint : DINT; numberOfCorrPoint : DINT; OPTIONAL iRetVal : VISION_STATE) : BOOL GLOBAL USER { macro="BK" | enable="_system.gRcuFocusedRobot.vision.bBKBootUpOk" } 
VAR
   elem : TRcuKinListElem; // element with the kinematicreference
   inumberOfPoint : INT;
   inumberOfCorr  : INT;
END_VAR
   
   inumberOfPoint := numberOfTrPoint;
   inumberOfCorr  := numberOfCorrPoint;
   IF RcData.CheckKin(elem, "BK_FINISH_ISRA2") THEN
      IF NOT elem.kin.vision.bBKBootUpOk THEN
         RcuResetMessage(EcoTalk_ErrBKMacroIgnored, elem.kin.kinListInx, 10, 0, "EcoTalk.BK_FINISH_ISRA2", "BK_FINISH_ISRA2");
	      elem.kin.ErrorReaction(TRUE);
         RETURN TRUE;
      END_IF;
      IF elem.kin.vision.bBKGhostMode THEN
         RETURN TRUE; // ignore all BK macros in Ghostmode
      END_IF;
      IF elem.kin.vision.iTypeBK = eISRA2 THEN
         elem.kin.vision.PreRun_Macro_BK_Ende(inumberOfPoint);
         STOPPOINT();
         IF IS_USED(iRetVal) THEN 
            RETURN elem.kin.vision.Macro_BK_Ende_2(inumberOfPoint, inumberOfCorr, iRetVal);
         ELSE
            RETURN elem.kin.vision.Macro_BK_Ende_2(inumberOfPoint, inumberOfCorr);
         END_IF;
      ELSE
         elem.kin.vision.PreRun_Macro_BK_Ende(inumberOfPoint);
         STOPPOINT();
         IF IS_USED(iRetVal) THEN 
            RETURN elem.kin.vision.Macro_BK_Ende(inumberOfPoint, inumberOfCorr, iRetVal);
         ELSE
            RETURN elem.kin.vision.Macro_BK_Ende(inumberOfPoint, inumberOfCorr);
         END_IF;
      END_IF;
   END_IF;
   RETURN FALSE;  
END_ROUTINE


ROUTINE BK_ACTION(point : POINT; pointNumber : DINT; trigger : TRIGGERFRAME) GLOBAL USER { macro="BK" | enable="_system.gRcuFocusedRobot.vision.bBKBootUpOk" } 
VAR
   elem : TRcuKinListElem; // element with the kinematicreference
   ipointNumber : INT;
END_VAR
   
   ipointNumber := pointNumber;
   IF RcData.CheckKin(elem, "BK_ACTION") THEN
      IF NOT elem.kin.vision.bBKBootUpOk THEN
         RcuResetMessage(EcoTalk_ErrBKMacroIgnored, elem.kin.kinListInx, 11, 0, "EcoTalk.BK_ACTION", "BK_ACTION");
	 elem.kin.ErrorReaction(TRUE);
         RETURN;
      END_IF;
      IF elem.kin.vision.bBKGhostMode THEN
         RETURN; // ignore all BK macros in Ghostmode
      END_IF;
      elem.kin.vision.Macro_BK_Action();
      trigger.TriggerBkAction(elem, point, ipointNumber);
   END_IF;
   
END_ROUTINE


ROUTINE BK_ACTION_DIRECT(pointNumber : DINT) GLOBAL USER { macro="BK" | enable="_system.gRcuFocusedRobot.vision.bBKBootUpOk" } 
VAR
